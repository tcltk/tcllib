test map-api-fetcher-4.0 {get, tile found: url zoom/column/row.png, set callback} -constraints tk -setup {
    set port [srv::start]
    srv::respond /tiles/3/5/2.png 200 image/png $png
    map::slippy::fetcher fet 5 http://127.0.0.1:$port/tiles
    set result {}
    unset -nocomplain done
} -body {
    fet get {3 2 5} record
    waitfor done
    lassign [lindex $result 0] what tile image
    list $srv::requests $what $tile [image width $image] [image height $image] \
	[$image get 0 0]
} -cleanup {
    catch {image delete $image}
    fet destroy
    srv::stop
    unset -nocomplain port result done what tile image
} -result {{{GET /tiles/3/5/2.png HTTP/1.1}} set {3 2 5} 1 1 {255 0 0}}

test map-api-fetcher-4.1 {get, tile not found: unset callback} -constraints tk -setup {
    set port [srv::start]
    map::slippy::fetcher fet 5 http://127.0.0.1:$port/tiles
    set result {}
    unset -nocomplain done
} -body {
    fet get {3 2 5} record
    waitfor done
    set result
} -cleanup {
    fet destroy
    srv::stop
    unset -nocomplain port result done
} -result {{unset {3 2 5}}}

test map-api-fetcher-4.2 {get, data is not an image: unset callback} -constraints tk -setup {
    set port [srv::start]
    srv::respond /tiles/0/0/0.png 200 image/png "not an image"
    map::slippy::fetcher fet 5 http://127.0.0.1:$port/tiles
    set result {}
    unset -nocomplain done
} -body {
    fet get {0 0 0} record
    waitfor done
    set result
} -cleanup {
    fet destroy
    srv::stop
    unset -nocomplain port result done
} -result {{unset {0 0 0}}}

test map-api-fetcher-4.3 {get, callback prefix gets arguments appended} -constraints tk -setup {
    set port [srv::start]
    map::slippy::fetcher fet 5 http://127.0.0.1:$port/tiles
    set result {}
    unset -nocomplain done
} -body {
    fet get {0 0 0} {record a b}
    waitfor done
    set result
} -cleanup {
    fet destroy
    srv::stop
    unset -nocomplain port result done
} -result {{a b unset {0 0 0}}}

test map-api-fetcher-4.4 {get, concurrent requests for one tile share one download} -constraints tk -setup {
    set port [srv::start]
    srv::respond /tiles/1/1/0.png 200 image/png $png
    map::slippy::fetcher fet 5 http://127.0.0.1:$port/tiles
    set result {}
    unset -nocomplain done
    proc record2 {args} {lappend ::result $args; if {[llength $::result] == 2} {set ::done 1}}
} -body {
    fet get {1 0 1} {record2 A}
    fet get {1 0 1} {record2 B}
    waitfor done
    lassign $result ra rb
    list $srv::requests [lrange $ra 0 2] [lrange $rb 0 2] [expr {[lindex $ra 3] eq [lindex $rb 3]}]
} -cleanup {
    catch {image delete [lindex $ra 3]}
    rename record2 {}
    fet destroy
    srv::stop
    unset -nocomplain port result done ra rb
} -result {{{GET /tiles/1/1/0.png HTTP/1.1}} {A set {1 0 1}} {B set {1 0 1}} 1}

# -------------------------------------------------------------------------
# map::slippy::cache (needs Tk)
# -------------------------------------------------------------------------

# A fake provider: answers 'levels' with 5, records 'get' requests and
# keeps the done callbacks for the test to invoke.
proc provider {cmd args} {
    switch -exact -- $cmd {
	levels { return 5 }
	get {
	    lappend ::pgets $args
	    return
	}
	extra { return [list extra {*}$args] }
	default { error "unknown provider method $cmd" }
    }
}

proc mkcachedir {} {
    set d [makeDirectory map-api-cache]
    file delete -force $d
    file mkdir $d
    return $d
}

test map-api-cache-1.0 {constructor, result} -constraints tk -setup {
    set dir [mkcachedir]
} -body {
    map::slippy::cache ca $dir provider
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -result ::ca

test map-api-cache-1.1 {constructor, missing directory} -constraints tk -setup {
    set dir [mkcachedir]
    file delete -force $dir
} -body {
    map::slippy::cache ca $dir provider
} -cleanup {
    unset dir
} -returnCodes error -match glob -result {Error in constructor: ::map::slippy::cache constructor: *": Does not exist}

test map-api-cache-1.2 {constructor, path is a file} -constraints tk -setup {
    set dir [makeFile {} map-api-cache-file]
} -body {
    map::slippy::cache ca $dir provider
} -cleanup {
    removeFile map-api-cache-file
    unset dir
} -returnCodes error -match glob -result {Error in constructor: ::map::slippy::cache constructor: *": Is not a directory}

test map-api-cache-1.3 {constructor, wrong # args} -constraints tk -setup {
    set dir [mkcachedir]
} -body {
    map::slippy::cache ca $dir
} -cleanup {
    file delete -force $dir
    unset dir
} -returnCodes error -result {Error in constructor: wrong # args: should be "::map::slippy::cache::Snit_constructor type selfns win self cachedir provider"}

test map-api-cache-2.0 {valid} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
    set msg {}
} -body {
    list [ca valid {4 1 1}] [ca valid {6 0 0} msg] $msg [ca valid {2 0 4} msg] $msg
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir msg
} -result {1 0 {Bad zoom level '6' (max: 5)} 0 {Bad cell '0 4' (max: 4)}}

test map-api-cache-3.0 {exists, not cached} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
} -body {
    ca exists {2 1 3}
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -result 0

test map-api-cache-3.1 {exists, cached file zoom/column/row.png} -constraints tk -setup {
    set dir [mkcachedir]
    file mkdir [file join $dir 2 3]
    close [open [file join $dir 2 3 1.png] w]
    map::slippy::cache ca $dir provider
} -body {
    ca exists {2 1 3}
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -result 1

test map-api-cache-3.2 {exists, invalid tile} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
} -body {
    ca exists {9 0 0}
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -returnCodes error -result {Bad zoom level '9' (max: 5)}

test map-api-cache-4.0 {get, wrong # args} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
} -body {
    ca get {0 0 0}
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -returnCodes error -result [snitWrongNumArgs ca ::map::slippy::cache::Snit_methodget {tile donecmd} 1]

test map-api-cache-4.1 {get, invalid tile} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
} -body {
    ca get {1 2 0} record
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -returnCodes error -result {Bad cell '2 0' (max: 2)}

test map-api-cache-4.2 {get, unknown tile asks the provider once, caches the image} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
    set pgets {}
    set result {}
    proc record2 {args} {lappend ::result $args}
} -body {
    ca get {2 1 3} {record2 A}
    ca get {2 1 3} {record2 B}
    set n [llength $pgets]
    lassign [lindex $pgets 0] ptile pdone
    set img [image create photo -data $png]
    {*}$pdone set $ptile $img
    list $n $ptile [expr {$result eq [list [list A set {2 1 3} $img] [list B set {2 1 3} $img]]}] \
	[file exists [file join $dir 2 3 1.png]] [ca exists {2 1 3}]
} -cleanup {
    catch {image delete $img}
    rename record2 {}
    ca destroy
    file delete -force $dir
    unset -nocomplain dir pgets result n ptile pdone img
} -result {1 {2 1 3} 1 1 1}

test map-api-cache-4.6 {get, empty donecmd (prefetch): image cached, then deleted} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
    set pgets {}
} -body {
    ca get {2 1 3} {}
    lassign [lindex $pgets 0] ptile pdone
    set img [image create photo -data $png]
    {*}$pdone set $ptile $img
    list [file exists [file join $dir 2 3 1.png]] [expr {$img in [image names]}]
} -cleanup {
    catch {image delete $img}
    ca destroy
    file delete -force $dir
    unset -nocomplain dir pgets ptile pdone img
} -result {1 0}

test map-api-cache-4.3 {get, provider has no image: unset to all requestors} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
    set pgets {}
    set result {}
    proc record2 {args} {lappend ::result $args}
} -body {
    ca get {2 1 3} {record2 A}
    ca get {2 1 3} {record2 B}
    lassign [lindex $pgets 0] ptile pdone
    {*}$pdone unset $ptile
    list $result [ca exists {2 1 3}]
} -cleanup {
    rename record2 {}
    ca destroy
    file delete -force $dir
    unset -nocomplain dir pgets result ptile pdone
} -result {{{A unset {2 1 3}} {B unset {2 1 3}}} 0}

test map-api-cache-4.4 {get, cached tile is delivered from the filesystem} -constraints tk -setup {
    set dir [mkcachedir]
    file mkdir [file join $dir 1 0]
    set c [open [file join $dir 1 0 1.png] wb]
    puts -nonewline $c $png
    close $c
    map::slippy::cache ca $dir provider
    set pgets {}
    set result {}
    unset -nocomplain done
} -body {
    ca get {1 1 0} record
    waitfor done
    lassign [lindex $result 0] what tile image
    list $pgets $what $tile [image width $image] [$image get 0 0]
} -cleanup {
    catch {image delete $image}
    ca destroy
    file delete -force $dir
    unset -nocomplain dir pgets result done what tile image c
} -result {{} set {1 1 0} 1 {255 0 0}}

test map-api-cache-4.5 {get, with fetcher as provider} -constraints tk -setup {
    set dir [mkcachedir]
    set port [srv::start]
    srv::respond /t/2/3/1.png 200 image/png $png
    map::slippy::fetcher fet 5 http://127.0.0.1:$port/t
    map::slippy::cache ca $dir fet
    set result {}
    unset -nocomplain done
} -body {
    ca get {2 1 3} record
    waitfor done
    lassign [lindex $result 0] what tile image
    list $what $tile [image width $image] [file exists [file join $dir 2 3 1.png]] \
	[ca levels] [ca tilewidth] [ca tileheight]
} -cleanup {
    catch {image delete $image}
    ca destroy
    fet destroy
    srv::stop
    file delete -force $dir
    unset -nocomplain dir port result done what tile image
} -result {set {2 1 3} 1 1 5 256 256}

test map-api-cache-5.0 {unknown methods are delegated to the provider} -constraints tk -setup {
    set dir [mkcachedir]
    map::slippy::cache ca $dir provider
} -body {
    ca extra 1 2
} -cleanup {
    ca destroy
    file delete -force $dir
    unset dir
} -result {extra 1 2}

rename provider {}
rename mkcachedir {}
catch {unset png}

# -------------------------------------------------------------------------

rename waitfor {}
rename record {}
rename recorderror {}
rename failing {}
namespace delete srv
unset jsonok
TestAccelExit map::slippy
testsuiteCleanup
# Leave no Tk main loop running after the tests.
if {[info exists tk_version]} {
    destroy .
}
return

