} -returnCodes error -result [snitWrongNumArgs fet ::map::slippy::fetcher::Snit_methodget {tile donecmd} 1]

test map-api-fetcher-3.1 {get, invalid tile} -constraints tk -setup {
    map::slippy::fetcher fet 5 http://127.0.0.1:1/tiles
} -body {
    fet get {7 0 0} record
} -cleanup {
    fet destroy
} -returnCodes error -result {Bad zoom level '7' (max: 5)}

test map-api-fetcher-3.2 {get, invalid cell} -constraints tk -setup {
    map::slippy::fetcher fet 5 http://127.0.0.1:1/tiles
} -body {
    fet get {1 0 2} record
} -cleanup {
    fet destroy
