if {[lsearch [namespace children] ::tcltest] == -1} {
    set selfrun 1
    set auto_path [linsert $auto_path 0 [pwd]]
    if {[file exists [file join [pwd] modules request]]} {
        set auto_path [linsert $auto_path 0 [file join [pwd] modules request]]
    }
    package require tcltest
    package require request
    namespace import ::tcltest::*
} else {
    source [file join \
        [file dirname [file dirname [file join [pwd] [info script]]]] \
        devtools testutilities.tcl]

    testsNeedTcl     8.5
    testsNeedTcltest 2

    support {
        useLocal request.tcl request
    }
    testing {
        useLocal request.tcl request
    }
}

namespace eval request::test {
    proc initHttpStubs {} {
        foreach cmd {geturl posturl data ncode status meta register} {
            set fullname ::http::$cmd
            set origname ::http::request_test_orig_$cmd
            if {[llength [info commands $fullname]] && ![llength [info commands $origname]]} {
                rename $fullname $origname
            }
        }
        namespace eval http {
            variable stubMode normal
            variable registerArgs {}
            proc setStubMode {mode} {
                variable stubMode
                set stubMode $mode
            }
            proc geturl {url args} {
                variable stubMode
                if {$url eq http://redirect.example.com} {
                    return tok-301
                }
                if {$url eq http://example.com/redirected} {
                    return tok-get
                }
                if {$stubMode eq notfound} {
                    return tok-404
                }
                return tok-get
            }
            proc posturl {url body args} {
                return tok-post
            }
            proc data {token} {
                switch -- $token {
                    tok-get { return get-body }
                    tok-post { return post-body }
                    tok-301 { return "" }
                    tok-404 { return notfound }
                    default { return {} }
                }
            }
            proc ncode {token} {
                switch -- $token {
                    tok-get { return 200 }
                    tok-post { return 200 }
                    tok-301 { return 301 }
                    tok-404 { return 404 }
                    default { return 500 }
                }
            }
            proc status {token} {
                switch -- $token {
                    tok-get { return ok }
                    tok-post { return ok }
                    tok-301 { return "Moved Permanently" }
                    tok-404 { return "not found" }
                    default { return error }
                }
            }
            proc meta {token} {
                switch -- $token {
                    tok-301 { return {Location http://example.com/redirected} }
                    default { return {Content-Type text/plain} }
                }
            }
            proc register {scheme port command} {
                variable registerArgs
                set registerArgs [list $scheme $port $command]
            }
            proc getRegisterArgs {} {
                variable registerArgs
                return $registerArgs
            }
        }
    }

    proc restoreHttpStubs {} {
        foreach cmd {geturl posturl data ncode status meta register} {
            set origname ::http::request_test_orig_$cmd
            if {[llength [info commands $origname]]} {
                if {[llength [info commands ::http::$cmd]]} {
                    rename ::http::$cmd ::http::request_test_stub_$cmd
                }
                rename $origname ::http::$cmd
            }
        }
    }

    # Helper: run a request that changes ::http::configure and verify
    # that the original value for a single key is restored after execute
    # both on success and on error.
    proc verifyHttpConfigRestore {key changedVal} {
        variable ::http::request_test_stub_geturl
        set orig [httpConfigGet $key]

        # success path
        request::test::initHttpStubs
        request create client
        client configure -method GET -url http://example.com -$key $changedVal
        set _dummy [client execute]
        request::test::restoreHttpStubs
        if {[httpConfigGet $key] ne $orig} {
            return -code error "http configure $key not restored after success"
        }

        # error path
        request::test::initHttpStubs
        http::setStubMode notfound
        request create client2
        client2 configure -method GET -url http://example.com -$key $changedVal
        catch {client2 execute} _err
        request::test::restoreHttpStubs
        if {[httpConfigGet $key] ne $orig} {
            return -code error "http configure $key not restored after error"
        }

        return "ok"
    }
}

# Helper to safely read ::http::configure for a single key
proc httpConfigGet {k} {
    if {[catch {set v [::http::configure configure -$k]}]} {
        if {[catch {set m [::http::configure configure]}]} {
            return {}
        }
        if {[dict exists $m $k]} { return [dict get $m $k] }
        return {}
    }
    return $v
}

# (no helper needed in harnessed tests)

# -------------------------------------------------------------------------

test request-1.1 {configure and cget work together} {
    request create client
    client configure -method GET -url http://example.com -headers {Accept text/plain} -proxyhost proxy.example.com
    set cfg [client configure]
    set method [dict get $cfg method]
    set url [dict get $cfg url]
    set headers [dict get $cfg headers]
    set proxy [client cget proxyhost]
    set method $url $headers $proxy
} {GET http://example.com {Accept text/plain} proxy.example.com}

test request-1.2 {configure accepts dictionary form} {
    request create client
    client configure [dict create method POST url http://example.com/body body payload headers {Content-Type text/plain}]
    set body [client cget body]
    set headers [client cget headers]
    set method [client cget method]
    set url [client cget url]
    set method $url $body $headers
} {POST http://example.com/body payload {Content-Type text/plain}}

test request-1.3 {cget throws on unknown attribute} {
    request create client
    catch {client cget unknown} msg
    set msg
} {unknown attribute unknown}

test request-1.4 {constructor args accept body and headers} {
    request::test::initHttpStubs
        request create client -method POST -url http://example.com -body payload -headers {Content-Type text/plain}
    set body [client execute]
    set storedBody [client cget body]
    set storedHeaders [client cget headers]
    request::test::restoreHttpStubs
    set body $storedBody $storedHeaders
} {payload {Content-Type text/plain}}

test request-1.5 {stateless request helper returns response body} {
    request::test::initHttpStubs
        request create client
    set result [request request GET http://example.com]
    request::test::restoreHttpStubs
    set result
} {get-body}

test request-1.6 {get wrapper returns response body} {
    request::test::initHttpStubs
        request create client
    set result [client get http://example.com]
    request::test::restoreHttpStubs
    set result
} {get-body}

test request-1.7 {post wrapper returns response body} {
    request::test::initHttpStubs
        request create client
    set result [client post http://example.com -body payload]
    request::test::restoreHttpStubs
    set result
} {post-body}

test request-1.8 {execute follows redirects for supported redirect status codes} {
    request::test::initHttpStubs
    request create client
    client configure -method GET -url http://redirect.example.com
    set body [client execute]
    request::test::restoreHttpStubs
    set body
} {get-body}

test request-1.9 {https:// paths register tls and execute with https} {
    request::test::initHttpStubs
    request create client
    client configure -method GET -url https://example.com
    set body [client execute]
    set regArgs [::http::getRegisterArgs]
    request::test::restoreHttpStubs
    set body $regArgs
} {https 443 ::tls::socket}

test request-1.9 {execute returns body and updates lastResponse} {
    request::test::initHttpStubs
    request create client
    client configure -method GET -url http://example.com
    set body [client execute]
    set last [client lastResponse]
    request::test::restoreHttpStubs
    set body $last
} {get-body get-body 200 ok {Content-Type text/plain} tok-get}

test request-1.9 {execute throws on missing method or url} {
    request create client
    catch {client execute} msg
    set msg
} {both method and url must be set before calling execute}

test request-1.10 {execute throws on non-2xx status} {
    request::test::initHttpStubs
    http::setStubMode notfound
    request create client
    client configure -method GET -url http://example.com
    catch {client execute} msg
    request::test::restoreHttpStubs
    set msg
} {HTTP request returned non-2xx status: 404 (not found)}

test request-1.11 {https execute throws when tls package is unavailable} {
    request::test::initHttpStubs
    request create client
    client configure -method GET -url https://example.com
    rename package package.orig
    proc package {args} {
        if {[llength $args] == 2 && [lindex $args 0] == require && [lindex $args 1] == tls} {
            return -code error "can't find package tls"
        }
        return [eval package.orig {*}$args]
    }
    catch {client execute} msg
    if {[llength [info commands package.orig]]} {
        catch {rename package.orig package}
    }
    request::test::restoreHttpStubs
    set msg
} {failed to load tls package: can't find package tls}

test request-1.12 {constructor -tls true fails when tls package is unavailable} {
    rename package package.orig
    proc package {args} {
        if {[llength $args] == 2 && [lindex $args 0] == require && [lindex $args 1] == tls} {
            return -code error "can't find package tls"
        }
        return [eval package.orig {*}$args]
    }
    catch {request create client -method GET -url https://example.com -tls true} msg
    if {[llength [info commands package.orig]]} {
        catch {rename package.orig package}
    }
    set msg
} {failed to load tls package: can't find package tls}

# Additional tests for restoring ::http::configure were removed; rely on harnessed tests

test request-1.20 {::http::configure options are restored after execute} {
    # verify each option that request may touch is restored
    set keys {accept proxyhost proxyport proxyfilter urlencoding useragent}
    foreach k $keys {
        set res [request::test::verifyHttpConfigRestore $k changed-value]
        if {$res ne ok} {error $res}
    }
} {}
