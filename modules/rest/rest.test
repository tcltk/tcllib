# -*- tcl -*-
# rest.test:  Tests for the rest package.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

# -------------------------------------------------------------------------

test rest-pkgindex-1.0 {pkgIndex.tcl matches package provide, ticket 523f7e0556} -setup {
    set i [interp create]
} -body {
    $i eval [list set dir [localDirectory]]
    $i eval {source [file join $dir pkgIndex.tcl]}
    set v [$i eval {package versions rest}]
    set f [lindex [$i eval [list package ifneeded rest $v]] end]
    set c [open $f]
    set data [read $c]
    close $c
    regexp {package provide rest (\S+)} $data -> pv
    expr {$pv eq $v}
} -cleanup {
    interp delete $i
    unset -nocomplain i v f c data pv
} -result 1

# -------------------------------------------------------------------------
testsuiteCleanup
return
