# rc4-api.test - additional tests for the documented rc4 API.
#
# Covers what rc4.test does not: the programming interface (RC4Init,
# RC4, RC4Final), option errors, the man page examples and round trips.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal rc4.tcl rc4
}

# -------------------------------------------------------------------------

set impls {}
if {[llength [info commands ::rc4::rc4c]]} {
    lappend impls critcl
}
lappend impls array list

proc ::rc4::TestStore {data} {
    lappend ::rc4test $data
}

# -------------------------------------------------------------------------
# rc4::rc4 - option handling

test rc4-api-1.0 {rc4: unknown option} -body {
    rc4::rc4 -key k -bogus x data
} -returnCodes error \
    -result {bad option -bogus: must be one of -chunksize, -command, -hex, -in, -infile, -key, -out}

test rc4-api-1.1 {rc4: too many data arguments} -body {
    rc4::rc4 -key k a b
} -returnCodes error \
    -result {wrong # args: should be "rc4 ?-hex? -key key -in channel | string"}

test rc4-api-1.2 {rc4: empty key is rejected} -body {
    rc4::rc4 -key {} data
} -returnCodes error \
    -result {wrong # args: should be "rc4 ?-hex? -key key -in channel | string"}

test rc4-api-1.3 {rc4: missing -key} -body {
    rc4::rc4 -hex data
} -returnCodes error \
    -result {wrong # args: should be "rc4 ?-hex? -key key -in channel | string"}

test rc4-api-1.4 {rc4: -infile with a missing file} -body {
    rc4::rc4 -key k -infile [file join [temporaryDirectory] nonexistent.rc4]
} -returnCodes error -match glob -result {couldn't open "*nonexistent.rc4": no such file or directory}

test rc4-api-1.5 {rc4: data looking like an option} -body {
    rc4::rc4 -hex -key k -foo
} -result [rc4::Hex [rc4::rc4 -key k -- -foo]]

test rc4-api-1.6 {rc4: empty data} -body {
    rc4::rc4 -hex -key k {}
} -result {}

# -------------------------------------------------------------------------
# rc4::rc4 - man page examples, round trips

test rc4-api-2.0 {rc4: man page example, encrypt} -body {
    rc4::rc4 -hex -key [binary format H* 0123456789abcdef] HelloWorld
} -result 3cf1ae8b7f1c670b612f

test rc4-api-2.1 {rc4: man page example, decrypt} -body {
    rc4::rc4 -key [binary format H* 0123456789abcdef] \
        [binary format H* 3cf1ae8b7f1c670b612f]
} -result HelloWorld

test rc4-api-2.2 {rc4: decrypting the ciphertext gives the plaintext} -body {
    set data [string repeat "Ab\0\xff" 1000]
    set c [rc4::rc4 -key "secret key" $data]
    list [string equal $c $data] [string equal [rc4::rc4 -key "secret key" $c] $data]
} -cleanup {
    unset -nocomplain data c
} -result {0 1}

test rc4-api-2.3 {rc4: -hex with -out writes binary, returns empty} -setup {
    set f [open [makeFile {} rc4api.data] wb+]
} -body {
    set r [rc4::rc4 -hex -key 01234567 -out $f abcdef]
    seek $f 0
    list $r [rc4::Hex [read $f]]
} -cleanup {
    close $f
    removeFile rc4api.data
    unset -nocomplain f r
} -result {{} f0b7907b2341}

test rc4-api-2.4 {rc4: -command with -out on string data calls the command} -setup {
    set ::rc4test {}
    set f [open [makeFile {} rc4api.data] wb+]
} -body {
    set r [rc4::rc4 -key 01234567 -command ::rc4::TestStore -out $f abcdef]
    list $r [rc4::Hex [lindex $::rc4test 0]] [llength $::rc4test]
} -cleanup {
    close $f
    removeFile rc4api.data
    unset -nocomplain f r ::rc4test
} -result {{} f0b7907b2341 1}

test rc4-api-2.5 {rc4: -in channel is not closed, data read until eof} -setup {
    set data [string repeat "0123456789" 1000]
    set f [open [makeFile {} rc4api.data] wb+]
    puts -nonewline $f $data
    seek $f 0
} -body {
    set r [rc4::rc4 -key k -chunksize 7 -in $f]
    list [expr {[lsearch -exact [file channels] $f] >= 0}] [eof $f] \
        [string equal $r [rc4::rc4 -key k $data]]
} -cleanup {
    close $f
    removeFile rc4api.data
    unset -nocomplain f r data
} -result {1 1 1}

test rc4-api-2.6 {rc4: -infile channel is closed afterwards} -setup {
    set path [makeFile {} rc4api.data]
    set f [open $path wb]
    puts -nonewline $f "\0\1\2"
    close $f
    set before [lsort [file channels]]
} -body {
    list [rc4::rc4 -hex -key 01234567 -infile $path] \
        [string equal $before [lsort [file channels]]]
} -cleanup {
    removeFile rc4api.data
    unset -nocomplain f path before
} -result {91d4f1 1}

test rc4-api-2.7 {rc4: -infile with -out channel} -setup {
    set path [makeFile {} rc4api.data]
    set f [open $path wb]
    puts -nonewline $f abcdef
    close $f
    set g [open [makeFile {} rc4api2.data] wb+]
} -body {
    set r [rc4::rc4 -key 01234567 -infile $path -out $g]
    seek $g 0
    list $r [rc4::Hex [read $g]]
} -cleanup {
    close $g
    removeFile rc4api.data
    removeFile rc4api2.data
    unset -nocomplain f g r path
} -result {{} f0b7907b2341}

# -------------------------------------------------------------------------
# Programming interface: RC4Init, RC4, RC4Final, for every implementation

foreach impl $impls {
    rc4::SelectImplementation $impl

    test rc4-api-3.0-$impl {RC4Init/RC4/RC4Final: test vector} -body {
        set Key [rc4::RC4Init [binary format H* 0123456789abcdef]]
        set r [rc4::Hex [rc4::RC4 $Key [binary format H* 0123456789abcdef]]]
        rc4::RC4Final $Key
        set r
    } -cleanup {
        unset -nocomplain Key r
    } -result 75b7878099e0c596

    test rc4-api-3.1-$impl {RC4: state carries over between calls} -body {
        set Key [rc4::RC4Init "key data"]
        set plain [string repeat "plaintext " 50]
        set c {}
        foreach n {0 1 7 13 100 379} {
            append c [rc4::RC4 $Key [string range $plain 0 [expr {$n - 1}]]]
            set plain [string range $plain $n end]
        }
        rc4::RC4Final $Key
        string equal $c [rc4::rc4 -key "key data" [string repeat "plaintext " 50]]
    } -cleanup {
        unset -nocomplain Key plain c n
    } -result 1

    test rc4-api-3.2-$impl {RC4: two keys are independent} -body {
        set k1 [rc4::RC4Init abc]
        set k2 [rc4::RC4Init abc]
        set a [rc4::RC4 $k1 hello]
        set b [rc4::RC4 $k2 hello]
        set c [rc4::RC4 $k1 hello]
        rc4::RC4Final $k1
        rc4::RC4Final $k2
        list [string equal $a $b] [string equal $a $c]
    } -cleanup {
        unset -nocomplain k1 k2 a b c
    } -result {1 0}

    test rc4-api-3.3-$impl {RC4: empty data} -body {
        set Key [rc4::RC4Init abc]
        set r [rc4::RC4 $Key {}]
        rc4::RC4Final $Key
        set r
    } -cleanup {
        unset -nocomplain Key r
    } -result {}

    test rc4-api-3.4-$impl {RC4Final returns empty} -body {
        set Key [rc4::RC4Init abc]
        rc4::RC4Final $Key
    } -cleanup {
        unset -nocomplain Key
    } -result {}

    test rc4-api-3.5-$impl {RC4Init: wrong # args} -body {
        rc4::RC4Init
    } -returnCodes error -match glob -result {wrong # args*}

    test rc4-api-3.6-$impl {RC4: wrong # args} -body {
        rc4::RC4 a
    } -returnCodes error -match glob -result {wrong # args*}
}
rc4::SelectImplementation [lindex $impls 0]

test rc4-api-3.7 {RC4Final destroys the key state (pure Tcl)} -setup {
    rc4::SelectImplementation list
} -body {
    set Key [rc4::RC4Init abc]
    rc4::RC4Final $Key
    info exists $Key
} -cleanup {
    rc4::SelectImplementation [lindex $impls 0]
    unset -nocomplain Key
} -result 0

test rc4-api-3.8 {RC4Final: wrong # args} -body {
    rc4::RC4Final
} -returnCodes error -result {wrong # args: should be "rc4::RC4Final Key"}

# -------------------------------------------------------------------------

rename ::rc4::TestStore {}
unset -nocomplain impls impl
testsuiteCleanup

# Local variables:
#   mode: tcl
#   indent-tabs-mode: nil
# End:
