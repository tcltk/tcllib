# -*- tcl -*-
# docstrip_util-api.test:  Additional tests for the documented API of the
# docstrip::util package: catalogues (index_from_catalogue,
# modules_from_catalogue), classical_preamble/postamble,
# packages_provided, ddt2man, guards, patch, import_unidiff and thefile.
# Complements docstrip_util.test (which is generated from
# tcldocstrip.dtx).
#
# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal docstrip.tcl docstrip
    useLocal docstrip_util.tcl docstrip::util
}

tcltest::testConstraint tcl9 [package vsatisfies [package provide Tcl] 9]

# -------------------------------------------------------------------------

proc lines {args} {
    join $args \n
}

proc writeFile {name text} {
    set fh [open $name w]
    puts -nonewline $fh $text
    close $fh
}

# A source file with a catalogue.
set catsrc [lines \
    {% The catalogue} \
    {%<docstrip.tcl::catalogue>pkgProvide dsutest::named 1.0 {named}} \
    {%<docstrip.tcl::catalogue>pkgIndex indexed} \
    {%<docstrip.tcl::catalogue&exp>pkgProvide dsutest::exp 0.1 {named}} \
    {%<docstrip.tcl::catalogue>pkgProvide dsutest::bad x.y {named}} \
    {%<docstrip.tcl::catalogue>someUnknownCommand} \
    {%<*named>} \
    {%% Public domain.} \
    {namespace eval dsutest::named {variable x named}} \
    {%</named>} \
    {%<*indexed>} \
    {package provide dsutest::indexed 2.0} \
    {package provide dsutest::indexed::extra 2.1} \
    {namespace eval dsutest::indexed {variable x indexed}} \
    {%</indexed>} \
    {}]

set docstripfile [localPath docstrip.tcl]

# Create a fresh directory with the catalogue source in it.
proc mkCatDir {} {
    set dir [file join [temporaryDirectory] dsutest]
    file delete -force $dir
    file mkdir $dir
    writeFile [file join $dir src.dtx] $::catsrc
    return $dir
}

# Evaluate a script in a fresh interpreter which can load docstrip.
proc inChild {script} {
    set i [interp create]
    $i eval [list package ifneeded docstrip 1.3 [list source $::docstripfile]]
    set code [catch {$i eval $script} res]
    interp delete $i
    return -code $code $res
}

# -------------------------------------------------------------------------
# thefile

test docstrip_util-api-1.0 {thefile, final newline dropped, only one} -setup {
    set f [makeFile {} dsu.txt]
    writeFile $f "a\nb\n\n"
} -body {
    docstrip::util::thefile $f
} -cleanup {
    removeFile dsu.txt
    unset f
} -result "a\nb\n"

test docstrip_util-api-1.1 {thefile, encoding option} -setup {
    set f [makeFile {} dsu.txt]
    set fh [open $f w]
    fconfigure $fh -encoding iso8859-2
    puts -nonewline $fh "łódź"
    close $fh
} -body {
    docstrip::util::thefile $f -encoding iso8859-2
} -cleanup {
    removeFile dsu.txt
    unset f fh
} -result "łódź"

# The error is rethrown without its message.
test docstrip_util-api-1.2 {thefile, bad option} -constraints knownBug -setup {
    set f [makeFile {} dsu.txt]
} -body {
    docstrip::util::thefile $f -foo bar
} -cleanup {
    removeFile dsu.txt
    unset f
} -returnCodes error -match glob -result {bad option "-foo": should be one of *}

# Read errors (e.g. invalid encoded data on Tcl 9) are not raised, the
# error message is returned as file contents.
test docstrip_util-api-1.4 {thefile, read error} -constraints {
    tcl9 knownBug
} -setup {
    set f [makeFile {} dsu.txt]
    set fh [open $f wb]
    puts -nonewline $fh "a\xffb"
    close $fh
} -body {
    docstrip::util::thefile $f -encoding utf-8
} -cleanup {
    removeFile dsu.txt
    unset f fh
} -returnCodes error -match glob -result {error reading *}

test docstrip_util-api-1.3 {thefile, missing file} -body {
    docstrip::util::thefile [file join [temporaryDirectory] nonexisting.txt]
} -returnCodes error -match glob -result {couldn't open *}

# -------------------------------------------------------------------------
# classical_preamble, classical_postamble

test docstrip_util-api-2.0 {classical_preamble, documented example} -body {
    docstrip::util::classical_preamble {##} \
	"\nSome message line 1\nline2\nline3" TARGET SOURCE {foo bar}
} -result [lines {##} \
	       {## This is `TARGET',} \
	       {## generated by the docstrip::util package.} \
	       {##} \
	       {## The original source files were:} \
	       {##} \
	       {## SOURCE (with options: `foo,bar')} \
	       {## } \
	       {## Some message line 1} \
	       {## line2} \
	       {## line3}]

test docstrip_util-api-2.1 {classical_preamble, several sources, no terminals, tails only} -body {
    docstrip::util::classical_preamble {#} msg T [file join a b S1.dtx] {x} S2.dtx {}
} -result [lines {#} \
	       {# This is `T',} \
	       {# generated by the docstrip::util package.} \
	       {#} \
	       {# The original source files were:} \
	       {#} \
	       {# S1.dtx (with options: `x')} \
	       {# S2.dtx} \
	       {# msg}]

test docstrip_util-api-2.2 {classical_preamble, no sources} -body {
    docstrip::util::classical_preamble {%} {} T
} -result [lines {%} \
	       {% This is `T',} \
	       {% generated by the docstrip::util package.} \
	       {%} \
	       {% The original source files were:} \
	       {%}]

test docstrip_util-api-2.3 {classical_postamble, documented example} -body {
    docstrip::util::classical_postamble {##} \
	"Some message line 1\nline2\nline3" TARGET SOURCE {foo bar}
} -result [lines {## Some message line 1} {## line2} {## line3} {##} {## End of file `TARGET'.}]

test docstrip_util-api-2.4 {classical_postamble, sources are ignored} -body {
    string equal \
	[docstrip::util::classical_postamble {#} m T S1 a S2 b] \
	[docstrip::util::classical_postamble {#} m T]
} -result 1

test docstrip_util-api-2.5 {classical_preamble, wrong # args} -body {
    docstrip::util::classical_preamble {#} msg
} -returnCodes error -result [tcltest::wrongNumArgs docstrip::util::classical_preamble {metaprefix message target ?arg ...?} 2]

# -------------------------------------------------------------------------
# packages_provided

test docstrip_util-api-3.0 {packages_provided, several packages} -body {
    docstrip::util::packages_provided {
	package provide a 1.0
	package provide c::d 2.1
    }
} -result {a 1.0 c::d 2.1}

test docstrip_util-api-3.1 {packages_provided, require, source and unknown commands ignored} -body {
    docstrip::util::packages_provided {
	package require nosuchpackage 7
	source nosuchfile.tcl
	load nosuchlib.so
	nosuchcommand x y
	package provide a 1.0
    }
} -result {a 1.0}

test docstrip_util-api-3.2 {packages_provided, processing stops at an error} -body {
    docstrip::util::packages_provided {
	package provide a 1.0
	error oops
	package provide b 2.0
    }
} -result {a 1.0}

test docstrip_util-api-3.3 {packages_provided, evaluated in a safe interpreter} -setup {
    set f [file join [temporaryDirectory] dsu-unsafe.txt]
} -body {
    set res [docstrip::util::packages_provided [string map [list @F@ [list $f]] {
	package provide a 1.0
	set ch [open @F@ w]
	package provide b 2.0
    }]]
    list $res [file exists $f]
} -cleanup {
    file delete $f
    unset f res
} -result {{a 1.0 b 2.0} 0}

test docstrip_util-api-3.4 {packages_provided, setup script with variable c} -body {
    docstrip::util::packages_provided {package provide x $v} {$c eval {set v 4.5}}
} -result {x 4.5}

test docstrip_util-api-3.5 {packages_provided, no packages} -body {
    docstrip::util::packages_provided {set x 1}
} -result {}

test docstrip_util-api-3.6 {packages_provided, package provide query is not counted} -body {
    docstrip::util::packages_provided {package provide a 1.0; package provide a}
} -result {a 1.0}

test docstrip_util-api-3.7 {packages_provided, abbreviated subcommand} -body {
    docstrip::util::packages_provided {package prov a 1.0}
} -result {a 1.0}

# -------------------------------------------------------------------------
# ddt2man

test docstrip_util-api-4.0 {ddt2man, comments, code, guards, verbatim, endinput} -body {
    docstrip::util::ddt2man [lines \
	{% [description]} \
	"proc a {} \{" \
	{%<foo>  b [x]} \
	"\}" \
	{%<<E} \
	{% verb [} \
	{%E} \
	{% end} \
	{} \
	{\endinput} \
	{after}]
} -result [lines \
	{ [description]} \
	{[example_begin]} \
	"proc a {} \{" \
	{[emph %<foo>]  b [lb]x[rb]} \
	"\}" \
	{% verb [lb]} \
	{[example_end]} \
	{ end} \
	{} \
	{}]

test docstrip_util-api-4.1 {ddt2man, empty lines kept} -body {
    docstrip::util::ddt2man [lines {% a} {} {% b}]
} -result " a\n\n b\n"

# The handler for metacomment lines refers to a misspelled variable.
test docstrip_util-api-4.2 {ddt2man, metacomment lines} -constraints {
    knownBug
} -body {
    docstrip::util::ddt2man [lines {%% meta} code {%% after code}]
} -result [lines { meta} {[example_begin]} code {[example_end]} { after code} {}]

# -------------------------------------------------------------------------
# guards

set guardtext [lines \
    {% comment} \
    {%<*foo>} \
    {a} \
    {%<bar&!baz> b} \
    {%<-foo|bar>c} \
    {%</foo>} \
    {%<*(foo,bar)&qux>} \
    {d} \
    {%</(foo,bar)&qux>} \
    {%<+foo>e} \
    {%<<END} \
    {%<*inverb>} \
    {%END} \
    {%<oops} \
    {%<&>bad} \
    {%<foo|>bad2}]

test docstrip_util-api-5.0 {guards counts} -body {
    dictsort [docstrip::util::guards counts $guardtext]
} -result {bar 4 baz 1 foo 7 qux 2}

test docstrip_util-api-5.1 {guards exprcounts} -body {
    dictsort [docstrip::util::guards exprcounts $guardtext]
} -result {& 1 (foo,bar)&qux 2 bar&!baz 1 foo 3 foo| 1 foo|bar 1}

# The documentation names the subcommand exprcount, the code exprcounts.
test docstrip_util-api-5.2 {guards exprcount, as documented} -constraints {
    knownBug
} -body {
    dictsort [docstrip::util::guards exprcount $guardtext]
} -result {& 1 (foo,bar)&qux 2 bar&!baz 1 foo 3 foo| 1 foo|bar 1}

test docstrip_util-api-5.3 {guards exprerr} -body {
    lsort [docstrip::util::guards exprerr $guardtext]
} -result {& foo|}

test docstrip_util-api-5.4 {guards expressions} -body {
    lsort [docstrip::util::guards expressions $guardtext]
} -result {& (foo,bar)&qux bar&!baz foo foo| foo|bar}

test docstrip_util-api-5.5 {guards exprmods} -body {
    dictsort [docstrip::util::guards exprmods $guardtext]
} -result {& { } (foo,bar)&qux */ bar&!baz { } foo */+ foo| { } foo|bar -}

test docstrip_util-api-5.6 {guards names} -body {
    lsort [docstrip::util::guards names $guardtext]
} -result {bar baz foo qux}

test docstrip_util-api-5.7 {guards rotten} -body {
    docstrip::util::guards rotten $guardtext
} -result {14 %<oops}

test docstrip_util-api-5.8 {guards, unknown subcommand} -body {
    docstrip::util::guards bogus $guardtext
} -returnCodes error -result {Unknown subcommand 'bogus', must be one of: counts, exprcounts, expressions, exprmods, names, rotten}

test docstrip_util-api-5.9 {guards, text without guards} -body {
    list [docstrip::util::guards counts "a\n% b"] \
	[docstrip::util::guards rotten "a\n% b"]
} -result {{} {}}

# -------------------------------------------------------------------------
# import_unidiff

test docstrip_util-api-6.0 {import_unidiff, hunks and line types} -body {
    docstrip::util::import_unidiff [lines \
	{--- a} {+++ b} \
	{@@ -1,3 +1,3 @@} { one} {-two} {+TWO} { three} \
	{@@ -10 +10,2 @@} { ten} {+eleven} {}]
} -result {{1 3 1 3 {0 one - two + TWO 0 three}} {10 10 10 11 {0 ten + eleven}}}

test docstrip_util-api-6.1 {import_unidiff, warnings} -body {
    set w {}
    set res [docstrip::util::import_unidiff [lines {@@ -1 +1 @@} { a} {bogus}] w]
    list $res $w
} -cleanup {
    unset w res
} -result [list {{1 1 1 1 {0 a}}} "Could not parse line:  bogus\n"]

test docstrip_util-api-6.2 {import_unidiff, bad hunk header} -body {
    set w {}
    set res [docstrip::util::import_unidiff [lines {@@ junk @@} { x}] w]
    list $res $w
} -cleanup {
    unset w res
} -result [list {} "Could not parse hunk header:  @@ junk @@\n"]

test docstrip_util-api-6.3 {import_unidiff, empty text} -body {
    docstrip::util::import_unidiff {}
} -result {}

test docstrip_util-api-6.4 {import_unidiff, empty hunk side} -body {
    docstrip::util::import_unidiff [lines {@@ -3,0 +4,1 @@} {+new}]
} -result {{3 2 4 4 {+ new}}}

# -------------------------------------------------------------------------
# patch

set patchsrc [lines \
    {% A comment} \
    {%<*pkg>} \
    "proc a {} \{" \
    {   return 1} \
    "\}" \
    {%<-pkg>dropped} \
    {%% meta line} \
    "proc b {} \{" \
    {%<pkg>   return 2} \
    "\}" \
    {%</pkg>}]

test docstrip_util-api-7.0 {patch, hunks lifted to the source} -setup {
    set SL [split $patchsrc \n]
    set from [docstrip::extract $patchsrc pkg -metaprefix #]
    set diff [docstrip::util::import_unidiff [lines \
	{@@ -1,3 +1,3 @@} " proc a {} \{" {-   return 1} {+   return 11} " \}" \
	{@@ -5,3 +5,4 @@} " proc b {} \{" {-   return 2} {+   return 22} {+   # new} " \}" {}]]
} -body {
    list [docstrip::util::patch SL pkg $from $diff -metaprefix #] [join $SL \n]
} -cleanup {
    unset SL from diff
} -result [list {} [lines \
    {% A comment} \
    {%<*pkg>} \
    "proc a {} \{" \
    {   return 11} \
    "\}" \
    {%<-pkg>dropped} \
    {%% meta line} \
    "proc b {} \{" \
    {%<pkg>   return 22} \
    {%<pkg>   # new} \
    "\}" \
    {%</pkg>}]]

test docstrip_util-api-7.1 {patch, metacomment line gets its prefix back} -setup {
    set SL [split $patchsrc \n]
    set from [docstrip::extract $patchsrc pkg -metaprefix #]
    set diff [docstrip::util::import_unidiff [lines {@@ -3,2 +3,2 @@} " \}" {-# meta line} {+# changed meta} {}]]
} -body {
    list [docstrip::util::patch SL pkg $from $diff -metaprefix #] [lindex $SL 6]
} -cleanup {
    unset SL from diff
} -result {{} {%% changed meta}}

# A hunk starting with a removed line (no leading context, as produced
# e.g. by diff -U0) is applied from the beginning of the file.
test docstrip_util-api-7.3 {patch, hunk without leading context} -constraints knownBug -setup {
    set SL [split $patchsrc \n]
    set from [docstrip::extract $patchsrc pkg -metaprefix #]
    set diff [docstrip::util::import_unidiff [lines {@@ -4,1 +4,1 @@} {-# meta line} {+# changed meta} {}]]
} -body {
    list [docstrip::util::patch SL pkg $from $diff -metaprefix #] [lindex $SL 6] [llength $SL]
} -cleanup {
    unset SL from diff
} -result {{} {%% changed meta} 11}

# Removed lines of a hunk are not compared with the fromtext, only the
# context lines are.
test docstrip_util-api-7.2 {patch, hunk not matching the fromtext is returned} -constraints knownBug -setup {
    set SL [split $patchsrc \n]
    set from [docstrip::extract $patchsrc pkg -metaprefix #]
    set diff [docstrip::util::import_unidiff [lines {@@ -1,1 +1,1 @@} "-proc X {} \{" "+proc Y {} \{" {}]]
} -body {
    list [docstrip::util::patch SL pkg $from $diff -metaprefix #] \
	[expr {[join $SL \n] eq $patchsrc}]
} -cleanup {
    unset SL from diff
} -result [list "@@ -1,1 +1,1 @@ (-- did not match fromtext --)\n-proc X {} \{\n+proc Y {} \{\n" 1]

test docstrip_util-api-7.4 {patch, hunk with context not matching the fromtext is returned} -setup {
    set SL [split $patchsrc \n]
    set from [docstrip::extract $patchsrc pkg -metaprefix #]
    set diff [docstrip::util::import_unidiff [lines {@@ -1,2 +1,2 @@} "-proc a {} \{" "+proc Y {} \{" {    return X} {}]]
} -body {
    list [docstrip::util::patch SL pkg $from $diff -metaprefix #] \
	[expr {[join $SL \n] eq $patchsrc}]
} -cleanup {
    unset SL from diff
} -result [list "@@ -1,2 +1,2 @@ (-- did not match fromtext --)\n-proc a {} \{\n+proc Y {} \{\n    return X\n" 1]

foreach {n mode line ok} {
    0 exact    "  return   1"   0
    1 anyspace "  return   1"   1
    2 anyspace "return1"        0
    3 nonspace "return1"        1
    4 none     "something else" 1
} {
    test docstrip_util-api-7.[expr {$n + 10}] "patch, -matching $mode" -setup {
	set SL [split $patchsrc \n]
	set from [docstrip::extract $patchsrc pkg -metaprefix #]
	set diff [list [list 1 2 1 2 [list - "proc a {} \{" + "proc A {} \{" 0 $line]]]
    } -body {
	docstrip::util::patch SL pkg $from $diff -metaprefix # -matching $mode
	lindex $SL 2
    } -cleanup {
	unset SL from diff
    } -result [expr {$ok ? "proc A {} \{" : "proc a {} \{"}]
}

test docstrip_util-api-7.20 {patch, extract does not match the fromtext} -setup {
    set SL [split $patchsrc \n]
} -body {
    docstrip::util::patch SL pkg "zzz\nyyy" {} -metaprefix #
} -cleanup {
    unset SL
} -returnCodes error -result {The extract did not match any part of the fromtext. Check the list of terminals and the options}

test docstrip_util-api-7.21 {patch, fromtext with preamble lines} -setup {
    set SL [split $patchsrc \n]
    set from "## preamble\n##\n[docstrip::extract $patchsrc pkg -metaprefix #]"
    set diff [docstrip::util::import_unidiff [lines {@@ -3,2 +3,2 @@} " proc a {} \{" {-   return 1} {+   return one} {}]]
} -body {
    list [docstrip::util::patch SL pkg $from $diff -metaprefix #] [lindex $SL 3]
} -cleanup {
    unset SL from diff
} -result {{} {   return one}}

# -------------------------------------------------------------------------
# index_from_catalogue

test docstrip_util-api-8.0 {index_from_catalogue, report} -setup {
    set dir [mkCatDir]
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -report 1 -reportcmd list
} -cleanup {
    file delete -force $dir
    unset dir
} -result [lines \
    "Entries will go to: [file join [temporaryDirectory] dsutest pkgIndex.tcl]" \
    {Generating empty index file.} \
    {Processing file: src.dtx} \
    {Malformed version number x.y given for package dsutest::bad.}]

test docstrip_util-api-8.1 {index_from_catalogue, entries written} -setup {
    set dir [mkCatDir]
} -body {
    set res [docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list]
    set lines [split [docstrip::util::thefile [file join $dir pkgIndex.tcl]] \n]
    list $res [lindex $lines 0] [lrange $lines end-2 end]
} -cleanup {
    file delete -force $dir
    unset dir res lines
} -result [list {} {# Tcl package index file, version 1.1} [list \
    {package ifneeded dsutest::named 1.0 "package provide dsutest::named 1.0; package require docstrip; [list docstrip::sourcefrom [file join $dir src.dtx] named]"} \
    {package ifneeded dsutest::indexed 2.0 "package require docstrip; [list docstrip::sourcefrom [file join $dir src.dtx] indexed]"} \
    {package ifneeded dsutest::indexed::extra 2.1 "package require docstrip; [list docstrip::sourcefrom [file join $dir src.dtx] indexed]"}]]

test docstrip_util-api-8.2 {index_from_catalogue, generated index loads the packages} -setup {
    set dir [mkCatDir]
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list
} -body {
    inChild [list apply {{dir} {
	source [file join $dir pkgIndex.tcl]
	list [package require dsutest::named] $dsutest::named::x \
	    [package require dsutest::indexed] $dsutest::indexed::x \
	    [package require dsutest::indexed::extra]
    }} $dir]
} -cleanup {
    file delete -force $dir
    unset dir
} -result {1.0 named 2.0 indexed 2.1}

test docstrip_util-api-8.3 {index_from_catalogue, -options} -setup {
    set dir [mkCatDir]
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list -options exp
    set lines [split [docstrip::util::thefile [file join $dir pkgIndex.tcl]] \n]
    list [lindex $lines end-4] [lindex $lines end]
} -cleanup {
    file delete -force $dir
    unset dir lines
} -result [list \
    "##  docstrip::util::index_from_catalogue [file join [temporaryDirectory] dsutest] *.dtx -options exp" \
    {package ifneeded dsutest::exp 0.1 "package provide dsutest::exp 0.1; package require docstrip; [list docstrip::sourcefrom [file join $dir src.dtx] named]"}]

test docstrip_util-api-8.4 {index_from_catalogue, existing index is appended to} -setup {
    set dir [mkCatDir]
    writeFile [file join $dir pkgIndex.tcl] "# my index\n"
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list
    set text [docstrip::util::thefile [file join $dir pkgIndex.tcl]]
    list [string match "# my index\n*" $text] \
	[regexp -all {## Appendix generated by} $text]
} -cleanup {
    file delete -force $dir
    unset dir text
} -result {1 2}

test docstrip_util-api-8.5 {index_from_catalogue, no matching files} -setup {
    set dir [mkCatDir]
} -body {
    docstrip::util::index_from_catalogue $dir *.ddt -reportcmd list
    docstrip::util::thefile [file join $dir pkgIndex.tcl]
} -cleanup {
    file delete -force $dir
    unset dir
} -match glob -result {# Tcl package index file, version 1.1*full path name of this file's directory.}

test docstrip_util-api-8.6 {index_from_catalogue, -reportcmd default is puts stdout} -setup {
    set dir [mkCatDir]
} -body {
    docstrip::util::index_from_catalogue $dir *.ddt
} -cleanup {
    file delete -force $dir
    unset dir
} -output "Entries will go to: [file join [temporaryDirectory] dsutest pkgIndex.tcl]\nGenerating empty index file.\n"

test docstrip_util-api-8.7 {index_from_catalogue, -reportcmd} -setup {
    set dir [mkCatDir]
    set ::items {}
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd {lappend ::items}
    lrange $::items 1 end
} -cleanup {
    file delete -force $dir
    unset dir ::items
} -result {{Generating empty index file.} {Processing file: src.dtx} {Malformed version number x.y given for package dsutest::bad.}}

test docstrip_util-api-8.8 {index_from_catalogue, -recursein} -setup {
    set dir [mkCatDir]
    file mkdir [file join $dir sub] [file join $dir other]
    file copy [file join $dir src.dtx] [file join $dir sub sub.dtx]
    file copy [file join $dir src.dtx] [file join $dir other other.dtx]
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list -recursein s*
    list [file exists [file join $dir pkgIndex.tcl]] \
	[file exists [file join $dir sub pkgIndex.tcl]] \
	[file exists [file join $dir other pkgIndex.tcl]] \
	[string match {*sub.dtx] indexed]"} [docstrip::util::thefile [file join $dir sub pkgIndex.tcl]]]
} -cleanup {
    file delete -force $dir
    unset dir
} -result {1 1 0 1}

# The report is not returned when -recursein is used.
test docstrip_util-api-8.9 {index_from_catalogue, -recursein with -report} -constraints {
    knownBug
} -setup {
    set dir [mkCatDir]
    file mkdir [file join $dir sub]
} -body {
    set res [docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list -report 1 -recursein *]
    string match "*Processing file: src.dtx*[file join $dir sub pkgIndex.tcl]*" $res
} -cleanup {
    file delete -force $dir
    unset dir res
} -result 1

test docstrip_util-api-8.10 {index_from_catalogue, -sourceconf} -setup {
    set dir [file join [temporaryDirectory] dsutest]
    file delete -force $dir
    file mkdir $dir
    set fh [open [file join $dir src.dtx] w]
    fconfigure $fh -encoding iso8859-2
    puts $fh [lines \
	{%<docstrip.tcl::catalogue>pkgProvide dsutest::enc 1.0 {code}} \
	"%<code>set ::dsutest_enc łódź"]
    close $fh
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list -sourceconf {-encoding iso8859-2}
    inChild [list apply {{dir} {
	source [file join $dir pkgIndex.tcl]
	package require dsutest::enc
	set ::dsutest_enc
    }} $dir]
} -cleanup {
    file delete -force $dir
    unset dir fh
} -result "łódź"

test docstrip_util-api-8.11 {index_from_catalogue, fileoptions in the catalogue} -setup {
    set dir [file join [temporaryDirectory] dsutest]
    file delete -force $dir
    file mkdir $dir
    set fh [open [file join $dir src.dtx] w]
    fconfigure $fh -encoding utf-8
    puts $fh [lines \
	{%<docstrip.tcl::catalogue>fileoptions -encoding iso8859-1} \
	{%<docstrip.tcl::catalogue>pkgIndex code} \
	{%<code>package provide dsutest::enc 1.0} \
	"%<code>set ::dsutest_enc \u0142"]
    close $fh
} -body {
    docstrip::util::index_from_catalogue $dir *.dtx -reportcmd list -sourceconf {-encoding utf-8}
    set text [docstrip::util::thefile [file join $dir pkgIndex.tcl]]
    list [expr {[string first {sourcefrom [file join $dir src.dtx] code -encoding iso8859-1]} $text] >= 0}] \
	[inChild [list apply {{dir} {
	    source [file join $dir pkgIndex.tcl]
	    package require dsutest::enc
	    set ::dsutest_enc
	}} $dir]]
} -cleanup {
    file delete -force $dir
    unset dir fh text
} -result [list 1 \u00c5\u0082]

# -------------------------------------------------------------------------
# modules_from_catalogue

test docstrip_util-api-9.0 {modules_from_catalogue, report and files} -setup {
    set dir [mkCatDir]
} -body {
    set res [docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx]]
    set files {}
    foreach f [glob -nocomplain -directory [file join $dir tm] -tails * */* */*/*] {
	if {[file isfile [file join $dir tm $f]]} {lappend files $f}
    }
    list $res [lsort $files]
} -cleanup {
    file delete -force $dir
    unset dir res files f
} -result [list [lines \
    {Wrote dsutest/named-1.0.tm} \
    {Wrote dsutest/indexed-2.0.tm} \
    {Wrote redirect dsutest/indexed/extra-2.1.tm} \
    {Wrote dsutest/bad-x.y.tm}] \
    {dsutest/bad-x.y.tm dsutest/indexed-2.0.tm dsutest/indexed/extra-2.1.tm dsutest/named-1.0.tm}]

test docstrip_util-api-9.1 {modules_from_catalogue, file contents with default preamble} -setup {
    set dir [mkCatDir]
} -body {
    docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx]
    docstrip::util::thefile [file join $dir tm dsutest named-1.0.tm]
} -cleanup {
    file delete -force $dir
    unset dir
} -result [lines \
    {##} \
    {## This is `dsutest/named-1.0.tm',} \
    {## generated by the docstrip::util package.} \
    {##} \
    {## The original source files were:} \
    {##} \
    {## src.dtx (with options: `named')} \
    {##  } \
    {# Public domain.} \
    {namespace eval dsutest::named {variable x named}} \
    {##} \
    {## End of file `dsutest/named-1.0.tm'.}]

test docstrip_util-api-9.2 {modules_from_catalogue, generated modules load} -setup {
    set dir [mkCatDir]
    docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx]
} -body {
    inChild [list apply {{dir} {
	::tcl::tm::path add $dir
	list [package require dsutest::named] $dsutest::named::x \
	    [package require dsutest::indexed::extra] $dsutest::indexed::x \
	    [package present dsutest::indexed]
    }} [file join $dir tm]]
} -cleanup {
    file delete -force $dir
    unset dir
} -result {1.0 named 2.1 indexed 2.0}

test docstrip_util-api-9.3 {modules_from_catalogue, -preamble, -postamble, -options} -setup {
    set dir [mkCatDir]
} -body {
    set res [docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx] \
		 -preamble "Copyright\nline 2" -postamble "Bye" -options exp]
    set text [docstrip::util::thefile [file join $dir tm dsutest exp-0.1.tm]]
    list [lsearch -inline [split $res \n] *exp*] [lrange [split $text \n] 7 8] [lrange [split $text \n] end-2 end]
} -cleanup {
    file delete -force $dir
    unset dir res text
} -result {{Wrote dsutest/exp-0.1.tm} {{## Copyright} {## line 2}} {{## Bye} ## {## End of file `dsutest/exp-0.1.tm'.}}}

test docstrip_util-api-9.4 {modules_from_catalogue, -formatpreamble and -formatpostamble} -setup {
    set dir [mkCatDir]
    proc pre {msg target source terms} { return "# PRE $msg $target [file tail $source] $terms" }
    proc post {msg target source terms} { return "# POST $msg" }
} -body {
    docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx] \
	-formatpreamble pre -formatpostamble post -preamble P -postamble Q
    docstrip::util::thefile [file join $dir tm dsutest named-1.0.tm]
} -cleanup {
    file delete -force $dir
    rename pre {}
    rename post {}
    unset dir
} -result [lines \
    {# PRE P dsutest/named-1.0.tm src.dtx named} \
    {# Public domain.} \
    {namespace eval dsutest::named {variable x named}} \
    {# POST Q}]

test docstrip_util-api-9.5 {modules_from_catalogue, -report 0 and -reportcmd} -setup {
    set dir [mkCatDir]
    set ::items {}
} -body {
    set res [docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx] \
		 -report 0 -reportcmd {lappend ::items}]
    list $res [lindex $::items 0]
} -cleanup {
    file delete -force $dir
    unset dir res ::items
} -result {{} {Wrote dsutest/named-1.0.tm}}

test docstrip_util-api-9.6 {modules_from_catalogue, existing file is overwritten} -setup {
    set dir [mkCatDir]
    file mkdir [file join $dir tm dsutest]
    writeFile [file join $dir tm dsutest named-1.0.tm] "old contents\n"
} -body {
    docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx]
    string match "*old contents*" [docstrip::util::thefile [file join $dir tm dsutest named-1.0.tm]]
} -cleanup {
    file delete -force $dir
    unset dir
} -result 0

test docstrip_util-api-9.7 {modules_from_catalogue, pkgIndex module without package} -setup {
    set dir [file join [temporaryDirectory] dsutest]
    file delete -force $dir
    file mkdir $dir
    writeFile [file join $dir src.dtx] [lines \
	{%<docstrip.tcl::catalogue>pkgIndex code} \
	{%<code>set x 1} {}]
} -body {
    docstrip::util::modules_from_catalogue [file join $dir tm] [file join $dir src.dtx]
} -cleanup {
    file delete -force $dir
    unset dir
} -result {Found no package in module <code>.}

# -------------------------------------------------------------------------
rename lines {}
rename writeFile {}
rename mkCatDir {}
rename inChild {}
unset catsrc docstripfile guardtext patchsrc
testsuiteCleanup
