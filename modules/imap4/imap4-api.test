# -------------------------------------------------------------------------
# ::imap4::search

test imap4-12.0 {search, no expression} -body {
    ::imap4::search a
} -returnCodes error -result {missing arguments. Usage: search chan arg ?arg ...?}

test imap4-12.1 {search, not selected} -setup {
    set c [connect AUTH]
} -body {
    ::imap4::search $c all
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP channel not in one of the following states: 'SELECT' (current state is 'AUTH')}

test imap4-12.2 {search, flags} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::search $c seen unanswered] [srv {set log}] \
	[::imap4::mboxinfo $c found]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{SEARCH SEEN UNANSWERED}} {1 3}}

test imap4-12.3 {search, all message search flags} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c answered deleted draft flagged recent seen new old \
	unanswered undeleted undraft unflagged unseen all
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH ANSWERED DELETED DRAFT FLAGGED RECENT SEEN NEW OLD UNANSWERED UNDELETED UNDRAFT UNFLAGGED UNSEEN ALL}}

test imap4-12.4 {search, nothing found} -setup {
    set c [connect SELECT]
    srv {set searchresult {}}
} -body {
    list [::imap4::search $c deleted] [::imap4::mboxinfo $c found]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {}}

test imap4-12.5 {search, header search with an atom} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c subject hello
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH subject "hello"}}

test imap4-12.6 {search, header search with a literal} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::search $c from joe@example.com] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{SEARCH from {15}} joe@example.com {}}}

test imap4-12.7 {search, all header search flags} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c body a cc b from c subject d text e keyword f bcc g
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH body "a" cc "b" from "c" subject "d" text "e" keyword "f" bcc "g"}}

test imap4-12.8 {search, mail header field} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c X-Mailer: tcl Reply-To: {a b}
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH HEADER X-Mailer "tcl" HEADER Reply-To {3}} {a b} {}}

test imap4-12.9 {search, larger and smaller} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c larger 4000 seen smaller 10000
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH larger 4000 SEEN smaller 10000}}

test imap4-12.10 {search, larger without integer} -setup {
    set c [connect SELECT]
} -body {
    list [catch {::imap4::search $c larger big} msg] $msg [srv {set log}]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {Invalid integer follows 'larger' in IMAP search} {}}

test imap4-12.11 {search, not} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c not seen
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH NOT (SEEN)}}

test imap4-12.12 {search, or} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c or {from joe} {subject {x y}}
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{SEARCH OR (from "joe") (subject {3}} {x y} )}

test imap4-12.13 {search, missing argument} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c from
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {Bad syntax for search expression (missing argument)}

test imap4-12.14 {search, unknown keyword} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c seen foo bar
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {Syntax error in search expression: '... foo bar'}

test imap4-12.15 {search, before is not implemented} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c before 1-Jan-2026
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {TODO}

test imap4-12.16 {search, uid is not implemented} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::search $c uid 1:3
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {TODO}

test imap4-12.17 {search, documented date conditions} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::search $c on 1-Jan-2026] [::imap4::search $c since 1-Jan-2026] \
	[::imap4::search $c sentbefore 1-Jan-2026] [::imap4::search $c senton 1-Jan-2026] \
	[::imap4::search $c sentsince 1-Jan-2026]
} -cleanup {
    disconnect $c
    unset c
} -result {0 0 0 0 0}

test imap4-12.18 {search, error from the server} -setup {
    set c [connect SELECT]
    srv {set reply(SEARCH) {{TAG NO [BADCHARSET] search failed}}}
} -body {
    ::imap4::search $c all
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP error: 3 NO [BADCHARSET] search failed}

# -------------------------------------------------------------------------
# ::imap4::close / ::imap4::cleanup

test imap4-13.0 {close} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::close $c] [::imap4::state $c] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 AUTH CLOSE}

test imap4-13.1 {close, then select another mailbox} -setup {
    set c [connect SELECT]
    ::imap4::close $c
} -body {
    list [::imap4::select $c Archive] [::imap4::mboxinfo $c current]
} -cleanup {
    disconnect $c
    unset c
} -result {0 Archive}

test imap4-13.2 {close, not selected} -setup {
    set c [connect AUTH]
} -body {
    ::imap4::close $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP channel not in one of the following states: 'SELECT' (current state is 'AUTH')}

test imap4-13.3 {close, error} -setup {
    set c [connect SELECT]
    srv {set reply(CLOSE) {{TAG NO cannot close}}}
} -body {
    list [catch {::imap4::close $c} msg] $msg [::imap4::state $c]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {IMAP error: 3 NO cannot close} SELECT}

test imap4-13.4 {close, wrong # args} -body {
    ::imap4::close
} -returnCodes error -result {wrong # args: should be "::imap4::close chan"}

test imap4-13.5 {cleanup} -setup {
    set c [connect SELECT]
    ::imap4::fetch $c 1 flags
    ::imap4::folders $c -inline
} -body {
    list [::imap4::cleanup $c] [expr {$c in [file channels]}] \
	[array names ::imap4::info $c,*] [array names ::imap4::mboxinfo $c,*] \
	[array names ::imap4::msginfo $c,*] [array names ::imap4::folderinfo $c,*]
} -cleanup {
    unset c
} -match glob -result {sock* 0 {} {} {} {}}

test imap4-13.6 {cleanup closes the mailbox (documented)} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::cleanup $c
    # Wait for the server to notice the end of the connection.
    for {set i 0} {$i < 100 && [srv {set log}] eq ""} {incr i} {after 10}
    srv {set log}
} -cleanup {
    unset c i
} -result {CLOSE}

test imap4-13.7 {cleanup, wrong # args} -body {
    ::imap4::cleanup
} -returnCodes error -result {wrong # args: should be "::imap4::cleanup chan"}

# -------------------------------------------------------------------------
# ::imap4::store / ::imap4::expunge / ::imap4::copy / ::imap4::logout

test imap4-14.0 {store, add flags} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::store $c 2:3 +FLAGS Deleted] [srv {set log}] \
	[join [::imap4::msginfo $c 2 flags]] [join [::imap4::msginfo $c 3 flags]]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{STORE 2:3 +FLAGS (\Deleted)}} {\Deleted} {\Flagged \Seen \Deleted}}

test imap4-14.1 {store, replace flags} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::store $c 1 FLAGS {Answered Draft}] [srv {set log}] \
	[join [::imap4::msginfo $c 1 flags]]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{STORE 1:1 FLAGS (\Answered \Draft)}} {\Answered \Draft}}

test imap4-14.2 {store, remove flags, silent} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::store $c :3 -FLAGS.SILENT Seen] [srv {set log}] \
	[srv {set f {}; foreach m $messages {lappend f [join [dict get $m flags]]}; set f}] \
	[::imap4::msginfo $c 3 flags?]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{STORE 1:3 -FLAGS.SILENT (\Seen)}} {{} {} {\Flagged}} 0}

test imap4-14.3 {store, all data items} -setup {
    set c [connect SELECT]
} -body {
    foreach key {FLAGS FLAGS.SILENT +FLAGS +FLAGS.SILENT -FLAGS -FLAGS.SILENT} {
	lappend res [::imap4::store $c 1 $key Seen]
    }
    set keys {}
    foreach l [srv {set log}] {lappend keys [lindex $l 2]}
    list $res $keys
} -cleanup {
    disconnect $c
    unset c res key keys l
} -result {{0 0 0 0 0 0} {FLAGS FLAGS.SILENT +FLAGS +FLAGS.SILENT -FLAGS -FLAGS.SILENT}}

test imap4-14.4 {store, flag with a backslash} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::store $c 2 +FLAGS [list {\Seen}]
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{STORE 2:2 +FLAGS (\Seen)}}

test imap4-14.5 {store, flags with and without a backslash} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::store $c 2 +FLAGS [list Seen {\Deleted}]
    srv {set log}
} -cleanup {
    disconnect $c
    unset c
} -result {{STORE 2:2 +FLAGS (\Seen \Deleted)}}

test imap4-14.6 {store, invalid data item} -setup {
    set c [connect SELECT]
} -body {
    list [catch {::imap4::store $c 1 SEEN Seen} msg] $msg [srv {set log}]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {Invalid data item: SEEN. Must be one of FLAGS,FLAGS.SILENT,+FLAGS,+FLAGS.SILENT,-FLAGS,-FLAGS.SILENT} {}}

test imap4-14.7 {store, invalid range} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::store $c x +FLAGS Seen
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {Invalid range}

test imap4-14.8 {store, error from the server} -setup {
    set c [connect SELECT]
    srv {set reply(STORE) {{TAG NO [READ-ONLY] mailbox is read-only}}}
} -body {
    ::imap4::store $c 1 +FLAGS Seen
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP error: 3 NO [READ-ONLY] mailbox is read-only}

test imap4-14.9 {store, wrong # args} -body {
    ::imap4::store a b c
} -returnCodes error -result {wrong # args: should be "::imap4::store chan range key values"}

test imap4-15.0 {expunge} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::expunge $c] [srv {set log}] [::imap4::state $c]
} -cleanup {
    disconnect $c
    unset c
} -result {0 EXPUNGE SELECT}

test imap4-15.1 {expunge, not selected} -setup {
    set c [connect AUTH]
} -body {
    ::imap4::expunge $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP channel not in one of the following states: 'SELECT' (current state is 'AUTH')}

test imap4-15.2 {expunge, wrong # args} -body {
    ::imap4::expunge
} -returnCodes error -result {wrong # args: should be "::imap4::expunge chan"}

test imap4-16.0 {copy} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::copy $c 2 Archive] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{COPY 2 Archive}}}

test imap4-16.1 {copy, no such mailbox} -setup {
    set c [connect SELECT]
} -body {
    list [catch {::imap4::copy $c 2 Nothing} msg] $msg [::imap4::mboxinfo $c perm]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {IMAP error: 3 NO [TRYCREATE] no such mailbox} TRYCREATE}

test imap4-16.2 {copy, not selected} -setup {
    set c [connect AUTH]
} -body {
    ::imap4::copy $c 1 Archive
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP channel not in one of the following states: 'SELECT' (current state is 'AUTH')}

test imap4-16.3 {copy, wrong # args} -body {
    ::imap4::copy a b
} -returnCodes error -result {wrong # args: should be "::imap4::copy chan msgid mailbox"}

test imap4-17.0 {logout} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::logout $c] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 LOGOUT}

test imap4-17.1 {logout closes the connection} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::logout $c
    expr {$c in [file channels]}
} -cleanup {
    disconnect $c
    unset c
} -result 0

test imap4-17.2 {logout, when no mailbox is selected} -constraints {
    knownBug
} -setup {
    set c [connect AUTH]
} -body {
    list [::imap4::logout $c] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 LOGOUT}

test imap4-17.3 {logout, wrong # args} -body {
    ::imap4::logout
} -returnCodes error -result {wrong # args: should be "::imap4::logout chan"}

# -------------------------------------------------------------------------
# Server responses

test imap4-18.0 {connection closed by the server} -setup {
    set c [connect AUTH]
    srv {set reply(NOOP) CLOSE}
} -body {
    ::imap4::noop $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP unexpected EOF from server.}

test imap4-18.1 {unknown response code} -setup {
    set c [connect AUTH]
    srv {set reply(NOOP) {{TAG MAYBE later}}}
} -body {
    ::imap4::noop $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP protocol error. Unknown response code 'MAYBE'}

test imap4-18.2 {malformed tagged response} -setup {
    set c [connect AUTH]
    srv {set reply(NOOP) {TAG}}
} -body {
    ::imap4::noop $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -match glob -result {IMAP: malformed response '*'}

test imap4-18.3 {untagged responses before the tagged one} -setup {
    set c [connect AUTH]
    srv {set reply(NOOP) {{* 7 EXISTS} {* OK still here} {TAG OK NOOP done}}}
} -body {
    list [::imap4::noop $c] [::imap4::mboxinfo $c exists]
} -cleanup {
    disconnect $c
    unset c
} -result {0 7}

# -------------------------------------------------------------------------
# ::imap4::debugmode

set debugScript {
    source [lindex $argv 0]
    set c [::imap4::open 127.0.0.1 [lindex $argv 1]]
    ::imap4::debugmode $c [lindex $argv 2]
}

test imap4-19.0 {debugmode} -setup {
    srv reset
    set f [makeFile $debugScript imap4debug.tcl]
} -body {
    set out [exec [info nameofexecutable] $f [localPath imap4.tcl] $port \
	"test message" << "help\n/expr {6*7}\ninfo\nNOOP\n\n!\n"]
    list [string match "*IMAP DEBUG MODE*" $out] \
	[string match "*Last error: 'test message'*" $out] \
	[string match "*imap debug> 42\n*" $out] \
	[string match "*Last received line: '* OK fake IMAP4rev1 server ready'*" $out] \
	[srv {set log}]
} -cleanup {
    removeFile imap4debug.tcl
    unset f out
} -result {1 1 1 1 NOOP}

test imap4-19.1 {debugmode, error from the server} -setup {
    srv reset
    set f [makeFile $debugScript imap4debug.tcl]
} -body {
    set out [exec [info nameofexecutable] $f [localPath imap4.tcl] $port \
	"" << "FOO\n!\n"]
    list [string match "*--- ERROR ---\nIMAP error: 1 BAD command unknown\n*" $out] \
	[srv {set log}]
} -cleanup {
    removeFile imap4debug.tcl
    unset f out
} -result {1 FOO}

test imap4-19.2 {debugmode sets ::imap4::debug} -constraints {
    knownBug
} -setup {
    srv reset
    set f [makeFile $debugScript imap4debug.tcl]
} -body {
    set out [exec [info nameofexecutable] $f [localPath imap4.tcl] $port \
	"" << "/set ::imap4::debug\n!\n"]
    string match "*imap debug> 1\n*" $out
} -cleanup {
    removeFile imap4debug.tcl
    unset f out
} -result 1

# -------------------------------------------------------------------------

srvstop
rename srvstart {}
rename srv {}
rename srvstop {}
rename connect {}
rename disconnect {}
rename freeport {}
unset childScript serverScript debugScript port
testsuiteCleanup
return
