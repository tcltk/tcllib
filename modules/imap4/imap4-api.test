# -------------------------------------------------------------------------
# ::imap4::fetch / ::imap4::msginfo

test imap4-5.0 {fetch, wrong # args} -body {
    ::imap4::fetch a b
} -returnCodes error -result {wrong # args: should be "::imap4::fetch chan range opt ?arg ...?"}

test imap4-5.1 {fetch, not selected} -setup {
    set c [connect AUTH]
} -body {
    ::imap4::fetch $c 1 flags
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP channel not in one of the following states: 'SELECT' (current state is 'AUTH')}

test imap4-5.2 {fetch, attributes} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::fetch $c 1:2 flags size uid] [srv {set log}] \
	[lsort [::imap4::msginfo $c 1]] [::imap4::msginfo $c 1 flags] \
	[::imap4::msginfo $c 2 flags] [::imap4::msginfo $c 1 size] \
	[::imap4::msginfo $c 2 uid] [::imap4::msginfo $c 3]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{FETCH 1:2 (FLAGS RFC822.SIZE UID)}} {flags size uid} {{\Seen}} {} 73 102 {}}

test imap4-5.3 {fetch, header fields} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::fetch $c 2 from: Subject:] [srv {set log}] \
	[lsort [::imap4::msginfo $c 2]] \
	[string trimright [::imap4::msginfo $c 2 from:]] \
	[string trimright [::imap4::msginfo $c 2 subject:]]
} -cleanup {
    disconnect $c
    unset c
} -result {0 {{FETCH 2:2 (BODY[HEADER.FIELDS (FROM SUBJECT)])}} {from: subject:} user2@example.com {Test 2}}

test imap4-5.3.1 {fetch, header fields without trailing spaces} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::fetch $c 2 from: subject:
    list [::imap4::msginfo $c 2 from:] [::imap4::msginfo $c 2 subject:]
} -cleanup {
    disconnect $c
    unset c
} -result {user2@example.com {Test 2}}

test imap4-5.4 {fetch, header field without a colon} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::fetch $c 1 to
    list [srv {set log}] [string trimright [::imap4::msginfo $c 1 to:]]
} -cleanup {
    disconnect $c
    unset c
} -result {{{FETCH 1:1 (BODY[HEADER.FIELDS (TO)])}} joe@example.com}

test imap4-5.5 {fetch, -inline} -setup {
    set c [connect SELECT]
} -body {
    set res {}
    foreach rec [::imap4::fetch $c :3 -inline from: subject: size] {
	set r {}
	foreach v $rec {lappend r [string trimright $v]}
	lappend res $r
    }
    list $res [srv {set log}]
} -cleanup {
    disconnect $c
    unset c res rec r v
} -result {{{user1@example.com {Test 1} 73} {user2@example.com {Test 2} 73} {user3@example.com {Test 3} 73}} {{FETCH 1:3 (RFC822.SIZE BODY[HEADER.FIELDS (FROM SUBJECT)])}}}

test imap4-5.6 {fetch, range without the end} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::fetch $c 2: -inline uid] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {{102 103} {{FETCH 2:3 (UID)}}}

test imap4-5.7 {fetch, all messages} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::fetch $c : -inline uid] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {{101 102 103} {{FETCH 1:3 (UID)}}}

test imap4-5.8 {fetch, header, text, bodystructure} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::fetch $c 3 header text bodystructure
    list [srv {set log}] \
	[::imap4::msginfo $c 3 header] [::imap4::msginfo $c 3 text] \
	[::imap4::msginfo $c 3 bodystructure]
} -cleanup {
    disconnect $c
    unset c
} -result [list {{FETCH 3:3 (RFC822.HEADER RFC822.TEXT BODYSTRUCTURE)}} \
	"From: user3@example.com\r\nSubject: Test 3\r\nTo: joe@example.com\r\n\r\n" \
	"Body 3\r\n" {TEXT PLAIN {CHARSET US-ASCII} NIL NIL 7BIT 8 1}]

test imap4-5.8.1 {fetch, internaldate} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::fetch $c 3 internaldate
    list [srv {set log}] [::imap4::msginfo $c 3 internaldate]
} -cleanup {
    disconnect $c
    unset c
} -result {{{FETCH 3:3 (INTERNALDATE)}} {21-Nov-2026 10:03:00 +0000}}

test imap4-5.9 {fetch, envelope} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::fetch $c 1 envelope
    ::imap4::msginfo $c 1 envelope
} -cleanup {
    disconnect $c
    unset c
} -result {{21 Nov 2026 10:01:00 +0000} {Test 1} {{{User 1} NIL user1 example.com}} NIL NIL {{NIL NIL joe example.com}} NIL NIL NIL <1@test>}

test imap4-5.10 {fetch, all} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::fetch $c 2 all
    list [srv {set log}] [lsort [::imap4::msginfo $c 2]]
} -cleanup {
    disconnect $c
    unset c
} -result {{{FETCH 2:2 (ALL)}} {envelope flags internaldate size}}

test imap4-5.11 {fetch, invalid range} -setup {
    set c [connect SELECT]
} -body {
    list [catch {::imap4::fetch $c a:b flags} msg] $msg \
	[catch {::imap4::fetch $c 1:2:3 flags} msg] $msg \
	[catch {::imap4::fetch $c x flags} msg] $msg [srv {set log}]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {Invalid range} 1 {Invalid range} 1 {Invalid range} {}}

test imap4-5.12 {fetch, error from the server} -setup {
    set c [connect SELECT]
    srv {set reply(FETCH) {{TAG NO fetch failed}}}
} -body {
    ::imap4::fetch $c 1 flags
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP error: 3 NO fetch failed}

test imap4-5.13 {fetch, unknown item in the reply} -setup {
    set c [connect SELECT]
    srv {set reply(FETCH) {{* 1 FETCH (XFOO 1)} {TAG OK done}}}
} -body {
    ::imap4::fetch $c 1 flags
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP: Unknown FETCH item 'XFOO'. Upgrade the software}

test imap4-5.14 {fetch, -inline, missing information} -setup {
    set c [connect SELECT]
    srv {set reply(FETCH) {{* 1 FETCH (UID 101)} {TAG OK done}}}
} -body {
    ::imap4::fetch $c 1:2 -inline uid
} -cleanup {
    disconnect $c
    unset c
} -result {101 {{}}}

test imap4-5.15 {fetch, multi-line header field} -setup {
    set c [connect SELECT]
    srv {lset messages 0 [dict replace [lindex $messages 0] header "Subject: first\r\n\tsecond\r\n\r\n"]}
} -body {
    ::imap4::fetch $c 1 subject:
    # Extra spaces are a known bug, see imap4-5.3.1.
    regsub -all { +} [string trimright [::imap4::msginfo $c 1 subject:]] { }
} -cleanup {
    disconnect $c
    unset c
} -result {first second}

test imap4-6.0 {msginfo, wrong # args} -body {
    ::imap4::msginfo a
} -returnCodes error -result {wrong # args: should be "::imap4::msginfo chan msgid ?arg ...?"}

test imap4-6.1 {msginfo, too many args} -body {
