    unset c msg
} -result {1 {IMAP error: 2 NO Mailbox does not exist} AUTH}

test imap4-4.10 {select, previous information kept on failure} -constraints {
    knownBug
} -setup {
    set c [connect SELECT]
    ::imap4::close $c
} -body {
    catch {::imap4::select $c Nothing}
    list [::imap4::mboxinfo $c current] [::imap4::mboxinfo $c exists]
} -cleanup {
    disconnect $c
    unset c
} -result {INBOX 3}

test imap4-4.11 {select, mailbox must be closed first} -setup {
