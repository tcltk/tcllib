} -returnCodes error -result {msginfo called with bad number of arguments! Try msginfo channel messageid ?info? ?defaultvalue?}

test imap4-6.2 {msginfo, query availability and default value} -setup {
    set c [connect SELECT]
    ::imap4::fetch $c 1 flags
} -body {
    list [::imap4::msginfo $c 1 flags?] [::imap4::msginfo $c 1 uid?] \
	[::imap4::msginfo $c 1 FLAGS?] [::imap4::msginfo $c 1 uid nouid] \
	[::imap4::msginfo $c 1 flags nouid] [::imap4::msginfo $c 1 ""] \
	[::imap4::msginfo $c 2 ""]
} -cleanup {
    disconnect $c
    unset c
} -result {1 0 1 nouid {{\Seen}} flags {}}

test imap4-6.3 {msginfo, unknown information} -setup {
    set c [connect SELECT]
    ::imap4::fetch $c 1 flags
} -body {
    ::imap4::msginfo $c 1 uid
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {No such information 'uid' available for message id '1'}

# -------------------------------------------------------------------------
# ::imap4::noop / ::imap4::check

test imap4-7.0 {noop, wrong # args} -body {
    ::imap4::noop
} -returnCodes error -result {wrong # args: should be "::imap4::noop chan"}

test imap4-7.1 {noop, in all states} -setup {
    srv reset
    set c [::imap4::open 127.0.0.1 $port]
} -body {
    lappend res [::imap4::noop $c]
    ::imap4::login $c joe secret
    lappend res [::imap4::noop $c]
    ::imap4::select $c
    lappend res [::imap4::noop $c]
    list $res [lsearch -all -inline [srv {set log}] NOOP]
} -cleanup {
    disconnect $c
    unset c res
} -result {{0 0 0} {NOOP NOOP NOOP}}

test imap4-7.2 {noop, untagged data updates the mailbox information} -setup {
    set c [connect SELECT]
    srv {set noopexists 5}
} -body {
    ::imap4::noop $c
    ::imap4::mboxinfo $c exists
} -cleanup {
    disconnect $c
    unset c
} -result 5

test imap4-7.3 {noop, error} -setup {
    set c [connect]
    srv {set reply(NOOP) {{TAG BAD what?}}}
} -body {
    ::imap4::noop $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP error: 1 BAD what?}

test imap4-7.4 {check} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::check $c] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 CHECK}

test imap4-7.5 {check, not selected} -setup {
    set c [connect AUTH]
} -body {
    ::imap4::check $c
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {IMAP channel not in one of the following states: 'SELECT' (current state is 'AUTH')}

