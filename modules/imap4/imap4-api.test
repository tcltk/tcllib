} -body {
    list [catch {::imap4::select $c Archive} msg] $msg [srv {set log}]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {IMAP channel not in one of the following states: 'AUTH' (current state is 'SELECT')} {}}

