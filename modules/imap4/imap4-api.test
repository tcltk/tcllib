    ::imap4::create $c {New Box}
    srv {dict exists $mailboxes {New Box}}
} -cleanup {
    disconnect $c
    unset c
} -result 1

test imap4-11.6 {delete} -setup {
    set c [connect AUTH]
} -body {
    list [::imap4::delete $c Archive] [srv {set log}] [srv {dict exists $mailboxes Archive}]
} -cleanup {
    disconnect $c
    unset c
