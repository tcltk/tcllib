# -*- tcl -*-
# imap4-api.test:  tests for the documented API of the imap4 client.
#
# The client uses blocking sockets, so the fake IMAP server runs in a
# child process.  The child is controlled through its standard input:
# the tests send it Tcl scripts and read back the results.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors.  No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal imap4.tcl imap4
}

testConstraint notls [expr {[info procs ::tls::socket] eq ""}]

# -------------------------------------------------------------------------
# Child process running scripts sent by the tests.

set childScript {
    fconfigure stdin  -translation lf -encoding utf-8
    fconfigure stdout -translation lf -encoding utf-8
    proc ctl {} {
	if {[gets stdin n] < 0} {exit}
	set script [read stdin $n]
	set code [catch {uplevel #0 $script} res]
	set reply [list $code $res]
	puts stdout [string length $reply]
	puts -nonewline stdout $reply
	flush stdout
    }
    fileevent stdin readable ctl
    vwait forever
}

proc srvstart {} {
    set f [makeFile $::childScript imap4child.tcl]
    set ::srvpipe [open |[list [info nameofexecutable] $f] r+]
    fconfigure $::srvpipe -translation lf -encoding utf-8 -buffering full
}

proc srv {script} {
    puts $::srvpipe [string length $script]
    puts -nonewline $::srvpipe $script
    flush $::srvpipe
    set n [gets $::srvpipe]
    if {![string is integer -strict $n]} {
	error "server child died"
    }
    set reply [read $::srvpipe $n]
    lassign $reply code res
    return -code $code $res
}

proc srvstop {} {
    catch {close $::srvpipe}
    unset ::srvpipe
    removeFile imap4child.tcl
}

# -------------------------------------------------------------------------
# Fake IMAP4rev1 server (a small part of RFC 3501), evaluated in the child.
#
# ::log gets every line received (without the tag) and the contents of
# every literal received.  ::reply(COMMAND) overrides the reply to a
# command: a list of lines, where TAG is replaced by the request tag, or
# CLOSE to drop the connection.

set serverScript {
    proc reset {} {
	global log tags reply greeting users mailboxes subscribed messages \
	    searchresult noopexists
	set log {}
	set tags {}
	array unset reply
	array set reply {}
	set greeting "* OK fake IMAP4rev1 server ready"
	set users {joe secret {j o} {my secret}}
	set mailboxes {
	    INBOX {\NoInferiors}
	    Arc08 {\Noselect}
	    Arc08/Private {\NoInferiors \UnMarked}
	    Archive {}
	}
	set subscribed {}
	set messages {}
	foreach {i flags} [list 1 [list {\Seen}] 2 {} 3 [list {\Flagged} {\Seen}]] {
	    lappend messages [dict create flags $flags uid [expr {100 + $i}] \
		header "From: user$i@example.com\r\nSubject: Test $i\r\nTo: joe@example.com\r\n\r\n" \
		text "Body $i\r\n" \
		date "21-Nov-2026 10:0$i:00 +0000"]
	}
	set searchresult {1 3}
	set noopexists {}
    }

    proc accept {sock host port} {
	global greeting
	fconfigure $sock -translation binary -buffering full -blocking 1
	if {$greeting eq ""} {
	    close $sock
	    return
	}
	send $sock $greeting
	fileevent $sock readable [list readcmd $sock]
    }

    proc send {sock args} {
	foreach line $args {
	    puts -nonewline $sock "$line\r\n"
	}
	flush $sock
    }

    proc quote {s} {
	return "\"[string map {\\ \\\\ \" \\\"} $s]\""
    }

    proc readcmd {sock} {
	global log tags reply
	if {[catch {gets $sock line} n] || $n < 0} {
	    catch {close $sock}
	    return
	}
	set line [string trimright $line \r]
	set idx [string first " " $line]
	if {$idx < 0} {
	    send $sock "* BAD missing tag"
	    return
	}
	set tag [string range $line 0 [expr {$idx - 1}]]
	set line [string range $line [expr {$idx + 1}] end]
	lappend tags $tag
	lappend log $line
	set full $line
	set literals {}
	# Literals: {n} at the end of a line.
	while {[regexp {\{(\d+)\}$} $line -> len]} {
	    send $sock "+ Ready for literal data"
	    set lit [read $sock $len]
	    lappend log $lit
	    lappend literals $lit
	    gets $sock line
	    set line [string trimright $line \r]
	    lappend log $line
	    append full \n $line
	}
	set cmd [string toupper [lindex [split $full] 0]]
	set rest [string range $full [string length $cmd] end]
	if {[info exists reply($cmd)]} {
	    if {$reply($cmd) eq "CLOSE"} {
		close $sock
		return
	    }
	    foreach r $reply($cmd) {
		send $sock [string map [list TAG $tag] $r]
	    }
	    return
	}
	if {[info commands cmd_$cmd] eq ""} {
	    send $sock "$tag BAD command unknown"
	    return
	}
	if {[catch {parseargs $rest $literals} args]} {
	    send $sock "$tag BAD $args"
	    return
	}
	cmd_$cmd $sock $tag $args
    }

    # Parses IMAP arguments: atoms, quoted strings, literals and
    # parenthesized lists.  Literals are given as {n} markers followed
    # by a newline in the string.
    proc parseargs {str literals} {
	set res {}
	set stack {}
	set i 0
	set n [string length $str]
	while {$i < $n} {
	    set c [string index $str $i]
	    if {[string is space $c]} {
		incr i
		continue
	    }
	    if {$c eq "("} {
		lappend stack $res
		set res {}
		incr i
		continue
	    }
	    if {$c eq ")"} {
		set inner $res
		set res [lindex $stack end]
		set stack [lrange $stack 0 end-1]
		lappend res $inner
		incr i
		continue
	    }
	    if {$c eq "\""} {
		set tok {}
		incr i
		while {$i < $n && [string index $str $i] ne "\""} {
		    if {[string index $str $i] eq "\\"} {incr i}
		    append tok [string index $str $i]
		    incr i
		}
		if {$i >= $n} {error "unterminated quoted string"}
		incr i
		lappend res $tok
		continue
	    }
	    if {[regexp -start $i {\A\{(\d+)\}\n} $str m]} {
		lappend res [lindex $literals 0]
		set literals [lrange $literals 1 end]
		incr i [string length $m]
		continue
	    }
	    regexp -start $i {\A[^\s()"]+} $str tok
	    lappend res $tok
	    incr i [string length $tok]
	}
	if {[llength $stack]} {error "unbalanced parentheses"}
	return $res
    }

    proc ok {sock tag cmd} {
	send $sock "$tag OK $cmd completed"
    }

    proc cmd_CAPABILITY {sock tag args} {
	send $sock "* CAPABILITY IMAP4rev1 STARTTLS Idle AUTH=PLAIN"
	ok $sock $tag CAPABILITY
    }
    proc cmd_NOOP {sock tag args} {
	global noopexists
	if {$noopexists ne ""} {
	    send $sock "* $noopexists EXISTS" "* 1 RECENT"
	}
	ok $sock $tag NOOP
    }
    proc cmd_CHECK {sock tag args} {ok $sock $tag CHECK}
    proc cmd_CLOSE {sock tag args} {ok $sock $tag CLOSE}
    proc cmd_EXPUNGE {sock tag args} {
	send $sock "* 2 EXPUNGE"
	ok $sock $tag EXPUNGE
    }
    proc cmd_STARTTLS {sock tag args} {
	send $sock "$tag NO STARTTLS is not available"
    }
    proc cmd_LOGOUT {sock tag args} {
	send $sock "* BYE fake server logging out"
	ok $sock $tag LOGOUT
	close $sock
    }
    proc cmd_LOGIN {sock tag args} {
	global users
	lassign [lindex $args 0] user pass
	if {[llength [lindex $args 0]] == 2 && [dict exists $users $user] &&
	    [dict get $users $user] eq $pass} {
	    ok $sock $tag LOGIN
	} else {
	    send $sock "$tag NO LOGIN failed"
	}
    }
    proc cmd_SELECT {sock tag args} {selectmbox $sock $tag SELECT [lindex $args 0]}
    proc cmd_EXAMINE {sock tag args} {selectmbox $sock $tag EXAMINE [lindex $args 0]}
    proc selectmbox {sock tag cmd args} {
	global mailboxes messages
	set mbox [lindex $args 0 0]
	if {[llength [lindex $args 0]] != 1 || ![dict exists $mailboxes $mbox]} {
	    send $sock "$tag NO Mailbox does not exist"
	    return
	}
	if {[string first {\Noselect} [dict get $mailboxes $mbox]] >= 0} {
	    send $sock "$tag NO Mailbox cannot be selected"
	    return
	}
	set n [expr {$mbox eq "INBOX" ? [llength $messages] : 0}]
	send $sock \
	    {* FLAGS (\Answered \Flagged \Deleted \Seen \Draft)} \
	    "* $n EXISTS" "* 1 RECENT" \
	    {* OK [UNSEEN 2] Message 2 is first unseen} \
	    {* OK [UIDVALIDITY 3857529045] UIDs valid} \
	    {* OK [UIDNEXT 104] Predicted next UID} \
	    {* OK [PERMANENTFLAGS (\Deleted \Seen \*)] Limited}
	if {$cmd eq "SELECT"} {
	    send $sock "$tag OK \[READ-WRITE\] SELECT completed"
	} else {
	    send $sock "$tag OK \[READ-ONLY\] EXAMINE completed"
	}
    }
    proc seqset {spec} {
	global messages
	set res {}
	foreach part [split $spec ,] {
	    lassign [split $part :] a b
	    if {$b eq ""} {set b $a}
	    if {$a eq "*"} {set a [llength $messages]}
	    if {$b eq "*"} {set b [llength $messages]}
	    if {$a > $b} {lassign [list $a $b] b a}
	    for {set i $a} {$i <= $b && $i <= [llength $messages]} {incr i} {
		lappend res $i
	    }
	}
	return $res
    }
    proc headerfields {header fields} {
	set res {}
	set keep 0
	foreach line [split [string map {\r\n \n} $header] \n] {
	    if {$line eq ""} continue
	    if {![string is space [string index $line 0]]} {
		set name [string toupper [lindex [split $line :] 0]]
		set keep [expr {[lsearch -exact $fields $name] >= 0}]
	    }
	    if {$keep} {
		append res $line\r\n
	    }
	}
	append res \r\n
    }
    proc literal {s} {
	return "{[string length $s]}\r\n$s"
    }
    proc cmd_FETCH {sock tag args} {
	global messages
	lassign [lindex $args 0] seq items
	if {[llength $items] == 1 && [string match BODY*HEADER.FIELDS* [lindex $items 0]]} {
	    # Single item, given without parentheses.
	}
	# Rebuild the item list from the raw request.
	set raw [lindex $::log end]
	regexp {^FETCH \S+ \((.*)\)$} $raw -> rawitems
	foreach i [seqset $seq] {
	    set m [lindex $messages [expr {$i - 1}]]
	    set out {}
	    set ritems $rawitems
	    while {[string length [string trim $ritems]]} {
		set ritems [string trim $ritems]
		if {[regexp -nocase {\A(BODY(?:\.PEEK)?\[HEADER\.FIELDS \(([^)]*)\)\])} $ritems -> item fields]} {
		    lappend out "BODY\[HEADER.FIELDS ($fields)\] [literal [headerfields [dict get $m header] [string toupper $fields]]]"
		} else {
		    regexp {\A\S+} $ritems item
		    switch -- [string toupper $item] {
			ALL {
			    lappend out "FLAGS ([join [dict get $m flags]])" \
				"INTERNALDATE \"[dict get $m date]\"" \
				"RFC822.SIZE [string length [dict get $m header][dict get $m text]]" \
				"ENVELOPE (\"21 Nov 2026 10:0$i:00 +0000\" \"Test $i\" ((\"User $i\" NIL \"user$i\" \"example.com\")) NIL NIL ((NIL NIL \"joe\" \"example.com\")) NIL NIL NIL \"<$i@test>\")"
			}
			FLAGS {lappend out "FLAGS ([join [dict get $m flags]])"}
			UID {lappend out "UID [dict get $m uid]"}
			INTERNALDATE {lappend out "INTERNALDATE \"[dict get $m date]\""}
			RFC822.SIZE {
			    lappend out "RFC822.SIZE [string length [dict get $m header][dict get $m text]]"
			}
			RFC822.HEADER {lappend out "RFC822.HEADER [literal [dict get $m header]]"}
			RFC822.TEXT {lappend out "RFC822.TEXT [literal [dict get $m text]]"}
			ENVELOPE {
			    lappend out "ENVELOPE (\"21 Nov 2026 10:0$i:00 +0000\" \"Test $i\" ((\"User $i\" NIL \"user$i\" \"example.com\")) NIL NIL ((NIL NIL \"joe\" \"example.com\")) NIL NIL NIL \"<$i@test>\")"
			}
			BODYSTRUCTURE {
			    lappend out "BODYSTRUCTURE (\"TEXT\" \"PLAIN\" (\"CHARSET\" \"US-ASCII\") NIL NIL \"7BIT\" [string length [dict get $m text]] 1)"
			}
			default {
			    send $sock "$tag BAD unknown fetch item $item"
			    return
			}
		    }
		}
		set ritems [string range $ritems [string length $item] end]
	    }
	    send $sock "* $i FETCH ([join $out])"
	}
	ok $sock $tag FETCH
    }
    proc cmd_STORE {sock tag args} {
	global messages
	lassign [lindex $args 0] seq key flags
	foreach i [seqset $seq] {
	    set m [lindex $messages [expr {$i - 1}]]
	    set old [dict get $m flags]
	    switch -glob -- [string toupper $key] {
		FLAGS* {set new $flags}
		+FLAGS* {
		    set new $old
		    foreach f $flags {
			if {[lsearch -exact $new $f] < 0} {lappend new $f}
		    }
		}
		-FLAGS* {
		    set new {}
		    foreach f $old {
			if {[lsearch -exact $flags $f] < 0} {lappend new $f}
		    }
		}
		default {
		    send $sock "$tag BAD invalid data item"
		    return
		}
	    }
	    dict set m flags $new
	    lset messages [expr {$i - 1}] $m
	    if {![string match -nocase *.SILENT $key]} {
		send $sock "* $i FETCH (FLAGS ([join $new]))"
	    }
	}
	ok $sock $tag STORE
    }
    proc cmd_SEARCH {sock tag args} {
	global searchresult
	send $sock [string trimright "* SEARCH $searchresult"]
	ok $sock $tag SEARCH
    }
    proc cmd_CREATE {sock tag args} {
	global mailboxes
	set mbox [lindex $args 0 0]
	if {[llength [lindex $args 0]] != 1 || [dict exists $mailboxes $mbox]} {
	    send $sock "$tag NO cannot create mailbox"
	    return
	}
	dict set mailboxes $mbox {}
	ok $sock $tag CREATE
    }
    proc cmd_DELETE {sock tag args} {
	global mailboxes
	set mbox [lindex $args 0 0]
	if {[llength [lindex $args 0]] != 1 || ![dict exists $mailboxes $mbox]} {
	    send $sock "$tag NO no such mailbox"
	    return
	}
	dict unset mailboxes $mbox
	ok $sock $tag DELETE
    }
    proc cmd_RENAME {sock tag args} {
	global mailboxes
	lassign [lindex $args 0] old new
	if {[llength [lindex $args 0]] != 2 || ![dict exists $mailboxes $old] ||
	    [dict exists $mailboxes $new]} {
	    send $sock "$tag NO cannot rename mailbox"
	    return
	}
	dict set mailboxes $new [dict get $mailboxes $old]
	dict unset mailboxes $old
	ok $sock $tag RENAME
    }
    proc cmd_SUBSCRIBE {sock tag args} {
	global mailboxes subscribed
	set mbox [lindex $args 0 0]
	if {[llength [lindex $args 0]] != 1 || ![dict exists $mailboxes $mbox]} {
	    send $sock "$tag NO no such mailbox"
	    return
	}
	lappend subscribed $mbox
	ok $sock $tag SUBSCRIBE
    }
    proc cmd_UNSUBSCRIBE {sock tag args} {
	global subscribed
	set mbox [lindex $args 0 0]
	set i [lsearch -exact $subscribed $mbox]
	if {[llength [lindex $args 0]] != 1 || $i < 0} {
	    send $sock "$tag NO not subscribed"
	    return
	}
	set subscribed [lreplace $subscribed $i $i]
	ok $sock $tag UNSUBSCRIBE
    }
    proc cmd_COPY {sock tag args} {
	global mailboxes
	lassign [lindex $args 0] seq mbox
	if {![dict exists $mailboxes $mbox]} {
	    send $sock "$tag NO \[TRYCREATE\] no such mailbox"
	    return
	}
	ok $sock $tag COPY
    }
    proc cmd_LIST {sock tag args} {
	global mailboxes
	lassign [lindex $args 0] ref pattern
	if {$pattern eq ""} {
	    send $sock {* LIST (\Noselect) "/" ""}
	    ok $sock $tag LIST
	    return
	}
	set pattern [string map {% *} $ref$pattern]
	dict for {name flags} $mailboxes {
	    if {[string match $pattern $name]} {
		if {[regexp {[\s"]} $name]} {set name [quote $name]}
		send $sock "* LIST ($flags) \"/\" $name"
	    }
	}
	ok $sock $tag LIST
    }

    reset
    set listener [socket -server accept -myaddr 127.0.0.1 0]
    lindex [fconfigure $listener -sockname] 2
}

srvstart
set port [srv $serverScript]

# A free port with nothing listening on it.
proc freeport {} {
    set s [socket -server {} -myaddr 127.0.0.1 0]
    set p [lindex [fconfigure $s -sockname] 2]
    close $s
    return $p
}

# Connection setup and cleanup used by most tests.
proc connect {{state NOAUTH}} {
    srv reset
    set chan [::imap4::open 127.0.0.1 $::port]
    if {$state ne "NOAUTH"} {
	::imap4::login $chan joe secret
    }
    if {$state eq "SELECT"} {
	::imap4::select $chan
    }
    srv {set log {}}
    return $chan
}
proc disconnect {chan} {
    if {[catch {::imap4::cleanup $chan}]} {
	foreach a {info folderinfo mboxinfo msginfo} {
	    array unset ::imap4::$a $chan,*
	}
    }
}

# -------------------------------------------------------------------------
# ::imap4::open

test imap4-1.0 {open, wrong # args} -body {
    ::imap4::open
} -returnCodes error -result {wrong # args: should be "::imap4::open hostname ?port?"}

test imap4-1.1 {open, returns a channel} -setup {
    srv reset
} -body {
    set c [::imap4::open 127.0.0.1 $port]
    list [expr {$c in [file channels]}] [srv {set log}] [::imap4::lastline $c] \
	[::imap4::state $c]
} -cleanup {
    disconnect $c
    unset c
} -result {1 {} {* OK fake IMAP4rev1 server ready} NOAUTH}

test imap4-1.2 {open, two connections} -setup {
    srv reset
} -body {
    set c1 [::imap4::open 127.0.0.1 $port]
    set c2 [::imap4::open 127.0.0.1 $port]
    ::imap4::login $c2 joe secret
    list [expr {$c1 ne $c2}] [::imap4::state $c1] [::imap4::state $c2]
} -cleanup {
    disconnect $c1
    disconnect $c2
    unset c1 c2
} -result {1 NOAUTH AUTH}

test imap4-1.3 {open, connection refused} -setup {
    set p [freeport]
} -body {
    ::imap4::open 127.0.0.1 $p
} -cleanup {
    unset p
} -returnCodes error -match glob -result {couldn't open socket: *}

test imap4-1.4 {open, connection closed instead of a greeting} -setup {
    srv reset
    srv {set greeting ""}
    set before [file channels]
} -body {
    ::imap4::open 127.0.0.1 $port
} -cleanup {
    foreach c [file channels] {
	if {$c ni $before} {disconnect $c}
    }
    unset before c
} -returnCodes error -result {IMAP unexpected EOF from server.}

test imap4-1.5 {open, malformed greeting} -setup {
    srv reset
    srv {set greeting "garbage"}
    set before [file channels]
} -body {
    ::imap4::open 127.0.0.1 $port
} -cleanup {
    foreach c [file channels] {
	if {$c ni $before} {disconnect $c}
    }
    unset before c
} -returnCodes error -result {IMAP: malformed response 'garbage'}

test imap4-1.6 {open, use_ssl without the tls package} -constraints {
    notls
} -setup {
    set ::imap4::use_ssl 1
} -body {
    ::imap4::open 127.0.0.1 [freeport]
} -cleanup {
    set ::imap4::use_ssl 0
} -returnCodes error -result {Package TLS must be loaded for secure connections.}

test imap4-1.7 {use_ssl variable, default} -body {
    set ::imap4::use_ssl
} -result 0

# -------------------------------------------------------------------------
# ::imap4::starttls

test imap4-2.0 {starttls, wrong # args} -body {
    ::imap4::starttls
} -returnCodes error -result {wrong # args: should be "::imap4::starttls chan"}

test imap4-2.1 {starttls, refused by the server} -setup {
    set c [connect]
} -body {
    list [catch {::imap4::starttls $c} msg] $msg [srv {set log}]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {IMAP error: 1 NO STARTTLS is not available} STARTTLS}

# -------------------------------------------------------------------------
# ::imap4::login

test imap4-3.0 {login, wrong # args} -body {
    ::imap4::login a b
} -returnCodes error -result {wrong # args: should be "::imap4::login chan user pass"}

test imap4-3.1 {login, accepted} -setup {
    set c [connect]
} -body {
    list [::imap4::login $c joe secret] [::imap4::state $c] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 AUTH {{LOGIN joe secret}}}

test imap4-3.2 {login, rejected} -setup {
    set c [connect]
} -body {
    list [catch {::imap4::login $c joe wrong} msg] $msg [::imap4::state $c]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {IMAP error: 1 NO LOGIN failed} NOAUTH}

test imap4-3.3 {login, already logged in} -setup {
    set c [connect AUTH]
} -body {
    list [catch {::imap4::login $c joe secret} msg] $msg [srv {set log}]
} -cleanup {
    disconnect $c
    unset c msg
} -result {1 {IMAP channel not in one of the following states: 'NOAUTH' (current state is 'AUTH')} {}}

test imap4-3.4 {login, user name and password with spaces} -constraints {
    knownBug
} -setup {
    set c [connect]
} -body {
    ::imap4::login $c {j o} {my secret}
} -cleanup {
    disconnect $c
    unset c
} -result 0

test imap4-3.5 {login, tags of requests} -setup {
    srv reset
} -body {
    set c [::imap4::open 127.0.0.1 $port]
    ::imap4::login $c joe secret
    ::imap4::noop $c
    ::imap4::noop $c
    srv {set tags}
} -cleanup {
    disconnect $c
    unset c
} -result {1 2 3}

# -------------------------------------------------------------------------
# ::imap4::select / ::imap4::examine / ::imap4::mboxinfo

test imap4-4.0 {select, wrong # args} -body {
    ::imap4::select
} -returnCodes error -result {wrong # args: should be "::imap4::select chan ?mailbox?"}

test imap4-4.1 {select, default mailbox} -setup {
    set c [connect AUTH]
} -body {
    list [::imap4::select $c] [::imap4::state $c] [srv {set log}]
} -cleanup {
    disconnect $c
    unset c
} -result {0 SELECT {{SELECT INBOX}}}

test imap4-4.2 {select, mailbox information} -setup {
    set c [connect AUTH]
    ::imap4::select $c INBOX
} -body {
    set res {}
    foreach i [lsort [::imap4::mboxinfo $c]] {
	lappend res $i [::imap4::mboxinfo $c $i]
    }
    set res
} -cleanup {
    disconnect $c
    unset c res i
} -result {current INBOX exists 3 flags {\Answered \Flagged \Deleted \Seen \Draft} perm READ-WRITE permflags {\Deleted \Seen \*} recent 1 uidnext 104 uidval 3857529045 unseen 2}

test imap4-4.3 {mboxinfo, upper case names} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::mboxinfo $c EXISTS] [::imap4::mboxinfo $c RECENT] \
	[::imap4::mboxinfo $c UIDNEXT] [::imap4::mboxinfo $c UIDVAL] \
	[::imap4::mboxinfo $c UNSEEN] [::imap4::mboxinfo $c CURRENT] \
	[::imap4::mboxinfo $c PERM]
} -cleanup {
    disconnect $c
    unset c
} -result {3 1 104 3857529045 2 INBOX READ-WRITE}

test imap4-4.4 {mboxinfo, query availability} -setup {
    set c [connect SELECT]
} -body {
    list [::imap4::mboxinfo $c exists?] [::imap4::mboxinfo $c found?] \
	[::imap4::mboxinfo $c FLAGS?]
} -cleanup {
    disconnect $c
    unset c
} -result {1 0 1}

test imap4-4.5 {mboxinfo, unknown information} -setup {
    set c [connect SELECT]
} -body {
    ::imap4::mboxinfo $c found
} -cleanup {
    disconnect $c
    unset c
} -returnCodes error -result {No such information 'found' available for the current mailbox}

test imap4-4.6 {mboxinfo, nothing selected} -setup {
    set c [connect AUTH]
} -body {
    list [::imap4::mboxinfo $c] [::imap4::mboxinfo $c ""] [::imap4::mboxinfo $c exists?]
} -cleanup {
    disconnect $c
    unset c
} -result {{} {} 0}

test imap4-4.7 {mboxinfo, wrong # args} -body {
    ::imap4::mboxinfo a b c
} -returnCodes error -result {wrong # args: should be "::imap4::mboxinfo chan ?info?"}

test imap4-4.8 {select, other mailbox} -setup {
    set c [connect AUTH]
} -body {
    list [::imap4::select $c Archive] [::imap4::mboxinfo $c exists] \
	[::imap4::mboxinfo $c current] [srv {set log}]
} -cleanup {
