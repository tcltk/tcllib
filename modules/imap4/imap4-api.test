    unset c
} -result {0 0 Archive {{SELECT Archive}}}

test imap4-4.9 {select, no such mailbox} -setup {
    set c [connect AUTH]
} -body {
    list [catch {::imap4::select $c Nothing} msg] $msg [::imap4::state $c]
} -cleanup {
