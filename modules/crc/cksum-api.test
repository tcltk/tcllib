# -*- tcl -*-
# cksum-api.test:  tests for the documented API of cksum not covered by
# cksum.test: -channel, -chunksize, -filename on binary data, the
# programming interface (CksumInit, CksumUpdate, CksumFinal), the
# documented examples and the option errors.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal cksum.tcl cksum ::crc
}

# -------------------------------------------------------------------------
# Test data with checksums verified with cksum(1).

set allbytes {}
for {set i 0} {$i < 256} {incr i} {append allbytes [binary format c $i]}
set pattern {}
for {set i 0} {$i < 10000} {incr i} {
    append pattern [binary format c [expr {($i * 7 + 3) % 256}]]
}
unset i

proc writefile {name data} {
    set f [open $name wb]
    puts -nonewline $f $data
    close $f
}

# -------------------------------------------------------------------------
# Errors

# The message contains the word "option" instead of the option.
test cksum-api-1.1 {cksum: unknown option} -constraints {
    knownBug
} -body {
    ::crc::cksum -bogus abc
} -returnCodes error -result {bad option "-bogus": must be -channel, -chunksize, -command, -filename, -format}

test cksum-api-1.2 {cksum: too many data arguments} -body {
    ::crc::cksum -- a b
} -returnCodes error -result {wrong # args: should be cksum ?-format string? -channel chan | -filename file | string}

test cksum-api-1.3 {cksum: -filename of a missing file} -setup {
    set name [makeFile {} cksum-api-missing.dat]
    removeFile cksum-api-missing.dat
} -body {
    ::crc::cksum -filename $name
} -cleanup {
    unset name
} -returnCodes error -match glob -result {couldn't open "*cksum-api-missing.dat": no such file or directory}

test cksum-api-1.4 {CksumInit: wrong # args} -body {
    ::crc::CksumInit x
} -returnCodes error -result [tcltest::wrongNumArgs ::crc::CksumInit {} 0]

test cksum-api-1.5 {CksumUpdate: wrong # args} -body {
    ::crc::CksumUpdate tok
} -returnCodes error -result [tcltest::wrongNumArgs ::crc::CksumUpdate {token data} 1]

test cksum-api-1.6 {CksumFinal: wrong # args} -body {
    ::crc::CksumFinal
} -returnCodes error -result [tcltest::wrongNumArgs ::crc::CksumFinal {token} 0]

# -------------------------------------------------------------------------
# String data, documented examples

test cksum-api-2.1 {documented example} -body {
    ::crc::cksum "Hello, World!"
} -result 2609532967

test cksum-api-2.2 {documented example with -format} -body {
    ::crc::cksum -format 0x%X "Hello, World!"
} -result 0x9B8A5027

test cksum-api-2.3 {all byte values} -body {
    ::crc::cksum $allbytes
} -result 1313719201

test cksum-api-2.4 {10000 bytes} -body {
    ::crc::cksum $pattern
} -result 1772535109

test cksum-api-2.5 {data starting with a hyphen} -body {
    list [::crc::cksum -- -abc] [::crc::cksum -abc] [::crc::cksum -format %u -- --]
} -result {2107165184 2107165184 4173446099}

# -------------------------------------------------------------------------
# -filename, -channel, -chunksize

test cksum-api-3.1 {-filename reads binary data} -setup {
    set name [makeFile {} cksum-api.dat]
    writefile $name $pattern
} -body {
    ::crc::cksum -filename $name
} -cleanup {
    removeFile cksum-api.dat
    unset name
} -result 1772535109

test cksum-api-3.2 {-filename: the file is closed} -setup {
    set name [makeFile {} cksum-api.dat]
    writefile $name abc
    set before [lsort [file channels]]
} -body {
    ::crc::cksum -filename $name
    string equal $before [lsort [file channels]]
} -cleanup {
    removeFile cksum-api.dat
    unset name before
} -result 1

test cksum-api-3.3 {-filename: empty file} -setup {
    set name [makeFile {} cksum-api.dat]
    writefile $name {}
} -body {
    ::crc::cksum -filename $name
} -cleanup {
    removeFile cksum-api.dat
    unset name
} -result 4294967295

test cksum-api-3.4 {-channel: read until eof, not closed} -setup {
    set name [makeFile {} cksum-api.dat]
    writefile $name $allbytes
    set f [open $name rb]
} -body {
    list [::crc::cksum -channel $f] [eof $f] [expr {$f in [file channels]}]
} -cleanup {
    close $f
    removeFile cksum-api.dat
    unset name f
} -result {1313719201 1 1}

test cksum-api-3.5 {-channel: from the current position} -setup {
    set name [makeFile {} cksum-api.dat]
    writefile $name "xyzHello, World!"
    set f [open $name rb]
    read $f 3
} -body {
    ::crc::cksum -channel $f
} -cleanup {
    close $f
    removeFile cksum-api.dat
    unset name f
} -result 2609532967

foreach {n size} {1 1 2 7 3 4096 4 100000} {
    test cksum-api-3.6.$n "-chunksize $size" -setup {
	set name [makeFile {} cksum-api.dat]
	writefile $name $pattern
    } -body {
	::crc::cksum -chunksize $size -filename $name
    } -cleanup {
	removeFile cksum-api.dat
	unset name
    } -result 1772535109
}

test cksum-api-3.7 {-channel with -format} -setup {
    set name [makeFile {} cksum-api.dat]
    writefile $name "Hello, World!"
    set f [open $name rb]
} -body {
    ::crc::cksum -format 0x%X -channel $f
} -cleanup {
    close $f
    removeFile cksum-api.dat
    unset name f
} -result 0x9B8A5027

# -------------------------------------------------------------------------
# Programming interface

test cksum-api-4.1 {documented example} -body {
    set tok [::crc::CksumInit]
    ::crc::CksumUpdate $tok "Hello, "
    ::crc::CksumUpdate $tok "World!"
    ::crc::CksumFinal $tok
} -cleanup {
    unset tok
} -result 2609532967

test cksum-api-4.2 {chunked updates of binary data} -body {
    set tok [::crc::CksumInit]
    for {set i 0} {$i < 10000} {incr i 333} {
	::crc::CksumUpdate $tok [string range $pattern $i [expr {$i + 332}]]
    }
    ::crc::CksumFinal $tok
} -cleanup {
    unset tok i
} -result 1772535109

test cksum-api-4.3 {no data} -body {
    ::crc::CksumFinal [::crc::CksumInit]
} -result 4294967295

test cksum-api-4.4 {empty updates} -body {
    set tok [::crc::CksumInit]
    ::crc::CksumUpdate $tok ""
    ::crc::CksumUpdate $tok "Hello, World!"
    ::crc::CksumUpdate $tok ""
    ::crc::CksumFinal $tok
} -cleanup {
    unset tok
} -result 2609532967

test cksum-api-4.5 {CksumUpdate returns empty, CksumFinal releases token} -body {
    set tok [::crc::CksumInit]
    set r [::crc::CksumUpdate $tok abc]
    ::crc::CksumFinal $tok
    list $r [info exists $tok]
} -cleanup {
    unset tok r
} -result {{} 0}

test cksum-api-4.6 {independent tokens} -body {
    set t1 [::crc::CksumInit]
    set t2 [::crc::CksumInit]
    ::crc::CksumUpdate $t1 "Hello, "
    ::crc::CksumUpdate $t2 a
    ::crc::CksumUpdate $t1 "World!"
    list [::crc::CksumFinal $t1] [::crc::CksumFinal $t2]
} -cleanup {
    unset t1 t2
} -result {2609532967 1220704766}

test cksum-api-4.7 {result is a 32 bit unsigned integer} -body {
    set r [::crc::CksumFinal [::crc::CksumInit]]
    list [string is integer -strict $r] [expr {$r >= 0 && $r <= 0xFFFFFFFF}]
} -cleanup {
    unset r
} -result {1 1}

# -------------------------------------------------------------------------

rename writefile {}
unset allbytes pattern n size

testsuiteCleanup

# Local Variables:
#  mode: tcl
#  indent-tabs-mode: nil
# End:
