# -*- tcl -*-
# crc16-api.test:  tests for the documented API of crc16 not covered by
# crc16.test: the documented examples, -filename for all commands,
# -seed for accumulating checksums of fragments, -implementation, --
# and the option errors.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal crc16.tcl crc16 ::crc
}

# -------------------------------------------------------------------------

set allbytes {}
for {set i 0} {$i < 256} {incr i} {append allbytes [binary format c $i]}
set pattern {}
for {set i 0} {$i < 10000} {incr i} {
    append pattern [binary format c [expr {($i * 7 + 3) % 256}]]
}
unset i

proc writefile {name data} {
    set f [open $name wb]
    puts -nonewline $f $data
    close $f
}

set commands {
    crc16 crc-ccitt xmodem crc-32 kermit modbus mcrf4xx genibus crc-x25
    crc-sdlc crc-usb buypass umts gsm unknown2 maxim unknown3 unknown4 cms
}

# -------------------------------------------------------------------------
# Errors

test crc16-api-1.1 {crc16: unknown option} -body {
    ::crc::crc16 -bogus abc
} -returnCodes error -result {bad option -bogus: must be one of -channel, -chunksize, -filename, -format, -impl, -seed or -- to indicate end of options}

test crc16-api-1.2 {crc16: too many data arguments} -body {
    ::crc::crc16 -- a b
} -returnCodes error -result {wrong # args: should be "crc16 ?-format string? ?-seed value? ?-impl procname? -file name | -- data"}

test crc16-api-1.3 {crc16: -filename of a missing file} -setup {
    set name [makeFile {} crc16-api-missing.dat]
    removeFile crc16-api-missing.dat
} -body {
    ::crc::crc16 -filename $name
} -cleanup {
    unset name
} -returnCodes error -match glob -result {couldn't open "*crc16-api-missing.dat": no such file or directory}

test crc16-api-1.4 {crc-ccitt: option without data} -body {
    ::crc::crc-ccitt -format %x
} -returnCodes error -match glob -result {wrong # args: should be *}

# -------------------------------------------------------------------------
# Documented examples

test crc16-api-2.1 {documented example: crc16} -body {
    ::crc::crc16 -- "Hello, World!"
} -result 64077

test crc16-api-2.2 {documented example: crc-ccitt} -body {
    ::crc::crc-ccitt -- "Hello, World!"
} -result 26586

test crc16-api-2.3 {documented example: crc16 -format} -body {
    ::crc::crc16 -format 0x%X -- "Hello, World!"
} -result 0xFA4D

test crc16-api-2.4 {--: data looking like an option} -body {
    list [::crc::crc16 -- -seed] [::crc::crc16 -- -filename] [::crc::crc16 -- --]
} -result {9868 48218 19933}

test crc16-api-2.5 {--: option values are not data} -body {
    expr {[::crc::crc16 -format %u -- -format] != [::crc::crc16 -- %u]}
} -result 1

# -------------------------------------------------------------------------
# -filename for all commands

set n 0
foreach cmd $commands {
    incr n
    test crc16-api-3.$n "$cmd -filename equals string data" -setup {
	set name [makeFile {} crc16-api.dat]
	writefile $name $allbytes
    } -body {
	expr {[::crc::$cmd -filename $name] == [::crc::$cmd -- $allbytes]}
    } -cleanup {
	removeFile crc16-api.dat
	unset name
    } -result 1
}

test crc16-api-4.1 {-filename: data larger than one chunk} -setup {
    set name [makeFile {} crc16-api.dat]
    writefile $name $pattern
} -body {
    list [expr {[::crc::crc16 -filename $name] == [::crc::crc16 -- $pattern]}] \
	[expr {[::crc::crc-ccitt -filename $name] == [::crc::crc-ccitt -- $pattern]}] \
	[expr {[::crc::kermit -filename $name] == [::crc::kermit -- $pattern]}]
} -cleanup {
    removeFile crc16-api.dat
    unset name
} -result {1 1 1}

test crc16-api-4.2 {-filename: the file is closed} -setup {
    set name [makeFile {} crc16-api.dat]
    writefile $name abc
    set before [lsort [file channels]]
} -body {
    ::crc::crc16 -filename $name
    string equal $before [lsort [file channels]]
} -cleanup {
    removeFile crc16-api.dat
    unset name before
} -result 1

test crc16-api-4.3 {-filename with -format} -setup {
    set name [makeFile {} crc16-api.dat]
    writefile $name "Hello, World!"
} -body {
    ::crc::crc16 -format 0x%X -filename $name
} -cleanup {
    removeFile crc16-api.dat
    unset name
} -result 0xFA4D

test crc16-api-4.4 {-filename: empty file gives the seed} -setup {
    set name [makeFile {} crc16-api.dat]
    writefile $name {}
} -body {
    list [::crc::crc16 -filename $name] [::crc::crc-ccitt -filename $name] \
	[::crc::crc16 -seed 1234 -filename $name]
} -cleanup {
    removeFile crc16-api.dat
    unset name
} -result {0 65535 1234}

# -------------------------------------------------------------------------
# -seed

set n 0
foreach cmd {crc16 crc-ccitt xmodem kermit modbus mcrf4xx buypass cms} {
    incr n
    test crc16-api-5.$n "$cmd -seed accumulates fragments" -body {
	set whole [::crc::$cmd -- "Hello, World!"]
	set part  [::crc::$cmd -seed [::crc::$cmd -- "Hello, "] -- "World!"]
	expr {$whole == $part}
    } -cleanup {
	unset whole part
    } -result 1
}

test crc16-api-5.9 {-seed changes the result} -body {
    expr {[::crc::crc16 -seed 5 -- abc] != [::crc::crc16 -- abc]}
} -result 1

test crc16-api-5.10 {crc16: the default seed is 0} -body {
    expr {[::crc::crc16 -seed 0 -- abc] == [::crc::crc16 -- abc]}
} -result 1

test crc16-api-5.11 {crc-ccitt: the default seed is 0xFFFF} -body {
    list [expr {[::crc::crc-ccitt -seed 0xFFFF -- abc] == [::crc::crc-ccitt -- abc]}] \
	[expr {[::crc::crc-ccitt -seed 0 -- abc] == [::crc::xmodem -- abc]}]
} -result {1 1}

test crc16-api-5.12 {-seed over several fragments} -body {
    set r 0
    foreach part {"Hel" "lo," " Wor" "ld!"} {
	set r [::crc::crc16 -seed $r -- $part]
    }
    set r
} -cleanup {
    unset r part
} -result 64077

# -------------------------------------------------------------------------
# -implementation

test crc16-api-6.1 {-implementation: called with data and seed} -setup {
    proc ::crc16apiImpl {data seed} {
	lappend ::crc16apiCalls [list $data $seed]
	return [expr {[string length $data] + $seed}]
    }
    set ::crc16apiCalls {}
} -body {
    list [::crc::crc16 -implementation ::crc16apiImpl -seed 10 -- abcd] \
	$::crc16apiCalls
} -cleanup {
    rename ::crc16apiImpl {}
    unset ::crc16apiCalls
} -result {14 {{abcd 10}}}

test crc16-api-6.2 {-implementation: result is formatted} -setup {
    proc ::crc16apiImpl {data seed} {return 255}
} -body {
    ::crc::crc16 -implementation ::crc16apiImpl -format 0x%04X -- x
} -cleanup {
    rename ::crc16apiImpl {}
} -result 0x00FF

test crc16-api-6.3 {-implementation with -filename: seed is chained} -setup {
    proc ::crc16apiImpl {data seed} {
	return [expr {[string length $data] + $seed}]
    }
    set name [makeFile {} crc16-api.dat]
    writefile $name $pattern
} -body {
    ::crc::crc16 -implementation ::crc16apiImpl -seed 1 -filename $name
} -cleanup {
    rename ::crc16apiImpl {}
    removeFile crc16-api.dat
    unset name
} -result 10001

test crc16-api-6.4 {-implementation: unknown command} -body {
    ::crc::crc16 -implementation ::crc16apiNoSuchImpl -- x
} -returnCodes error -result {invalid command name "::crc16apiNoSuchImpl"}

test crc16-api-6.5 {-implementation overrides the command default} -setup {
    proc ::crc16apiImpl {data seed} {return $seed}
} -body {
    list [::crc::crc-ccitt -implementation ::crc16apiImpl -- x] \
	[::crc::crc16 -implementation ::crc16apiImpl -- x]
} -cleanup {
    rename ::crc16apiImpl {}
} -result {65535 0}

# -------------------------------------------------------------------------

rename writefile {}
unset allbytes pattern commands n cmd

testsuiteCleanup

# Local Variables:
#  mode: tcl
#  indent-tabs-mode: nil
# End:
