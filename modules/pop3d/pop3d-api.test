# -*- tcl -*-
# pop3d-api.test:  Tests for the documented API of package pop3d
# (supplements pop3d.test: options, destruction modes, callback
# interfaces and message transfer).
#
# The client runs in the same interpreter, talking to the server
# through a socket on 127.0.0.1, with all waits bounded.
#- - -- --- ----- -------- ------------- ---------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use      log/log.tcl   log
    use      md5/md5x.tcl  md5
    use      mime/mime.tcl mime
}
testing {
    useLocalKeep pop3d.tcl pop3d
}

# Reduce output generated by the server objects
foreach level {info notice debug warning error} {
    ::log::lvSuppress $level 1
}
unset level

#- - -- --- ----- -------- ------------- ---------------------
## Callbacks: authentication and storage, recording their calls.

namespace eval ::ptest {
    variable calls {}
    variable users
    array set users {
	ak  {smash box0}
	jh  {wooof box1}
    }
    variable messages
    array set messages {
	box0 {
	    "Subject: one\nFrom: a@example.com\n\nline1\n.dotline\nline3\n"
	    "Subject: two\n\nbody2\n"
	}
	box1 {}
    }
    variable locked {}
}

proc ::ptest::auth {cmd name} {
    variable users
    lappend ::ptest::calls [list auth $cmd $name]
    switch -exact -- $cmd {
	exists {return [info exists users($name)]}
	lookup {return $users($name)}
    }
}

proc ::ptest::storage {cmd mbox args} {
    variable messages
    variable locked
    lappend ::ptest::calls [list storage $cmd $mbox {*}$args]
    switch -exact -- $cmd {
	lock {
	    if {$mbox in $locked} {return 0}
	    lappend locked $mbox
	    return 1
	}
	unlock {
	    set i [lsearch -exact $locked $mbox]
	    if {$i >= 0} {set locked [lreplace $locked $i $i]}
	    return
	}
	stat {return [llength $messages($mbox)]}
	size {
	    if {[llength $args]} {
		return [string length [lindex $messages($mbox) [lindex $args 0]-1]]
	    }
	    set n 0
	    foreach m $messages($mbox) {incr n [string length $m]}
	    return $n
	}
	get {
	    return [mime::initialize -string [lindex $messages($mbox) [lindex $args 0]-1]]
	}
	dele {
	    return
	}
    }
}

#- - -- --- ----- -------- ------------- ---------------------
## Client helpers

proc ::ptest::newserver {args} {
    variable srv
    variable calls {}
    variable locked {}
    set srv [::pop3d::new]
    $srv configure -port 0 -socket {socket -myaddr 127.0.0.1} {*}$args
    $srv up
    return $srv
}

proc ::ptest::open {} {
    variable srv
    variable lines {}
    variable eof 0
    variable buf {}
    set s [socket 127.0.0.1 [$srv cget -port]]
    # Binary input, lines are split here to see the exact line endings.
    fconfigure $s -translation {binary crlf} -buffering line -blocking 0
    fileevent $s readable [list ::ptest::Readable $s]
    return $s
}

proc ::ptest::Readable {s} {
    variable lines
    variable eof
    variable buf
    append buf [read $s]
    while {[set i [string first \n $buf]] >= 0} {
	set line [string range $buf 0 $i-1]
	set buf  [string range $buf $i+1 end]
	if {[string index $line end] eq "\r"} {set line [string range $line 0 end-1]}
	lappend lines $line
    }
    if {[eof $s]} {
	set eof 1
	fileevent $s readable {}
    }
    set ::ptest::tick 1
}

# Wait (bounded) until COND (an expression in ::ptest) is true.
proc ::ptest::waitfor {cond} {
    set id [after 5000 {set ::ptest::tick timeout}]
    while {![namespace eval ::ptest [list expr $cond]]} {
	vwait ::ptest::tick
	if {$::ptest::tick eq "timeout"} break
    }
    after cancel $id
    return
}

# Next response line, <eof> at eof, <timeout> if nothing arrived.
proc ::ptest::getline {} {
    variable lines
    waitfor {[llength $lines] || $eof}
    if {![llength $lines]} {
	if {$::ptest::eof} {return <eof>}
	return <timeout>
    }
    set line [lindex $lines 0]
    set lines [lrange $lines 1 end]
    return $line
}

# Lines of a multi-line response, up to the terminating ".".
# With RAW false a stray CR at the end of a line is removed (see test
# pop3d-api-4.4.1).
proc ::ptest::getmulti {{raw 0}} {
    set r {}
    while {1} {
	set line [getline]
	if {$line in {. <eof> <timeout>}} break
	if {!$raw} {set line [string trimright $line \r]}
	lappend r $line
    }
    return $r
}

proc ::ptest::cmd {s line} {
    puts $s $line
    getline
}

# Open a connection, skip the greeting, log in.
proc ::ptest::login {{user ak} {pass smash}} {
    set s [open]
    getline
    cmd $s "USER $user"
    cmd $s "PASS $pass"
    return $s
}

proc ::ptest::cleanup {args} {
    variable srv
    foreach s $args {catch {close $s}}
    catch {$srv destroy}
    set ::ptest::lines {}
    set ::ptest::calls {}
    set ::ptest::locked {}
    # Let the server see the closed connections.
    update
    return
}

#- - -- --- ----- -------- ------------- ---------------------
## Object command

test pop3d-api-1.0 {configure, unknown option} -setup {
    set srv [::pop3d::new]
} -body {
    $srv configure -bogus 1
} -cleanup {
    $srv destroy
    unset srv
} -returnCodes error -result {Unknown option "-bogus": Expected "-port", "-auth", "-socket", or "-storage"}

test pop3d-api-1.1 {cget, wrong # args} -setup {
    set srv [::pop3d::new]
} -body {
    $srv cget
} -cleanup {
    $srv destroy
    unset srv
} -returnCodes error -match glob -result {wrong # args: should be "*_cget name anoption"}

test pop3d-api-1.2 {destroy, bad mode} -setup {
    set srv [::pop3d::new]
} -body {
    $srv destroy bogus
} -cleanup {
    $srv destroy
    unset srv
} -returnCodes error -result {Illegal destruction mode "bogus": Expected "kill", or "defer"}

test pop3d-api-1.3 {destroy kill removes the command} -body {
    set srv [::pop3d::new]
    $srv destroy kill
    info commands ::$srv
} -cleanup {
    unset srv
} -result {}

test pop3d-api-1.4 {destroy defer without connections destroys at once} -body {
    set srv [::pop3d::new]
    $srv destroy defer
    info commands ::$srv
} -cleanup {
    unset srv
} -result {}

test pop3d-api-1.5 {up twice is harmless} -setup {
    ::ptest::newserver
} -body {
    set p [$::ptest::srv cget -port]
    $::ptest::srv up
    list [$::ptest::srv cget -state] [expr {[$::ptest::srv cget -port] == $p}]
} -cleanup {
    ::ptest::cleanup
    unset p
} -result {up 1}

test pop3d-api-1.6 {down twice is harmless} -setup {
    ::ptest::newserver
} -body {
    $::ptest::srv down
    $::ptest::srv down
    $::ptest::srv cget -state
} -cleanup {
    ::ptest::cleanup
} -result down

#- - -- --- ----- -------- ------------- ---------------------
## Options

test pop3d-api-2.0 {-port 0: an actual port is reported while up} -setup {
    ::ptest::newserver
} -body {
    set p [$::ptest::srv cget -port]
    list [string is integer -strict $p] [expr {$p > 0}] \
	[expr {$p == [lindex [$::ptest::srv configure] 1]}]
} -cleanup {
    ::ptest::cleanup
    unset p
} -result {1 1 1}

test pop3d-api-2.1 {-port changed while up takes effect only after down/up} -setup {
    ::ptest::newserver
} -body {
    set p [$::ptest::srv cget -port]
    $::ptest::srv configure -port 0
    set r [expr {[$::ptest::srv cget -port] == $p}]
    $::ptest::srv down
    lappend r [$::ptest::srv cget -port]
    $::ptest::srv up
    lappend r [expr {[$::ptest::srv cget -port] > 0}]
} -cleanup {
    ::ptest::cleanup
    unset p r
} -result {1 0 1}

test pop3d-api-2.2 {-socket command prefix is used to open the listening socket} -setup {
    set ::sockargs {}
    proc mysocket {args} {
	lappend ::sockargs $args
	socket -myaddr 127.0.0.1 {*}$args
    }
    set srv [::pop3d::new]
    $srv configure -port 0 -socket mysocket
} -body {
    $srv up
    list [llength $::sockargs] [lindex $::sockargs 0 0] [lindex $::sockargs 0 end] \
	[expr {[$srv cget -port] > 0}]
} -cleanup {
    $srv destroy
    rename mysocket {}
    unset srv ::sockargs
} -result {1 -server 0 1}

test pop3d-api-2.3 {no -auth: all users are rejected} -setup {
    ::ptest::newserver -storage ::ptest::storage
    set s [::ptest::open]
    ::ptest::getline
} -body {
    list [::ptest::cmd $s "USER ak"] [::ptest::cmd $s "PASS smash"] [::ptest::cmd $s STAT]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {{+OK please send PASS command} {-ERR authentication failed, sorry} {-ERR client not authenticated}}

test pop3d-api-2.4 {no -storage: mailboxes are empty} -setup {
    ::ptest::newserver -auth ::ptest::auth
    set s [::ptest::login]
} -body {
    list [::ptest::cmd $s STAT] [::ptest::cmd $s LIST] [::ptest::getmulti]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {{+OK 0 0} {+OK 0 messages} {}}

#- - -- --- ----- -------- ------------- ---------------------
## Authentication and storage callback interfaces

test pop3d-api-3.0 {auth callback: exists, then lookup} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
} -body {
    set s [::ptest::login]
    set r [::ptest::cmd $s NOOP]
    list $r [lsearch -all -inline -glob $::ptest::calls {auth *}]
} -cleanup {
    ::ptest::cleanup $s
    unset s r
} -result {{+OK } {{auth exists ak} {auth lookup ak}}}

test pop3d-api-3.1 {storage callback: lock, stat, size at login; unlock at close} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
} -body {
    set s [::ptest::login]
    set r [lsearch -all -inline -glob $::ptest::calls {storage *}]
    ::ptest::cmd $s QUIT
    ::ptest::waitfor {$eof}
    update
    lappend r [lindex $::ptest::calls end]
} -cleanup {
    ::ptest::cleanup $s
    unset s r
} -result {{storage lock box0} {storage stat box0} {storage size box0} {storage unlock box0}}

test pop3d-api-3.2 {locked mailbox: second login fails} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
} -body {
    set a [::ptest::login]
    set b [::ptest::open]
    ::ptest::getline
    ::ptest::cmd $b "USER ak"
    ::ptest::cmd $b "PASS smash"
} -cleanup {
    ::ptest::cleanup $a $b
    unset a b
} -result {-ERR could not aquire lock for maildrop ak}

test pop3d-api-3.3 {storage callback: dele on QUIT with the deleted ids} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "DELE 2"
    ::ptest::cmd $s "DELE 1"
    set r [lsearch -all -inline -glob $::ptest::calls {storage dele *}]
    ::ptest::cmd $s QUIT
    lappend r [lsearch -all -inline -glob $::ptest::calls {storage dele *}]
} -cleanup {
    ::ptest::cleanup $s
    unset s r
} -result {{{storage dele box0 {2 1}}}}

test pop3d-api-3.4 {RSET: no dele on QUIT} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "DELE 1"
    set r [::ptest::cmd $s RSET]
    ::ptest::cmd $s QUIT
    list $r [lsearch -all -inline -glob $::ptest::calls {storage dele *}]
} -cleanup {
    ::ptest::cleanup $s
    unset s r
} -result {{+OK 2 messages waiting} {}}

#- - -- --- ----- -------- ------------- ---------------------
## Protocol details

test pop3d-api-4.0 {commands are case-insensitive} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::open]
    ::ptest::getline
} -body {
    list [::ptest::cmd $s "user ak"] [::ptest::cmd $s "Pass smash"] [::ptest::cmd $s "stat"]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result [list {+OK please send PASS command} {+OK congratulations} \
	       "+OK 2 [expr {[string length [lindex $::ptest::messages(box0) 0]] + [string length [lindex $::ptest::messages(box0) 1]]}]"]

test pop3d-api-4.1 {CAPA in the authorization state} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::open]
    ::ptest::getline
} -body {
    list [::ptest::cmd $s CAPA] [::ptest::getmulti]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {{+OK Capability list follows} {USER PIPELINING}}

test pop3d-api-4.2 {CAPA in the transaction state} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    list [::ptest::cmd $s CAPA] [::ptest::getmulti]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -match glob -result {{+OK Capability list follows} {USER PIPELINING {IMPLEMENTATION tcllib/pop3d-*}}}

test pop3d-api-4.3 {LIST, all messages} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    list [::ptest::cmd $s LIST] [::ptest::getmulti]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result [list {+OK 2 messages} \
	       [list "1 [string length [lindex $::ptest::messages(box0) 0]]" \
		    "2 [string length [lindex $::ptest::messages(box0) 1]]"]]

test pop3d-api-4.4 {RETR delivers the message, byte-stuffed} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    set first [::ptest::cmd $s "RETR 1"]
    set msg [::ptest::getmulti]
    set blank [lsearch -exact $msg ""]
    list $first [expr {"Subject: one" in [lrange $msg 0 $blank]}] \
	[lrange $msg $blank+1 end]
} -cleanup {
    ::ptest::cleanup $s
    unset s first msg blank
} -result [list "+OK [string length [lindex $::ptest::messages(box0) 0]] octets" 1 {line1 ..dotline line3}]

test pop3d-api-4.4.1 {RETR: lines end in CR LF, not CR CR LF} -constraints knownBug -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    # The CRLF line endings of mime::buildmessage are translated once
    # more by the crlf channel.
    ::ptest::cmd $s "RETR 1"
    set bad 0
    foreach line [::ptest::getmulti 1] {
	if {[string match *\r $line]} {incr bad}
    }
    set bad
} -cleanup {
    ::ptest::cleanup $s
    unset s bad line
} -result 0

test pop3d-api-4.5 {RETR of a deleted message} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "DELE 1"
    ::ptest::cmd $s "RETR 1"
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {-ERR no such message}

test pop3d-api-4.6 {RETR 0 is not a message} -constraints knownBug -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    # The lower bound of the message id is not checked, the storage
    # is asked for message 0.
    ::ptest::cmd $s "RETR 0"
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {-ERR no such message}

test pop3d-api-4.7 {TOP n: headers, blank line and n body lines} -constraints knownBug -setup {
    # The end of the headers is not found in the CRLF-terminated
    # lines of mime::buildmessage, so the whole message is sent.
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    set first [::ptest::cmd $s "TOP 1 2"]
    set msg [::ptest::getmulti]
    set blank [lsearch -exact $msg ""]
    list $first [expr {"Subject: one" in [lrange $msg 0 $blank]}] \
	[lrange $msg $blank+1 end]
} -cleanup {
    ::ptest::cleanup $s
    unset s first msg blank
} -result {{+OK } 1 {line1 ..dotline}}

test pop3d-api-4.8 {TOP 0: headers only (RFC 1939)} -constraints knownBug -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "TOP 1 0"
    set msg [::ptest::getmulti]
    set blank [lsearch -exact $msg ""]
    lrange $msg $blank+1 end
} -cleanup {
    ::ptest::cleanup $s
    unset s msg blank
} -result {}

test pop3d-api-4.9 {TOP, missing number of lines} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "TOP 1"
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {-ERR missing argument: #lines to read}

test pop3d-api-4.10 {TOP, negative number of lines} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "TOP 1 -1"
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {-ERR number of lines has to be greater than or equal to zero.}

test pop3d-api-4.11 {STAT does not count deleted messages (RFC 1939)} -constraints knownBug -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "DELE 1"
    ::ptest::cmd $s STAT
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result "+OK 1 [string length [lindex $::ptest::messages(box0) 1]]"

test pop3d-api-4.12 {LIST does not show deleted messages (RFC 1939)} -constraints knownBug -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    ::ptest::cmd $s "DELE 1"
    ::ptest::cmd $s LIST
    ::ptest::getmulti
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result [list "2 [string length [lindex $::ptest::messages(box0) 1]]"]

test pop3d-api-4.13 {QUIT closes the connection} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::open]
    ::ptest::getline
} -body {
    set r [::ptest::cmd $s QUIT]
    ::ptest::waitfor {$eof}
    update
    list [string match {+OK * shutting down} $r] $::ptest::eof [$::ptest::srv conn list]
} -cleanup {
    ::ptest::cleanup $s
    unset s r
} -result {1 1 {}}

#- - -- --- ----- -------- ------------- ---------------------
## Connections, down, destroy

test pop3d-api-5.0 {conn state of a logged in connection} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    set c [$::ptest::srv conn list]
    array set st [$::ptest::srv conn state [lindex $c 0]]
    list [llength $c] $st(state) $st(name) $st(storage) $st(msg) $st(server) \
	$st(remotehost)
} -cleanup {
    ::ptest::cleanup $s
    unset s c st
} -match glob -result [list 1 trans ak box0 2 * 127.0.0.1]

test pop3d-api-5.1 {down does not affect existing connections} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    $::ptest::srv down
    list [$::ptest::srv cget -state] [::ptest::cmd $s NOOP] \
	[llength [$::ptest::srv conn list]]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {down {+OK } 1}

test pop3d-api-5.2 {destroy kill closes open connections} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    $::ptest::srv destroy kill
    ::ptest::waitfor {$eof}
    list $::ptest::eof [info commands ::$::ptest::srv] \
	[lindex $::ptest::calls end]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {1 {} {storage unlock box0}}

test pop3d-api-5.3 {destroy defer keeps open connections working} -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    $::ptest::srv destroy defer
    list [$::ptest::srv cget -state] [::ptest::cmd $s NOOP]
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {exiting {+OK }}

test pop3d-api-5.4 {destroy defer: destroyed after the last connection closed} -constraints knownBug -setup {
    ::ptest::newserver -auth ::ptest::auth -storage ::ptest::storage
    set s [::ptest::login]
} -body {
    $::ptest::srv destroy defer
    ::ptest::cmd $s QUIT
    ::ptest::waitfor {$eof}
    update
    info commands ::$::ptest::srv
} -cleanup {
    ::ptest::cleanup $s
    unset s
} -result {}

#- - -- --- ----- -------- ------------- ---------------------
namespace delete ::ptest
testsuiteCleanup
return
