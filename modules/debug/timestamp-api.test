# -*- tcl -*-
# timestamp-api.test:  tests for debug::timestamp (no tests existed before).

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    useLocal debug.tcl debug
}
testing {
    useLocal timestamp.tcl debug::timestamp
}

# -------------------------------------------------------------------------

test debug-timestamp-api-1.0 {timestamp, wrong # args} -body {
    debug timestamp x
} -returnCodes error -result {wrong # args: should be "debug timestamp"}

test debug-timestamp-api-1.1 {timestamp, first call, milliseconds only} -setup {
    set ::debug::timestamp::delta 0
} -body {
    set before [clock milliseconds]
    set ts [debug timestamp]
    set after [clock milliseconds]
    list [regexp {^(\d+)mS $} $ts -> ms] [expr {$before <= $ms && $ms <= $after}]
} -cleanup {
    unset before after ts ms
} -result {1 1}

test debug-timestamp-api-1.2 {timestamp, later calls, milliseconds and delta} -setup {
    set ::debug::timestamp::delta 0
} -body {
    regexp {^(\d+)mS $} [debug timestamp] -> ms1
    after 5
    set ts [debug timestamp]
    list [regexp {^(\d+)-(\d+)mS $} $ts -> ms2 d] [expr {$ms2 - $ms1 == $d}] [expr {$d >= 5}]
} -cleanup {
    unset ms1 ms2 d ts
} -result {1 1 1}

test debug-timestamp-api-1.3 {timestamp, in a tag prefix} -setup {
    set fd [open [makeFile {} dtapi.log] w]
    debug on dtapi13
    debug level dtapi13 1 $fd
    debug prefix dtapi13 {[debug timestamp]}
} -body {
    debug.dtapi13 msg
    debug.dtapi13 msg
    close $fd
    regexp {^dtapi13 \| \d+(-\d+)?mS msg\ndtapi13 \| \d+-\d+mS msg$} [viewFile dtapi.log]
} -cleanup {
    removeFile dtapi.log
    unset fd
} -result 1

# -------------------------------------------------------------------------
testsuiteCleanup
