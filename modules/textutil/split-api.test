# -*- tcl -*-
# split-api.test:  API tests for the textutil::split package.
#
# Complements split.test, which already covers most documented behaviour
# of splitn and splitx.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal split.tcl textutil::split
}

# -------------------------------------------------------------------------
## splitn

test textutil-split-1.0 {splitn, wrong # args, not enough} -body {
    ::textutil::split::splitn
} -returnCodes error \
    -result {wrong # args: should be "::textutil::split::splitn str ?len?"}

test textutil-split-1.1 {splitn, wrong # args, too many} -body {
    ::textutil::split::splitn abc 1 2
} -returnCodes error \
    -result {wrong # args: should be "::textutil::split::splitn str ?len?"}

test textutil-split-1.2 {splitn, negative size} -body {
    ::textutil::split::splitn abc -1
} -returnCodes error -result {len must be > 0}

test textutil-split-1.3 {splitn, empty string and invalid size} -body {
    ::textutil::split::splitn "" 0
} -returnCodes error -result {len must be > 0}

test textutil-split-2.0 {splitn, exact multiple of the size} -body {
    ::textutil::split::splitn abcdef 3
} -result {abc def}

test textutil-split-2.1 {splitn, last chunk shorter} -body {
    ::textutil::split::splitn abcdefg 3
} -result {abc def g}

test textutil-split-2.2 {splitn, size equal to the length} -body {
    ::textutil::split::splitn abc 3
} -result {abc}

test textutil-split-2.3 {splitn, size larger than the length} -body {
    ::textutil::split::splitn abc 10
} -result {abc}

test textutil-split-2.4 {splitn, chunks with spaces} -body {
    ::textutil::split::splitn "a b c d" 2
} -result {{a } {b } {c } d}

test textutil-split-2.5 {splitn, non-ASCII characters} -body {
    ::textutil::split::splitn "щастя" 2
} -result {ща ст я}

test textutil-split-2.6 {splitn, default size equals split ""} -body {
    string equal [::textutil::split::splitn "a b\nc"] [split "a b\nc" ""]
} -result 1

# -------------------------------------------------------------------------
## splitx

test textutil-split-3.0 {splitx, wrong # args, not enough} -body {
    ::textutil::split::splitx
} -returnCodes error \
    -result {wrong # args: should be "::textutil::split::splitx str ?regexp?"}

test textutil-split-3.1 {splitx, wrong # args, too many} -body {
    ::textutil::split::splitx abc a b
} -returnCodes error \
    -result {wrong # args: should be "::textutil::split::splitx str ?regexp?"}

test textutil-split-3.2 {splitx, invalid regexp} -body {
    ::textutil::split::splitx abc (
} -returnCodes error \
    -match glob -result {*compile regular expression pattern: parentheses () not balanced}

test textutil-split-3.3 {splitx, regexp matching the empty string} -body {
    ::textutil::split::splitx abc {x*}
} -returnCodes error \
    -result {splitting on regexp "x*" would cause infinite loop}

test textutil-split-4.0 {splitx, no match} -body {
    ::textutil::split::splitx "abc" ,
} -result {abc}

test textutil-split-4.1 {splitx, adjacent separators give empty elements} -body {
    ::textutil::split::splitx "a,,b" ,
} -result {a {} b}

test textutil-split-4.2 {splitx, separator at both ends} -body {
    ::textutil::split::splitx ",a," ,
} -result {{} a {}}

test textutil-split-4.3 {splitx, multi-character separator} -body {
    ::textutil::split::splitx "one::two::three" ::
} -result {one two three}

test textutil-split-4.4 {splitx, non-capturing group is not included} -body {
    ::textutil::split::splitx "a1b22c" {(?:[0-9]+)}
} -result {a b c}

test textutil-split-4.5 {splitx, capturing group is included} -body {
    ::textutil::split::splitx "a1b22c" {([0-9]+)}
} -result {a 1 b 22 c}

test textutil-split-4.6 {splitx, non-ASCII separator} -body {
    ::textutil::split::splitx "раз—два—три" —
} -result {раз два три}

test textutil-split-4.7 {splitx, default regexp includes carriage return} -body {
    ::textutil::split::splitx "a\r\nb"
} -result {a b}

test textutil-split-4.8 {splitx, empty regexp equals split ""} -body {
    string equal [::textutil::split::splitx "a b\nc" ""] [split "a b\nc" ""]
} -result 1

# -------------------------------------------------------------------------
## Exports

test textutil-split-5.0 {exported commands} -body {
    lsort [namespace eval ::textutil::split {namespace export}]
} -result {splitn splitx}

# -------------------------------------------------------------------------
testsuiteCleanup
return
