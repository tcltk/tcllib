# -*- tcl -*-
# adjust-api.test:  API tests for the textutil::adjust package.
#
# Complements adjust.test (justification, -full, -length, -strictlength,
# indent, undent) and adjust_hyph.test (hyphenation with the predefined
# pattern files).

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    useLocal repeat.tcl textutil::repeat
    useLocal string.tcl textutil::string
}
testing {
    useLocal adjust.tcl textutil::adjust
}

# -------------------------------------------------------------------------
## Wrong # args

test textutil-adjust-1.0 {adjust, wrong # args} -body {
    ::textutil::adjust::adjust
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::adjust text ?arg ...?"}

test textutil-adjust-1.1 {readPatterns, wrong # args, not enough} -body {
    ::textutil::adjust::readPatterns
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::readPatterns filNam"}

test textutil-adjust-1.2 {readPatterns, wrong # args, too many} -body {
    ::textutil::adjust::readPatterns a b
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::readPatterns filNam"}

test textutil-adjust-1.3 {listPredefined, wrong # args} -body {
    ::textutil::adjust::listPredefined a
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::listPredefined"}

test textutil-adjust-1.4 {getPredefined, wrong # args, not enough} -body {
    ::textutil::adjust::getPredefined
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::getPredefined name"}

test textutil-adjust-1.5 {getPredefined, wrong # args, too many} -body {
    ::textutil::adjust::getPredefined a b
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::getPredefined name"}

test textutil-adjust-1.6 {indent, wrong # args, not enough} -body {
    ::textutil::adjust::indent a
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::indent text prefix ?skip?"}

test textutil-adjust-1.7 {indent, wrong # args, too many} -body {
    ::textutil::adjust::indent a b 1 2
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::indent text prefix ?skip?"}

test textutil-adjust-1.8 {undent, wrong # args, not enough} -body {
    ::textutil::adjust::undent
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::undent text"}

test textutil-adjust-1.9 {undent, wrong # args, too many} -body {
    ::textutil::adjust::undent a b
} -returnCodes error \
    -result {wrong # args: should be "::textutil::adjust::undent text"}

# -------------------------------------------------------------------------
## adjust, option errors

test textutil-adjust-2.0 {adjust, unknown option} -body {
    ::textutil::adjust::adjust abc -foo 1
} -returnCodes error -match glob \
    -result {bad option "-foo": must be -full, -hyphenate, *-justify, -length, or -strictlength}

# The error message contains a double space after "-hyphenate," caused
# by a backslash-newline inside the quoted message in Configure.
test textutil-adjust-2.1 {adjust, unknown option, exact message} -constraints knownBug -body {
    ::textutil::adjust::adjust abc -foo 1
} -returnCodes error \
    -result {bad option "-foo": must be -full, -hyphenate, -justify, -length, or -strictlength}

test textutil-adjust-2.2 {adjust, -full not a boolean} -body {
    ::textutil::adjust::adjust abc -full maybe
} -returnCodes error -result {expected boolean but got "maybe"}

test textutil-adjust-2.3 {adjust, -hyphenate not a boolean} -body {
    ::textutil::adjust::adjust abc -hyphenate maybe
} -returnCodes error -result {expected boolean but got "maybe"}

test textutil-adjust-2.4 {adjust, -strictlength not a boolean} -body {
    ::textutil::adjust::adjust abc -strictlength maybe
} -returnCodes error -result {expected boolean but got "maybe"}

test textutil-adjust-2.5 {adjust, bad -justify value} -body {
    ::textutil::adjust::adjust abc -justify middle
} -returnCodes error \
    -result {bad value "middle": should be center, left, plain or right}

test textutil-adjust-2.6 {adjust, -length zero} -body {
    ::textutil::adjust::adjust abc -length 0
} -returnCodes error -result {expected positive integer but got "0"}

test textutil-adjust-2.7 {adjust, -length negative} -body {
    ::textutil::adjust::adjust abc -length -5
} -returnCodes error -result {expected positive integer but got "-5"}

test textutil-adjust-2.8 {adjust, -length not an integer} -body {
    ::textutil::adjust::adjust abc -length abc
} -returnCodes error -result {expected positive integer but got "abc"}

test textutil-adjust-2.9 {adjust, -length a float} -body {
    ::textutil::adjust::adjust abc -length 2.5
} -returnCodes error -result {expected positive integer but got "2.5"}

test textutil-adjust-2.10 {adjust, -hyphenate 1 without loaded patterns} -setup {
    set loaded [info exists ::textutil::adjust::HyphPatterns(_LOADED_)]
    unset -nocomplain ::textutil::adjust::HyphPatterns(_LOADED_)
} -body {
    ::textutil::adjust::adjust abc -hyphenate 1
} -cleanup {
    if {$loaded} {set ::textutil::adjust::HyphPatterns(_LOADED_) 1}
    unset loaded
} -returnCodes error -result {hyphenation patterns not loaded!}

test textutil-adjust-2.11 {adjust, -hyphenate 0 without loaded patterns} -setup {
    set loaded [info exists ::textutil::adjust::HyphPatterns(_LOADED_)]
    unset -nocomplain ::textutil::adjust::HyphPatterns(_LOADED_)
} -body {
    ::textutil::adjust::adjust abc -hyphenate 0
} -cleanup {
    if {$loaded} {set ::textutil::adjust::HyphPatterns(_LOADED_) 1}
    unset loaded
} -result abc

# -------------------------------------------------------------------------
## adjust, behaviour

test textutil-adjust-3.0 {adjust, empty string} -body {
    ::textutil::adjust::adjust ""
} -result ""

test textutil-adjust-3.1 {adjust, whitespace only} -body {
    ::textutil::adjust::adjust "  \n\t "
} -result ""

test textutil-adjust-3.2 {adjust, short string has no newlines} -body {
    ::textutil::adjust::adjust "a\tb\nc"
} -result "a b c"

test textutil-adjust-3.3 {adjust, lines up to -length characters} -body {
    ::textutil::adjust::adjust "a b c d e f" -length 3
} -result "a b\nc d\ne f"

test textutil-adjust-3.4 {adjust, -length 1} -body {
    ::textutil::adjust::adjust "a b" -length 1
} -result "a\nb"

test textutil-adjust-3.5 {adjust, long word exceeds -length by default} -body {
    ::textutil::adjust::adjust "abcdefghij" -length 4
} -result "abcdefghij"

test textutil-adjust-3.6 {adjust, -strictlength splits a long word} -body {
    ::textutil::adjust::adjust "abcdefghij" -length 4 -strictlength 1
} -result "abcd\nefgh\nij"

test textutil-adjust-3.7 {adjust, -strictlength 0} -body {
    ::textutil::adjust::adjust "abcdefghij" -length 4 -strictlength 0
} -result "abcdefghij"

test textutil-adjust-3.8 {adjust, -justify right} -body {
    ::textutil::adjust::adjust "aaa bb cccc" -length 6 -justify right
} -result "aaa bb\n  cccc"

test textutil-adjust-3.9 {adjust, -justify left explicit} -body {
    ::textutil::adjust::adjust "aaa bb cccc" -length 6 -justify left
} -result "aaa bb\ncccc"

test textutil-adjust-3.10 {adjust, -justify left -full 1 pads to -length} -body {
    ::textutil::adjust::adjust "aaa bb cccc" -length 6 -justify left -full 1
} -result "aaa bb\ncccc  "

test textutil-adjust-3.11 {adjust, -justify center -full 1} -body {
    ::textutil::adjust::adjust "aaa bb" -length 9 -justify center -full 1
} -result "  aaa bb "

test textutil-adjust-3.12 {adjust, -justify plain fills the lines} -body {
    ::textutil::adjust::adjust "aaaa bbbb ccccc dd" -length 10 -justify plain
} -result "aaaa  bbbb\nccccc dd"

test textutil-adjust-3.13 {adjust, -justify plain, last line of 90% is justified} -body {
    ::textutil::adjust::adjust "aaaa bbbb cccccc dd" -length 10 -justify plain
} -result "aaaa  bbbb\ncccccc  dd"

test textutil-adjust-3.14 {adjust, -justify plain, single word lines unchanged} -body {
    ::textutil::adjust::adjust "aaaaaaa bbbbbbb" -length 10 -justify plain
} -result "aaaaaaa\nbbbbbbb"

test textutil-adjust-3.15 {adjust, -justify value is case insensitive} -body {
    ::textutil::adjust::adjust "a b" -length 5 -justify RIGHT
} -result "  a b"

test textutil-adjust-3.16 {adjust, options do not persist between calls} -body {
    list [::textutil::adjust::adjust "a b" -length 5 -justify right -full 1] \
	[::textutil::adjust::adjust "a b"]
} -result {{  a b} {a b}}

test textutil-adjust-3.17 {adjust, last of repeated options wins} -body {
    ::textutil::adjust::adjust "a b" -length 5 -justify center -justify right
} -result "  a b"

test textutil-adjust-3.18 {adjust, boolean values in any form} -body {
    list [::textutil::adjust::adjust "abcdef" -length 3 -strictlength yes] \
	[::textutil::adjust::adjust "abcdef" -length 3 -strictlength off]
} -result [list "abc\ndef" "abcdef"]

test textutil-adjust-3.19 {adjust, non-ASCII text} -body {
    ::textutil::adjust::adjust "Чуєш їх доцю, га? Кумедна ж ти" -length 12
} -result "Чуєш їх\nдоцю, га?\nКумедна ж ти"

# -------------------------------------------------------------------------
## listPredefined, getPredefined, readPatterns

test textutil-adjust-4.0 {listPredefined} -body {
    lsort [::textutil::adjust::listPredefined]
} -result {dehypht.tex eshyph_vo.tex ithyph.tex}

test textutil-adjust-4.1 {getPredefined, every listed file} -body {
    set res {}
    foreach f [lsort [::textutil::adjust::listPredefined]] {
	set p [::textutil::adjust::getPredefined $f]
	lappend res [file tail $p] [file isfile $p]
    }
    set res
} -cleanup {
    unset -nocomplain res f p
} -result {dehypht.tex 1 eshyph_vo.tex 1 ithyph.tex 1}

test textutil-adjust-4.2 {getPredefined, not a .tex file} -body {
    ::textutil::adjust::getPredefined foo.txt
} -returnCodes error -result {Illegal hyphenation file "foo.txt"}

test textutil-adjust-4.3 {getPredefined, unknown .tex file} -body {
    ::textutil::adjust::getPredefined nosuchfile.tex
} -returnCodes error -match glob -result {Unknown hyphenation file "*nosuchfile.tex"}

test textutil-adjust-4.4 {readPatterns, missing file} -setup {
    set f [file join [tcltest::temporaryDirectory] nosuchfile.tex]
} -body {
    ::textutil::adjust::readPatterns $f
} -cleanup {
    unset f
} -returnCodes error -match glob -result {couldn't open "*nosuchfile.tex": no such file or directory}

test textutil-adjust-4.5 {readPatterns, returns empty} -body {
    ::textutil::adjust::readPatterns [::textutil::adjust::getPredefined dehypht.tex]
} -result {}

test textutil-adjust-5.0 {adjust -hyphenate 1, long word is hyphenated} -setup {
    ::textutil::adjust::readPatterns [::textutil::adjust::getPredefined dehypht.tex]
} -body {
    ::textutil::adjust::adjust "Donaudampfschifffahrt" -hyphenate 1 -length 12
} -result "Donaudampf-\nschifffahrt"

test textutil-adjust-5.1 {adjust -hyphenate 0 after loading patterns} -setup {
    ::textutil::adjust::readPatterns [::textutil::adjust::getPredefined dehypht.tex]
} -body {
    ::textutil::adjust::adjust "Donaudampfschifffahrt" -hyphenate 0 -length 12
} -result "Donaudampfschifffahrt"

test textutil-adjust-5.2 {adjust -hyphenate 1, words that fit are not hyphenated} -setup {
    ::textutil::adjust::readPatterns [::textutil::adjust::getPredefined dehypht.tex]
} -body {
    ::textutil::adjust::adjust "Schiff ist ein Wort" -hyphenate 1 -length 12
} -result "Schiff ist\nein Wort"

test textutil-adjust-5.3 {adjust -hyphenate 1, word that cannot be hyphenated} -setup {
    ::textutil::adjust::readPatterns [::textutil::adjust::getPredefined dehypht.tex]
} -body {
    ::textutil::adjust::adjust "Kxqzrtwplm" -hyphenate 1 -length 5
} -returnCodes error \
    -result {Word "Kxqzrtwplm" can't be hyphenated and exceeds linesize 5!}

# -------------------------------------------------------------------------
## indent

test textutil-adjust-6.0 {indent, empty string} -body {
    ::textutil::adjust::indent "" "> "
} -result ""

test textutil-adjust-6.1 {indent, whitespace-only lines become empty} -body {
    ::textutil::adjust::indent "a\n  \t\nb" "> "
} -result "> a\n\n> b"

test textutil-adjust-6.2 {indent, trailing whitespace removed from skipped lines} -body {
    ::textutil::adjust::indent "a  \t\nb" "> " 1
} -result "a\n> b"

test textutil-adjust-6.3 {indent, empty prefix only trims} -body {
    ::textutil::adjust::indent "  a  \n b " ""
} -result "  a\n b"

test textutil-adjust-6.4 {indent, skipped empty lines count} -body {
    ::textutil::adjust::indent "a\n\nb\nc" "# " 2
} -result "a\n\n# b\n# c"

test textutil-adjust-6.5 {indent, non-space prefix} -body {
    ::textutil::adjust::indent "a\nb" "-->"
} -result "-->a\n-->b"

test textutil-adjust-6.6 {indent, hanging indent of adjusted text} -body {
    ::textutil::adjust::indent \
	[::textutil::adjust::adjust "one two three four" -length 9] "    " 1
} -result "one two\n    three\n    four"

# -------------------------------------------------------------------------
## undent

test textutil-adjust-7.0 {undent, empty string} -body {
    ::textutil::adjust::undent ""
} -result ""

test textutil-adjust-7.1 {undent, tab prefix} -body {
    ::textutil::adjust::undent "\t\ta\n\t\t\tb\n\t\tc"
} -result "a\n\tb\nc"

test textutil-adjust-7.2 {undent, hanging indent preserved} -body {
    ::textutil::adjust::undent "  a\n    b\n  c"
} -result "a\n  b\nc"

test textutil-adjust-7.3 {undent, no common prefix} -body {
    ::textutil::adjust::undent "a\n  b"
} -result "a\n  b"

test textutil-adjust-7.4 {undent, different whitespace is not common} -body {
    ::textutil::adjust::undent "  a\n\tb"
} -result "  a\n\tb"

test textutil-adjust-7.5 {undent, long whitespace-only line ignored and emptied} -body {
    ::textutil::adjust::undent "  a\n      \n  c"
} -result "a\n\nc"

test textutil-adjust-7.6 {undent, short whitespace-only line ignored and emptied} -body {
    ::textutil::adjust::undent "    a\n \n    c"
} -result "a\n\nc"

# Whitespace-only lines are returned unchanged when there is no common
# prefix to remove, contrary to the documentation.
test textutil-adjust-7.7 {undent, no common prefix, whitespace-only line emptied} -constraints knownBug -body {
    ::textutil::adjust::undent "a\n   \nb"
} -result "a\n\nb"

test textutil-adjust-7.8 {undent, single line} -body {
    ::textutil::adjust::undent "   a b"
} -result "a b"

# -------------------------------------------------------------------------
## Exports

test textutil-adjust-8.0 {exported commands} -body {
    lsort [namespace eval ::textutil::adjust {namespace export}]
} -result {adjust indent undent}

# -------------------------------------------------------------------------
testsuiteCleanup
return
