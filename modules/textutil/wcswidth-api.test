# -*- tcl -*-
# wcswidth-api.test:  API tests for the textutil::wcswidth package.
#
# Complements wcswidth.test (wrong # args, ASCII and CJK samples).

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal wcswidth.tcl textutil::wcswidth
}

# -------------------------------------------------------------------------
## wcswidth

test textutil-wcswidth-1.0 {wcswidth, empty string} -body {
    ::textutil::wcswidth ""
} -result 0

test textutil-wcswidth-1.1 {wcswidth, example from the manual} -body {
    ::textutil::wcswidth "Δ÷☕M☔ℤ"
} -result 8

test textutil-wcswidth-1.2 {wcswidth, ambiguous characters count as narrow} -body {
    ::textutil::wcswidth "¡§Δ"
} -result 3

test textutil-wcswidth-1.3 {wcswidth, fullwidth forms} -body {
    ::textutil::wcswidth "ＡＢＣ"
} -result 6

test textutil-wcswidth-1.4 {wcswidth, halfwidth forms} -body {
    ::textutil::wcswidth "ｱｲ"
} -result 2

test textutil-wcswidth-1.5 {wcswidth, Hangul syllables} -body {
    ::textutil::wcswidth "가힣"
} -result 4

test textutil-wcswidth-1.6 {wcswidth, ideographic space} -body {
    ::textutil::wcswidth "a　b"
} -result 4

test textutil-wcswidth-1.7 {wcswidth, sum of wcswidth_char} -body {
    set s "Ukrainian: ґє | CJK: 漢字"
    set sum 0
    foreach c [split $s ""] {
	incr sum [::textutil::wcswidth_char [scan $c %c]]
    }
    expr {$sum == [::textutil::wcswidth $s]}
} -cleanup {
    unset s sum c
} -result 1

# -------------------------------------------------------------------------
## wcswidth_char

foreach {n cp width} {
    0  0x41    1
    1  0x20    1
    2  0xA1    1
    3  0x394   1
    4  0x1100  2
    5  0x2615  2
    6  0x3000  2
    7  0x4E00  2
    8  0xAC00  2
    9  0xFF01  2
    10 0xFF61  1
    11 0x20A9  1
} {
    test textutil-wcswidth_char-2.$n "wcswidth_char $cp" -body {
	::textutil::wcswidth_char $cp
    } -result $width
}
unset n cp width

test textutil-wcswidth_char-3.0 {wcswidth_char, decimal codepoint} -body {
    ::textutil::wcswidth_char 19968
} -result 2

test textutil-wcswidth_char-3.1 {wcswidth_char, supplementary plane, wide} -body {
    list [::textutil::wcswidth_char 0x1F600] [::textutil::wcswidth_char 0x20000]
} -result {2 2}

test textutil-wcswidth_char-3.2 {wcswidth_char, supplementary plane, narrow} -body {
    ::textutil::wcswidth_char 0x10400
} -result 1

# -------------------------------------------------------------------------
## wcswidth_type

foreach {n cp type} {
    0  0x00    N
    1  0xA1    A
    2  0x394   A
    3  0x1100  W
    4  0x2615  W
    5  0x3000  F
    6  0x4E00  W
    7  0xAC00  W
    8  0xFF01  F
    9  0xFF61  H
    10 0x20A9  H
    11 0x2124  N
} {
    test textutil-wcswidth_type-4.$n "wcswidth_type $cp" -body {
	::textutil::wcswidth_type $cp
    } -result $type
}
unset n cp type

# Narrow (Na) characters, e.g. ASCII letters and SPACE, are reported as N
# (neutral). The build script reads only the first character of the
# property value.
foreach {n cp} {
    0 0x20
    1 0x41
    2 0x61
    3 0x7E
    4 0x27E6
} {
    test textutil-wcswidth_type-5.$n "wcswidth_type $cp, narrow" -constraints knownBug -body {
	::textutil::wcswidth_type $cp
    } -result Na
}
unset n cp

test textutil-wcswidth_type-6.0 {wcswidth_type, every documented type except Na} -body {
    set types {}
    foreach cp {0x00 0xA1 0x1100 0x3000 0xFF61} {
	lappend types [::textutil::wcswidth_type $cp]
    }
    lsort $types
} -cleanup {
    unset types cp
} -result {A F H N W}

test textutil-wcswidth_type-6.1 {wcswidth_type, consistent with wcswidth_char} -body {
    set bad {}
    foreach cp {0x00 0x41 0xA1 0x394 0x1100 0x2615 0x3000 0x4E00 0xAC00 0xFF01 0xFF61 0x20A9 0x1F600} {
	set t [::textutil::wcswidth_type $cp]
	set w [::textutil::wcswidth_char $cp]
	if {($t in {W F}) != ($w == 2)} {lappend bad $cp}
    }
    set bad
} -cleanup {
    unset bad cp t w
} -result {}

# -------------------------------------------------------------------------
testsuiteCleanup
return
