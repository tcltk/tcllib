# -*- tcl -*-
# csv-api.test:  Additional tests for the documented API of the csv
# package: iscomplete, joinmatrix, delimiter modes, the matrix and queue
# commands with all their argument forms, and argument errors.
# Complements csv.test.
#
# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use struct/queue.tcl  struct::queue
    use struct/matrix.tcl struct::matrix
}
testing {
    useLocal csv.tcl csv
}

# -------------------------------------------------------------------------
# Helpers

# Write the given text into a file and return a channel reading it.
proc openData {text} {
    set fh [open [makeFile {} csvdata.csv] w]
    puts -nonewline $fh $text
    close $fh
    return [open [file join [temporaryDirectory] csvdata.csv] r]
}

proc closeData {fh} {
    close $fh
    removeFile csvdata.csv
}

proc queueItems {q} {
    set res {}
    while {[$q size] > 0} {
	lappend res [$q get]
    }
    return $res
}

# -------------------------------------------------------------------------
# iscomplete

test csv-api-1.0 {iscomplete, wrong # args, not enough} -body {
    csv::iscomplete
} -returnCodes error -result [tcltest::wrongNumArgs csv::iscomplete data 0]

test csv-api-1.1 {iscomplete, wrong # args, too many} -body {
    csv::iscomplete a b
} -returnCodes error -result [tcltest::tooManyArgs csv::iscomplete data]

test csv-api-1.2 {iscomplete, empty data} -body {
    csv::iscomplete {}
} -result 1

test csv-api-1.3 {iscomplete, no quotes} -body {
    csv::iscomplete {a,b,c}
} -result 1

test csv-api-1.4 {iscomplete, quoted values} -body {
    csv::iscomplete {"a","b,c",d}
} -result 1

test csv-api-1.5 {iscomplete, open quoted value} -body {
    csv::iscomplete {a,"b,c}
} -result 0

test csv-api-1.6 {iscomplete, open quoted value with newline} -body {
    csv::iscomplete "a,\"b\nc"
} -result 0

test csv-api-1.7 {iscomplete, completed multi-line value} -body {
    csv::iscomplete "a,\"b\nc\",d"
} -result 1

test csv-api-1.8 {iscomplete, doubled quotes} -body {
    list [csv::iscomplete {a,"b""c"}] [csv::iscomplete {a,"b""c}]
} -result {1 0}

# -------------------------------------------------------------------------
# join

test csv-api-2.0 {join, wrong # args, not enough} -body {
    csv::join
} -returnCodes error -result [tcltest::wrongNumArgs csv::join {values ?sepChar? ?delChar? ?delMode?} 0]

test csv-api-2.1 {join, wrong # args, too many} -body {
    csv::join a , \" auto x
} -returnCodes error -result [tcltest::tooManyArgs csv::join {values ?sepChar? ?delChar? ?delMode?}]

test csv-api-2.2 {join, empty list} -body {
    csv::join {}
} -result {}

test csv-api-2.3 {join, single empty value} -body {
    csv::join {{}}
} -result {}

test csv-api-2.4 {join, custom separator} -body {
    csv::join {a {b;c} {d e}} \;
} -result {a;"b;c";d e}

test csv-api-2.5 {join, custom separator, default separator is not special} -body {
    csv::join {a,b c} \;
} -result {a,b;c}

test csv-api-2.6 {join, carriage return is quoted} -body {
    csv::join [list a "b\rc"]
} -result "a,\"b\rc\""

test csv-api-2.7 {join, always quote, default delimiter} -body {
    csv::join {a {} {b"c}} , \" always
} -result {"a","","b""c"}

test csv-api-2.8 {join, explicit auto mode} -body {
    csv::join {a {} {b"c}} , \" auto
} -result {a,,"b""c"}

test csv-api-2.9 {join, always quote, custom separator and delimiter} -body {
    csv::join {a b'c} | ' always
} -result {'a'|'b''c'}

# -------------------------------------------------------------------------
# joinlist

test csv-api-3.0 {joinlist, wrong # args, not enough} -body {
    csv::joinlist
} -returnCodes error -result [tcltest::wrongNumArgs csv::joinlist {values ?sepChar? ?delChar? ?delMode?} 0]

test csv-api-3.1 {joinlist, wrong # args, too many} -body {
    csv::joinlist a , \" auto x
} -returnCodes error -result [tcltest::tooManyArgs csv::joinlist {values ?sepChar? ?delChar? ?delMode?}]

test csv-api-3.2 {joinlist, empty list} -body {
    csv::joinlist {}
} -result {}

test csv-api-3.3 {joinlist, always quote} -body {
    csv::joinlist {{a b} {c {d,e}}} , \" always
} -result "\"a\",\"b\"\n\"c\",\"d,e\"\n"

test csv-api-3.4 {joinlist, always quote, custom separator and delimiter} -body {
    csv::joinlist {{a b} {c {}}} \; ' always
} -result "'a';'b'\n'c';''\n"

test csv-api-3.5 {joinlist, records of different length} -body {
    csv::joinlist {{a} {b c d} {}}
} -result "a\nb,c,d\n\n"

# -------------------------------------------------------------------------
# joinmatrix

test csv-api-4.0 {joinmatrix, wrong # args, not enough} -body {
    csv::joinmatrix
} -returnCodes error -result [tcltest::wrongNumArgs csv::joinmatrix {matrix ?sepChar? ?delChar? ?delMode?} 0]

test csv-api-4.1 {joinmatrix, wrong # args, too many} -body {
    csv::joinmatrix m , \" auto x
} -returnCodes error -result [tcltest::tooManyArgs csv::joinmatrix {matrix ?sepChar? ?delChar? ?delMode?}]

test csv-api-4.2 {joinmatrix, defaults} -setup {
    struct::matrix m
    m add columns 3
    m add row {1 {a,b} {say "hi"}}
    m add row {2 {} x}
} -body {
    csv::joinmatrix m
} -cleanup {
    m destroy
} -result "1,\"a,b\",\"say \"\"hi\"\"\"\n2,,x\n"

test csv-api-4.3 {joinmatrix, custom separator} -setup {
    struct::matrix m
    m add columns 2
    m add row {{a,b} {c;d}}
} -body {
    csv::joinmatrix m \;
} -cleanup {
    m destroy
} -result "a,b;\"c;d\"\n"

test csv-api-4.4 {joinmatrix, custom separator and delimiter} -setup {
    struct::matrix m
    m add columns 2
    m add row {{a'b} {c d}}
} -body {
    csv::joinmatrix m , '
} -cleanup {
    m destroy
} -result "'a''b',c d\n"

test csv-api-4.5 {joinmatrix, always quote} -setup {
    struct::matrix m
    m add columns 2
    m add row {a b}
    m add row {c {}}
} -body {
    csv::joinmatrix m , \" always
} -cleanup {
    m destroy
} -result "\"a\",\"b\"\n\"c\",\"\"\n"

test csv-api-4.6 {joinmatrix, short rows are padded} -setup {
    struct::matrix m
    m add columns 3
    m add row {a}
    m add row {b c d}
} -body {
    csv::joinmatrix m
} -cleanup {
    m destroy
} -result "a,,\nb,c,d\n"

# -------------------------------------------------------------------------
# read2matrix

test csv-api-5.0 {read2matrix, wrong # args, none} -body {
    csv::read2matrix
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan m ?separator? ?expand?}

test csv-api-5.1 {read2matrix, wrong # args, one} -body {
    csv::read2matrix chan
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan m ?separator? ?expand?}

test csv-api-5.2 {read2matrix, wrong # args, five without -alternate} -body {
    csv::read2matrix chan m , none x
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan m ?separator? ?expand?}

test csv-api-5.3 {read2matrix, wrong # args, too many} -body {
    csv::read2matrix -alternate chan m , none x
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan m ?separator? ?expand?}

test csv-api-5.4 {read2matrix, -alternate, bad separator} -body {
    csv::read2matrix -alternate chan m {}
} -returnCodes error -result {illegal separator character "", is empty}

test csv-api-5.5 {read2matrix, default expand mode none truncates} -setup {
    set fh [openData "a,b,c\nd,e\n"]
    struct::matrix m
    m add columns 2
} -body {
    csv::read2matrix $fh m
    list [m columns] [m rows] [m get rect 0 0 end end]
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {2 2 {{a b} {d e}}}

test csv-api-5.6 {read2matrix, explicit separator and expand mode none} -setup {
    set fh [openData "a;b;c\nd;e\n"]
    struct::matrix m
    m add columns 2
} -body {
    csv::read2matrix $fh m \; none
    m get rect 0 0 end end
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {{a b} {d e}}

test csv-api-5.7 {read2matrix, empty mode, first line determines width} -setup {
    set fh [openData "a,b\nc,d,e\nf\n"]
    struct::matrix m
} -body {
    csv::read2matrix $fh m , empty
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {2 {{a b} {c d} {f {}}}}

test csv-api-5.8 {read2matrix, auto mode, longest line determines width} -setup {
    set fh [openData "a,b\nc,d,e\nf\n"]
    struct::matrix m
} -body {
    csv::read2matrix $fh m , auto
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {3 {{a b {}} {c d e} {f {} {}}}}

test csv-api-5.9 {read2matrix, empty lines are skipped} -setup {
    set fh [openData "\na,b\n\n\nc,d\n"]
    struct::matrix m
} -body {
    csv::read2matrix $fh m , auto
    m get rect 0 0 end end
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {{a b} {c d}}

test csv-api-5.10 {read2matrix, last line without newline} -setup {
    set fh [openData "a,b\nc,d"]
    struct::matrix m
} -body {
    csv::read2matrix $fh m , auto
    m get rect 0 0 end end
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {{a b} {c d}}

test csv-api-5.11 {read2matrix, -alternate} -setup {
    set fh [openData "a,\"\"\nb,\"x\"\"y\"\n"]
    struct::matrix m
    m add columns 2
} -body {
    csv::read2matrix -alternate $fh m
    m get rect 0 0 end end
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {{a {}} {b x\"y}}

test csv-api-5.12 {read2matrix, -alternate with separator} -setup {
    set fh [openData "a;\"b;c\"\n"]
    struct::matrix m
    m add columns 2
} -body {
    csv::read2matrix -alternate $fh m \;
    m get rect 0 0 end end
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {{a {b;c}}}

test csv-api-5.13 {read2matrix, -alternate with separator and expand mode} -setup {
    set fh [openData "a;b;c\n"]
    struct::matrix m
} -body {
    csv::read2matrix -alternate $fh m \; auto
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result {3 {{a b c}}}

test csv-api-5.14 {read2matrix, multi-line quoted value} -setup {
    set fh [openData "a,\"b\n\nc\",d\ne,f,g\n"]
    struct::matrix m
} -body {
    csv::read2matrix $fh m , auto
    m get rect 0 0 end end
} -cleanup {
    m destroy
    closeData $fh
    unset fh
} -result [list [list a "b\n\nc" d] {e f g}]

# -------------------------------------------------------------------------
# read2queue

test csv-api-6.0 {read2queue, wrong # args, none} -body {
    csv::read2queue
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan q ?separator?}

test csv-api-6.1 {read2queue, wrong # args, one} -body {
    csv::read2queue chan
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan q ?separator?}

test csv-api-6.2 {read2queue, wrong # args, four without -alternate} -body {
    csv::read2queue chan q , x
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan q ?separator?}

test csv-api-6.3 {read2queue, wrong # args, too many} -body {
    csv::read2queue -alternate chan q , x
} -returnCodes error -result {wrong#args: Should be ?-alternate? chan q ?separator?}

test csv-api-6.4 {read2queue, -alternate, bad separator} -body {
    csv::read2queue -alternate chan q ab
} -returnCodes error -result {illegal separator character "ab", is a string}

test csv-api-6.5 {read2queue, defaults} -setup {
    set fh [openData "a,b,c\n\nd,\"e,f\"\n"]
    struct::queue q
} -body {
    csv::read2queue $fh q
    queueItems q
} -cleanup {
    q destroy
    closeData $fh
    unset fh
} -result {{a b c} {d e,f}}

test csv-api-6.6 {read2queue, custom separator} -setup {
    set fh [openData "a;b,c\n"]
    struct::queue q
} -body {
    csv::read2queue $fh q \;
    queueItems q
} -cleanup {
    q destroy
    closeData $fh
    unset fh
} -result {{a b,c}}

test csv-api-6.7 {read2queue, -alternate} -setup {
    set fh [openData "a,\"\"\n"]
    struct::queue q
} -body {
    csv::read2queue -alternate $fh q
    queueItems q
} -cleanup {
    q destroy
    closeData $fh
    unset fh
} -result {{a {}}}

test csv-api-6.8 {read2queue, -alternate with separator} -setup {
    set fh [openData "a;\"b;c\"\n"]
    struct::queue q
} -body {
    csv::read2queue -alternate $fh q \;
    queueItems q
} -cleanup {
    q destroy
    closeData $fh
    unset fh
} -result {{a {b;c}}}

test csv-api-6.9 {read2queue, empty input} -setup {
    set fh [openData ""]
    struct::queue q
} -body {
    csv::read2queue $fh q
    q size
} -cleanup {
    q destroy
    closeData $fh
    unset fh
} -result 0

# -------------------------------------------------------------------------
# report

test csv-api-7.0 {report, printmatrix} -setup {
    struct::matrix m
    m add columns 2
    m add row {a {b,c}}
} -body {
    csv::report printmatrix m
} -cleanup {
    m destroy
} -result "a,\"b,c\"\n"

test csv-api-7.1 {report, printmatrix2channel} -setup {
    struct::matrix m
    m add columns 2
    m add row {a {b,c}}
    set fh [open [makeFile {} out.csv] w]
} -body {
    set res [csv::report printmatrix2channel m $fh]
    close $fh
    list $res [viewFile out.csv]
} -cleanup {
    m destroy
    removeFile out.csv
    unset fh res
} -result [list {} {a,"b,c"}]

test csv-api-7.2 {report, wrong # args, not enough} -body {
    csv::report printmatrix
} -returnCodes error -result [tcltest::wrongNumArgs csv::report {cmd matrix ?arg ...?} 1]

# -------------------------------------------------------------------------
# split

test csv-api-8.0 {split, empty line} -body {
    csv::split {}
} -result {}

test csv-api-8.1 {split, -alternate, empty line} -body {
    csv::split -alternate {}
} -result {{}}

test csv-api-8.11 {split, regular format, quoted empty string is a quote} -body {
    csv::split {123,"123,521.2","Mary says ""Hello, I am Mary""",""}
} -result {123 123,521.2 {Mary says "Hello, I am Mary"} {"}}

# Ticket [387599b3d8]: doubled quotes inside an unquoted value.
test csv-api-8.13 {split -alternate, doubled quote in unquoted value} -constraints {
    knownBug
} -body {
    csv::split -alternate {a;b""b;c} \;
} -result [list a {b"b} c]

test csv-api-8.14 {split, doubled quote in unquoted value} -body {
    csv::split {a;b""b;c} \;
} -result [list a {b"b} c]

test csv-api-8.12 {split -alternate, quoted empty string is empty} -body {
    csv::split -alternate {123,"123,521.2","Mary says ""Hello, I am Mary""",""}
} -result {123 123,521.2 {Mary says "Hello, I am Mary"} {}}

test csv-api-8.2 {split, custom separator and delimiter} -body {
    csv::split {a;'b;c';'d''e'} \; '
} -result {a {b;c} d'e}

test csv-api-8.3 {split, -alternate, custom separator and delimiter} -body {
    csv::split -alternate {a;'';'b;c'} \; '
} -result {a {} {b;c}}

test csv-api-8.4 {split, -alternate, custom separator} -body {
    csv::split -alternate {a;"";"b;c"} \;
} -result {a {} {b;c}}

test csv-api-8.5 {split, wrong # args, four without -alternate} -body {
    csv::split a b c d
} -returnCodes error -result {wrong#args: Should be ?-alternate? line ?separator? ?delimiter?}

test csv-api-8.6 {split, empty delimiter} -body {
    csv::split a , {}
} -returnCodes error -result {illegal separator character "", is empty}

test csv-api-8.7 {split, delimiter is a string} -body {
    csv::split a , ab
} -returnCodes error -result {illegal separator character "ab", is a string}

test csv-api-8.8 {split, -alternate, delimiter is a string} -body {
    csv::split -alternate a , ab
} -returnCodes error -result {illegal separator character "ab", is a string}

test csv-api-8.9 {split, round trip with join} -body {
    set values [list a {} {b,c} {d"e} " f " "g\nh"]
    csv::split [csv::join $values]
} -cleanup {
    unset values
} -result [list a {} {b,c} {d"e} " f " "g\nh"]

test csv-api-8.10 {split -alternate, round trip with join, always quote} -body {
    set values [list a {} {b;c} {d'e}]
    csv::split -alternate [csv::join $values \; ' always] \; '
} -cleanup {
    unset values
} -result [list a {} {b;c} {d'e}]

# -------------------------------------------------------------------------
# split2matrix

test csv-api-9.0 {split2matrix, wrong # args, none} -body {
    csv::split2matrix
} -returnCodes error -result {wrong#args: Should be ?-alternate? m line ?separator? ?expand?}

test csv-api-9.1 {split2matrix, wrong # args, one} -body {
    csv::split2matrix m
} -returnCodes error -result {wrong#args: Should be ?-alternate? m line ?separator? ?expand?}

test csv-api-9.2 {split2matrix, wrong # args, too many} -body {
    csv::split2matrix -alternate m line , none x
} -returnCodes error -result {wrong#args: Should be ?-alternate? m line ?separator? ?expand?}

test csv-api-9.3 {split2matrix, default expand mode none truncates} -setup {
    struct::matrix m
    m add columns 2
} -body {
    csv::split2matrix m {a,b,c}
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
} -result {2 {{a b}}}

test csv-api-9.4 {split2matrix, custom separator} -setup {
    struct::matrix m
    m add columns 2
} -body {
    csv::split2matrix m {a;b,c} \;
    m get rect 0 0 end end
} -cleanup {
    m destroy
} -result {{a b,c}}

test csv-api-9.5 {split2matrix, expand mode empty} -setup {
    struct::matrix m
} -body {
    csv::split2matrix m {a,b} , empty
    csv::split2matrix m {c,d,e} , empty
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
} -result {2 {{a b} {c d}}}

test csv-api-9.6 {split2matrix, expand mode empty, non-empty matrix} -setup {
    struct::matrix m
    m add columns 1
} -body {
    csv::split2matrix m {a,b} , empty
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
} -result {1 a}

test csv-api-9.7 {split2matrix, expand mode auto} -setup {
    struct::matrix m
    m add columns 1
} -body {
    csv::split2matrix m {a,b} , auto
    csv::split2matrix m {c,d,e} , auto
    csv::split2matrix m {f} , auto
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
} -result {3 {{a b {}} {c d e} {f {} {}}}}

test csv-api-9.8 {split2matrix, -alternate} -setup {
    struct::matrix m
    m add columns 2
} -body {
    csv::split2matrix -alternate m {a,""}
    m get rect 0 0 end end
} -cleanup {
    m destroy
} -result {{a {}}}

test csv-api-9.9 {split2matrix, -alternate with separator} -setup {
    struct::matrix m
    m add columns 2
} -body {
    csv::split2matrix -alternate m {a;"b;c"} \;
    m get rect 0 0 end end
} -cleanup {
    m destroy
} -result {{a {b;c}}}

# The 5 argument form (-alternate m line sepChar expand) is not
# recognized: the argument count switch has two arms for 4 arguments.
# Ticket [f2b25fff77].
test csv-api-9.10 {split2matrix, -alternate with separator and expand mode} -constraints {
    knownBug
} -setup {
    struct::matrix m
} -body {
    csv::split2matrix -alternate m {a;b;c} \; auto
    list [m columns] [m get rect 0 0 end end]
} -cleanup {
    m destroy
} -result {3 {{a b c}}}

test csv-api-9.11 {split2matrix, -alternate, bad separator} -setup {
    struct::matrix m
} -body {
    csv::split2matrix -alternate m a ab
} -cleanup {
    m destroy
} -returnCodes error -result {illegal separator character "ab", is a string}

# -------------------------------------------------------------------------
# split2queue

test csv-api-10.0 {split2queue, wrong # args, none} -body {
    csv::split2queue
} -returnCodes error -result {wrong#args: Should be ?-alternate? q line ?separator?}

test csv-api-10.1 {split2queue, wrong # args, one} -body {
    csv::split2queue q
} -returnCodes error -result {wrong#args: Should be ?-alternate? q line ?separator?}

