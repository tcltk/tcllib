test csv-api-10.5 {split2queue, custom separator} -setup {
    struct::queue q
} -body {
    csv::split2queue q {a;b,c} \;
    queueItems q
} -cleanup {
    q destroy
} -result {{a b,c}}

test csv-api-10.6 {split2queue, -alternate} -setup {
    struct::queue q
} -body {
    csv::split2queue -alternate q {a,""}
    queueItems q
} -cleanup {
    q destroy
} -result {{a {}}}

test csv-api-10.7 {split2queue, -alternate with separator} -setup {
    struct::queue q
} -body {
    csv::split2queue -alternate q {a;"b;c"} \;
    queueItems q
} -cleanup {
    q destroy
} -result {{a {b;c}}}

test csv-api-10.8 {split2queue, -alternate, bad separator} -setup {
    struct::queue q
} -body {
    csv::split2queue -alternate q a {}
} -cleanup {
    q destroy
} -returnCodes error -result {illegal separator character "", is empty}

# -------------------------------------------------------------------------
# writematrix

test csv-api-11.0 {writematrix, wrong # args, not enough} -body {
    csv::writematrix m
} -returnCodes error -result [tcltest::wrongNumArgs csv::writematrix {m chan ?sepChar? ?delChar?} 1]

test csv-api-11.1 {writematrix, wrong # args, too many} -body {
    csv::writematrix m chan , \" x
} -returnCodes error -result [tcltest::tooManyArgs csv::writematrix {m chan ?sepChar? ?delChar?}]

test csv-api-11.2 {writematrix, custom separator and delimiter} -setup {
    struct::matrix m
    m add columns 3
    m add row {a {b;c} {d'e}}
    m add row {f {} g}
    set fh [open [makeFile {} out.csv] w]
} -body {
    csv::writematrix m $fh \; '
    close $fh
    viewFile out.csv
} -cleanup {
    m destroy
    removeFile out.csv
    unset fh
} -result "a;'b;c';'d''e'\nf;;g"

test csv-api-11.3 {writematrix, empty matrix} -setup {
    struct::matrix m
    set fh [open [makeFile {} out.csv] w]
} -body {
    csv::writematrix m $fh
    close $fh
    file size [file join [temporaryDirectory] out.csv]
} -cleanup {
    m destroy
    removeFile out.csv
    unset fh
} -result 0

# -------------------------------------------------------------------------
# writequeue

test csv-api-12.0 {writequeue, wrong # args, not enough} -body {
    csv::writequeue q
} -returnCodes error -result [tcltest::wrongNumArgs csv::writequeue {q chan ?sepChar? ?delChar?} 1]

test csv-api-12.1 {writequeue, wrong # args, too many} -body {
    csv::writequeue q chan , \" x
} -returnCodes error -result [tcltest::tooManyArgs csv::writequeue {q chan ?sepChar? ?delChar?}]

test csv-api-12.2 {writequeue, custom separator and delimiter, queue emptied} -setup {
    struct::queue q
    q put {a {b;c}} {d'e f}
    set fh [open [makeFile {} out.csv] w]
} -body {
    csv::writequeue q $fh \; '
    close $fh
    list [q size] [viewFile out.csv]
} -cleanup {
    q destroy
    removeFile out.csv
    unset fh
} -result [list 0 "a;'b;c'\n'd''e';f"]

test csv-api-12.3 {writequeue, read back with read2queue} -setup {
    struct::queue q
    q put {a {b,c}} [list "multi\nline" {x"y}]
    set fh [open [makeFile {} out.csv] w]
} -body {
    csv::writequeue q $fh
    close $fh
    set fh [open [file join [temporaryDirectory] out.csv] r]
    csv::read2queue $fh q
    close $fh
    set items [queueItems q]
    list [llength $items] [lindex $items 0 0] [lindex $items 0 1] [lindex $items 1 0] [lindex $items 1 1]
} -cleanup {
    q destroy
    removeFile out.csv
    unset fh items
} -result [list 2 a b,c "multi\nline" {x"y}]

# -------------------------------------------------------------------------
rename openData {}
rename closeData {}
rename queueItems {}
testsuiteCleanup
