    csv::split2queue -alternate q line , x
} -returnCodes error -result {wrong#args: Should be ?-alternate? q line ?separator?}

test csv-api-10.4 {split2queue, defaults} -setup {
    struct::queue q
} -body {
    csv::split2queue q {a,"b,c",d}
    csv::split2queue q {e}
