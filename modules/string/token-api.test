# -*- tcl -*-
# Testsuite string::token (text, file, chomp)
#
# There were no tests for string::token itself before, only for
# string::token::shell (token_shell.test).

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use      cmdline/cmdline.tcl    cmdline
    use      fileutil/fileutil.tcl  fileutil
}
testing {
    useLocal token.tcl string::token
}

# -------------------------------------------------------------------------

set lex [list {[0-9]+} NUM {[a-z]+} WORD {\s+} WS]

# -------------------------------------------------------------------------
## Ensemble and argument checks

test string-token-api-1.0 {string token, ensemble registered in string} -body {
    string token text $lex abc
} -result {{WORD 0 2}}

test string-token-api-1.1 {string token, bad subcommand} -body {
    string token bogus
} -returnCodes error -match glob -result {unknown or ambiguous subcommand "bogus": must be chomp, file, *text}

test string-token-api-1.2 {string token text, wrong # args} -body {
    string token text a
} -returnCodes error -match glob -result {wrong # args: should be "*text map text"}

test string-token-api-1.3 {string token text, too many args} -body {
    string token text a b c
} -returnCodes error -match glob -result {wrong # args: should be "*text map text"}

test string-token-api-1.4 {string token file, wrong # args} -body {
    string token file a
} -returnCodes error -match glob -result {wrong # args: should be "*file map path ?arg ...?"}

test string-token-api-1.5 {string token chomp, wrong # args} -body {
    string token chomp a b c
} -returnCodes error -match glob -result {wrong # args: should be "*chomp map sv text rv"}

# -------------------------------------------------------------------------
## text

test string-token-api-2.0 {text, tokens with labels and indices} -body {
    string token text $lex "abc 12x"
} -result {{WORD 0 2} {WS 3 3} {NUM 4 5} {WORD 6 6}}

test string-token-api-2.1 {text, empty string gives no tokens} -body {
    string token text $lex ""
} -result {}

test string-token-api-2.2 {text, untokenizable character} -body {
    string token text $lex "ab-c"
} -returnCodes error -result {Unexpected character '-' at offset 2}

test string-token-api-2.3 {text, error code} -body {
    catch {string token text $lex "ab-c"} msg opts
    dict get $opts -errorcode
} -cleanup {
    unset -nocomplain msg opts
} -result {STRING TOKEN BAD CHARACTER}

test string-token-api-2.4 {text, untokenizable first character} -body {
    string token text $lex "-"
} -returnCodes error -result {Unexpected character '-' at offset 0}

test string-token-api-2.5 {text, regexps are tested in dictionary order} -body {
    list [string token text {ab LONG a SHORT b B} ab] \
	[string token text {a SHORT ab LONG b B} ab]
} -result {{{LONG 0 1}} {{SHORT 0 0} {B 1 1}}}

test string-token-api-2.6 {text, matches are anchored at the current position} -body {
    # Without anchoring, NUM would match the "1" further on.
    string token text [list {[0-9]} NUM {[a-z]} CHAR] a1
} -result {{CHAR 0 0} {NUM 1 1}}

test string-token-api-2.7 {text, regexp with alternation and groups} -body {
    string token text [list {(foo|bar)+} FB { } SP] "foobar bar"
} -result {{FB 0 5} {SP 6 6} {FB 7 9}}

test string-token-api-2.8 {text, same label for several regexps} -body {
    string token text [list {[0-9]+} TOK {[a-z]+} TOK] 12ab
} -result {{TOK 0 1} {TOK 2 3}}

test string-token-api-2.9 {text, non-ASCII characters} -body {
    string token text [list {\w+} WORD {\s+} WS] "йога ї"
} -result {{WORD 0 3} {WS 4 4} {WORD 5 5}}

test string-token-api-2.10 {text, documented ini example, lines} -setup {
    set ini [list {[#;].*$} COMMENT {\[[^]]+\]} GROUP {\w+\s*[:=].+$} ENTRY]
} -body {
    set r {}
    foreach line {{; example.ini } {Filename = test.db} {[Database]} {Port: 143}} {
	lappend r [string token text $ini $line]
    }
    lappend r [catch {string token text $ini invalid} msg] $msg
} -cleanup {
    unset -nocomplain ini r line msg
} -result {{{COMMENT 0 13}} {{ENTRY 0 17}} {{GROUP 0 9}} {{ENTRY 0 8}} 1 {Unexpected character 'i' at offset 0}}

# -------------------------------------------------------------------------
## file

test string-token-api-3.0 {file, tokenizes the file contents} -setup {
    set f [makeFile {} token-api.txt]
    set fd [open $f w]
    puts -nonewline $fd "abc 12\nx"
    close $fd
} -body {
    string token file $lex $f
} -cleanup {
    removeFile token-api.txt
    unset -nocomplain f fd
} -result {{WORD 0 2} {WS 3 3} {NUM 4 5} {WS 6 6} {WORD 7 7}}

test string-token-api-3.1 {file, error for untokenizable content} -setup {
    set f [makeFile {} token-api.txt]
    set fd [open $f w]
    puts -nonewline $fd "ab+"
    close $fd
} -body {
    string token file $lex $f
} -cleanup {
    removeFile token-api.txt
    unset -nocomplain f fd
} -returnCodes error -result {Unexpected character '+' at offset 2}

test string-token-api-3.2 {file, empty file} -setup {
    set f [makeFile {} token-api.txt]
    close [open $f w]
} -body {
    string token file $lex $f
} -cleanup {
    removeFile token-api.txt
    unset -nocomplain f
} -result {}

test string-token-api-3.3 {file, missing file} -body {
    string token file $lex [file join [temporaryDirectory] no-such-token-file]
} -returnCodes error -match glob -result {*no-such-token-file*}

# -------------------------------------------------------------------------
## chomp

test string-token-api-4.0 {chomp, token found} -setup {
    set start 0
    set result {}
} -body {
    set status [string token chomp $lex start "ab 1" result]
    list $status $start $result
} -cleanup {
    unset -nocomplain start result status
} -result {1 2 {{WORD 0 1}}}

test string-token-api-4.1 {chomp, appends to the result variable} -setup {
    set start 3
    set result {{OLD 0 0}}
} -body {
    set status [string token chomp $lex start "ab 12" result]
    list $status $start $result
} -cleanup {
    unset -nocomplain start result status
} -result {1 5 {{OLD 0 0} {NUM 3 4}}}

test string-token-api-4.2 {chomp, no token found, variables unchanged} -setup {
    set start 2
    set result {}
} -body {
    set status [string token chomp $lex start "ab-" result]
    list $status $start $result
} -cleanup {
    unset -nocomplain start result status
} -result {0 2 {}}

test string-token-api-4.3 {chomp, end of string reached} -setup {
    set start 3
    set result keep
} -body {
    set status [string token chomp $lex start "ab-" result]
    list $status $start $result
} -cleanup {
    unset -nocomplain start result status
} -result {2 3 keep}

test string-token-api-4.4 {chomp, start beyond the end} -setup {
    set start 10
    set result keep
} -body {
    set status [string token chomp $lex start "ab" result]
    list $status $start $result
} -cleanup {
    unset -nocomplain start result status
} -result {2 10 keep}

test string-token-api-4.5 {chomp, empty string} -setup {
    set start 0
    set result keep
} -body {
    set status [string token chomp $lex start "" result]
    list $status $start $result
} -cleanup {
    unset -nocomplain start result status
} -result {2 0 keep}

test string-token-api-4.6 {chomp, variables in the caller's scope} -body {
    apply {{lex} {
	set s 0
	set r {}
	set st [string token chomp $lex s "12" r]
	list $st $s $r
    }} $lex
} -result {1 2 {{NUM 0 1}}}

test string-token-api-4.7 {chomp, own lexer switching dictionaries} -body {
    # Lex a word, then digits only, using two dictionaries.
    set words [list {[a-z]+} WORD]
    set nums  [list {[0-9]+} NUM]
    set start 0
    set result {}
    set s1 [string token chomp $words start abc123 result]
    set s2 [string token chomp $words start abc123 result]
    set s3 [string token chomp $nums  start abc123 result]
    set s4 [string token chomp $nums  start abc123 result]
    list $s1 $s2 $s3 $s4 $result
} -cleanup {
    unset -nocomplain words nums start result s1 s2 s3 s4
} -result {1 0 1 2 {{WORD 0 2} {NUM 3 5}}}

# -------------------------------------------------------------------------
unset -nocomplain lex
testsuiteCleanup
