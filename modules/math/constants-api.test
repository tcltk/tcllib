# -*- tcl -*-
# constants-api.test --
#    Tests for the documented API of the math::constants package, in
#    addition to constants.test.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors. No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.6
testsNeedTcltest 2.1

support {
    useLocal math.tcl math
}
testing {
    useLocal constants.tcl math::constants
}

# -------------------------------------------------------------------------

proc matchNumbersLoose {expected actual} {
    if {[llength $expected] != [llength $actual]} {
	return 0
    }
    foreach a $actual e $expected {
	if {![string is double -strict $a] || abs($a-$e) > 1.0e-10 * max(1.0, abs($e))} {
	    return 0
	}
    }
    return 1
}
customMatch loose matchNumbersLoose

proc matchNumbers {expected actual} {
    if {[llength $expected] != [llength $actual]} {
	return 0
    }
    foreach a $actual e $expected {
	if {![string is double -strict $a]} {
	    return 0
	}
	if {abs($a-$e) > 1.0e-14 * max(1.0, abs($e))} {
	    return 0
	}
    }
    return 1
}
customMatch numbers matchNumbers

# The documented constants
set ::documentedConstants {
    pi e ln10 phi gamma sqrt2 thirdrt2 sqrt3 radtodeg degtorad
    onethird twothirds onesixth huge tiny
}

# -------------------------------------------------------------------------
# constants
# -------------------------------------------------------------------------

test constants-api-1.1 "constants: example from the manual, in a namespace" -body {
    namespace eval ::consttest {
	::math::constants::constants radtodeg degtorad
    }
    list [info exists ::consttest::radtodeg] [info exists ::consttest::degtorad] \
	[info exists ::radtodeg]
} -cleanup {
    namespace delete ::consttest
} -result {1 1 0}

test constants-api-1.2 "constants: radtodeg and degtorad are reciprocal" -body {
    namespace eval ::consttest {
	::math::constants::constants radtodeg degtorad
	expr {$radtodeg * $degtorad}
    }
} -cleanup {
    namespace delete ::consttest
} -match loose -result 1.0

test constants-api-1.3 "constants: in a procedure, the variables are visible" -body {
    namespace eval ::consttest {
	proc p {} {
	    ::math::constants::constants pi
	    set pi
	}
    }
    ::consttest::p
} -cleanup {
    namespace delete ::consttest
} -match numbers -result [expr {4.0*atan(1.0)}]

test constants-api-1.4 "constants: all documented constants exist" -body {
    namespace eval ::consttest [list ::math::constants::constants {*}$::documentedConstants]
    set missing {}
    foreach c $::documentedConstants {
	if {![info exists ::consttest::$c] ||
	    ![string is double -strict [set ::consttest::$c]]} {
	    lappend missing $c
	}
    }
    set missing
} -cleanup {
    namespace delete ::consttest
    unset -nocomplain missing c
} -result {}

test constants-api-1.5 "constants: values" -body {
    namespace eval ::consttest {
	::math::constants::constants pi e ln10 phi sqrt2 thirdrt2 sqrt3
	list $pi $e $ln10 $phi $sqrt2 $thirdrt2 $sqrt3
    }
} -cleanup {
    namespace delete ::consttest
} -match numbers -result [list [expr {4.0*atan(1.0)}] [expr {exp(1.0)}] [expr {log(10.0)}] \
	[expr {(1.0+sqrt(5.0))/2.0}] [expr {sqrt(2.0)}] [expr {pow(2.0,1.0/3.0)}] \
	[expr {sqrt(3.0)}]]

test constants-api-1.5.1 "constants: radtodeg and degtorad" -body {
    namespace eval ::consttest {
	::math::constants::constants radtodeg degtorad
	list $radtodeg $degtorad
    }
} -cleanup {
    namespace delete ::consttest
} -match loose -result [list [expr {45.0/atan(1.0)}] [expr {atan(1.0)/45.0}]]

# radtodeg and degtorad are defined with only 12 and 14 significant digits
# (57.2957795131 and 0.017453292519943), much less than double precision.
test constants-api-1.5.2 "constants: radtodeg and degtorad in full double precision" -constraints knownBug -body {
    namespace eval ::consttest {
	::math::constants::constants radtodeg degtorad
	list $radtodeg $degtorad
    }
} -cleanup {
    namespace delete ::consttest
} -match numbers -result [list [expr {45.0/atan(1.0)}] [expr {atan(1.0)/45.0}]]

test constants-api-1.6 "constants: Euler's constant" -body {
    namespace eval ::consttest {
	::math::constants::constants gamma
	set gamma
    }
} -cleanup {
    namespace delete ::consttest
} -match numbers -result 0.57721566490153286061

test constants-api-1.7 "constants: fractions give exact results" -body {
    namespace eval ::consttest {
	::math::constants::constants onethird twothirds onesixth
	list [expr {3.0*$onethird == 1.0}] [expr {$onethird + $onethird == $twothirds}] \
	    [expr {2.0*$onesixth == $onethird}]
    }
} -cleanup {
    namespace delete ::consttest
} -result {1 1 1}

test constants-api-1.8 "constants: huge and tiny" -body {
    namespace eval ::consttest {
	::math::constants::constants huge tiny
	list [expr {$huge > 1.0e300}] [expr {$tiny > 0.0}] [expr {$tiny < 1.0e-300}]
    }
} -cleanup {
    namespace delete ::consttest
} -result {1 1 1}

test constants-api-1.9 "constants: no arguments" -body {
    namespace eval ::consttest {
	::math::constants::constants
	info vars ::consttest::*
    }
} -cleanup {
    namespace delete ::consttest
} -result {}

test constants-api-1.10 "constants: unknown constant" -body {
    namespace eval ::consttest {
	::math::constants::constants nosuchconstant
    }
} -cleanup {
    namespace delete ::consttest
} -returnCodes error -result {can't read "::math::constants::nosuchconstant": no such variable}

test constants-api-1.11 "constants: importable with namespace import" -body {
    namespace eval ::consttest {
	namespace import ::math::constants::constants ::math::constants::print-constants
	constants e
	list [info exists e] [llength [info commands ::consttest::print-constants]]
    }
} -cleanup {
    namespace delete ::consttest
} -result {1 1}

# -------------------------------------------------------------------------
# print-constants
# -------------------------------------------------------------------------

test constants-api-2.1 "print-constants: selected constants" -body {
    ::math::constants::print-constants pi e
} -match regexp -output {^pi = 3\.14159265358979\d* = ratio of circle circumference and diameter
e = 2\.71828182845904\d* = base for natural logarithm
$} -result {}

test constants-api-2.2 "print-constants: unknown constant" -body {
    ::math::constants::print-constants nosuchconstant
} -output "*** nosuchconstant unknown ***\n" -result {}

# All documented constants are listed, in the order of the manual
# (the undocumented eps follows them).
test constants-api-2.3 "print-constants: all constants" -body {
    ::math::constants::print-constants
} -match regexp -output "^[join [lmap c $::documentedConstants {
    format {%s = [^\n]* = [^\n]*\n} $c
}] {}]eps = \[^\n\]*\n\$" -result {}

test constants-api-2.4 "print-constants: returns an empty string" -body {
    ::math::constants::print-constants e
} -output "*" -match glob -result {}

# -------------------------------------------------------------------------

rename matchNumbers {}
rename matchNumbersLoose {}
unset ::documentedConstants

# End of test cases
testsuiteCleanup
