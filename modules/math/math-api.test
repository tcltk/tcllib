# -*- tcl -*-
# math-api.test --
#    Tests for the documented API of the math package (basic commands),
#    in addition to math.test.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors. No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.1

testing {
    useLocal math.tcl math
}

# -------------------------------------------------------------------------

proc matchNumbers {expected actual} {
    if {[llength $expected] != [llength $actual]} {
	return 0
    }
    foreach a $actual e $expected {
	if {![string is double -strict $a] || abs($a-$e) > 1.0e-9 * max(1.0, abs($e))} {
	    return 0
	}
    }
    return 1
}
customMatch numbers matchNumbers

# -------------------------------------------------------------------------
# integrate
# -------------------------------------------------------------------------

test math-api-1.1 "integrate: quadratic function is integrated exactly" -match numbers -body {
    lindex [::math::integrate {0 0 1 1 2 4 3 9 4 16}] 0
} -result [expr {64.0/3.0}]

test math-api-1.2 "integrate: even number of pairs" -match numbers -body {
    lindex [::math::integrate {0 0 1 1 2 4 3 9 4 16 5 25}] 0
} -result [expr {125.0/3.0}]

test math-api-1.3 "integrate: result is area and error bound" -body {
    set r [::math::integrate {0 0 1 1 2 4 3 9 4 16}]
    list [llength $r] [expr {[lindex $r 1] >= 0.0}]
} -cleanup {
    unset -nocomplain r
} -result {2 1}

test math-api-1.4 "integrate: unmatched pair" -body {
    ::math::integrate {0 0 1 1 2 4 3 9 4 16 5}
} -returnCodes error -result {unmatched xy pair in input}

test math-api-1.5 "integrate: decreasing x1" -body {
    ::math::integrate {1 0 0 1 2 4 3 9 4 16}
} -returnCodes error -result {monotonicity broken by x1}

test math-api-1.6 "integrate: decreasing xn" -body {
    ::math::integrate {0 0 1 1 2 4 4 9 3 16}
} -returnCodes error -result {monotonicity broken by xn}

test math-api-1.7 "integrate: decreasing x in the middle" -body {
    ::math::integrate {0 0 2 1 1 4 3 9 4 16}
} -returnCodes error -result {monotonicity broken by x3}

test math-api-1.8 "integrate: wrong # args" -body {
    ::math::integrate
} -returnCodes error -result {wrong # args: should be "::math::integrate xy_pairs"}

# -------------------------------------------------------------------------
# fibonacci
# -------------------------------------------------------------------------

test math-api-2.1 "fibonacci: large values are exact" -body {
    list [::math::fibonacci 90] [::math::fibonacci 100]
} -result {2880067194370816120 354224848179261915075}

test math-api-2.2 "fibonacci: recurrence" -body {
    set bad {}
    for {set n 2} {$n < 120} {incr n} {
	if {[::math::fibonacci $n] != [::math::fibonacci [expr {$n-1}]] + [::math::fibonacci [expr {$n-2}]]} {
	    lappend bad $n
	}
    }
    set bad
} -cleanup {
    unset -nocomplain bad n
} -result {}

test math-api-2.3 "fibonacci: wrong # args" -body {
    ::math::fibonacci
} -returnCodes error -result {wrong # args: should be "::math::fibonacci n"}

# -------------------------------------------------------------------------
# random
# -------------------------------------------------------------------------

test math-api-3.1 "random: no arguments gives a value in \[0, 1)" -body {
    expr {srand(4711)}
    set ok 1
    for {set i 0} {$i < 200} {incr i} {
	set r [::math::random]
	if {![string is double -strict $r] || $r < 0.0 || $r >= 1.0} {
	    set ok 0
	}
    }
    set ok
} -cleanup {
    unset -nocomplain ok i r
} -result 1

test math-api-3.2 "random: one argument gives integers in \[0, value1)" -body {
    expr {srand(4711)}
    set seen {}
    for {set i 0} {$i < 200} {incr i} {
	lappend seen [::math::random 4]
    }
    lsort -unique -integer $seen
} -cleanup {
    unset -nocomplain seen i
} -result {0 1 2 3}

test math-api-3.3 "random: two arguments give integers in \[value1, value2)" -body {
    expr {srand(4711)}
    set seen {}
    for {set i 0} {$i < 200} {incr i} {
	lappend seen [::math::random -2 2]
    }
    lsort -unique -integer $seen
} -cleanup {
    unset -nocomplain seen i
} -result {-2 -1 0 1}

# -------------------------------------------------------------------------
# Statistics commands
# -------------------------------------------------------------------------

test math-api-4.1 "sigma, cov, stats: consistent results" -match numbers -body {
    set values {2 4 4 4 5 5 7 9}
    set mean  [::math::mean {*}$values]
    set sigma [::math::sigma {*}$values]
    set cov   [::math::cov {*}$values]
    concat [::math::stats {*}$values] [expr {100.0*$sigma/$mean - $cov}]
} -cleanup {
    unset -nocomplain values mean sigma cov
} -result [list 5.0 [expr {sqrt(32.0/7.0)}] [expr {100.0*sqrt(32.0/7.0)/5.0}] 0.0]

test math-api-4.2 "min, max, mean, sum, product: a single value" -body {
    list [::math::min 3] [::math::max 3] [::math::mean 3] [::math::sum 3] [::math::product 3]
} -match numbers -result {3 3 3 3 3}

test math-api-4.3 "min, max: big integers" -body {
    list [::math::min 100000000000000000000 3] [::math::max 100000000000000000000 3]
} -result {3 100000000000000000000}

# -------------------------------------------------------------------------

rename matchNumbers {}

# End of test cases
testsuiteCleanup
