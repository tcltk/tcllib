# -*- tcl -*-
# bigfloat-api.test --
#    Tests for the documented API of the math::bigfloat package, in
#    addition to bigfloat2.test: the examples of the manual, isFloat,
#    integer operands and the documented error cases.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors. No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.1

support {
    useLocal math.tcl math
}
testing {
    useLocal bigfloat2.tcl math::bigfloat
}

# -------------------------------------------------------------------------

namespace eval ::bftest {
    namespace import ::math::bigfloat::*
}

# Run a script in ::bftest (where the package commands are imported)
proc bf {script} {
    namespace eval ::bftest $script
}

# -------------------------------------------------------------------------
# fromstr
# -------------------------------------------------------------------------

test bigfloat-api-1.1 "fromstr: integers are returned unchanged" -body {
    bf {list [fromstr 10000000000] [fromstr -39]}
} -result {10000000000 -39}

test bigfloat-api-1.2 "fromstr: a dot or an exponent makes a BigFloat" -body {
    bf {list [isFloat [fromstr -1.000000]] [isFloat [fromstr 2000e30]]}
} -result {1 1}

test bigfloat-api-1.3 "fromstr: trailingZeros adds precision (manual example)" -body {
    bf {list [tostr [fromstr 1. 10]] [equal [fromstr 1.0000000000] [fromstr 1. 10]]}
} -result {1.000000000 1}

test bigfloat-api-1.4 "fromstr: trailingZeros with an integer" -body {
    bf {fromstr 10 2}
} -returnCodes error -result {second argument not allowed with an integer}

test bigfloat-api-1.5 "fromstr: not a number" -body {
    bf {fromstr abc}
} -returnCodes error -result {abc is not a number}

test bigfloat-api-1.6 "fromstr: trailing garbage" -body {
    bf {fromstr 1.5x}
} -returnCodes error -result {1.5x is not a number}

test bigfloat-api-1.7 "fromstr: wrong # args" -body {
    ::math::bigfloat::fromstr
} -returnCodes error -result {wrong # args: should be "::math::bigfloat::fromstr number ?addzeros?"}

# -------------------------------------------------------------------------
# tostr
# -------------------------------------------------------------------------

test bigfloat-api-2.1 "tostr: examples from the manual" -body {
    bf {list [tostr [fromstr 0.99999]] [tostr [fromstr 1.00001]] [tostr [fromstr 0.002]]}
} -result {1.0000 1.0000 0.e-2}

test bigfloat-api-2.2 "tostr: numbers close to zero (manual examples)" -body {
    bf {list [tostr [fromstr 0.001]] [tostr [fromstr 0.000000]] \
	    [tostr [fromstr 0.0]]}
} -result {0.e-2 0.e-5 0.}

test bigfloat-api-2.3 "tostr: an integer is returned unchanged" -body {
    bf {list [tostr 12345678901234567890] [tostr -5]}
} -result {12345678901234567890 -5}

test bigfloat-api-2.4 "tostr: scientific notation" -body {
    bf {tostr [fromstr 3.4523e+5]}
} -result 3.452e+5

test bigfloat-api-2.5 "tostr: -nosci" -body {
    bf {tostr -nosci [fromstr 3.4523e+5]}
} -result 345200.

test bigfloat-api-2.6 "tostr: big exponent" -body {
    bf {tostr [fromstr 2000e30]}
} -result 2.00e+33

test bigfloat-api-2.7 "tostr: unknown option" -body {
    bf {tostr -bad [fromstr 1.0]}
} -returnCodes error -result {unknown option: should be -nosci}

test bigfloat-api-2.8 "tostr: no arguments" -body {
    bf {tostr}
} -returnCodes error -result {syntax error: should be tostr ?-nosci? number}

test bigfloat-api-2.9 "tostr: not a BigFloat" -body {
    bf {tostr -nosci abc}
} -returnCodes error -result {BigFloat expected}

# -------------------------------------------------------------------------
# fromdouble, todouble
# -------------------------------------------------------------------------

test bigfloat-api-3.1 "fromdouble: fixed number of decimals (manual example)" -body {
    bf {list [tostr [fromstr 1.111 4]] [tostr [fromdouble 1.111 4]]}
} -result {1.111000 1.111}

test bigfloat-api-3.2 "fromdouble: negative number" -body {
    bf {tostr [fromdouble -2.5 3]}
} -result -2.50

test bigfloat-api-3.3 "fromdouble: not a number" -body {
    bf {fromdouble abc}
} -returnCodes error -result {abc is not a number}

test bigfloat-api-3.4 "fromdouble: wrong # args" -body {
    ::math::bigfloat::fromdouble
} -returnCodes error -result {wrong # args: should be "::math::bigfloat::fromdouble double ?exp?"}

test bigfloat-api-3.5 "todouble: with tcl_precision set" -setup {
    set hadPrecision [info exists ::tcl_precision]
    if {$hadPrecision} {
	set savedPrecision $::tcl_precision
    }
    set ::tcl_precision 15
} -body {
    set a [bf {todouble [fromstr 1.50000]}]
    set b [bf {todouble [fromstr -2.2500e3]}]
    list [string is double -strict $a] [expr {$a == 1.5}] \
	[string is double -strict $b] [expr {$b == -2250.0}]
} -cleanup {
    if {$hadPrecision} {
	set ::tcl_precision $savedPrecision
    } else {
	unset ::tcl_precision
    }
    unset -nocomplain hadPrecision savedPrecision a b
} -result {1 1 1 1}

# Tcl 9 no longer has the tcl_precision variable, todouble reads it
# unconditionally.
test bigfloat-api-3.6 "todouble: without tcl_precision (Tcl 9)" -constraints knownBug -body {
    expr {[bf {todouble [fromstr 1.50000]}] == 1.5}
} -result 1

test bigfloat-api-3.7 "todouble: not a BigFloat" -setup {
    set hadPrecision [info exists ::tcl_precision]
    if {!$hadPrecision} {
	set ::tcl_precision 15
    }
} -body {
    bf {todouble 3}
} -cleanup {
    if {!$hadPrecision} {
	unset ::tcl_precision
    }
    unset -nocomplain hadPrecision
} -returnCodes error -result {BigFloat expected}

# -------------------------------------------------------------------------
# isInt, isFloat, int2float
# -------------------------------------------------------------------------

test bigfloat-api-4.1 "isFloat: BigFloats" -body {
    bf {list [isFloat [fromstr 1.0]] [isFloat [fromstr 2000e30]] [isFloat [fromdouble 1.5]]}
} -result {1 1 1}

test bigfloat-api-4.2 "isFloat: not BigFloats" -body {
    bf {list [isFloat 10] [isFloat -39] [isFloat abc] [isFloat 1.5] [isFloat {}]}
} -result {0 0 0 0 0}

test bigfloat-api-4.3 "isInt: integers and others" -body {
    bf {list [isInt 10] [isInt -39] [isInt 12345678901234567890] \
	    [isInt [fromstr 1.0]] [isInt 1.5] [isInt abc]}
} -result {1 1 1 0 0 0}

test bigfloat-api-4.4 "isFloat: wrong # args" -body {
    ::math::bigfloat::isFloat
} -returnCodes error -result {wrong # args: should be "::math::bigfloat::isFloat x"}

test bigfloat-api-4.5 "int2float: examples from the manual" -body {
    bf {list [tostr [int2float 10]] [tostr [int2float 10 3]]}
} -result {10. 10.00}

test bigfloat-api-4.6 "int2float: result is a BigFloat" -body {
    bf {isFloat [int2float 10]}
} -result 1

test bigfloat-api-4.7 "int2float: zero decimals" -body {
    bf {int2float 10 0}
} -returnCodes error -result {non-positive decimals number}

test bigfloat-api-4.8 "int2float: not an integer" -body {
    bf {int2float 1.5}
} -returnCodes error -result {first argument is not an integer}

# -------------------------------------------------------------------------
# Arithmetics
# -------------------------------------------------------------------------

test bigfloat-api-5.1 "add, sub, mul, div, mod: integers behave like expr" -body {
    bf {list [add 1 2] [sub 1 2] [mul 3 4] [div 7 2] [mod 7 2] \
	    [mul 12345678901234567890 98765432109876543210]}
} -result [list 3 -1 12 3 1 [expr {12345678901234567890 * 98765432109876543210}]]

test bigfloat-api-5.2 "add, sub, mul, div: BigFloat and integer" -body {
    bf {list [tostr [add [fromstr 1.000] 2]] [tostr [sub 2 [fromstr 0.500]]] \
	    [tostr [mul [fromstr 1.500] 3]] [tostr [div [fromstr 7.000] 2]]}
} -result {3.00 1.50 4.50 3.50}

test bigfloat-api-5.3 "mod: BigFloat by integer and by BigFloat" -body {
    bf {list [tostr [mod [fromstr 7.500] 2]] [tostr [mod [fromstr 7.500] [fromstr 2.000]]]}
} -result {1.50 1.50}

test bigfloat-api-5.4 "div: integer by BigFloat" -body {
    bf {div 1 [fromstr 2.0]}
} -returnCodes error -result {trying to divide an integer by a BigFloat}

test bigfloat-api-5.5 "div: integer by zero" -body {
    bf {div 1 0}
} -returnCodes error -result {divide by zero}

test bigfloat-api-5.6 "div: BigFloat by BigFloat zero" -body {
    bf {div [fromstr 1.0] [fromstr 0.0]}
} -returnCodes error -result {divide by zero}

test bigfloat-api-5.7 "div: BigFloat by integer zero" -body {
    bf {div [fromstr 1.0] 0}
} -returnCodes error -result {divide by zero}

test bigfloat-api-5.8 "mod: by zero" -body {
    bf {list [catch {mod 1 0} m1] $m1 [catch {mod [fromstr 5.0] 0} m2] $m2}
} -cleanup {
    unset -nocomplain m1 m2
} -result {1 {divide by zero} 1 {divide by zero}}

test bigfloat-api-5.9 "add: not a number" -body {
    bf {add [fromstr 1.0] abc}
} -returnCodes error -result {input is not an integer, nor a BigFloat}

test bigfloat-api-5.10 "abs, opp: BigFloats and integers" -body {
    bf {list [tostr [abs [fromstr -1.500]]] [tostr [opp [fromstr 1.500]]] [abs -3] [opp 3]}
} -result {1.50 -1.50 3 -3}

test bigfloat-api-5.11 "pow: BigFloat and integer base" -body {
    bf {list [tostr [pow [fromstr 1.500] 2]] [tostr [pow [fromstr 2.000] 0]] [pow 2 100]}
} -result [list 2.25 1 [expr {2**100}]]

test bigfloat-api-5.12 "pow: negative exponent" -body {
    bf {pow [fromstr 2.0] -1}
} -returnCodes error -result {pow : exponent is not a positive integer}

foreach {cmd args} {add {a b} sub {a b} mul {a b} div {a b} mod {a b} abs number opp a pow {a b}} {
    test bigfloat-api-5.13.$cmd "$cmd: wrong # args" -body {
	::math::bigfloat::$cmd
    } -returnCodes error -result "wrong # args: should be \"::math::bigfloat::$cmd $args\""
}
unset cmd args

# -------------------------------------------------------------------------
# Comparisons
# -------------------------------------------------------------------------

test bigfloat-api-6.1 "iszero: examples from the manual" -body {
    bf {list [iszero [fromstr 0.002]] [iszero [fromstr 0.001]] [iszero [fromstr 0.0]]}
} -result {0 1 1}

test bigfloat-api-6.2 "iszero: integers" -body {
    bf {list [iszero 0] [iszero 1] [iszero -1]}
} -result {1 0 0}

test bigfloat-api-6.3 "compare: BigFloats" -body {
    bf {list [compare [fromstr 1.000] [fromstr 2.000]] [compare [fromstr 2.000] [fromstr 1.000]] \
	    [compare [fromstr 1.000] [fromstr 1.0001]]}
} -result {-1 1 0}

test bigfloat-api-6.4 "compare, equal: integers" -body {
    bf {list [compare 1 2] [compare 3 2] [compare 2 2] [equal 2 2] [equal 2 3]}
} -result {-1 1 0 1 0}

test bigfloat-api-6.5 "compare: integer and BigFloat" -body {
    bf {compare 1 [fromstr 1.0]}
} -returnCodes error -result {BigFloat expected}

test bigfloat-api-6.6 "equal: integer and BigFloat" -body {
    bf {equal 1 [fromstr 1.0]}
} -returnCodes error -result {BigFloat expected}

foreach {cmd args} {iszero x equal {a b} compare {a b}} {
    test bigfloat-api-6.7.$cmd "$cmd: wrong # args" -body {
	::math::bigfloat::$cmd
    } -returnCodes error -result "wrong # args: should be \"::math::bigfloat::$cmd $args\""
}
unset cmd args

# -------------------------------------------------------------------------
# Analysis
# -------------------------------------------------------------------------

test bigfloat-api-7.1 "sqrt, exp: known values" -body {
    bf {list [tostr [sqrt [fromstr 2.000000000]]] [tostr [exp [fromstr 1.000000000]]]}
} -result {1.41421356 2.7182818}

test bigfloat-api-7.2 "log, sin, sinh, tanh: zero results" -body {
    bf {list [tostr [log [fromstr 1.000000000]]] [tostr [sin [fromstr 0.000000000]]] \
	    [tostr [sinh [fromstr 0.000000000]]] [tostr [tanh [fromstr 0.000000000]]]}
} -result {0.e-8 0.e-8 0.e-8 0.e-8}

test bigfloat-api-7.3 "cos, cosh: one" -body {
    bf {list [tostr [cos [fromstr 0.000000000]]] [tostr [cosh [fromstr 0.000000000]]]}
} -result {1.00000000 1.00000000}

test bigfloat-api-7.4 "atan, acos, asin: known values" -body {
    bf {list [tostr [atan [fromstr 1.000000000]]] [tostr [acos [fromstr 0.000000000]]] \
	    [tostr [asin [fromstr 1.000000000]]]}
} -result {0.78539816 1.570796326795 1.570796326795}

test bigfloat-api-7.5 "tan, cotan: known values" -body {
    bf {list [tostr [tan [fromstr 0.50000000000000000000]]] \
	    [tostr [cotan [fromstr 0.50000000000000000000]]]}
} -result {0.546302489843790513 1.830487721712451919}

test bigfloat-api-7.6 "sqrt: negative argument" -body {
    bf {sqrt [fromstr -1.0]}
} -returnCodes error -result {negative sqrt input}

test bigfloat-api-7.7 "log: zero and negative arguments" -body {
    bf {list [catch {log [fromstr 0.0]} m1] $m1 [catch {log [fromstr -1.0]} m2] $m2}
} -cleanup {
    unset -nocomplain m1 m2
} -result {1 {zero logarithm error} 1 {zero logarithm error}}

test bigfloat-api-7.8 "acos, asin: argument out of range" -body {
    bf {list [catch {acos [fromstr 2.0]} m1] $m1 [catch {asin [fromstr -2.0]} m2] $m2}
} -cleanup {
    unset -nocomplain m1 m2
} -result {1 {acos on a number greater than 1} 1 {asin on a number greater than 1}}

test bigfloat-api-7.9 "cotan: zero" -body {
    bf {cotan [fromstr 0.0]}
} -returnCodes error -result {divide by zero}

test bigfloat-api-7.10 "analysis functions: integer argument" -body {
    set result {}
    foreach f {sqrt log exp cos sin tan cotan acos asin atan cosh sinh tanh} {
	lappend result [catch {::math::bigfloat::$f 1} msg] $msg
    }
    lsort -unique $result
} -cleanup {
    unset -nocomplain result f msg
} -result {1 {BigFloat expected}}

foreach cmd {sqrt log exp cos sin tan cotan acos asin atan cosh sinh tanh} {
    test bigfloat-api-7.11.$cmd "$cmd: wrong # args" -body {
	::math::bigfloat::$cmd
    } -returnCodes error -result "wrong # args: should be \"::math::bigfloat::$cmd x\""
}
unset cmd

# -------------------------------------------------------------------------
# pi, rad2deg, deg2rad
# -------------------------------------------------------------------------

test bigfloat-api-8.1 "pi: number of digits" -body {
    bf {list [tostr [pi 10]] [tostr [pi 20]]}
} -result {3.141592654 3.1415926535897932385}

test bigfloat-api-8.2 "pi: not an integer" -body {
    bf {pi abc}
} -returnCodes error -result {'abc' expected to be an integer}

# n must be a positive integer; a negative value is accepted and breaks the
# cached value of Pi used by the trigonometric functions.
test bigfloat-api-8.3 "pi: negative number of digits" -constraints knownBug -body {
    bf {list [catch {pi -1}] [tostr [tan [fromstr 1.000000000]]]}
} -cleanup {
    ::math::bigfloat::reset
} -result {1 1.5574077}

test bigfloat-api-8.4 "pi: wrong # args" -body {
    ::math::bigfloat::pi
} -returnCodes error -result {wrong # args: should be "::math::bigfloat::pi precision ?binary?"}

test bigfloat-api-8.5 "rad2deg, deg2rad: conversions" -body {
    bf {list [tostr [rad2deg [pi 10]]] [tostr [deg2rad [fromstr 180.0000000000]]] \
	    [tostr [deg2rad [fromstr 90.0000000000]]]}
} -result {180.0000000 3.14159265359 1.5707963268}

test bigfloat-api-8.6 "rad2deg, deg2rad: integer argument" -body {
    bf {list [catch {rad2deg 1} m1] $m1 [catch {deg2rad 1} m2] $m2}
} -cleanup {
    unset -nocomplain m1 m2
} -result {1 {BigFloat expected} 1 {BigFloat expected}}

test bigfloat-api-8.7 "rad2deg: wrong # args" -body {
    ::math::bigfloat::rad2deg
} -returnCodes error -result {wrong # args: should be "::math::bigfloat::rad2deg x"}

test bigfloat-api-8.8 "deg2rad: wrong # args" -body {
    ::math::bigfloat::deg2rad
} -returnCodes error -result {wrong # args: should be "::math::bigfloat::deg2rad x"}

# -------------------------------------------------------------------------
# Rounding
# -------------------------------------------------------------------------

test bigfloat-api-9.1 "round, ceil, floor: positive numbers" -body {
    bf {list [round [fromstr 2.4000]] [round [fromstr 2.6000]] \
	    [ceil [fromstr 2.1000]] [ceil [fromstr 2.0000]] [floor [fromstr 2.9000]]}
} -result {2 3 3 2 2}

test bigfloat-api-9.2 "round, ceil, floor: negative numbers" -body {
    bf {list [round [fromstr -2.6000]] [ceil [fromstr -2.5000]] [floor [fromstr -2.5000]]}
} -result {-3 -2 -3}

test bigfloat-api-9.3 "round, ceil, floor: results are integers" -body {
    bf {list [isInt [round [fromstr 2.4000]]] [isInt [ceil [fromstr 2.4000]]] [isInt [floor [fromstr 2.4000]]]}
} -result {1 1 1}

test bigfloat-api-9.4 "round: integer argument" -body {
    bf {round 3}
} -returnCodes error -result {BigFloat expected}

foreach cmd {round ceil floor} {
    test bigfloat-api-9.5.$cmd "$cmd: wrong # args" -body {
	::math::bigfloat::$cmd
    } -returnCodes error -result "wrong # args: should be \"::math::bigfloat::$cmd number\""
}
unset cmd

# -------------------------------------------------------------------------

namespace delete ::bftest
rename bf {}

# End of test cases
testsuiteCleanup
