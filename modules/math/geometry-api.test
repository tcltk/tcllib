test geometry-api-4.1 {unitVector: from a line} -body {
    ::math::geometry::unitVector {10 10 15 15}
} -match tolerant -result {0.7071067811865476 0.7071067811865476}

test geometry-api-4.2 {unitVector: single point means line through origin} -body {
    ::math::geometry::unitVector {10 10}
} -match tolerant -result {0.7071067811865476 0.7071067811865476}

test geometry-api-4.3 {unitVector: vertical line} -body {
    ::math::geometry::unitVector {0 0 0 5}
} -match tolerant -result {0 1}

test geometry-api-4.4 {unitVector: pointing west} -body {
