} -match tolerant -result {-1 0}

test geometry-api-4.5 {unitVector: result has length 1} -body {
    ::math::geometry::length [::math::geometry::unitVector {1 2 4 6}]
} -match tolerant -result 1.0

test geometry-api-4.6 {unitVector: wrong # args} -body {
    ::math::geometry::unitVector
} -returnCodes error -result {wrong # args: should be "::math::geometry::unitVector line"}

# -------------------------------------------------------------------------
# lengthOfPolyline
# -------------------------------------------------------------------------

test geometry-api-5.1 {lengthOfPolyline: example from the code} -body {
    ::math::geometry::lengthOfPolyline {0 0 5 0 5 10}
} -match tolerant -result 15.0

test geometry-api-5.2 {lengthOfPolyline: single segment} -body {
    ::math::geometry::lengthOfPolyline {0 0 3 4}
} -match tolerant -result 5.0

test geometry-api-5.3 {lengthOfPolyline: closed polyline is not treated as polygon} -body {
    # The square is not closed automatically: 3 sides only
    ::math::geometry::lengthOfPolyline {0 0 1 0 1 1 0 1}
} -match tolerant -result 3.0

test geometry-api-5.4 {lengthOfPolyline: single point} -body {
    ::math::geometry::lengthOfPolyline {1 1}
} -match tolerant -result 0

test geometry-api-5.5 {lengthOfPolyline: wrong # args} -body {
    ::math::geometry::lengthOfPolyline
} -returnCodes error -result {wrong # args: should be "::math::geometry::lengthOfPolyline polyline"}

