# -*- tcl -*-
# geometry-api.test --
#    Additional tests for the math::geometry package: documented commands
#    not covered by geometry.test, plus edge and error cases.
#
# Copyright (c) 2026 by Serhiy Storchaka
# All rights reserved.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.1

support {
    useLocal math.tcl math
}
testing {
    useLocal geometry.tcl math::geometry
}

# -------------------------------------------------------------------------

# Tolerant comparison: nested lists are flattened, numbers are compared
# with a relative/absolute tolerance of 1e-9, other words exactly.
proc geomApiFlatten {list} {
    set result {}
    foreach e $list {
	if {[llength $e] > 1} {
	    lappend result {*}[geomApiFlatten $e]
	} else {
	    lappend result $e
	}
    }
    return $result
}
proc geomApiMatch {expected actual} {
    set expected [geomApiFlatten $expected]
    set actual   [geomApiFlatten $actual]
    if {[llength $expected] != [llength $actual]} {
	return 0
    }
    foreach e $expected a $actual {
	if {[string is double -strict $e] && [string is double -strict $a]} {
	    if {abs($e - $a) > 1.0e-9 * max(1.0, abs($e))} {
		return 0
	    }
	} elseif {$e ne $a} {
	    return 0
	}
    }
    return 1
}
customMatch tolerant geomApiMatch

# -------------------------------------------------------------------------
# Point and vector constructors / arithmetic (only lightly covered before)
# -------------------------------------------------------------------------

test geometry-api-1.1 {p: construct a point} -body {
    ::math::geometry::p 1 2
} -result {1 2}

test geometry-api-1.2 {+: sum of two vectors} -body {
    ::math::geometry::+ {1 2} {3 -4}
} -match tolerant -result {4 -2}

test geometry-api-1.3 {-: difference of two vectors} -body {
    ::math::geometry::- {1 2} {3 -4}
} -match tolerant -result {-2 6}

test geometry-api-1.4 {s*: scale a vector} -body {
    ::math::geometry::s* 2.5 {2 -4}
} -match tolerant -result {5.0 -10.0}

test geometry-api-1.5 {length of a vector} -body {
    ::math::geometry::length {3 4}
} -match tolerant -result 5.0

test geometry-api-1.6 {length of the null vector} -body {
    ::math::geometry::length {0 0}
} -match tolerant -result 0.0

test geometry-api-1.7 {distance equals length of difference} -body {
    list [::math::geometry::distance {1 1} {4 5}] \
	[::math::geometry::length [::math::geometry::- {1 1} {4 5}]]
} -match tolerant -result {5.0 5.0}

test geometry-api-1.8 {h: horizontal vector} -body {
    list [::math::geometry::h 3] [::math::geometry::h -2]
} -match tolerant -result {{3 0} {-2 0}}

test geometry-api-1.9 {v: vertical vector} -body {
    list [::math::geometry::v 3] [::math::geometry::v -2]
} -match tolerant -result {{0 3} {0 -2}}

test geometry-api-1.10 {between: s=0 returns point1, s=1 returns point2} -body {
    list [::math::geometry::between {1 2} {5 10} 0] \
	[::math::geometry::between {1 2} {5 10} 1]
} -match tolerant -result {{1 2} {5 10}}

test geometry-api-1.11 {between: extrapolation beyond the points} -body {
    list [::math::geometry::between {0 0} {10 10} 2] \
	[::math::geometry::between {0 0} {10 10} -0.5]
} -match tolerant -result {{20 20} {-5 -5}}

test geometry-api-1.12 {direction: unit vectors for main angles} -body {
    list [::math::geometry::direction 0] [::math::geometry::direction 90] \
	[::math::geometry::direction 180] [::math::geometry::direction 270]
} -match tolerant -result {{1 0} {0 1} {-1 0} {0 -1}}

# -------------------------------------------------------------------------
# rect / nwse
# -------------------------------------------------------------------------

test geometry-api-2.1 {rect: construct from NW and SE corners} -body {
    ::math::geometry::rect {1 2} {3 4}
} -result {1 2 3 4}

test geometry-api-2.2 {nwse: extract corners} -body {
    ::math::geometry::nwse {1 2 3 4}
} -result {{1 2} {3 4}}

test geometry-api-2.3 {nwse is the inverse of rect} -body {
    ::math::geometry::nwse [::math::geometry::rect {0 10} {5 -1}]
} -result {{0 10} {5 -1}}

test geometry-api-2.4 {rect: wrong # args} -body {
    ::math::geometry::rect {1 2}
} -returnCodes error -result {wrong # args: should be "::math::geometry::rect pa pb"}

test geometry-api-2.5 {nwse: wrong # args} -body {
    ::math::geometry::nwse
} -returnCodes error -result {wrong # args: should be "::math::geometry::nwse rect"}

# -------------------------------------------------------------------------
# inproduct / angleBetween / areaParallellogram
# -------------------------------------------------------------------------

test geometry-api-3.1 {inproduct: 2D vectors} -body {
    ::math::geometry::inproduct {1 2} {3 4}
} -match tolerant -result 11.0

test geometry-api-3.2 {inproduct: orthogonal vectors} -body {
    ::math::geometry::inproduct {1 0} {0 5}
} -match tolerant -result 0.0

test geometry-api-3.3 {inproduct: 3D vectors} -body {
    ::math::geometry::inproduct {1 2 3} {4 5 6}
} -match tolerant -result 32.0

test geometry-api-3.4 {inproduct: wrong # args} -body {
    ::math::geometry::inproduct {1 2}
} -returnCodes error -result {wrong # args: should be "::math::geometry::inproduct vector1 vector2"}

test geometry-api-3.5 {angleBetween: perpendicular vectors} -body {
    ::math::geometry::angleBetween {1 0} {0 1}
} -match tolerant -result 90.0

test geometry-api-3.6 {angleBetween: 45 degrees} -body {
    ::math::geometry::angleBetween {1 0} {1 1}
} -match tolerant -result 45.0

test geometry-api-3.7 {angleBetween: opposite vectors} -body {
    ::math::geometry::angleBetween {1 0} {-1 0}
} -match tolerant -result 180.0

test geometry-api-3.8 {angleBetween: same direction, different lengths} -body {
    ::math::geometry::angleBetween {2 2} {5 5}
} -match tolerant -result 0.0

test geometry-api-3.9 {angleBetween: 3D vectors} -body {
    ::math::geometry::angleBetween {1 0 0} {0 0 1}
} -match tolerant -result 90.0

test geometry-api-3.10 {angleBetween: wrong # args} -body {
    ::math::geometry::angleBetween {1 0}
} -returnCodes error -result {wrong # args: should be "::math::geometry::angleBetween vector1 vector2"}

# areaParallellogram has a syntax error in its expression (unbalanced
# parenthesis), so it fails for every input.
test geometry-api-3.11 {areaParallellogram: rectangle} -constraints knownBug -body {
    ::math::geometry::areaParallellogram {2 0} {0 3}
} -match tolerant -result 6.0

test geometry-api-3.12 {areaParallellogram: order of vectors does not matter} -constraints knownBug -body {
    list [::math::geometry::areaParallellogram {1 2} {3 1}] \
	[::math::geometry::areaParallellogram {3 1} {1 2}]
} -match tolerant -result {5.0 5.0}

test geometry-api-3.13 {areaParallellogram: parallel vectors} -constraints knownBug -body {
    ::math::geometry::areaParallellogram {1 1} {2 2}
} -match tolerant -result 0.0

test geometry-api-3.14 {areaParallellogram: wrong # args} -body {
    ::math::geometry::areaParallellogram {1 1}
} -returnCodes error -result {wrong # args: should be "::math::geometry::areaParallellogram vector1 vector2"}

# -------------------------------------------------------------------------
