# -*- tcl -*-
# quasirandom-api.test --
#     Additional API tests for the math::quasirandom package:
#     documented names (qrpoint, set-start), options of the constructor
#     and of the integral method, the volumes of the circle, disk,
#     sphere and ball, edge cases and error cases.
#     Complements quasirandom.test.
#

source [file join \
	    [file dirname [file dirname [file join [pwd] [info script]]]] \
	    devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.1

testing {
    useLocal  quasirandom.tcl math::quasirandom
}

# -------------------------------------------------------------------------

proc qrApiMatch {expected actual} {
    if {[llength $expected] != [llength $actual]} {
        return 0
    }
    foreach e $expected a $actual {
        if {![string is double -strict $a]} {
            return 0
        }
        if {abs($a - $e) > 1.0e-7 * max(1.0, abs($e))} {
            return 0
        }
    }
    return 1
}
::tcltest::customMatch tolerant qrApiMatch

proc qrApiConst {coords} {
    return 1.0
}

proc qrApiX {coords} {
    return [lindex $coords 0]
}

set pi [expr {acos(-1.0)}]

# -------------------------------------------------------------------------
# Creating generators

# The manual page documents the class as "qrpoint", the package
# provides "qrpoints".
test quasirandom-api-1.1 {qrpoint create, name as documented} -constraints {
    knownBug
} -body {
    ::math::quasirandom::qrpoint create gen 2
} -cleanup {
    catch {gen destroy}
} -result ::gen

test quasirandom-api-1.2 {qrpoints create returns the name} -body {
    ::math::quasirandom::qrpoints create gen 2
} -cleanup {
    gen destroy
} -result ::gen

test quasirandom-api-1.3 {qrpoints new generates a unique name} -body {
    set g1 [::math::quasirandom::qrpoints new 3]
    set g2 [::math::quasirandom::qrpoints new 3]
    list [expr {$g1 ne $g2}] [llength [$g1 next]]
} -cleanup {
    $g1 destroy
    $g2 destroy
    unset g1 g2
} -result {1 3}

test quasirandom-api-1.4 {dimension zero} -body {
    ::math::quasirandom::qrpoints create gen 0
} -returnCodes error -result {The dimension argument should be a positive integer value or one of circle, disk, sphere or ball}

test quasirandom-api-1.5 {dimension not an integer} -body {
    ::math::quasirandom::qrpoints create gen 1.5
} -returnCodes error -result {The dimension argument should be a positive integer value or one of circle, disk, sphere or ball}

test quasirandom-api-1.6 {unknown kind of space} -body {
    ::math::quasirandom::qrpoints create gen cube
} -returnCodes error -result {The dimension argument should be a positive integer value or one of circle, disk, sphere or ball}

test quasirandom-api-1.7 {unknown option} -body {
    ::math::quasirandom::qrpoints create gen 2 -foo 1
} -returnCodes error -result {Unknown option: -foo -- value: 1}

test quasirandom-api-1.8 {option -evaluations} -constraints {
    knownBug
} -body {
    ::math::quasirandom::qrpoints create gen 2 -evaluations 20
    gen set-evaluations
} -cleanup {
    catch {gen destroy}
} -result 20

test quasirandom-api-1.9 {option -evaluations, bad value} -constraints {
    knownBug
} -body {
    ::math::quasirandom::qrpoints create gen 2 -evaluations 0
} -cleanup {
    catch {gen destroy}
} -returnCodes error -result {The value for the option -evaluations should be a positive integer value}

test quasirandom-api-1.10 {option -start} -body {
    ::math::quasirandom::qrpoints create gen  2
    ::math::quasirandom::qrpoints create gen5 2 -start 5
    gen next; gen next; gen next; gen next
    expr {[gen next] eq [gen5 next]}
} -cleanup {
    gen destroy
    gen5 destroy
} -result 1

test quasirandom-api-1.11 {option -start, bad value} -constraints {
    knownBug
} -body {
    ::math::quasirandom::qrpoints create gen 2 -start x
} -cleanup {
    catch {gen destroy}
} -returnCodes error -result {The value for the option -start should be an integer value}

# -------------------------------------------------------------------------
# next

test quasirandom-api-2.1 {next, one dimension: golden ratio sequence} -setup {
    ::math::quasirandom::qrpoints create gen 1
} -body {
    list [gen next] [gen next] [gen next]
} -cleanup {
    gen destroy
} -match tolerant -result [list [expr {fmod(1/((1+sqrt(5))/2),1)}] \
                               [expr {fmod(2/((1+sqrt(5))/2),1)}] \
                               [expr {fmod(3/((1+sqrt(5))/2),1)}]]

test quasirandom-api-2.2 {next, points differ} -setup {
    ::math::quasirandom::qrpoints create gen 4
} -body {
    set pts {}
    for {set i 0} {$i < 50} {incr i} {
        lappend pts [gen next]
    }
    llength [lsort -unique $pts]
} -cleanup {
    gen destroy
    unset pts i
} -result 50

# -------------------------------------------------------------------------
# set-start (documented) / set-step (implemented)

test quasirandom-api-3.1 {set-start, name as documented} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    list [gen set-start 10] [gen set-start]
} -cleanup {
    gen destroy
} -result {10 10}

test quasirandom-api-3.2 {set-step controls the next point} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    set first [gen next]
    gen next
    gen next
    gen set-step 1
    expr {[gen next] eq $first}
} -cleanup {
    gen destroy
    unset first
} -result 1

test quasirandom-api-3.3 {set-step, default is 1, advanced by next} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    set r [gen set-step]
    gen next
    gen next
    lappend r [gen set-step]
} -cleanup {
    gen destroy
    unset r
} -result {1 3}

test quasirandom-api-3.4 {set-step 0 gives the origin} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen set-step 0
    gen next
} -cleanup {
    gen destroy
} -match tolerant -result {0.0 0.0}

test quasirandom-api-3.5 {set-step, bad value} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen set-step x
} -cleanup {
    gen destroy
} -returnCodes error -match glob -result {*should be an integer value}

# -------------------------------------------------------------------------
# set-evaluations

test quasirandom-api-4.1 {set-evaluations, rounded up to a multiple of 4} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    list [gen set-evaluations 1] [gen set-evaluations 5] [gen set-evaluations 8] \
         [gen set-evaluations 101] [gen set-evaluations]
} -cleanup {
    gen destroy
} -result {4 8 8 104 104}

test quasirandom-api-4.2 {set-evaluations, default is 100} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen set-evaluations
} -cleanup {
    gen destroy
} -result 100

test quasirandom-api-4.3 {set-evaluations, bad value} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen set-evaluations 0
} -cleanup {
    gen destroy
} -returnCodes error -match glob -result {*should be a positive integer value}

test quasirandom-api-4.4 {set-evaluations determines the points used by integral} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen set-evaluations 12
    gen integral qrApiConst {{0 1} {0 1}}
    gen set-step
} -cleanup {
    gen destroy
} -result 13

# -------------------------------------------------------------------------
# integral

test quasirandom-api-5.1 {integral -evaluations is local to the call} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    set v [gen integral qrApiConst {{0 2} {0 3}} -evaluations 7]
    list $v [gen set-step] [gen set-evaluations]
} -cleanup {
    gen destroy
    unset v
} -match tolerant -result {6.0 8 100}

test quasirandom-api-5.2 {integral, linear function over a block, 1 percent} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    # Integral of x over [1,3]x[0,2] = 8
    set v [gen integral qrApiX {{1 3} {0 2}} -evaluations 1000]
    expr {abs($v - 8.0) < 0.08}
} -cleanup {
    gen destroy
    unset v
} -result 1

test quasirandom-api-5.4 {integral, wrong number of ranges} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen integral qrApiConst {{0 1}}
} -cleanup {
    gen destroy
} -returnCodes error -result {The number of ranges (minmax) should be equal to the dimension (2)}

test quasirandom-api-5.5 {integral, unknown option} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen integral qrApiConst {{0 1} {0 1}} -foo 1
} -cleanup {
    gen destroy
} -returnCodes error -result {Unknown option: -foo -- value: 1}

test quasirandom-api-5.6 {integral, bad -evaluations} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen integral qrApiConst {{0 1} {0 1}} -evaluations 0
} -cleanup {
    gen destroy
} -returnCodes error -result {The value for the option -evaluations should be a positive integer value}

test quasirandom-api-5.7 {integral over a circle: radius expected} -setup {
    ::math::quasirandom::qrpoints create gen circle
} -body {
    gen integral qrApiConst {{0 1}}
} -cleanup {
    gen destroy
} -returnCodes error -result {For a circle, disk, sphere or ball only the radius should be given}

test quasirandom-api-5.8 {integral, wrong # args} -setup {
    ::math::quasirandom::qrpoints create gen 2
} -body {
    gen integral qrApiConst
} -cleanup {
    gen destroy
} -returnCodes error -result {wrong # args: should be "gen integral func minmax ?arg ...?"}

test quasirandom-api-5.9 {integral, function in the caller's namespace} -setup {
    namespace eval ::qrApiNs {
        proc two {coords} {return 2.0}
    }
    ::math::quasirandom::qrpoints create gen 1
} -body {
    namespace eval ::qrApiNs {gen integral two {{0 5}}}
} -cleanup {
    gen destroy
    namespace delete ::qrApiNs
} -match tolerant -result 10.0

# The length of the unit circle, the area of the unit disk, of the unit
# sphere and the volume of the unit ball: the code uses cos(-1.0)
# instead of acos(-1.0) for pi.

test quasirandom-api-6.1 {integral of 1 over the circle is 2 pi r} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen circle
} -body {
    gen integral qrApiConst 2.0
} -cleanup {
    gen destroy
} -match tolerant -result [expr {4.0 * $pi}]

test quasirandom-api-6.2 {integral of 1 over the disk is pi r**2} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen disk
} -body {
    gen integral qrApiConst 2.0
} -cleanup {
    gen destroy
} -match tolerant -result [expr {4.0 * $pi}]

test quasirandom-api-6.3 {integral of 1 over the sphere is 4 pi r**2} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen sphere
} -body {
    gen integral qrApiConst 2.0
} -cleanup {
    gen destroy
} -match tolerant -result [expr {16.0 * $pi}]

test quasirandom-api-6.4 {integral of 1 over the ball is 4/3 pi r**3} -constraints {
    knownBug
} -setup {
    ::math::quasirandom::qrpoints create gen ball
} -body {
    gen integral qrApiConst 2.0
} -cleanup {
    gen destroy
} -match tolerant -result [expr {32.0 / 3.0 * $pi}]

test quasirandom-api-6.5 {points on the circle, the sphere} -setup {
    ::math::quasirandom::qrpoints create gc circle
    ::math::quasirandom::qrpoints create gs sphere
} -body {
    set bad 0
    for {set i 0} {$i < 50} {incr i} {
        lassign [gc next] x y
        if {abs(hypot($x, $y) - 1.0) > 1.0e-9} {incr bad}
        lassign [gs next] x y z
        if {abs(sqrt($x**2 + $y**2 + $z**2) - 1.0) > 1.0e-9} {incr bad}
    }
    set bad
} -cleanup {
    gc destroy
    gs destroy
    unset bad i x y z
} -result 0

# -------------------------------------------------------------------------

rename qrApiMatch {}
rename qrApiConst {}
rename qrApiX {}
unset -nocomplain pi

testsuiteCleanup
