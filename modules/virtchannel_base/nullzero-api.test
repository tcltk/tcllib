# -*- tcl -*-
# nullzero-api.test:  Tests for the documented API of package tcl::chan::nullzero
# (supplements the existing tests, if any).
#- - -- --- ----- -------- ------------- ---------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0
testsNeed        TclOO 1

support {
    use virtchannel_core/core.tcl   tcl::chan::core
    use virtchannel_core/events.tcl tcl::chan::events
}
testing {
    useLocal nullzero.tcl tcl::chan::nullzero
}

#- - -- --- ----- -------- ------------- ---------------------

test tcl-chan-nullzero-api-1.0 {constructor, wrong # args} -body {
    tcl::chan::nullzero X
} -returnCodes error -result {wrong # args: should be "tcl::chan::nullzero"}

test tcl-chan-nullzero-api-1.1 {close removes the channel and its handler} -body {
    set c [tcl::chan::nullzero]
    set during [llength [info class instances ::tcl::chan::nullzero::implementation]]
    close $c
    list $during [expr {$c in [file channels]}] \
	[info class instances ::tcl::chan::nullzero::implementation]
} -cleanup {
    unset c during
} -result {1 0 {}}

test tcl-chan-nullzero-api-2.0 {reading returns null characters} -setup {
    set c [tcl::chan::nullzero]
    fconfigure $c -translation binary
} -body {
    binary encode hex [read $c 4]
} -cleanup {
    close $c
    unset c
} -result 00000000

test tcl-chan-nullzero-api-2.1 {written data is forgotten, reading still gives nulls} -setup {
    set c [tcl::chan::nullzero]
    fconfigure $c -translation binary
} -body {
    puts -nonewline $c "abc"
    flush $c
    list [binary encode hex [read $c 3]] [eof $c]
} -cleanup {
    close $c
    unset c
} -result {000000 0}

test tcl-chan-nullzero-api-2.2 {large read} -setup {
    set c [tcl::chan::nullzero]
    fconfigure $c -translation binary
} -body {
    set d [read $c 70000]
    list [string length $d] [string length [string map [list \0 {}] $d]]
} -cleanup {
    close $c
    unset c d
} -result {70000 0}

test tcl-chan-nullzero-api-2.3 {not seekable} -setup {
    set c [tcl::chan::nullzero]
} -body {
    list [tell $c] [catch {seek $c 0} msg] $msg
} -cleanup {
    close $c
    unset c msg
} -match glob -result {-1 1 {error during seek on "*": invalid argument}}

test tcl-chan-nullzero-api-3.0 {readable and writable events} -setup {
    set c [tcl::chan::nullzero]
    fconfigure $c -translation binary
    set ::result {}
} -body {
    fileevent $c readable {
	fileevent $c readable {}
	lappend ::result r[string length [read $c 1]]
	if {[llength $::result] == 2} {set ::done 1}
    }
    fileevent $c writable {
	fileevent $c writable {}
	lappend ::result w
	if {[llength $::result] == 2} {set ::done 1}
    }
    set id [after 5000 {set ::done timeout}]
    vwait ::done
    after cancel $id
    lsort $::result
} -cleanup {
    close $c
    unset c id ::result ::done
} -result {r1 w}

#- - -- --- ----- -------- ------------- ---------------------
rename tcl::chan::events {}
rename tcl::chan::core   {}
testsuiteCleanup
return
