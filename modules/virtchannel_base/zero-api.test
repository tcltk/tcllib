# -*- tcl -*-
# zero-api.test:  Tests for the documented API of package tcl::chan::zero
# (supplements the existing tests, if any).
#- - -- --- ----- -------- ------------- ---------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0
testsNeed        TclOO 1

support {
    use virtchannel_core/core.tcl   tcl::chan::core
    use virtchannel_core/events.tcl tcl::chan::events
}
testing {
    useLocal zero.tcl tcl::chan::zero
}

#- - -- --- ----- -------- ------------- ---------------------

test tcl-chan-zero-api-1.0 {constructor, wrong # args} -body {
    tcl::chan::zero X
} -returnCodes error -result {wrong # args: should be "tcl::chan::zero"}

test tcl-chan-zero-api-1.1 {close removes the channel and its handler} -body {
    set c [tcl::chan::zero]
    set during [llength [info class instances ::tcl::chan::zero::implementation]]
    close $c
    list $during [expr {$c in [file channels]}] \
	[info class instances ::tcl::chan::zero::implementation]
} -cleanup {
    unset c during
} -result {1 0 {}}

test tcl-chan-zero-api-2.0 {reading returns null characters} -setup {
    set c [tcl::chan::zero]
    fconfigure $c -translation binary
} -body {
    binary encode hex [read $c 5]
} -cleanup {
    close $c
    unset c
} -result 0000000000

test tcl-chan-zero-api-2.1 {infinite stream, never eof} -setup {
    set c [tcl::chan::zero]
    fconfigure $c -translation binary
} -body {
    set d [read $c 100000]
    list [string length $d] [string length [string map [list \0 {}] $d]] [eof $c]
} -cleanup {
    close $c
    unset c d
} -result {100000 0 0}

test tcl-chan-zero-api-2.3 {read-only: writing is an error} -setup {
    set c [tcl::chan::zero]
} -body {
    puts $c x
} -cleanup {
    close $c
    unset c
} -returnCodes error -match glob -result {channel "*" wasn't opened for writing}

test tcl-chan-zero-api-2.4 {not seekable} -setup {
    set c [tcl::chan::zero]
} -body {
    list [tell $c] [catch {seek $c 0} msg] $msg
} -cleanup {
    close $c
    unset c msg
} -match glob -result {-1 1 {error during seek on "*": invalid argument}}

test tcl-chan-zero-api-3.0 {always readable} -setup {
    set c [tcl::chan::zero]
    fconfigure $c -translation binary
    set ::result {}
} -body {
    fileevent $c readable {
	lappend ::result [binary encode hex [read $c 2]]
	if {[llength $::result] >= 3} {fileevent $c readable {}; set ::done 1}
    }
    set id [after 5000 {set ::done timeout}]
    vwait ::done
    after cancel $id
    set ::result
} -cleanup {
    close $c
    unset c id ::result ::done
} -result {0000 0000 0000}

#- - -- --- ----- -------- ------------- ---------------------
rename tcl::chan::events {}
rename tcl::chan::core   {}
testsuiteCleanup
return
