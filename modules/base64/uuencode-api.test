# -*- tcl -*-
# uuencode-api.test: tests for the documented API of the uuencode
# package, complementing uuencode.test.
#
# This testsuite is in the public domain.
# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useTcllibC
    useLocalKeep uuencode.tcl uuencode
}

# -------------------------------------------------------------------------

proc allbytes {} {
    set data {}
    for {set i 0} {$i < 256} {incr i} {append data [format %c $i]}
    return $data
}

proc writebinary {name data} {
    set path [file join [tcltest::temporaryDirectory] $name]
    set f [open $path wb]
    puts -nonewline $f $data
    close $f
    return $path
}

set utf8line "Δ÷ “Utf-8” ♞ℤ"

# -------------------------------------------------------------------------
# ::uuencode::encode / ::uuencode::decode

test uuencode-api-1.0 {encode, empty string} -body {
    ::uuencode::encode {}
} -result {}

test uuencode-api-1.1 {decode, empty string} -body {
    ::uuencode::decode {}
} -result {}

test uuencode-api-1.2 {encode, input padded with NUL to a multiple of 3} -body {
    list [::uuencode::encode a] [::uuencode::encode ab]
} -result {80`` 86(`}

test uuencode-api-1.3 {decode, result includes the NUL padding} -body {
    list [::uuencode::decode 80``] [::uuencode::decode 86(`]
} -result [list a\0\0 ab\0]

test uuencode-api-1.4 {encode, more than one line of data is not split} -body {
    string length [::uuencode::encode [string repeat x 90]]
} -result 120

test uuencode-api-1.5 {encode, error on non-binary string} -constraints {
    tcl9plus
} -body {
    ::uuencode::encode Ā
} -returnCodes error -match glob -result {expected code point values below 0xff*}

# The documentation promises an error for strings which are neither
# binary nor 7-bit ASCII. On Tcl 8 the characters are silently
# truncated to their low byte instead.
test uuencode-api-1.6 {encode, error on non-binary string, Tcl 8} -constraints {
    tcl8.6only knownBug
} -body {
    ::uuencode::encode Ā
} -returnCodes error -match glob -result *

test uuencode-api-1.7 {round trip of all byte values} -body {
    string equal [allbytes]\0\0 [::uuencode::decode [::uuencode::encode [allbytes]]]
} -result 1

test uuencode-api-1.8 {manpage example, UTF-8 text} -body {
    set bytes [encoding convertto utf-8 $utf8line]
    set encuu [::uuencode::encode $bytes]
    set decuu [string trimright [::uuencode::decode $encuu] \x00]
    list $encuu [string equal $utf8line [encoding convertfrom utf-8 $decuu]]
} -cleanup {
    unset -nocomplain bytes encuu decuu
} -result [list {SI3#MR#B@)Q5=&8M..*`G2#BF9[BA*0`} 1]

test uuencode-api-1.9 {manpage example, 7-bit ASCII text} -body {
    set encuu [::uuencode::encode "! 7-bit ASCII {~^}"]
    set decuu [string trimright [::uuencode::decode $encuu] \x00]
    list $encuu $decuu
} -cleanup {
    unset -nocomplain encuu decuu
} -result [list {(2`W+6)I="!!4T-)22![?EY]} {! 7-bit ASCII {~^}}]

# -------------------------------------------------------------------------
# ::uuencode::uuencode

test uuencode-api-2.0 {uuencode, no arguments} -body {
    ::uuencode::uuencode
} -returnCodes error -result {wrong # args: should be "uuencode ?-name string? ?-mode octal? (-file filename | ?--? string)"}

test uuencode-api-2.1 {uuencode, too many arguments} -body {
    ::uuencode::uuencode a b
} -returnCodes error -result {wrong # args: should be "uuencode ?-name string? ?-mode octal? (-file filename | ?--? string)"}

test uuencode-api-2.2 {uuencode, empty data} -body {
    ::uuencode::uuencode {}
} -result "begin 644 data.dat\n`\nend"

test uuencode-api-2.3 {uuencode, -name} -body {
    ::uuencode::uuencode -name test.uu abc
} -result "begin 644 test.uu\n#86)C\n`\nend"

test uuencode-api-2.4 {uuencode, -mode with 0o prefix} -body {
    ::uuencode::uuencode -mode 0o755 abc
} -result "begin 755 data.dat\n#86)C\n`\nend"

test uuencode-api-2.5 {uuencode, -mode 0755, Tcl 8} -constraints {
    tcl8.6only
} -body {
    ::uuencode::uuencode -mode 0755 abc
} -result "begin 755 data.dat\n#86)C\n`\nend"

# "0755" is a decimal number in Tcl 9, so the header gets "1363".
test uuencode-api-2.6 {uuencode, -mode 0755, Tcl 9} -constraints {
    tcl9plus knownBug
} -body {
    ::uuencode::uuencode -mode 0755 abc
} -result "begin 755 data.dat\n#86)C\n`\nend"

test uuencode-api-2.7 {uuencode, -- before data starting with a dash} -body {
    ::uuencode::uuencode -name x -- -abc
} -result "begin 644 x\n\$+6%B8P``\n`\nend"

test uuencode-api-2.8 {uuencode, abbreviated options} -body {
    ::uuencode::uuencode -n x -m 0o600 abc
} -result "begin 600 x\n#86)C\n`\nend"

test uuencode-api-2.9 {uuencode, lines of 45 bytes} -body {
    ::uuencode::uuencode [string repeat x 50]
} -result "begin 644 data.dat
M>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX>'AX
%>'AX>'@`
`
end"

test uuencode-api-2.10 {uuencode, manpage example} -body {
    ::uuencode::uuencode -name test.uu [encoding convertto utf-8 $utf8line]
} -result "begin 644 test.uu
7SI3#MR#B@)Q5=&8M..*`G2#BF9\[BA*0`
`
end"

test uuencode-api-2.11 {uuencode, -file} -setup {
    set path [writebinary uuencode-api.bin [allbytes]]
} -body {
    set enc [::uuencode::uuencode -name all.bin -file $path]
    list [lindex [split $enc \n] 0] [string equal $enc [::uuencode::uuencode -name all.bin [allbytes]]]
} -cleanup {
    file delete $path
    unset -nocomplain path enc
} -result {{begin 644 all.bin} 1}

test uuencode-api-2.12 {uuencode, -file of a missing file} -body {
    ::uuencode::uuencode -file [file join [tcltest::temporaryDirectory] uuencode-api.none]
} -returnCodes error -match glob -result {couldn't open "*uuencode-api.none": no such file or directory}

# -------------------------------------------------------------------------
# ::uuencode::uudecode

test uuencode-api-3.0 {uudecode, no arguments} -body {
    ::uuencode::uudecode
} -returnCodes error -result {wrong # args: should be "uudecode (-file filename | ?--? string)"}

test uuencode-api-3.1 {uudecode, too many arguments} -body {
    ::uuencode::uudecode a b
} -returnCodes error -result {wrong # args: should be "uudecode (-file filename | ?--? string)"}

test uuencode-api-3.2 {uudecode, no begin line} -body {
    ::uuencode::uudecode "some text\nwithout data\n"
} -result {}

test uuencode-api-3.3 {uudecode, several files and surrounding text} -body {
    ::uuencode::uudecode "junk\n[::uuencode::uuencode -name a.txt abcd]\nmore junk\n[::uuencode::uuencode -name b.bin -mode 0o600 xyz]\ntrailer\n"
} -result {{a.txt 644 abcd} {b.bin 600 xyz}}

test uuencode-api-3.4 {uudecode, line length removes the NUL padding} -body {
    ::uuencode::uudecode [::uuencode::uuencode [string repeat x 50]]
} -result [list [list data.dat 644 [string repeat x 50]]]

test uuencode-api-3.5 {uudecode, -- before data} -body {
    ::uuencode::uudecode -- [::uuencode::uuencode -- -abc]
} -result {{data.dat 644 -abc}}

test uuencode-api-3.6 {uudecode, round trip of all byte values} -body {
    set res [::uuencode::uudecode [::uuencode::uuencode -name all.bin [allbytes]]]
    list [llength $res] [lrange [lindex $res 0] 0 1] [string equal [lindex $res 0 2] [allbytes]]
} -cleanup {
    unset -nocomplain res
} -result {1 {all.bin 644} 1}

test uuencode-api-3.7 {uudecode, -file} -setup {
    set path [writebinary uuencode-api.uu [::uuencode::uuencode -name all.bin [allbytes]]]
} -body {
    set res [::uuencode::uudecode -file $path]
    list [llength $res] [lrange [lindex $res 0] 0 1] [string equal [lindex $res 0 2] [allbytes]]
} -cleanup {
    file delete $path
    unset -nocomplain path res
} -result {1 {all.bin 644} 1}

test uuencode-api-3.8 {uudecode, manpage example} -body {
    set res {}
    set data [::uuencode::uuencode -name test.uu [encoding convertto utf-8 $utf8line]]
    foreach lst [::uuencode::uudecode $data] {
	lassign $lst name mode decuu
	set decuu [string trimright $decuu \x00]
	lappend res $name $mode [string equal $utf8line [encoding convertfrom utf-8 $decuu]]
    }
    set res
} -cleanup {
    unset -nocomplain res data lst name mode decuu
} -result {test.uu 644 1}

test uuencode-api-3.9 {uudecode, -file of a missing file} -body {
    ::uuencode::uudecode -file [file join [tcltest::temporaryDirectory] uuencode-api.none]
} -returnCodes error -match glob -result {couldn't open "*uuencode-api.none": no such file or directory}

# -------------------------------------------------------------------------

rename allbytes {}
rename writebinary {}
unset utf8line
testsuiteCleanup
return
