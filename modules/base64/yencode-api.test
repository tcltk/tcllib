# -*- tcl -*-
# yencode-api.test: tests for the documented API of the yencode
# package, complementing yencode.test.
#
# This testsuite is in the public domain.
# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    use crc/crc32.tcl crc32
    useTcllibC
    useLocalKeep yencode.tcl yencode
}

# -------------------------------------------------------------------------

tcltest::testConstraint crc32 [llength [info commands ::crc::crc32]]

proc allbytes {} {
    set data {}
    for {set i 0} {$i < 256} {incr i} {append data [format %c $i]}
    return $data
}

proc writebinary {name data} {
    set path [file join [tcltest::temporaryDirectory] $name]
    set f [open $path wb]
    puts -nonewline $f $data
    close $f
    return $path
}

set utf8line "Δ÷ “Utf-8” ♞ℤ"

# -------------------------------------------------------------------------
# ::yencode::encode / ::yencode::decode

test yencode-api-1.0 {encode, empty string} -body {
    ::yencode::encode {}
} -result {}

test yencode-api-1.1 {decode, empty string} -body {
    ::yencode::decode {}
} -result {}

test yencode-api-1.2 {encode, critical characters are escaped} -body {
    # Bytes which map to NUL, TAB, LF, CR and "=".
    ::yencode::encode \xd6\xdf\xe0\xe3\x13
} -result "=@=I=J=M=\}"

test yencode-api-1.3 {decode, escaped characters} -body {
    ::yencode::decode "=@=I=J=M=\}"
} -result \xd6\xdf\xe0\xe3\x13

test yencode-api-1.4 {round trip of all byte values} -body {
    string equal [allbytes] [::yencode::decode [::yencode::encode [allbytes]]]
} -result 1

test yencode-api-1.5 {encode, error on non-binary string} -constraints {
    tcl9plus
} -body {
    ::yencode::encode Ā
} -returnCodes error -match glob -result {expected code point values below 0xff*}

# The documentation promises an error for strings which are neither
# binary nor 7-bit ASCII. On Tcl 8 the characters are silently
# truncated to their low byte instead.
test yencode-api-1.6 {encode, error on non-binary string, Tcl 8} -constraints {
    tcl8.6only knownBug
} -body {
    ::yencode::encode Ā
} -returnCodes error -match glob -result *

test yencode-api-1.7 {manpage example, UTF-8 text} -body {
    set bytes [encoding convertto utf-8 $utf8line]
    set decy [::yencode::decode [::yencode::encode $bytes]]
    string equal $utf8line [encoding convertfrom utf-8 $decy]
} -cleanup {
    unset -nocomplain bytes decy
} -result 1

test yencode-api-1.8 {manpage example, 7-bit ASCII text} -body {
    ::yencode::decode [::yencode::encode "! 7-bit ASCII {~^}"]
} -result {! 7-bit ASCII {~^}}

# -------------------------------------------------------------------------
# ::yencode::yencode

test yencode-api-2.0 {yencode, no arguments} -body {
    ::yencode::yencode
} -returnCodes error -result {wrong # args: should be "yencode ?options? -file name | data"}

test yencode-api-2.1 {yencode, too many arguments} -body {
    ::yencode::yencode a b
} -returnCodes error -result {wrong # args: should be "yencode ?options? -file name | data"}

test yencode-api-2.2 {yencode, bad option} -body {
    ::yencode::yencode -bogus x
} -returnCodes error -match glob -result {bad option -bogus: must be *}

test yencode-api-2.3 {yencode, bad -crc32 value} -body {
    ::yencode::yencode -crc32 maybe x
} -returnCodes error -result {bad option -crc32: argument must be true or false}

test yencode-api-2.4 {yencode, header, data line and trailer with crc32} -constraints {
    crc32
} -body {
    ::yencode::yencode -name abc.txt abc
} -result "=ybegin line=128 size=3 name=abc.txt\n\x8b\x8c\x8d\r\n=yend size=3 crc32=352441c2"

test yencode-api-2.5 {yencode, -crc32 0 omits the checksum} -body {
    ::yencode::yencode -name abc.txt -crc32 0 abc
} -result "=ybegin line=128 size=3 name=abc.txt\n\x8b\x8c\x8d\r\n=yend size=3"

test yencode-api-2.6 {yencode, -crc32 false omits the checksum} -body {
    ::yencode::yencode -name abc.txt -crc32 false abc
} -result "=ybegin line=128 size=3 name=abc.txt\n\x8b\x8c\x8d\r\n=yend size=3"

test yencode-api-2.7 {yencode, -line} -body {
    ::yencode::yencode -name x -line 4 -crc32 no abcdefghij
} -result "=ybegin line=4 size=10 name=x\n\x8b\x8c\x8d\x8e\r\n\x8f\x90\x91\x92\r\n\x93\x94\r\n=yend size=10"

test yencode-api-2.8 {yencode, empty data} -body {
    ::yencode::yencode -name x -crc32 0 {}
} -result "=ybegin line=128 size=0 name=x\n=yend size=0"

test yencode-api-2.9 {yencode, -- before data starting with a dash} -body {
    ::yencode::yencode -name x -crc32 0 -- -a
} -result "=ybegin line=128 size=2 name=x\nW\x8b\r\n=yend size=2"

test yencode-api-2.10 {yencode, default line length is 128} -body {
    set lines [split [::yencode::yencode -name x -crc32 0 [string repeat a 300]] \n]
    set res {}
    foreach line $lines {lappend res [string length $line]}
    set res
} -cleanup {
    unset -nocomplain lines line res
} -result {32 129 129 45 14}

test yencode-api-2.11 {yencode, manpage example} -constraints {
    crc32
} -body {
    set lines [split [::yencode::yencode -name test.y [encoding convertto utf-8 $utf8line]] \n]
    list [llength $lines] [lindex $lines 0] [lindex $lines end]
} -cleanup {
    unset -nocomplain lines
} -result {3 {=ybegin line=128 size=23 name=test.y} {=yend size=23 crc32=fc01071}}

test yencode-api-2.12 {yencode, -file} -setup {
    set path [writebinary yencode-api.bin [allbytes]]
} -body {
    string equal [::yencode::yencode -name all.bin -crc32 0 -file $path] \
	[::yencode::yencode -name all.bin -crc32 0 [allbytes]]
} -cleanup {
    file delete $path
    unset -nocomplain path
} -result 1

test yencode-api-2.13 {yencode, -file of a missing file} -body {
    ::yencode::yencode -file [file join [tcltest::temporaryDirectory] yencode-api.none]
} -returnCodes error -match glob -result {couldn't open "*yencode-api.none": no such file or directory}

# -------------------------------------------------------------------------
# ::yencode::ydecode

test yencode-api-3.0 {ydecode, no arguments} -body {
    ::yencode::ydecode
} -returnCodes error -result {wrong # args: should be "ydecode ?options? -file name | data"}

test yencode-api-3.1 {ydecode, too many arguments} -body {
    ::yencode::ydecode a b
} -returnCodes error -result {wrong # args: should be "ydecode ?options? -file name | data"}

test yencode-api-3.3 {ydecode, no =ybegin line} -body {
    ::yencode::ydecode "some text\nwithout data\n"
} -result {}

test yencode-api-3.4 {ydecode, size and data} -body {
    set res [::yencode::ydecode [::yencode::yencode -line 4 -crc32 0 abcdefghij]]
    list [llength $res] [lrange [lindex $res 0] 1 end]
} -cleanup {
    unset -nocomplain res
} -result {1 {10 abcdefghij}}

test yencode-api-3.5 {ydecode, several files and surrounding text} -body {
    set res {}
    foreach item [::yencode::ydecode "junk\n[::yencode::yencode -crc32 0 abcd]\nmore\n[::yencode::yencode xyz]\nend\n"] {
	lappend res [lrange $item 1 end]
    }
    set res
} -cleanup {
    unset -nocomplain res item
} -result {{4 abcd} {3 xyz}}

test yencode-api-3.6 {ydecode, round trip of all byte values} -body {
    set res [::yencode::ydecode [::yencode::yencode -crc32 0 [allbytes]]]
    list [llength $res] [lindex $res 0 1] [string equal [lindex $res 0 2] [allbytes]]
} -cleanup {
    unset -nocomplain res
} -result {1 256 1}

test yencode-api-3.7 {ydecode, -- before data} -body {
    lrange [lindex [::yencode::ydecode -- [::yencode::yencode -crc32 0 -- -abc]] 0] 1 end
} -result {4 -abc}

test yencode-api-3.9 {ydecode, numeric name from the header} -body {
    lindex [::yencode::ydecode [::yencode::yencode -name 1234 -crc32 0 abc]] 0 0
} -result 1234

test yencode-api-3.10 {ydecode, default name when there is none} -body {
    lindex [::yencode::ydecode "=ybegin line=128 size=1\n\x8b\r\n=yend size=1"] 0
} -result [list default.bin 1 a]

test yencode-api-3.11 {ydecode, -file} -setup {
    set path [writebinary yencode-api.y [::yencode::yencode -crc32 0 [allbytes]]]
} -body {
    set res [::yencode::ydecode -file $path]
    list [llength $res] [lindex $res 0 1] [string equal [lindex $res 0 2] [allbytes]]
} -cleanup {
    file delete $path
    unset -nocomplain path res
} -result {1 256 1}

test yencode-api-3.12 {ydecode, -file with 7-bit data} -setup {
    set path [writebinary yencode-api.y [::yencode::yencode -crc32 0 "\x16\x37\x38"]]
} -body {
    lrange [lindex [::yencode::ydecode -file $path] 0] 1 end
} -cleanup {
    file delete $path
    unset -nocomplain path
} -result [list 3 "\x16\x37\x38"]

test yencode-api-3.13 {ydecode, -file of a missing file} -body {
    ::yencode::ydecode -file [file join [tcltest::temporaryDirectory] yencode-api.none]
} -returnCodes error -match glob -result {couldn't open "*yencode-api.none": no such file or directory}

test yencode-api-3.14 {ydecode, manpage example} -body {
    set res {}
    foreach lst [::yencode::ydecode [::yencode::yencode -name test.y [encoding convertto utf-8 $utf8line]]] {
	lassign $lst name size decy
	lappend res $size [string equal $utf8line [encoding convertfrom utf-8 $decy]]
    }
    set res
} -cleanup {
    unset -nocomplain res lst name size decy
} -result {23 1}

# -------------------------------------------------------------------------

rename allbytes {}
rename writebinary {}
unset utf8line
testsuiteCleanup
return
