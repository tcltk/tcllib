# -*- tcl -*- Tests for the wip module, shared by wip.test (wip 2,
# wip2.tcl) and wip1.test (wip 1, wip.tcl).
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.

# In wip 1 the unknown handler is invoked without removing the unknown
# word from the program, so a handler which returns normally causes an
# endless loop (fixed in wip 2).  The handlers in the tests below guard
# against this.
if {[package vsatisfies [package present wip] 2]} {
    set wipUnknownBug {}
} else {
    set wipUnknownBug knownBug
}

# -------------------------------------------------------------------------
# A test engine.  Every method records its invocation in the global ::log
# and returns a result derived from its name and arguments.  The engine
# knows the word interpreter through its variable 'wip'.

snit::type ::wiptest::engine {
    variable wip {}
    method setwip {w} { set wip $w }

    method a {}          { lappend ::log a ;            return A }
    method b {x}         { lappend ::log [list b $x] ;   return B$x }
    method c {x y}       { lappend ::log [list c $x $y] ; return C$x$y }
    method v {x args}    { return V }
    method fixed {f x}   { lappend ::log [list fixed $f $x] ; return F$f$x }

    # Methods accessing the word interpreter
    method nextword {}   { lappend ::log nextword ; return [$wip next] }
    method peekword {}   { return [$wip peek] }
    method rest {}       { set r [$wip peekall] ; $wip replace ; return $r }
    method twice {}      {
        # Run the next two commands.
        $wip run_next
        return [$wip run_next]
    }
    method nested {}     { return [$wip run a b 1] }
    method while {}      { return [$wip run_next_while {a b}] }
    method until {}      { return [$wip run_next_until {stop}] }
    method if {}         { return [$wip run_next_if {a}] }
    method ifnot {}      { return [$wip run_next_ifnot {stop}] }
    method stop {}       { lappend ::log stop ; return STOP }
    method fail {}       { error "engine failure" }
}

proc engine {} {
    return [::wiptest::engine %AUTO%]
}

# Create an engine and a word interpreter for it, with the given
# definitions.  The interpreter is ::wiptest::w, the engine ::wiptest::e.
proc setup {args} {
    set e [::wiptest::engine ::wiptest::e]
    ::wip ::wiptest::w $e {*}$args
    $e setwip ::wiptest::w
    set ::log {}
    return
}

proc cleanup {} {
    catch {::wiptest::w destroy}
    catch {::wiptest::e destroy}
    unset -nocomplain ::log
    return
}

# -------------------------------------------------------------------------
# Construction

test wip-1.0 {constructor, no engine} -body {
    ::wip ::wiptest::w {}
} -cleanup {
    cleanup
} -returnCodes error -result {Error in constructor: No engine specified}

test wip-1.1 {constructor, returns the object name} -setup {
    set e [engine]
} -body {
    ::wip ::wiptest::w $e
} -cleanup {
    cleanup
    $e destroy
    unset e
} -result ::wiptest::w

test wip-1.2 {constructor, %AUTO% name} -setup {
    set e [engine]
} -body {
    set w [::wip %AUTO% $e]
    list [string match ::wip* $w] [llength [info commands $w]]
} -cleanup {
    $w destroy
    $e destroy
    unset e w
} -result {1 1}

test wip-1.3 {constructor, no definitions} -setup {
    setup
} -body {
    ::wiptest::w run a
} -cleanup {
    cleanup
} -returnCodes error -result {Unknown command "a"}

test wip-1.4 {constructor, "def name" definitions} -setup {
    setup def a def b
} -body {
    list [::wiptest::w run a b 1] $::log
} -cleanup {
    cleanup
} -result {B1 {a {b 1}}}

test wip-1.5 {constructor, "def name method_prefix" definitions} -setup {
    setup def x a def y {fixed 7} def b
} -body {
    list [::wiptest::w run x y 1 b 2] $::log
} -cleanup {
    cleanup
} -result {B2 {a {fixed 7 1} {b 2}}}

test wip-1.6 {constructor, definition does not start with def} -body {
    setup a
} -cleanup {
    cleanup
} -returnCodes error -result {Error in constructor: Expected "def", got "a"}

test wip-1.7 {constructor, garbage after a complete definition} -body {
    setup def x a b
} -cleanup {
    cleanup
} -returnCodes error -result {Error in constructor: Expected "def", got "b"}

test wip-1.8 {constructor, name missing at end} -body {
    setup def a def
} -cleanup {
    cleanup
} -returnCodes error -result {Error in constructor: Incomplete definition at end, name missing.}

test wip-1.9 {constructor, varargs method} -body {
    setup def v
} -cleanup {
    cleanup
} -returnCodes error -result {Error in constructor: Unable to handle Tcl varargs}

test wip-1.10 {destroy} -setup {
    setup
} -body {
    ::wiptest::w destroy
    info commands ::wiptest::w
} -cleanup {
    cleanup
} -result {}

