# -------------------------------------------------------------------------
# Unknown words

test wip-4.0 {unknown, wrong # args} -setup {
    setup
} -body {
    ::wiptest::w unknown
} -cleanup {
    cleanup
} -returnCodes error -match glob -result {wrong # args: should be "* cmdprefix"}

test wip-4.1 {unknown, handler gets the word and returns the result} -setup {
    setup def a
    proc ::wiptest::unk {prefix word} {
        lappend ::log [list unknown $prefix $word]
        # Guard against endless loops if the word is not consumed.
        if {[llength $::log] > 10} {error "endless loop"}
        return U$word
    }
} -constraints $wipUnknownBug -body {
    list [::wiptest::w unknown {::wiptest::unk P}] \
        [::wiptest::w run a x] [::wiptest::w run y] $::log
} -cleanup {
    cleanup
    rename ::wiptest::unk {}
} -result {{} Ux Uy {a {unknown P x} {unknown P y}}}

test wip-4.2 {unknown, handler can consume more words} -setup {
    setup def a
    proc ::wiptest::unk {word} {
        lappend ::log [list unknown $word [::wiptest::w next]]
        if {[llength $::log] > 10} {error "endless loop"}
        return U
    }
} -constraints $wipUnknownBug -body {
    ::wiptest::w unknown ::wiptest::unk
    list [::wiptest::w run x 1 a] $::log
} -cleanup {
    cleanup
    rename ::wiptest::unk {}
} -result {A {{unknown x 1} a}}

test wip-4.3 {unknown, handler errors propagate} -setup {
    setup
    proc ::wiptest::unk {word} {
        error "bad word $word"
    }
} -body {
    ::wiptest::w unknown ::wiptest::unk
    ::wiptest::w run x
} -cleanup {
    cleanup
    rename ::wiptest::unk {}
} -returnCodes error -result {bad word x}

test wip-4.4 {unknown, handler runs in the global namespace} -setup {
    setup
    proc ::wiptest::unk {word} {
        if {[incr ::count] > 10} {error "endless loop"}
        return [uplevel 1 {namespace current}][info level]
    }
} -constraints $wipUnknownBug -body {
    ::wiptest::w unknown ::wiptest::unk
    ::wiptest::w run x
} -cleanup {
    cleanup
    rename ::wiptest::unk {}
    unset -nocomplain ::count
} -result ::1

