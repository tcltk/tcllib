test wip-5.14 {program changes from a command are executed} -setup {
    setup def a def b
    snit::method ::wiptest::engine pushb {} {
        $wip push b 9
        return P
    }
    snit::method ::wiptest::engine addb {} {
        $wip add b 8
        return Q
    }
    ::wiptest::w defl {pushb addb}
} -body {
    list [::wiptest::w run pushb a addb a] $::log
} -cleanup {
    cleanup
} -result {B8 {{b 9} a a {b 8}}}

test wip-5.15 {accessors with empty word lists} -setup {
    setup
} -body {
    ::wiptest::w replace a
    ::wiptest::w pushl {}
    ::wiptest::w addl {}
    ::wiptest::w insertl 0 {}
    ::wiptest::w push
    ::wiptest::w add
    ::wiptest::w peekall
} -cleanup {
    cleanup
} -result a

# -------------------------------------------------------------------------
# Engines which are not snit objects

test wip-6.1 {engine, any command understanding "info args"} -setup {
    proc ::wiptest::eng {method args} {
        switch -- $method {
            info {
                # info args m
                switch -- [lindex $args 1] {
                    hello {return {who}}
                    bye   {return {}}
                }
            }
            hello { return "hello [lindex $args 0]" }
            bye   { return bye }
        }
    }
    ::wip ::wiptest::w ::wiptest::eng def hello def bye
} -body {
    list [::wiptest::w run hello world] [::wiptest::w run bye hello you]
} -cleanup {
    cleanup
    rename ::wiptest::eng {}
} -result {{hello world} {hello you}}

# -------------------------------------------------------------------------
# wip::dsl

snit::type ::wiptest::dsl0 {
    wip::dsl
    constructor {} {
        $self wip_setup
        def a
        defl {b c}
    }
    method a {}    { return A }
    method b {x}   { return B$x }
    method c {x y} { return C$x$y }
    method go {args} { return [runl $args] }
    method go2 {args} {
        replacel $args
        push b 1
        add c 2 3
        set r [list [peek] [peekall]]
        lappend r [run_next] [next] [next] [peekall]
        return $r
    }
}

snit::type ::wiptest::dsl2 {
    wip::dsl foo
    wip::dsl bar
    constructor {} {
        $self wip_foo_setup
        $self wip_bar_setup
        def_foo x a
        def_bar x b
    }
    method a {}  { return A }
    method b {v} { return B$v }
    method go {args} {
        return [list [runl_foo $args] [run_bar x 1]]
    }
}

test wip-7.1 {wip::dsl, setup and procedures} -setup {
    set o [::wiptest::dsl0 %AUTO%]
} -body {
    $o go a b 1 c 2 3
} -cleanup {
    $o destroy
    unset o
} -result C23

test wip-7.2 {wip::dsl, program accessor procedures} -setup {
    set o [::wiptest::dsl0 %AUTO%]
} -body {
    $o go2 a
} -cleanup {
    $o destroy
    unset o
} -result {b {b 1 a c 2 3} B1 a c {2 3}}

test wip-7.3 {wip::dsl, installed setup method and procedures} -setup {
    set o [::wiptest::dsl0 %AUTO%]
} -body {
    list [lsort [$o info methods wip*]] \
        [lsort [namespace eval ::wiptest::dsl0 {info procs run*}]]
} -cleanup {
    $o destroy
    unset o
} -result {wip_setup {run run_next run_next_if run_next_ifnot run_next_until run_next_while runl}}

test wip-7.4 {wip::dsl, suffixes} -setup {
    set o [::wiptest::dsl2 %AUTO%]
} -body {
    list [$o go x] [lsort [$o info methods wip*]] \
        [lsort [namespace eval ::wiptest::dsl2 {info procs def*}]]
} -cleanup {
    $o destroy
    unset o
} -result {{A B1} {wip_bar_setup wip_foo_setup} {def/_bar def/_foo def_bar def_foo defd_bar defd_foo defdva_bar defdva_foo defl_bar defl_foo deflva_bar deflva_foo}}

# The manpage says that the component is named "wip", or "wip_$suffix"
# with a suffix; it is "mywip" and "mywip_$suffix".
test wip-7.5 {wip::dsl, component name} -setup {
    set o [::wiptest::dsl0 %AUTO%]
} -body {
    llength [lsearch -all -glob [$o info vars] *::wip]
} -cleanup {
    $o destroy
    unset o
} -constraints knownBug -result 1

test wip-7.6 {wip::dsl, actual component name} -setup {
    set o [::wiptest::dsl0 %AUTO%]
} -body {
    llength [lsearch -all -glob [$o info vars] *::mywip]
} -cleanup {
    $o destroy
    unset o
} -result 1

