# -*- tcl -*-
# sha256-api.test:  additional tests for the documented API of sha256.
#
# Complements sha256.test: -bin, -channel, -file/-filename, hmac, the
# incremental programming interface and error cases.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    if {[useTcllibC]} {
        useLocalKeep sha256.tcl sha256 ::sha2
    } else {
        useLocal     sha256.tcl sha256 ::sha2
    }
    TestAccelInit                      ::sha2
}

# -------------------------------------------------------------------------

proc mkdata {} {
    # 10240 bytes, all byte values: more than one read chunk.
    set d {}
    for {set i 0} {$i < 256} {incr i} {append d [format %c $i]}
    string repeat $d 40
}

set datafile [makeFile {} sha256api[pid].data]
set f [open $datafile wb]
puts -nonewline $f [mkdata]
close $f
unset f

# command  length  message  hash-of-message  hash-of-datafile  hash-of-""
set digests {
    sha256 32 "Tcl does SHA256"
    0b91043ee484abd83c3e4b08d6034d71b937026379f0f59bda6e625e6e214789
    e96760a87768717bcebcfd25ddc7d46b4dbc95a4b0014def080c08539f7d90d0
    e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    sha224 28 "Tcl does SHA224"
    cedbe4b18ff91e640cf9ebfadabdca672f39aa0efdb571ac0a4a0aa0
    652136ef42ac64009220eb9f5df8a5616e7b04784d6aaac00b6a2f19
    d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
}

set dashHash {
    sha256 9806e72c3ed3362b7ded0142804aaec6469b7f85cb973d6f5edd66d782448973
    sha224 8b38321f0c302c4e1600ae18c420de8117d05d2c72a4113a05ee7494
}

set msgHmac  4f9352c64d655e8a36abe73e6163a9d7a54039877c1c92ec90b07d48d4e854e0
set fileHmac 6accaeabfc8b4f861549a9237a414d694b27c3c43410c0c58631df2a0eadb5b2

# -------------------------------------------------------------------------

TestAccelDo sha2 impl {

    # ---------------------------------------------------------------------
    # ::sha2::sha256 and ::sha2::sha224

    foreach {cmd len msg msgHash fileHash emptyHash} $digests {
        set usage "wrong # args: should be \"::sha2::$cmd ?-hex|-bin? -filename file | -channel channel | string\""

        test $cmd-api-$impl-1.1 "$cmd: string ($impl)" -body {
            ::sha2::$cmd $msg
        } -result $msgHash

        test $cmd-api-$impl-1.2 "$cmd: empty string ($impl)" -body {
            ::sha2::$cmd ""
        } -result $emptyHash

        test $cmd-api-$impl-1.3 "$cmd -hex ($impl)" -body {
            ::sha2::$cmd -hex $msg
        } -result $msgHash

        test $cmd-api-$impl-1.4 "$cmd -bin ($impl)" -body {
            set r [::sha2::$cmd -bin $msg]
            list [string length $r] [::sha2::Hex $r]
        } -cleanup {
            unset r
        } -result [list $len $msgHash]

        test $cmd-api-$impl-1.5 "$cmd: last of -hex/-bin wins ($impl)" -body {
            list [string length [::sha2::$cmd -hex -bin $msg]] \
                [::sha2::$cmd -bin -hex $msg]
        } -result [list $len $msgHash]

        test $cmd-api-$impl-1.6 "$cmd: string with leading dash ($impl)" -body {
            list [::sha2::$cmd -hex -- -hello] [::sha2::$cmd -hello] \
                [::sha2::Hex [::sha2::$cmd -bin -- -hello]]
        } -result [lrepeat 3 [dict get $dashHash $cmd]]

        # knownBug: the documentation promises a hex result unless -bin is
        # given, but with more than one argument the result is binary unless
        # -hex is given explicitly.
        test $cmd-api-$impl-1.7 "$cmd -- string: result is hex by default ($impl)" -constraints {
            knownBug
        } -body {
            ::sha2::$cmd -- $msg
        } -result $msgHash

        test $cmd-api-$impl-1.8 "$cmd: binary data ($impl)" -body {
            ::sha2::$cmd [mkdata]
        } -result $fileHash

        test $cmd-api-$impl-2.1 "$cmd -hex -file ($impl)" -body {
            ::sha2::$cmd -hex -file $datafile
        } -result $fileHash

        test $cmd-api-$impl-2.2 "$cmd -hex -filename ($impl)" -body {
            ::sha2::$cmd -hex -filename $datafile
        } -result $fileHash

        test $cmd-api-$impl-2.3 "$cmd -bin -file ($impl)" -body {
            ::sha2::Hex [::sha2::$cmd -bin -file $datafile]
        } -result $fileHash

        test $cmd-api-$impl-2.4 "$cmd -file: result is hex by default ($impl)" -constraints {
            knownBug
        } -body {
            ::sha2::$cmd -file $datafile
        } -result $fileHash

        test $cmd-api-$impl-2.5 "$cmd -file: file is closed afterwards ($impl)" -setup {
            set before [lsort [file channels]]
        } -body {
            ::sha2::$cmd -hex -file $datafile
            expr {[lsort [file channels]] eq $before}
        } -cleanup {
            unset before
        } -result 1

        test $cmd-api-$impl-2.6 "$cmd -file: missing file ($impl)" -body {
            ::sha2::$cmd -hex -file [file join [temporaryDirectory] nosuchfile.sha2]
        } -returnCodes error -match glob -result {couldn't open "*nosuchfile.sha2": no such file or directory}

        test $cmd-api-$impl-3.1 "$cmd -hex -channel, channel stays open ($impl)" -setup {
            set ch [open $datafile rb]
        } -body {
            list [::sha2::$cmd -hex -channel $ch] \
                [expr {$ch in [file channels]}] [eof $ch]
        } -cleanup {
            close $ch
            unset ch
        } -result [list $fileHash 1 1]

        test $cmd-api-$impl-3.2 "$cmd -channel: reads from current position ($impl)" -setup {
            set ch [open $datafile rb]
            read $ch 256
        } -body {
            ::sha2::$cmd -hex -channel $ch
        } -cleanup {
            close $ch
            unset ch
        } -result [::sha2::$cmd -hex [string range [mkdata] 256 end]]

        test $cmd-api-$impl-3.3 "$cmd -bin -channel ($impl)" -setup {
            set ch [open $datafile rb]
        } -body {
            ::sha2::Hex [::sha2::$cmd -bin -channel $ch]
        } -cleanup {
            close $ch
            unset ch
        } -result $fileHash

        test $cmd-api-$impl-3.4 "$cmd -channel: result is hex by default ($impl)" -constraints {
            knownBug
        } -setup {
            set ch [open $datafile rb]
        } -body {
            ::sha2::$cmd -channel $ch
        } -cleanup {
            close $ch
            unset ch
        } -result $fileHash

        test $cmd-api-$impl-4.1 "$cmd: bad option ($impl)" -body {
            ::sha2::$cmd -foo bar
        } -returnCodes error -result {bad option -foo: must be one of -bin, -channel, -chunksize, -filename, -hex}

        test $cmd-api-$impl-4.2 "$cmd: too many strings ($impl)" -body {
            ::sha2::$cmd a b
        } -returnCodes error -result $usage

        test $cmd-api-$impl-4.3 "$cmd: options but no string ($impl)" -body {
            ::sha2::$cmd -hex -bin
        } -returnCodes error -result $usage

        test $cmd-api-$impl-4.4 "$cmd: invalid channel ($impl)" -body {
            ::sha2::$cmd -hex -channel nosuchchannel
        } -returnCodes error -result {can not find channel named "nosuchchannel"}
    }
    unset cmd len msg msgHash fileHash emptyHash usage

    # ---------------------------------------------------------------------
    # ::sha2::hmac

    set msg "Tcl does SHA256"

    test sha256-api-$impl-5.1 "hmac key string: documented example ($impl)" -body {
        ::sha2::hmac Sekret $msg
    } -result $msgHmac

    test sha256-api-$impl-5.2 "hmac -key key -- string ($impl)" -body {
        ::sha2::hmac -key Sekret -- $msg
    } -result $msgHmac

    test sha256-api-$impl-5.3 "hmac -hex -key key string ($impl)" -body {
        ::sha2::hmac -hex -key Sekret -- $msg
    } -result $msgHmac

    test sha256-api-$impl-5.4 "hmac -bin ($impl)" -body {
        set r [::sha2::hmac -bin -key Sekret -- $msg]
        list [string length $r] [::sha2::Hex $r]
    } -cleanup {
        unset r
    } -result [list 32 $msgHmac]

    test sha256-api-$impl-5.5 "hmac -key key -- string with leading dash ($impl)" -body {
        ::sha2::hmac -key k -- -hello
    } -result 8ea79a65fd7a9ba67e2a5bdfdd04d5975a7b5aafaf0fb7a08a39e7649238afb8

    test sha256-api-$impl-5.6 "hmac: empty key and data ($impl)" -body {
        ::sha2::hmac "" ""
    } -result b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad

    test sha256-api-$impl-5.7 "hmac: key longer than the block size ($impl)" -body {
        ::sha2::hmac [string repeat k 100] data
    } -result 09380ee4b802da2363bc96e8e0d133ba275458ea8ddbc564f986fc12b31f8cb1

    test sha256-api-$impl-5.8 "hmac: RFC 4231 test case 2 ($impl)" -body {
        ::sha2::hmac Jefe "what do ya want for nothing?"
    } -result 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843

    test sha256-api-$impl-6.1 "hmac -key -file ($impl)" -body {
        ::sha2::hmac -key key -file $datafile
    } -result $fileHmac

    test sha256-api-$impl-6.2 "hmac -key -filename ($impl)" -body {
        ::sha2::hmac -key key -filename $datafile
    } -result $fileHmac

    test sha256-api-$impl-6.3 "hmac -bin -key -file ($impl)" -body {
        ::sha2::Hex [::sha2::hmac -bin -key key -file $datafile]
    } -result $fileHmac

    test sha256-api-$impl-6.4 "hmac -key -channel, channel stays open ($impl)" -setup {
        set ch [open $datafile rb]
    } -body {
        list [::sha2::hmac -key key -channel $ch] \
            [expr {$ch in [file channels]}]
    } -cleanup {
        close $ch
        unset ch
    } -result [list $fileHmac 1]

    test sha256-api-$impl-6.5 "hmac -file: file is closed afterwards ($impl)" -setup {
        set before [lsort [file channels]]
    } -body {
        ::sha2::hmac -key key -file $datafile
        expr {[lsort [file channels]] eq $before}
    } -cleanup {
        unset before
    } -result 1

    test sha256-api-$impl-7.1 "hmac: no arguments ($impl)" -body {
        ::sha2::hmac
    } -returnCodes error -result {wrong # args: should be "hmac ?-hex? -key key -filename file | string"}

    test sha256-api-$impl-7.2 "hmac: bad option ($impl)" -body {
        ::sha2::hmac -foo bar baz
    } -returnCodes error -result {bad option -foo: must be one of -channel, -chunksize, -filename, -hex}

    test sha256-api-$impl-7.3 "hmac: -key without string ($impl)" -body {
        ::sha2::hmac -hex -key k
    } -returnCodes error -result {wrong # args: should be "hmac ?-hex? -key key -filename file | string"}

    test sha256-api-$impl-7.4 "hmac: no -key ($impl)" -body {
        ::sha2::hmac -hex -- text
    } -returnCodes error -result {wrong # args: should be "hmac ?-hex? -key key -filename file | string"}

    # knownBug: "-key k" is silently replaced by the first of the two
    # remaining arguments instead of raising "wrong # args".
    test sha256-api-$impl-7.5 "hmac: -key and two more arguments ($impl)" -constraints {
        knownBug
    } -body {
        ::sha2::hmac -key k a b
    } -returnCodes error -result {wrong # args: should be "hmac ?-hex? -key key -filename file | string"}

    unset msg

    # ---------------------------------------------------------------------
    # Programming interface

    test sha256-api-$impl-8.1 "SHA256Init/Update/Final: documented example ($impl)" -body {
        set tok [::sha2::SHA256Init]
        ::sha2::SHA256Update $tok "Tcl "
        ::sha2::SHA256Update $tok "does "
        ::sha2::SHA256Update $tok "SHA256"
        set r [::sha2::SHA256Final $tok]
        list [string length $r] [::sha2::Hex $r]
    } -cleanup {
        unset tok r
    } -result {32 0b91043ee484abd83c3e4b08d6034d71b937026379f0f59bda6e625e6e214789}

    test sha256-api-$impl-8.2 "SHA224Init/SHA256Update/SHA224Final ($impl)" -body {
        set tok [::sha2::SHA224Init]
        ::sha2::SHA256Update $tok "Tcl does "
        ::sha2::SHA256Update $tok "SHA224"
        set r [::sha2::SHA224Final $tok]
        list [string length $r] [::sha2::Hex $r]
    } -cleanup {
        unset tok r
    } -result {28 cedbe4b18ff91e640cf9ebfadabdca672f39aa0efdb571ac0a4a0aa0}

    test sha256-api-$impl-8.3 "SHA256Update returns empty ($impl)" -body {
        set tok [::sha2::SHA256Init]
        set u [::sha2::SHA256Update $tok abc]
        ::sha2::SHA256Final $tok
        set u
    } -cleanup {
        unset tok u
    } -result {}

    test sha256-api-$impl-8.4 "SHA256Init/Final without data ($impl)" -body {
        list [::sha2::Hex [::sha2::SHA256Final [::sha2::SHA256Init]]] \
            [::sha2::Hex [::sha2::SHA224Final [::sha2::SHA224Init]]]
    } -result {e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f}

    test sha256-api-$impl-8.5 "SHA256Update: byte-wise updates equal one update ($impl)" -body {
        set data [mkdata]
        set tok [::sha2::SHA256Init]
        foreach c [split [string range $data 0 199] {}] {
            ::sha2::SHA256Update $tok $c
        }
        ::sha2::SHA256Update $tok [string range $data 200 end]
        ::sha2::Hex [::sha2::SHA256Final $tok]
    } -cleanup {
        unset tok data c
    } -result e96760a87768717bcebcfd25ddc7d46b4dbc95a4b0014def080c08539f7d90d0

    test sha256-api-$impl-8.6 "Init: independent tokens ($impl)" -body {
        set t1 [::sha2::SHA256Init]
        set t2 [::sha2::SHA224Init]
        ::sha2::SHA256Update $t1 "Tcl does SHA256"
        ::sha2::SHA256Update $t2 "Tcl does SHA224"
        list [expr {$t1 ne $t2}] \
            [::sha2::Hex [::sha2::SHA256Final $t1]] \
            [::sha2::Hex [::sha2::SHA224Final $t2]]
    } -cleanup {
        unset t1 t2
    } -result {1 0b91043ee484abd83c3e4b08d6034d71b937026379f0f59bda6e625e6e214789 cedbe4b18ff91e640cf9ebfadabdca672f39aa0efdb571ac0a4a0aa0}

    test sha256-api-$impl-8.7 "Final: token is invalid afterwards ($impl)" -body {
        set t1 [::sha2::SHA256Init]
        set t2 [::sha2::SHA224Init]
        ::sha2::SHA256Final $t1
        ::sha2::SHA224Final $t2
        list [info exists $t1] [info exists $t2]
    } -cleanup {
        unset t1 t2
    } -result {0 0}

    test sha256-api-$impl-9.1 "HMACInit/Update/Final ($impl)" -body {
        set tok [::sha2::HMACInit Sekret]
        ::sha2::HMACUpdate $tok "Tcl "
        ::sha2::HMACUpdate $tok "does "
        ::sha2::HMACUpdate $tok "SHA256"
        set r [::sha2::HMACFinal $tok]
        list [string length $r] [::sha2::Hex $r]
    } -cleanup {
        unset tok r
    } -result [list 32 $msgHmac]

    test sha256-api-$impl-9.2 "HMACInit/Final without data ($impl)" -body {
        ::sha2::Hex [::sha2::HMACFinal [::sha2::HMACInit ""]]
    } -result b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad

    test sha256-api-$impl-9.3 "HMACFinal: token is invalid afterwards ($impl)" -body {
        set tok [::sha2::HMACInit k]
        ::sha2::HMACFinal $tok
        info exists $tok
    } -cleanup {
        unset tok
    } -result 0

    test sha256-api-$impl-9.4 "HMACInit: wrong # args ($impl)" -body {
        ::sha2::HMACInit
    } -returnCodes error -result {wrong # args: should be "::sha2::HMACInit K"}

    test sha256-api-$impl-9.5 "HMACUpdate: wrong # args ($impl)" -body {
        ::sha2::HMACUpdate x
    } -returnCodes error -result {wrong # args: should be "::sha2::HMACUpdate token data"}
}

# -------------------------------------------------------------------------

removeFile $datafile
unset datafile digests dashHash msgHmac fileHmac
rename mkdata {}

TestAccelExit sha2
testsuiteCleanup

# -------------------------------------------------------------------------
# Local Variables:
#   mode: tcl
#   indent-tabs-mode: nil
# End:
