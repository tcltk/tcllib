# -*- tcl -*-
# map-api.test:  Additional tests for the documented API of struct::map.
#
# This file contains a collection of tests for one or more of the Tcllib
# procedures.  Sourcing this file into Tcl runs the tests and
# generates output for errors.  No output means no errors were found.
#
# Complements map.test, covering what that does not.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use       snit/snit.tcl   snit
}
testing {
    useLocal map.tcl struct::map
}

# -------------------------------------------------------------------------
## Constructor

test struct-map-api-1.0 {constructor, result is the fully qualified name} -body {
    struct::map M
} -cleanup {
    M destroy
} -result ::M

test struct-map-api-1.1 {constructor, name in a namespace} -setup {
    namespace eval ::mapns {}
} -body {
    namespace eval ::mapns {struct::map M}
} -cleanup {
    ::mapns::M destroy
    namespace delete ::mapns
} -result ::mapns::M

test struct-map-api-1.2 {constructor, %AUTO% generates a unique name} -body {
    set a [struct::map %AUTO%]
    set b [struct::map %AUTO%]
    list [string match ::* $a] [string match ::* $b] [expr {$a ne $b}] \
	[llength [info commands $a]] [llength [info commands $b]]
} -cleanup {
    $a destroy
    $b destroy
    unset a b
} -result {1 1 1 1 1}

test struct-map-api-1.3 {destroy removes the instance command} -body {
    struct::map M
    M destroy
    info commands ::M
} -result {}

test struct-map-api-1.4 {two maps are independent} -setup {
    struct::map M
    struct::map N
} -body {
    M set a 1
    N set a 2
    list [M get] [N get]
} -cleanup {
    M destroy
    N destroy
} -result {{a 1} {a 2}}

# -------------------------------------------------------------------------
## set

test struct-map-api-2.0 {set without value returns the current value} -setup {
    struct::map M
    M set K V
} -body {
    M set K
} -cleanup {
    M destroy
} -result V

test struct-map-api-2.1 {set without value, unknown key is an error} -setup {
    struct::map M
} -body {
    M set K
} -cleanup {
    M destroy
} -returnCodes error -result {can't read "K": no such variable}

test struct-map-api-2.2 {set overwrites an existing key} -setup {
    struct::map M
    M set K V
} -body {
    list [M set K W] [M get]
} -cleanup {
    M destroy
} -result {W {K W}}

test struct-map-api-2.3 {set, keys and values with spaces} -setup {
    struct::map M
} -body {
    M set {k 1} {v 1}
    list [M set {k 1}] [M names] [M get]
} -cleanup {
    M destroy
} -result {{v 1} {{k 1}} {{k 1} {v 1}}}

test struct-map-api-2.4 {set, empty key and value} -setup {
    struct::map M
} -body {
    list [M set {} {}] [M names] [M get]
} -cleanup {
    M destroy
} -result {{} {{}} {{} {}}}

test struct-map-api-2.5 {get and names with several keys} -setup {
    struct::map M
    M set a 1
    M set b 2
    M set c 3
} -body {
    list [lsort [M names]] [lsort -stride 2 [M get]]
} -cleanup {
    M destroy
} -result {{a b c} {a 1 b 2 c 3}}

# -------------------------------------------------------------------------
## unset with patterns

test struct-map-api-3.0 {unset, glob pattern} -setup {
    struct::map M
    foreach k {a ab ba c} {M set $k .}
} -body {
    list [M unset a*] [lsort [M names]]
} -cleanup {
    M destroy
} -result {{} {ba c}}

test struct-map-api-3.1 {unset, several patterns} -setup {
    struct::map M
    foreach k {a ab ba c d} {M set $k .}
} -body {
    list [M unset a* c] [lsort [M names]]
} -cleanup {
    M destroy
} -result {{} {ba d}}

test struct-map-api-3.2 {unset, ? and [] patterns} -setup {
    struct::map M
    foreach k {b ba bb ca} {M set $k .}
} -body {
    M unset b? {[c]*}
    M names
} -cleanup {
    M destroy
} -result b

test struct-map-api-3.3 {unset, pattern matching nothing} -setup {
    struct::map M
    M set a 1
} -body {
    list [M unset x* y] [M get]
} -cleanup {
    M destroy
} -result {{} {a 1}}

test struct-map-api-3.4 {unset, * removes all keys} -setup {
    struct::map M
    M set a 1
    M set b 2
} -body {
    list [M unset *] [M names]
} -cleanup {
    M destroy
} -result {{} {}}

test struct-map-api-3.5 {unset of an empty map} -setup {
    struct::map M
} -body {
    list [M unset] [M unset a] [M names]
} -cleanup {
    M destroy
} -result {{} {} {}}

# -------------------------------------------------------------------------
testsuiteCleanup
