# -*- tcl -*-
# tree-api.test:  Additional tests for the documented API of struct::tree.
#
# This file contains a collection of tests for one or more of the Tcllib
# procedures.  Sourcing this file into Tcl runs the tests and
# generates output for errors.  No output means no errors were found.
#
# Complements tree.test / tree.testsuite, covering what those do not.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use cmdline/cmdline.tcl cmdline
    useLocal list.tcl struct::list
}
testing {
    useAccel [useTcllibC] struct/tree.tcl struct::tree
    TestAccelInit                         struct::tree
}

# -------------------------------------------------------------------------

TestAccelDo struct::tree impl {

    proc mksource {} {
	struct::tree src
	src insert root end n1 n2
	src insert n1 end n3
	src set n1 k v
	return
    }

    # ---------------------------------------------------------------------
    ## Constructor, copy operators := and as

    foreach {n op} {1 := 2 as} {
	test tree-api-${impl}-1.$n "constructor, $op copies the source tree" -setup {
	    mksource
	} -body {
	    struct::tree t $op src
	    list [string equal [t serialize] [src serialize]] \
		[t children root] [t children n1] [t get n1 k]
	} -cleanup {
	    t destroy
	    src destroy
	} -result {1 {n1 n2} n3 v}

	test tree-api-${impl}-2.$n "constructor, $op with unknown source creates no tree" -body {
	    list [catch {struct::tree t $op ::bogus} msg] $msg [info commands ::t]
	} -cleanup {
	    unset -nocomplain msg
	} -result {1 {invalid command name "::bogus"} {}}
    }

    test tree-api-${impl}-1.3 {constructor, copy is independent of the source} -setup {
	mksource
    } -body {
	struct::tree t := src
	t delete n2
	t set n1 k w
	list [src exists n2] [src get n1 k] [t exists n2] [t get n1 k]
    } -cleanup {
	t destroy
	src destroy
    } -result {1 v 0 w}

    test tree-api-${impl}-1.4 {constructor, result is the qualified name} -body {
	struct::tree t
    } -cleanup {
	t destroy
    } -result ::t

    rename mksource {}
}

#----------------------------------------------------------------------
TestAccelExit struct::tree
testsuiteCleanup
