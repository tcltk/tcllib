    list [::practcl::platform::tk_core_options windows] \
	[::practcl::platform::tk_core_options linux] \
	[::practcl::platform::tk_core_options macosx] \
	[::practcl::platform::tk_core_options freebsd]
} -result {{} {--enable-xft=no --enable-xss=no} --enable-aqua=yes {}}

test practcl-api-13.5 {tcl_core_options, wrong # args} -body {
    ::practcl::platform::tcl_core_options
} -returnCodes error -result {wrong # args: should be "::practcl::platform::tcl_core_options os"}

# -------------------------------------------------------------------------
# ::practcl::read_rc_file

test practcl-api-14.1 {read_rc_file, key/value lines and comments} -setup {
    set f [pwrite [file join $::PracWork rc.txt] "# comment\nkey1 value1\nkey2 {multi\nline}\n  # indented comment\n  key3 v3\n"]
} -body {
    set r [::practcl::read_rc_file $f]
    list [dict keys $r] [dict get $r key2]
} -cleanup {
    file delete $f
    unset f r
} -result [list {key1 key2 key3} "multi\nline"]

test practcl-api-14.2 {read_rc_file appends to localdat} -setup {
    set f [pwrite [file join $::PracWork rc.txt] "key1 value1\nkey0 new\n"]
} -body {
    set r [::practcl::read_rc_file $f {key0 old other x}]
    list [dict get $r key0] [dict get $r other] [dict get $r key1]
} -cleanup {
    file delete $f
    unset f r
} -result {new x value1}

test practcl-api-14.3 {read_rc_file, missing file} -body {
    ::practcl::read_rc_file [file join $::PracWork no-such.rc]
} -returnCodes error -match glob -result {couldn't open "*no-such.rc": no such file or directory}

# -------------------------------------------------------------------------
# ::practcl::read_sh_subst, read_sh_file

test practcl-api-15.1 {read_sh_subst substitutes ${VAR} and $(VAR)} -body {
    ::practcl::read_sh_subst {${A}-$(B)} {A 1 B 2}
} -result 1-2

test practcl-api-15.2 {read_sh_subst strips quotes and blanks} -body {
    ::practcl::read_sh_subst { '${A}' } {A q}
} -result q

test practcl-api-15.3 {read_sh_subst of an unknown variable} -body {
    ::practcl::read_sh_subst {${NOPE}} {A 1}
} -result {}

test practcl-api-15.4 {read_sh_file, assignments, export and comments} -setup {
    set f [pwrite [file join $::PracWork sh.sh] "# comment\nA=1\nB='\${A}x'\n\nexport C=\$(A)y\nexport D=hello world\n"]
} -body {
    ::practcl::read_sh_file $f {X 1}
} -cleanup {
    file delete $f
    unset f
} -result {A 1 B {${A}x} C 1y D {hello world}}

test practcl-api-15.5 {read_sh_file, include of another file} -setup {
    set inc [pwrite [file join $::PracWork inc.sh] "INC=yes\n"]
    set f [pwrite [file join $::PracWork main.sh] "A=1\ninclude $inc\nB=2\n"]
} -body {
    ::practcl::read_sh_file $f {X 1}
} -cleanup {
    file delete $f $inc
    unset f inc
} -result {A 1 INC yes B 2}

test practcl-api-15.6 {read_sh_file, missing file} -body {
    ::practcl::read_sh_file [file join $::PracWork no-such.sh]
} -returnCodes error -match glob -result {couldn't open "*no-such.sh": no such file or directory}

# -------------------------------------------------------------------------
# ::practcl::read_Config.sh, read_Makefile

test practcl-api-16.1 {read_Config.sh reads values without substitution} -setup {
    set f [pwrite [file join $::PracWork tclConfig.sh] "# c\nTCL_VERSION='8.6'\nTCL_LIB_FILE='libtcl\${TCL_VERSION}.so'\n\nTCL_PREFIX=/usr\nnot an assignment\n"]
} -body {
    ::practcl::read_Config.sh $f
} -cleanup {
    file delete $f
    unset f
} -result {TCL_VERSION 8.6 TCL_LIB_FILE {libtcl${TCL_VERSION}.so} TCL_PREFIX /usr}

test practcl-api-16.2 {read_Makefile picks the TEA fields} -setup {
    set d [pdir mkf]
    set f [pwrite [file join $d Makefile] "# c\nPACKAGE_NAME = foo\nPACKAGE_VERSION = 1.2\nPKG_LIB_FILE = libfoo1.2.so\nsrcdir = .\nLIBS = -lm\nOTHER = x\ncompile = gcc\nAFTER = y\n"]
} -body {
    set r [::practcl::read_Makefile $f]
    list [dict get $r name] [dict get $r version] [dict get $r libfile] \
	[dict get $r PRACTCL_LIBS] [expr {[dict get $r srcdir] eq $d}] [lsort [dict keys $r]]
} -cleanup {
    file delete -force $d
    unset d f r
} -result {foo 1.2 libfoo1.2.so -lm 1 {PRACTCL_LIBS libfile name srcdir version}}

test practcl-api-16.3 {read_Makefile, explicit srcdir} -setup {
    set f [pwrite [file join $::PracWork Makefile2] "srcdir = /src/foo\n"]
} -body {
    ::practcl::read_Makefile $f
} -cleanup {
    file delete $f
    unset f
} -result {srcdir /src/foo}

