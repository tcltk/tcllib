	[PR define remove lst b] [PR define remove nolist b] [PR define get lst]
} -cleanup {
    PR destroy
} -result {{a b} {a b c} {a c} {} {a c}}

test practcl-api-40.4 {define dump and array subcommands} -setup {
    mkproject ::PR
} -body {
    PR define set k1 v1 k2 v2
    list [dict get [PR define dump] k2] [lsort [PR define names k*]] [PR define size]
} -cleanup {
    PR destroy
} -result {v2 {k1 k2} 4}

test practcl-api-40.5 {define, bad subcommand} -setup {
    mkproject ::PR
} -body {
    PR define bogus
} -cleanup {
    PR destroy
} -returnCodes error -match glob -result {unknown or ambiguous subcommand "bogus": must be anymore, *}

test practcl-api-40.6 {link add, list, remove} -setup {
    mkproject ::PR
} -body {
    PR link add custom X
    PR link add custom X
    PR link add custom Y
    PR link add other X
    set r [list [PR link list custom] [PR link list nonesuch]]
    PR link remove Y custom
    lappend r [PR link list custom]
    PR link remove X
    lappend r [PR link list custom] [PR link list other] [lsort -stride 2 [PR link dump]]
} -cleanup {
    PR destroy
    unset r
} -result {{X Y} {} X {} {} {custom {} other {}}}

test practcl-api-40.7 {link, usage errors} -setup {
    mkproject ::PR
} -body {
