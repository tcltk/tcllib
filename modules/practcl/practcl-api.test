# practcl::library

test practcl-api-44.1 {library linktype} -setup {
    mklibrary
} -body {
    LB linktype
} -cleanup {
    LB destroy
} -result library

test practcl-api-44.2 {package-ifneeded, null passthrough and aliases} -setup {
    ::practcl::library create ::LB {name foo version 1.0}
} -body {
    LB package-ifneeded foo_alias
} -cleanup {
    LB destroy
} -result "package ifneeded foo 1.0 \[list package provide foo 1.0\]\n\npackage ifneeded foo_alias 1.0 {package require foo 1.0 ; package provide foo_alias 1.0}"

test practcl-api-44.3 {package-ifneeded, output_tcl and shared library} -setup {
    ::practcl::library create ::LB {name foo pkg_vers 2.0 output_tcl foo.tcl}
    ::practcl::library create ::LB2 {name bar SHARED_BUILD 1 libfile libbar.so}
} -body {
    list [LB package-ifneeded] [LB2 package-ifneeded]
} -cleanup {
    LB destroy
    LB2 destroy
} -result {{package ifneeded foo 2.0 [list source [file join $dir foo.tcl]]} {package ifneeded bar 0.1a [list load [file join $dir libbar.so] bar]}}

test practcl-api-44.4 {shared_library, static_library} -setup {
    ::practcl::library create ::LB {name Foo version 1.2 libprefix lib
	PRACTCL_NAME_LIBRARY %LIBRARY_PREFIX%%LIBRARY_NAME%%LIBRARY_VERSION_NODOTS%
	SHLIB_SUFFIX .so}
} -body {
    list [LB shared_library] [LB static_library]
} -cleanup {
    LB destroy
} -result {libfoo12.so libfoo12.a}

test practcl-api-44.5 {clean removes object files and the library, regenerates} -setup {
    mklibrary
    LB define set libfile libfoo.a
    set d [pdir clean]
    foreach f {a.o objs/b.o keep.c libfoo.a} {pwrite [file join $d $f] {}}
} -body {
    LB clean $d
    tailsorted $d [::practcl::findByPattern $d *]
} -cleanup {
    LB destroy
    file delete -force $d
    unset d f
} -result {foo.c foo.h keep.c}

test practcl-api-44.6 {clean without libfile keeps the directory} -constraints knownBug -setup {
    # [file join $PATH {}] is PATH itself, which clean tries to delete.
    mklibrary
    set d [pdir clean]
    pwrite [file join $d a.o] {}
    pwrite [file join $d keep.c] {}
} -body {
    LB clean $d
    tailsorted $d [::practcl::findByPattern $d *]
} -cleanup {
    LB destroy
    file delete -force $d
    unset d
} -result {foo.c foo.h keep.c}

# -------------------------------------------------------------------------
# practcl::toolset

test practcl-api-45.1 {toolset select, gcc unless MSVC} -setup {
    unset -nocomplain ::env(VisualStudioVersion)
    mkproject ::PR
} -body {
    PR clay mixinmap toolset {}
    ::practcl::toolset select PR
    set r [PR clay mixinmap toolset]
    set ::env(VisualStudioVersion) 17.0
    ::practcl::toolset select PR
    lappend r [PR clay mixinmap toolset]
} -cleanup {
    unset -nocomplain ::env(VisualStudioVersion)
    PR destroy
    unset r
} -result {::practcl::toolset.gcc ::practcl::toolset.msvc}

test practcl-api-45.2 {build-cflags} -setup {
    mkproject ::PR name Foo version 1.2
} -body {
    set r [PR build-cflags ::PR {-DX=1} n v d]
    list $n $v $NAME [expr {$r eq $d}] $d
} -cleanup {
    PR destroy
    unset -nocomplain r n v d NAME
} -result {foo 1.2 FOO 1 {-DX=1 -DPACKAGE_NAME="foo" -DPACKAGE_VERSION="1.2" -DPACKAGE_TARNAME="foo" -DPACKAGE_STRING="foo\ 1.2"}}

test practcl-api-45.3 {build-cflags, default version} -setup {
    ::practcl::project create ::PR {name bar}
} -body {
    PR build-cflags ::PR {} n v d
    set v
} -cleanup {
    PR destroy
    unset -nocomplain n v d NAME
} -result 0.1a

test practcl-api-45.4 {build-cflags replaces existing package defines} -constraints knownBug -setup {
    # The end of the old define is searched in the flag, not in DEFS.
    mkproject ::PR
} -body {
    set d [PR build-cflags ::PR {-DFOO=1 -DPACKAGE_NAME="old" -DBAR=2} n v d]
    list [regexp {"old"} $d] [regexp -all PACKAGE_NAME $d] [regexp -all -- -DFOO=1 $d] [regexp -all -- -DBAR=2 $d]
} -cleanup {
    PR destroy
    unset -nocomplain d n v NAME
} -result {0 1 1 1}

# -------------------------------------------------------------------------
# practcl::subproject

proc mksub {name args} {
    mkproject ::PR
    ::practcl::subproject create $name ::PR [dict merge {name sub} $args]
}

test practcl-api-46.1 {subproject linktype, BuildDir, child} -setup {
    mksub ::SP srcdir /some/src
} -body {
    list [SP linktype] [SP script {my BuildDir /x}] [SP child organs]
} -cleanup {
    SP destroy
    PR destroy
} -result {{subordinate package} /some/src {project ::SP module ::SP}}

test practcl-api-46.2 {subproject linker-external and linker-extra} -setup {
    mksub ::SP srcdir /some/src
} -body {
    list [SP linker-external {LIBS -lm}] \
	[SP linker-external {PRACTCL_PKG_LIBS -lz LIBS -lm}] \
	[SP linker-external {}] \
	[SP linker-extra {PRACTCL_LINKER_EXTRA -x}] \
	[SP linker-extra {}] [SP linker-products {}]
} -cleanup {
    SP destroy
    PR destroy
} -result {-lm -lz {} -x {} {}}

test practcl-api-46.3 {subproject env-present} -setup {
    mksub ::SP srcdir /some/src pkg_name practcl
    ::practcl::subproject create ::SP2 ::PR {name practcl_api_no_such_package srcdir /x}
} -body {
    list [SP env-present] [SP2 env-present]
} -cleanup {
    SP destroy
    SP2 destroy
    PR destroy
} -result {1 0}

test practcl-api-46.4 {subproject go selects the distribution and build directory} -setup {
    set d [pdir sub]
    file mkdir [file join $d src .git]
    mksub ::SP srcdir [file join $d src] masterpath $d
} -body {
    SP go
    list [SP define get scm] [expr {[SP define get builddir] eq [file join $d src]}]
} -cleanup {
    SP destroy
    PR destroy
    file delete -force $d
    unset d
} -result {git 1}

# -------------------------------------------------------------------------
# practcl::distribution

test practcl-api-47.1 {claim_option of the distribution classes} -body {
    list [::practcl::distribution claim_option] \
	[::practcl::distribution.snapshot claim_option] \
	[::practcl::distribution.fossil claim_option] \
	[::practcl::distribution.git claim_option]
} -result {Unknown snapshot fossil git}

test practcl-api-47.2 {claim_path detects the source markers} -setup {
    set d [pdir claim]
    file mkdir [file join $d git .git] [file join $d none]
    pwrite [file join $d fsl .fslckout] {}
    pwrite [file join $d fsl2 _FOSSIL_] {}
    pwrite [file join $d snap .download] {}
} -body {
    set r {}
    foreach c {distribution distribution.snapshot distribution.fossil distribution.git} {
	set l {}
	foreach p {git fsl fsl2 snap none} {
	    lappend l [::practcl::$c claim_path [file join $d $p]]
	}
	lappend r $l
    }
    set r
} -cleanup {
    file delete -force $d
    unset d r l c p
} -result {{false false false false false} {false false false true false} {false true true false false} {true false false false false}}

test practcl-api-47.3 {claim_object uses the urls} -setup {
    mksub ::SP srcdir /nonexist fossil_url http://example.invalid/f
    ::practcl::subproject create ::SP2 ::PR {name s2 srcdir /nonexist git_url http://example.invalid/g}
} -body {
    list [::practcl::distribution claim_object ::SP] \
	[::practcl::distribution.fossil claim_object ::SP] \
	[::practcl::distribution.fossil claim_object ::SP2] \
	[::practcl::distribution.git claim_object ::SP] \
	[::practcl::distribution.git claim_object ::SP2] \
	[::practcl::distribution.snapshot claim_object ::SP]
} -cleanup {
    SP destroy
    SP2 destroy
    PR destroy
} -result {false true false false true false}

test practcl-api-47.4 {distribution select, by path} -setup {
    set d [pdir dsel]
    file mkdir [file join $d src .git]
    mksub ::SP srcdir [file join $d src] fossil_url http://example.invalid/f
} -body {
    list [::practcl::distribution select ::SP] [SP define get scm] \
	[SP clay mixinmap distribution]
} -cleanup {
    SP destroy
    PR destroy
    file delete -force $d
    unset d
} -result {git git ::practcl::distribution.git}

test practcl-api-47.5 {distribution select, by url and file_url} -setup {
    mksub ::SP srcdir /nonexist fossil_url http://example.invalid/f
    ::practcl::subproject create ::SP2 ::PR {name s2 srcdir /nonexist file_url http://example.invalid/s2.zip}
    ::practcl::subproject create ::SP3 ::PR {name s3 srcdir /nonexist scm preset}
} -body {
    list [::practcl::distribution select ::SP] [::practcl::distribution select ::SP2] \
	[::practcl::distribution select ::SP3] [SP2 clay mixinmap distribution]
} -cleanup {
    SP destroy
    SP2 destroy
    SP3 destroy
    PR destroy
} -result {fossil snapshot preset ::practcl::distribution.snapshot}

test practcl-api-47.6 {distribution select, nothing found} -setup {
    mksub ::SP srcdir /nonexist
} -body {
    ::practcl::distribution select ::SP
} -cleanup {
    SP destroy
    PR destroy
} -returnCodes error -result {Cannot determine source distribution method}

test practcl-api-47.7 {distribution Sandbox and SrcDir} -setup {
    mksub ::SP srcdir /nonexist fossil_url http://example.invalid/f sandbox /my/sandbox
    ::practcl::subproject create ::SP2 ::PR {name s2 fossil_url http://example.invalid/f}
    PR define set sandbox /prj/sandbox
} -body {
    ::practcl::distribution select ::SP
    ::practcl::distribution select ::SP2
    list [SP script {my Sandbox}] [SP script {my SrcDir}] \
	[SP2 script {my Sandbox}] [SP2 script {my SrcDir}]
} -cleanup {
    SP destroy
    SP2 destroy
    PR destroy
} -result {/my/sandbox /nonexist /prj/sandbox /prj/sandbox/s2}

test practcl-api-47.8 {distribution scm_info} -setup {
    set d [pdir dsel]
    file mkdir [file join $d src .git]
    mksub ::SP srcdir [file join $d src]
} -body {
    ::practcl::distribution select ::SP
    SP scm_info
} -cleanup {
