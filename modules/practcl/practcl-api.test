test practcl-api-13.1 {tcl_core_options, windows} -body {
    ::practcl::platform::tcl_core_options windows
} -result {--with-tzdata --with-encoding utf-8}

test practcl-api-13.2 {tcl_core_options, macosx} -body {
    ::practcl::platform::tcl_core_options macosx
} -result {--enable-corefoundation=yes --enable-framework=no --with-tzdata --with-encoding utf-8}

test practcl-api-13.3 {tcl_core_options, other} -body {
    list [::practcl::platform::tcl_core_options linux] \
	[::practcl::platform::tcl_core_options freebsd]
} -result {{--with-tzdata --with-encoding utf-8} {--with-tzdata --with-encoding utf-8}}

