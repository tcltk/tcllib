# practcl::metaclass (through practcl::project)

proc mkproject {name args} {
    ::practcl::project create $name [dict merge {name foo version 1.0} $args]
}

test practcl-api-40.1 {define get, exists, default value} -setup {
    mkproject ::PR
} -body {
    list [PR define get name] [PR define get nokey] [PR define get nokey dflt] \
	[PR define exists name] [PR define exists nokey] \
	[PR define getnull name] [PR define cget version]
} -cleanup {
    PR destroy
} -result {foo {} dflt 1 0 foo 1.0}

test practcl-api-40.2 {define set, key/value pairs or one list} -setup {
    mkproject ::PR
} -body {
    PR define set k1 v1 k2 v2
    PR define set {k3 v3}
    list [PR define get k1] [PR define get k2] [PR define get k3]
} -cleanup {
    PR destroy
} -result {v1 v2 v3}

test practcl-api-40.3 {define add and remove list elements} -setup {
    mkproject ::PR
} -body {
