test practcl-api-47.10 {Unpack does nothing for an existing source directory} -setup {
    set d [pdir dsel]
    file mkdir [file join $d src .git]
    mksub ::SP srcdir [file join $d src]
} -body {
    ::practcl::distribution select ::SP
    SP script {my Unpack}
} -cleanup {
    SP destroy
    PR destroy
    file delete -force $d
    unset d
} -result {}

# -------------------------------------------------------------------------

file delete -force $::PracWork
rename pwrite {}
rename pread {}
rename pdir {}
rename pmode {}
rename tailsorted {}
rename mkfossil {}
rename rmfossil {}
rename mkpkgtree {}
rename mkproject {}
rename mklibrary {}
rename fillLibrary {}
rename mksub {}
unset ::PracWork ::PracHome
testsuiteCleanup
return
