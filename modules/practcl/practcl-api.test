} -result [list [list [file join $::PracWork a.txt]:2:bar] {}]

test practcl-api-20.3 {grep, missing file} -body {
    ::practcl::grep foo [file join $::PracWork no-such.txt]
} -returnCodes error -match glob -result {couldn't open "*no-such.txt": no such file or directory}

