# -*- tcl -*-
# practcl-api.test:  Tests for the documented API of the practcl package:
# the utility commands and the parts of the class library which can be
# exercised without compilers, downloads or installation.
#
# practcl.test only checks ::practcl::findByPattern.
# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.6
testsNeedTcltest 2
testsNeed        TclOO 1

support {
    use try/fhome.tcl file::home
}
testing {
    useLocal practcl.tcl practcl
}

# -------------------------------------------------------------------------
# Environment.  A private home directory keeps ::practcl::local_os (and
# the ::practcl::LOCAL project created from it) away from the user's own
# ~/tcl/practcl.rc.  ::CWD is used by the project classes as the master
# build directory.

set ::PracWork [file normalize [tcltest::makeDirectory practcl-api-work]]
set ::PracHome [file join $::PracWork home]
file mkdir $::PracHome
set ::env(HOME) $::PracHome
unset -nocomplain ::env(FOSSIL_MIRROR) ::env(VisualStudioVersion)
unset -nocomplain ::practcl::LOCAL_INFO
set ::CWD $::PracWork

proc pwrite {path data} {
    file mkdir [file dirname $path]
    set f [open $path w]
    fconfigure $f -translation lf
    puts -nonewline $f $data
    close $f
    return $path
}
proc pread {path} {
    set f [open $path r]
    set data [read $f]
    close $f
    return $data
}
proc pdir {name} {
    # A fresh, empty scratch directory below the work directory.
    set d [file join $::PracWork $name]
    file delete -force $d
    file mkdir $d
    return $d
}
proc pmode {path} {
    file stat $path st
    return [format %o [expr {$st(mode) & 0o777}]]
}
proc tailsorted {base paths} {
    set result {}
    foreach p $paths {
	lappend result [::practcl::file_relative $base $p]
    }
    return [lsort $result]
}

tcltest::testConstraint makeExe   [expr {[auto_execok make] ne {}}]
tcltest::testConstraint fossilExe [expr {[auto_execok fossil] ne {}}]
tcltest::testConstraint notWin    [expr {$::tcl_platform(platform) ne "windows"}]

# -------------------------------------------------------------------------
# ::practcl::cat

test practcl-api-1.1 {cat, wrong # args} -body {
    ::practcl::cat
} -returnCodes error -result {wrong # args: should be "::practcl::cat fname"}

test practcl-api-1.2 {cat returns the whole file} -setup {
    set f [pwrite [file join $::PracWork cat.txt] "line1\nline2\n"]
} -body {
    ::practcl::cat $f
} -cleanup {
    file delete $f
    unset f
} -result "line1\nline2\n"

test practcl-api-1.3 {cat of a missing file returns empty} -body {
    ::practcl::cat [file join $::PracWork no-such-file]
} -result {}

# -------------------------------------------------------------------------
# ::practcl::docstrip

test practcl-api-2.1 {docstrip, wrong # args} -body {
    ::practcl::docstrip
} -returnCodes error -result {wrong # args: should be "::practcl::docstrip text"}

test practcl-api-2.2 {docstrip removes global comments and blank lines} -body {
    ::practcl::docstrip "# comment\nset a 1\n\n  # indented\nset b 2\n"
} -result "set a 1\nset b 2\n"

test practcl-api-2.3 {docstrip descends into namespace eval, keeps proc bodies} -body {
    ::practcl::docstrip {namespace eval foo {
  # inner comment
  set b 2
}
proc x {} {
 # kept
 return
}
}
} -result {namespace eval foo {
  set b 2
}
proc x {} {
 # kept
 return
}
}

test practcl-api-2.4 {docstrip descends into ::define and oo::class create} -body {
    ::practcl::docstrip {clay::define ::foo {
  # strip me
  method m {} {}
}
oo::class create ::bar {
  # strip me too
  method n {} {}
}
}
} -result {clay::define ::foo {
  method m {} {}
}
oo::class create ::bar {
  method n {} {}
}
}

test practcl-api-2.5 {docstrip of empty text} -body {
    ::practcl::docstrip {}
} -result {}

# -------------------------------------------------------------------------
# putb

test practcl-api-3.1 {putb, wrong # args} -body {
    putb
} -returnCodes error -result {wrong # args: should be "putb buffername ?arg ...?"}

test practcl-api-3.2 {putb, missing text} -body {
    putb buf
} -cleanup {
    unset -nocomplain buf
} -returnCodes error -result {usage: putb buffername ?map? string}

test practcl-api-3.3 {putb, too many arguments} -body {
    putb buf a b c
} -cleanup {
    unset -nocomplain buf
} -returnCodes error -result {usage: putb buffername ?map? string}

test practcl-api-3.4 {putb appends a line} -setup {
    set buf x
} -body {
    putb buf hello
    putb buf world
    set buf
} -cleanup {
    unset buf
} -result "xhello\nworld\n"

test practcl-api-3.5 {putb creates the variable} -setup {
    unset -nocomplain buf
} -body {
    putb buf hello
} -cleanup {
    unset buf
} -result "hello\n"

test practcl-api-3.6 {putb with a string map} -setup {
    set buf {}
} -body {
    putb buf {%a% 1 %b% 2} {x%a%y%b%z}
} -cleanup {
    unset buf
} -result "x1y2z\n"

# -------------------------------------------------------------------------
# Proc, noop

test practcl-api-4.1 {Proc, wrong # args} -body {
    Proc a b
} -returnCodes error -result {wrong # args: should be "Proc name arglist body"}

test practcl-api-4.2 {Proc creates a missing command} -setup {
    catch {rename ::practcl_api_p {}}
} -body {
    Proc ::practcl_api_p {x} {return <$x>}
    ::practcl_api_p 1
} -cleanup {
    rename ::practcl_api_p {}
} -result <1>

test practcl-api-4.3 {Proc does not replace an existing command} -setup {
    proc ::practcl_api_p {} {return old}
} -body {
    Proc ::practcl_api_p {} {return new}
    ::practcl_api_p
} -cleanup {
    rename ::practcl_api_p {}
} -result old

test practcl-api-4.4 {noop accepts anything and does nothing} -body {
    list [noop] [noop a b {c d}]
} -result {{} {}}

# -------------------------------------------------------------------------
# ::practcl::debug

test practcl-api-5.1 {debug appends its arguments to ::DEBUG_INFO} -setup {
    set saved [info exists ::DEBUG_INFO]
    if {$saved} {set old $::DEBUG_INFO}
    set ::DEBUG_INFO {}
} -body {
    ::practcl::debug a b
    ::practcl::debug c
    set ::DEBUG_INFO
} -cleanup {
    if {$saved} {set ::DEBUG_INFO $old} else {unset ::DEBUG_INFO}
    unset -nocomplain saved old
} -result "\na b\nc"

# -------------------------------------------------------------------------
# ::practcl::doexec, doexec_in, dotclexec, domake, domake.tcl

test practcl-api-6.1 {doexec, runs the command and echoes it} -setup {
    set d [pdir exec]
    set script [pwrite [file join $d s.tcl] {
	set f [open [lindex $argv 0] w]; puts -nonewline $f [lrange $argv 1 end]; close $f
    }]
    set out [file join $d out.txt]
} -body {
    ::practcl::doexec [info nameofexecutable] $script $out a b
    pread $out
} -cleanup {
    file delete -force $d
    unset d script out
} -result {a b} -output "[list [info nameofexecutable] [file join $::PracWork exec s.tcl] [file join $::PracWork exec out.txt] a b]\n"

test practcl-api-6.2 {doexec, error of the command} -body {
    ::practcl::doexec [info nameofexecutable] [file join $::PracWork no-such-script.tcl]
} -returnCodes error -match glob -result * -output *

test practcl-api-6.3 {doexec_in runs in the directory, restores pwd} -setup {
    set d [pdir execin]
    pwrite [file join $d s.tcl] {
	set f [open here.txt w]; puts -nonewline $f [pwd]; close $f
    }
    set here [pwd]
} -body {
    ::practcl::doexec_in $d [info nameofexecutable] s.tcl
    list [expr {[pwd] eq $here}] [expr {[pread [file join $d here.txt]] eq [file normalize $d]}]
} -cleanup {
    cd $here
    file delete -force $d
    unset d here
} -result {1 1} -output "[list [info nameofexecutable] s.tcl]\n"

test practcl-api-6.4 {dotclexec runs a script with the current interpreter} -setup {
    set d [pdir tclexec]
    set script [pwrite [file join $d s.tcl] {
	set f [open [lindex $argv 0] w]; puts -nonewline $f [info patchlevel]; close $f
    }]
    set out [file join $d out.txt]
} -body {
    ::practcl::dotclexec $script $out
    expr {[pread $out] eq [info patchlevel]}
} -cleanup {
    file delete -force $d
    unset d script out
} -result 1 -output "[list [info nameofexecutable] [file join $::PracWork tclexec s.tcl] [file join $::PracWork tclexec out.txt]]\n"

test practcl-api-6.5 {domake runs make in the directory} -constraints makeExe -setup {
    set d [pdir make]
    pwrite [file join $d Makefile] "all:\n\t@echo built > made.txt\n\nother:\n\t@echo other > other.txt\n"
    set here [pwd]
} -body {
    ::practcl::domake $d -s other
    list [expr {[pwd] eq $here}] [file exists [file join $d made.txt]] \
	[string trim [pread [file join $d other.txt]]]
} -cleanup {
    cd $here
    file delete -force $d
    unset d here
} -result {1 0 other} -output "[list *** [file join $::PracWork make] ***]\nmake -s other\n"

test practcl-api-6.6 {domake.tcl runs make.tcl in the directory} -setup {
    set d [pdir maketcl]
    pwrite [file join $d make.tcl] {
	set f [open made.txt w]; puts -nonewline $f $argv; close $f
    }
    set here [pwd]
} -body {
    ::practcl::domake.tcl $d x y
    list [expr {[pwd] eq $here}] [pread [file join $d made.txt]]
} -cleanup {
    cd $here
    file delete -force $d
    unset d here
} -result {1 {x y}} -output "[list *** [file join $::PracWork maketcl] ***]\nmake.tcl x y\n"

# -------------------------------------------------------------------------
# ::practcl::fossil, ::practcl::fossil_status
# These use a private fossil repository created by the test itself.

proc mkfossil {d} {
    set ::PracFossilHome [array get ::env FOSSIL_HOME]
    set ::env(FOSSIL_HOME) [file join $d fhome]
    file mkdir $::env(FOSSIL_HOME)
    exec fossil init [file join $d repo.fossil] --admin-user tester >/dev/null 2>/dev/null
    file mkdir [file join $d co]
    set here [pwd]
    cd [file join $d co]
    exec fossil open --nested [file join $d repo.fossil] >/dev/null 2>/dev/null
    cd $here
    return [file join $d co]
}
proc rmfossil {d} {
    unset -nocomplain ::env(FOSSIL_HOME)
    array set ::env $::PracFossilHome
    unset ::PracFossilHome
    file delete -force $d
}

test practcl-api-7.1 {fossil runs fossil in the directory} -constraints fossilExe -setup {
    set d [pdir fossil]
    set co [mkfossil $d]
    set here [pwd]
} -body {
    ::practcl::fossil $co settings ignore-glob *.practcl
    list [expr {[pwd] eq $here}] \
	[string match {*\*.practcl*} [exec fossil settings ignore-glob -R [file join $d repo.fossil]]]
} -cleanup {
    cd $here
    rmfossil $d
    unset d co here
} -result {1 1} -output "settings ignore-glob *.practcl\n"

test practcl-api-7.2 {fossil_status returns the checkout information} -constraints fossilExe -setup {
    set d [pdir fossilst]
    set co [mkfossil $d]
    unset -nocomplain ::fosdat($co)
} -body {
    set info [::practcl::fossil_status $co]
    list [lsort [dict keys $info]] \
	[regexp {^[0-9a-f]{40,64}$} [dict get $info hash]] \
	[regexp {^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d$} [dict get $info maxdate]] \
	[regexp {^\d{14}$} [dict get $info isodate]] \
	[dict get $info tags] [dict get $info version]
} -cleanup {
    unset -nocomplain ::fosdat($co)
    rmfossil $d
    unset d co info
} -result {{hash isodate maxdate tags version} 1 1 1 trunk {}}

test practcl-api-7.3 {fossil_status caches its result per directory} -setup {
    set d [file join $::PracWork not-a-checkout]
    set ::fosdat($d) {tags cached}
} -body {
    ::practcl::fossil_status $d
} -cleanup {
    unset ::fosdat($d) d
} -result {tags cached}

# -------------------------------------------------------------------------
# ::practcl::os, ::practcl::local_os

test practcl-api-8.1 {local_os, documented fields} -body {
    set info [::practcl::local_os]
    set missing {}
    foreach f {download EXEEXT local_install prefix sandbox TEACUP_PROFILE
	       TEACUP_OS TEA_PLATFORM TEACUP_ARCH teapot userhome} {
	if {![dict exists $info $f]} {lappend missing $f}
    }
    set missing
} -cleanup {
    unset info missing f
} -result {}

test practcl-api-8.2 {local_os, user home and derived paths} -constraints {notWin} -body {
    set info [::practcl::local_os]
    set uh [dict get $info userhome]
    if {[dict get $info TEACUP_OS] eq "macosx"} {
	set expect [file join [file normalize $::PracHome] Library {Application Support} Tcl]
    } else {
	set expect [file normalize [file join $::PracHome tcl]]
    }
    list [expr {$uh eq $expect}] \
	[expr {[dict get $info teapot] eq [file join $uh teapot]}] \
	[expr {[dict get $info download] eq [file join $uh download]}] \
	[expr {[dict get $info prefix] eq $uh}] \
	[dict get $info EXEEXT]
} -cleanup {
    unset info uh expect
} -result {1 1 1 1 {}}

test practcl-api-8.3 {local_os, platform fields are consistent} -body {
    set info [::practcl::local_os]
    list [expr {[dict get $info os] eq [dict get $info TEACUP_OS]}] \
	[expr {[dict get $info TEACUP_PROFILE] ne "unknown"}] \
	[expr {$::tcl_platform(platform) ne "windows" ||
	       [dict get $info TEA_PLATFORM] eq "windows"}]
} -cleanup {
    unset info
} -result {1 1 1}

test practcl-api-8.4 {local_os caches its result} -body {
    expr {[::practcl::local_os] eq $::practcl::LOCAL_INFO}
} -result 1

test practcl-api-8.5 {local_os reads practcl.rc in userhome} -setup {
    set uh [dict get [::practcl::local_os] userhome]
    pwrite [file join $uh practcl.rc] "# comment\nsandbox /my/sandbox\nextra_key {a b}\n"
    set saved $::practcl::LOCAL_INFO
    unset ::practcl::LOCAL_INFO
} -body {
    set info [::practcl::local_os]
    list [dict get $info sandbox] [dict get $info extra_key]
} -cleanup {
    file delete [file join $uh practcl.rc]
    set ::practcl::LOCAL_INFO $saved
    unset -nocomplain uh saved info
} -result {/my/sandbox {a b}}

test practcl-api-8.6 {os returns TEACUP_OS of the main project} -body {
    expr {[::practcl::os] eq [dict get [::practcl::local_os] TEACUP_OS]}
} -result 1

# -------------------------------------------------------------------------
# ::practcl::mkzip

test practcl-api-9.1 {mkzip, wrong # args} -body {
    ::practcl::mkzip a b
} -returnCodes error -result {wrong # args: should be "::practcl::mkzip exename barekit vfspath"}

test practcl-api-9.2 {mkzip appends a zip of the directory to the kit} -setup {
    set d [pdir mkzip]
    set kit [pwrite [file join $d kit.bin] "BAREKIT"]
    pwrite [file join $d vfs main.tcl] "puts hello\n"
    pwrite [file join $d vfs lib sub.tcl] "# sub\n"
    set exe [file join $d out.exe]
} -body {
    ::practcl::mkzip $exe $kit [file join $d vfs]
    set f [open $exe rb]
    set data [read $f]
    close $f
    list [string range $data 0 6] \
	[expr {[string first "PK\x03\x04" $data] >= 7}] \
	[expr {[string first main.tcl $data] > 0}] \
	[expr {[string first lib/sub.tcl $data] > 0}]
} -cleanup {
    file delete -force $d
    unset -nocomplain d kit exe data f
} -result {BAREKIT 1 1 1}

# -------------------------------------------------------------------------
# ::practcl::sort_dict

test practcl-api-10.1 {sort_dict, wrong # args} -body {
    ::practcl::sort_dict
} -returnCodes error -result {wrong # args: should be "::practcl::sort_dict list"}

test practcl-api-10.2 {sort_dict sorts by key in dictionary order} -body {
    ::practcl::sort_dict {b 2 a 1 c10 x c9 y}
} -result {a 1 b 2 c9 y c10 x}

test practcl-api-10.3 {sort_dict of empty list} -body {
    ::practcl::sort_dict {}
} -result {}

# -------------------------------------------------------------------------
# ::practcl::read_configuration, ::practcl::config.tcl

test practcl-api-11.1 {read_configuration without guidance returns local_os} -setup {
    set d [pdir conf0]
} -body {
    set r [::practcl::read_configuration $d]
    list [dict get $r USEMSVC] [expr {[dict remove $r USEMSVC] eq [::practcl::local_os]}]
} -cleanup {
    file delete -force $d
    unset d r
} -result {0 1}

test practcl-api-11.2 {read_configuration reads config.tcl} -setup {
    set d [pdir conf1]
    pwrite [file join $d config.tcl] "# from configure\nname foo\nversion 1.0\nprefix /p\nsrcdir /s/foo\nLIBDIR {\${prefix}/lib}\n"
} -body {
    set r [::practcl::read_configuration $d]
    list [dict get $r name] [dict get $r version] [dict get $r prefix] \
	[dict get $r LIBDIR] [dict get $r sandbox] [dict get $r USEMSVC]
} -cleanup {
    file delete -force $d
    unset d r
} -result {foo 1.0 /p /p/lib /s 0}

test practcl-api-11.3 {read_configuration reads config.site for cross compiling} -setup {
    set d [pdir conf2]
    pwrite [file join $d config.site] "CC=x86_64-w64-mingw32-gcc\nAR=x86_64-w64-mingw32-ar\n"
} -body {
    set r [::practcl::read_configuration $d]
    list [dict get $r CC] [dict get $r XCOMPILE_CC] [dict get $r XCOMPILE_AR] \
	[expr {[dict get $r CONFIG_SITE] eq [file join $d config.site]}] \
	[dict get $r TEACUP_OS] [dict get $r EXEEXT] [dict get $r USEMSVC]
} -cleanup {
    file delete -force $d
    unset d r
} -result {x86_64-w64-mingw32-gcc x86_64-w64-mingw32-gcc x86_64-w64-mingw32-ar 1 windows .exe 0}

test practcl-api-11.4 {read_configuration, mingw keeps a known architecture} -constraints knownBug -setup {
    # "dict exists exists $result TEACUP_ARCH" is always false, so the
    # architecture is always overwritten with ix86.
    set d [pdir conf3]
    pwrite [file join $d config.site] "CC=x86_64-w64-mingw32-gcc\n"
} -body {
    set r [::practcl::read_configuration $d]
    set arch [dict get [::practcl::local_os] TEACUP_ARCH]
    list [expr {[dict get $r TEACUP_ARCH] eq $arch}] \
	[expr {[dict get $r TEACUP_PROFILE] eq "win32-$arch"}]
} -cleanup {
    file delete -force $d
    unset d r arch
} -result {1 1}

test practcl-api-11.5 {read_configuration, VisualStudioVersion selects MSVC} -setup {
    set d [pdir conf4]
    set ::env(VisualStudioVersion) 17.0
} -body {
    set r [::practcl::read_configuration $d]
    list [dict get $r USEMSVC] [dict get $r TEACUP_OS] [dict get $r EXEEXT]
} -cleanup {
    unset ::env(VisualStudioVersion)
    file delete -force $d
    unset d r
} -result {1 windows .exe}

test practcl-api-11.6 {config.tcl is the same as read_configuration} -setup {
    set d [pdir conf5]
    pwrite [file join $d config.tcl] "name bar\nversion 2.0\nprefix /p\n"
} -body {
    expr {[::practcl::config.tcl $d] eq [::practcl::read_configuration $d]}
} -cleanup {
    file delete -force $d
    unset d
} -result 1

