} -cleanup {
    PR destroy
    unset m1 m2
} -result {1 {Usage: link add LINKTYPE OBJECT} 1 {Usage: link list LINKTYPE}}

test practcl-api-40.8 {link object uses the object's linktype} -setup {
    mkproject ::PR
    mkproject ::PR2 name sub
} -body {
