} -result {DEFS {-DX=${A}} TCL_DEFS {-DY=$(A)} TK_DEFS %A% A 1}

test practcl-api-19.3 {de_shell library macros} -body {
    dict get [::practcl::de_shell {
	name foo version 1.2 prefix /p
	E %LIBRARY_NAME%-%LIBRARY_VERSION%-%LIBRARY_VERSION_NODOTS%-%LIBRARY_PREFIX%
	F {${PKG_OBJECTS} $(PKG_STUB_OBJECTS)}
    }] E
} -result foo-1.2-12-/p

test practcl-api-19.4 {de_shell, libprefix overrides prefix, object macros} -body {
    set r [::practcl::de_shell {
	name foo version 1.2 prefix /p libprefix lib
	E %LIBRARY_PREFIX% F {${PKG_OBJECTS} $(PKG_STUB_OBJECTS)}
    }]
