    list [PR link list project] [lsort -stride 2 [PR link list]]
} -cleanup {
    PR destroy
    PR2 destroy
} -result {::PR2 {project ::PR2}}

test practcl-api-40.9 {script runs in the object context} -setup {
    mkproject ::PR
} -body {
    PR script {my define set fromscript [self]}
    PR define get fromscript
