    unset d
} -result {
      scm  None
      hash {}
      maxdate {}
      tags {}
      isodate {}
    }

test practcl-api-47.9 {git ScmTag} -setup {
    set d [pdir dsel]
    file mkdir [file join $d src .git] [file join $d src2 .git]
    mksub ::SP srcdir [file join $d src]
    ::practcl::subproject create ::SP2 ::PR [list name s2 srcdir [file join $d src2] tag v1]
} -body {
    ::practcl::distribution select ::SP
    ::practcl::distribution select ::SP2
    list [SP script {my ScmTag}] [SP2 script {my ScmTag}] [SP2 define get scm_tag]
} -cleanup {
    SP destroy
    SP2 destroy
    PR destroy
    file delete -force $d
