# -------------------------------------------------------------------------
# practcl::module: add, make ensemble; practcl::make_obj

test practcl-api-42.1 {add, product selected from the file type} -setup {
    set d [pdir prod]
    foreach f {foo.h foo.c libx.a} {pwrite [file join $d $f] {}}
    mkproject ::PR
} -body {
    set r {}
    foreach f {foo.h foo.c libx.a} {
	set o [PR add [file join $d $f]]
	lappend r [info object mixins $o]
    }
    list $r [llength [PR link list product]]
} -cleanup {
    PR destroy
    file delete -force $d
    unset d f o r
} -result {{::practcl::product.cheader ::practcl::product.csource ::practcl::product.clibrary} 3}

test practcl-api-42.2 {add, a .tcl file is sourced into a dynamic product} -setup {
    set d [pdir prod]
    pwrite [file join $d dyn.tcl] "my define set fromfile yes\n"
    mkproject ::PR
} -body {
    set o [PR add [file join $d dyn.tcl]]
    list [info object mixins $o] [$o define get fromfile] [$o define get name] \
	[$o define get localpath] [$o linktype]
} -cleanup {
    PR destroy
    file delete -force $d
    unset d o
} -result {::practcl::product.dynamic yes dyn _dyn {subordinate product dynamic}}

test practcl-api-42.3 {add, explicit class} -setup {
    mkproject ::PR
} -body {
    set o [PR add {class product.csource filename zz.c}]
    list [info object mixins $o] [$o define get filename] [$o project-compile-products]
} -cleanup {
    PR destroy
    unset o
} -result {::practcl::product.csource zz.c {foo_zz {cfile zz.c extra {} external 0 object ::*}}} -match glob

test practcl-api-42.4 {make target, objects, object, filename} -setup {
    mkproject ::PR
} -body {
    set o [PR make target t1 {filename out.txt} {}]
    list [info object class $o] [expr {[PR make objects] eq [list t1 $o]}] \
	[expr {[PR make object t1] eq $o}] [PR make object nope] \
	[PR make filename t1] [PR make filename nope] [$o define get name]
} -cleanup {
    PR destroy
    unset o
} -result {::practcl::make_obj 1 1 {} out.txt {} t1}

test practcl-api-42.5 {make target substitutes the info at global level} -setup {
    mkproject ::PR
    set ::practcl_api_v sub.txt
} -body {
    PR make target t1 {filename $::practcl_api_v} {}
    PR make filename t1
} -cleanup {
    PR destroy
    unset ::practcl_api_v
} -result sub.txt

test practcl-api-42.6 {make target, aliases} -setup {
    mkproject ::PR
} -body {
    set o [PR make target t1 {filename a.out aliases {a1 a2}} {}]
    list [expr {[PR make object a1] eq $o}] [expr {[PR make object a2] eq $o}]
} -cleanup {
    PR destroy
    unset o
} -result {1 1}

test practcl-api-42.7 {make target, redefinition returns the same object} -constraints knownBug -setup {
    # "dict get $$make_object $name"
    mkproject ::PR
} -body {
    set o [PR make target t1 {filename a.out} {}]
    expr {[PR make target t1 {filename a.out} {}] eq $o}
} -cleanup {
    PR destroy
    unset o
} -result 1

test practcl-api-42.8 {make, bad subcommand} -setup {
    mkproject ::PR
} -body {
    PR make bogus
} -cleanup {
    PR destroy
} -returnCodes error -match glob -result {unknown method make bogus. Valid: *}

test practcl-api-42.9 {make pkginfo} -setup {
    mkproject ::PR TEACUP_OS testos TEACUP_PROFILE testprof libdir /lib/x
} -body {
    set r [PR make pkginfo]
    list [lsort [dict keys $r]] [dict get $r PKG_DIR] [dict get $r profile] [dict get $r os] \
	[dict get $r libdir] [dict get $r zipfile] \
	[expr {[dict get $r platform] eq $::tcl_platform(platform)}]
} -cleanup {
    PR destroy
    unset r
} -result {{PKG_DIR libdir name os platform profile version zipfile} foo1.0 testprof testos /lib/x foo-1.0-testprof.zip 1}

test practcl-api-42.10 {make depends, trigger, todo, do} -setup {
    mkproject ::PR
    set d [pdir make]
    set ::practcl_api_ran {}
    PR make target t1 [list filename [file join $d t1.out]] {lappend ::practcl_api_ran t1}
    PR make target t2 [list filename [file join $d t2.out] depends t1 triggers t3] {lappend ::practcl_api_ran t2}
    PR make target t3 [list filename [file join $d t3.out]] {lappend ::practcl_api_ran t3}
    PR make target t4 [list filename [file join $d t4.out]] {lappend ::practcl_api_ran t4}
} -body {
    PR make depends t2
    PR make trigger t2
    set r [lsort [PR make todo]]
    PR make do
    list $r [lsort $::practcl_api_ran]
} -cleanup {
    PR destroy
    file delete -force $d
    unset d r ::practcl_api_ran
} -result {{t1 t2 t3} {t1 t2 t3}}

test practcl-api-42.11 {make todo when nothing is to be done} -constraints knownBug -setup {
    # The result variable is never initialised.
    mkproject ::PR
    PR make target t1 {filename x.out} {}
} -body {
    PR make todo
} -cleanup {
    PR destroy
} -result {}

test practcl-api-42.12 {make_obj check: missing output, existing output, dependency} -setup {
    mkproject ::PR
    set d [pdir make]
    set e [pwrite [file join $d exists.out] x]
    set a [PR make target a [list filename $e] {}]
    set b [PR make target b [list filename [file join $d missing.out]] {}]
    set c [PR make target c [list filename $e depends b] {}]
    set n [PR make target n [list filename $e depends nosuch] {}]
} -body {
    list [$a check] [$b check] [$c check] [$n check]
} -cleanup {
    PR destroy
    file delete -force $d
    unset d e a b c n
} -result {0 1 1 0}

test practcl-api-42.13 {make_obj output, do, triggers} -setup {
    mkproject ::PR
    set o [PR make target a {filename f1 files {f2 {} f3}} {}]
} -body {
    set r [list [$o output] [$o do]]
    $o triggers
    lappend r [$o do]
} -cleanup {
    PR destroy
    unset o r
} -result {{f1 f2 f3} 0 1}

test practcl-api-42.14 {make_obj reset} -setup {
    mkproject ::PR
    set o [PR make target a {filename f1} {}]
} -body {
    $o triggers
    $o reset
    list [$o do] [$o check]
} -cleanup {
    PR destroy
    unset o
} -result {0 0}

test practcl-api-42.15 {make reset allows a target to trigger again} -constraints knownBug -setup {
    # make_obj reset sets "triggerd" instead of "triggered".
    mkproject ::PR
    set o [PR make target a {filename f1} {}]
} -body {
    $o triggers
    PR make reset
    $o triggers
    $o do
} -cleanup {
    PR destroy
    unset o
} -result 1

test practcl-api-42.16 {make_obj constructor, action body} -setup {
    mkproject ::PR
} -body {
    set o [::practcl::make_obj new ::PR t9 {filename x} {set a 1}]
    list [$o define get name] [$o define get filename] [$o define get action]
} -cleanup {
    PR destroy
    unset o
} -result {t9 x {set a 1}}

# -------------------------------------------------------------------------
# practcl::dynamic, product, module code generation

proc mklibrary {} {
    ::practcl::library create ::LB {name foo version 1.0 output_c foo.c initfunc Foo_Init pkg_name foo}
}

test practcl-api-43.1 {include, include_dir, include_directory} -setup {
    mklibrary
} -body {
    LB include <stdio.h>
    LB include <stdio.h>
    LB include_dir /a /b
    LB include_directory /b /c
    list [LB define get include] [LB define get include_dir]
} -cleanup {
    LB destroy
} -result {<stdio.h> {/a /b /c}}

test practcl-api-43.2 {cstructure, defaults to public} -setup {
    mklibrary
} -body {
    LB cstructure Point {int x; int y;}
    LB cstructure Priv {int z;} {public 0 deleteproc PrivDelete}
    LB script {my variable cstruct; set cstruct}
} -cleanup {
    LB destroy
} -result {Point {body {int x; int y;} public 1} Priv {body {int z;} public 0 deleteproc PrivDelete}}

test practcl-api-43.3 {c_function, keywords set the flags} -setup {
    mklibrary
} -body {
    LB c_function {static int add(int a, int b)} {return a+b;}
    LB c_function {STUB_EXPORT int pub(void)} {return 0;}
    LB c_function {extern int ext(void)} {return 1;}
    LB c_function {static inline int inl(void)} {return 2;}
    LB c_function {char *ptr(void)} {return 0;}
    LB script {
	my variable cfunct
	set r {}
	foreach f {add pub ext inl *ptr} {
	    lappend r $f [dict filter [dict get $cfunct $f] key public extern export inline]
	}
	set r
    }
} -cleanup {
    LB destroy
} -result {add {export 0 extern 0 public 0 inline 0} pub {export 1 extern 1 public 1 inline 0} ext {export 0 extern 1 public 1 inline 0} inl {export 0 extern 0 public 0 inline 1} *ptr {export 0 extern 0 public 1 inline 0}}

test practcl-api-43.4 {c_function, non conforming definition is kept verbatim} -constraints knownBug -setup {
    # The warning refers to an unset variable "headers".
    mklibrary
} -body {
    LB c_function {nonsense} {x}
} -cleanup {
    LB destroy
} -match glob -result * -output "WARNING: *"

test practcl-api-43.5 {c_header, c_code accumulate code} -setup {
    mklibrary
} -body {
    LB c_header {#define X 1}
    LB c_header {#define Y 2}
    LB c_code {static int y = 2;}
} -cleanup {
    LB destroy
} -result "\nstatic int y = 2;"

test practcl-api-43.6 {cmethod, c_tcloomethod, c_tclcmd, c_tclproc_raw store definitions} -setup {
    mklibrary
} -body {
    LB cmethod m1 {return TCL_OK;}
    LB c_tcloomethod m2 {return TCL_OK;} {aliases m2a}
    LB c_tclcmd ::foo::c1 {return TCL_OK;}
    LB c_tclproc_raw ::foo::c2 {return TCL_ERROR;} {callproc MyProc}
    LB c_tclproc_nspace ::foo
    LB c_tclproc_nspace ::foo
    LB script {
	my variable methods tclprocs code
	list [dict keys $methods] [string match {Tcl_Object thisObject = *return TCL_OK;} [dict get $methods m1 body]] \
	    [dict get $methods m2 aliases] $tclprocs $code(nspace)
    }
} -cleanup {
    LB destroy
} -result {{m1 m2} 1 m2a {::foo::c1 {body {return TCL_OK;}} ::foo::c2 {callproc MyProc body {return TCL_ERROR;}}} ::foo}

test practcl-api-43.7 {tcltype generates the type functions} -setup {
    mklibrary
} -body {
    LB tcltype Foo {freeproc {free (1);} dupproc dupFoo updatestringproc {upd (1);} setfromanyproc {return TCL_OK;}}
    LB script {
	my variable tcltype cfunct
	list [dict get $tcltype Foo cname] [dict get $tcltype Foo freeproc] \
	    [dict get $tcltype Foo dupproc] [lsort [dict keys $cfunct]]
    }
} -cleanup {
    LB destroy
} -result {foo_tclobjtype FooObj_freeIntRepProc dupFoo {FooObj_freeIntRepProc FooObj_setFromAnyProc FooObj_updateStringRepProc}}

test practcl-api-43.8 {tcltype keeps an explicit cname} -constraints knownBug -setup {
    # "dict exists tcltype $name cname" tests the literal string.
    mklibrary
} -body {
    LB tcltype Foo {cname my_type freeproc f dupproc d updatestringproc u setfromanyproc s}
    LB script {my variable tcltype; dict get $tcltype Foo cname}
} -cleanup {
    LB destroy
} -result my_type

test practcl-api-43.9 {tcltype, missing function} -setup {
    mklibrary
} -body {
    LB tcltype Bar {freeproc f}
} -cleanup {
    LB destroy
} -returnCodes error -result {Bar does not define dupproc}

test practcl-api-43.10 {code, generate-tcl-pre, generate-tcl-post} -setup {
    mklibrary
} -body {
    set r [list [LB generate-tcl-pre] [LB generate-tcl-post]]
    LB code tcl {set a 1}
    LB code tcl-post {set b 2}
    lappend r [string match "*# BEGIN*set a 1*# END*" [LB generate-tcl-pre]] \
	[string match "*set b 2*" [LB generate-tcl-post]]
} -cleanup {
    LB destroy
    unset r
} -result {{} {} 1 1}

proc fillLibrary {} {
    LB include <stdio.h>
    LB c_header {#define X 1}
    LB c_code {static int y = 2;}
    LB c_function {static int add(int a, int b)} {return a+b;}
    LB c_function {STUB_EXPORT int pub(void)} {return 0;}
    LB cstructure Point {int x; int y;}
    LB c_tclproc_nspace ::foo
    LB c_tclcmd ::foo::bar {return TCL_OK;}
    LB cmethod meth {return TCL_OK;}
}

test practcl-api-43.11 {generate-h describes the public API} -setup {
    mklibrary
    fillLibrary
} -body {
    set h [LB generate-h]
    list [string match "*typedef struct Point Point;*" $h] \
	[string match "*struct Point {int x; int y;};*" $h] \
	[string match "*int Foo_Init(Tcl_Interp \\*interp);*" $h] \
	[string match "*STUB_EXPORT int pub(void);*" $h] \
	[string match "*add(*" $h]
} -cleanup {
    LB destroy
    unset h
} -result {1 1 1 1 0}

test practcl-api-43.12 {generate-c, after go} -setup {
    mklibrary
    fillLibrary
} -body {
    LB go
    LB script {my Collate_Source $::CWD}
    set c [LB generate-c]
    list [string match "*#include <tcl.h>\n#include <tclOO.h>*" $c] \
	[string match "*#include <stdio.h>*" $c] \
	[string match "*#define X 1*" $c] \
	[string match "*static int y = 2;*" $c] \
	[string match "*static int add(int a, int b)\{return a+b;\}*" $c] \
	[string match "*PointDataType*" $c] \
	[string match "*static int TclCmd_foo_bar(*" $c] \
	[string match "*OOMethod_meth(*" $c]
} -cleanup {
    LB destroy
    unset c
} -result {1 1 1 1 1 1 1 1}

test practcl-api-43.13 {generate-loader, after go} -setup {
    mklibrary
    fillLibrary
} -body {
    LB go
    LB script {my Collate_Source $::CWD}
    set l [LB generate-loader]
    list [string match "*extern int DLLEXPORT Foo_Init( Tcl_Interp \\*interp ) \{*" $l] \
	[string match {*Tcl_InitStubs(interp, "8.6", 0)*} $l] \
	[string match {*Tcl_CreateObjCommand(interp,"::foo::bar",*} $l] \
	[string match {*Tcl_PkgProvide(interp, "foo" , "1.0" )*} $l] \
	[string match "*return TCL_OK;\n\}\n" $l]
} -cleanup {
    LB destroy
    unset l
} -result {1 1 1 1 1}

test practcl-api-43.14 {generate-loader without initfunc} -setup {
    ::practcl::library create ::LB {name foo version 1.0}
} -body {
    LB generate-loader
} -cleanup {
    LB destroy
} -result {}

test practcl-api-43.15 {implement writes the .c and .h files} -setup {
    mklibrary
    fillLibrary
    set d [pdir impl]
} -body {
    LB implement $d
    list [lsort [glob -tails -directory $d *]] \
	[string match "*Foo_Init*" [pread [file join $d foo.c]]] \
	[string match "*struct Point*" [pread [file join $d foo.h]]]
} -cleanup {
    LB destroy
    file delete -force $d
    unset d
} -result {{foo.c foo.h} 1 1}

test practcl-api-43.16 {project-compile-products and project-static-packages} -setup {
    mklibrary
    set d [pdir pcp]
    pwrite [file join $d bar.c] {}
} -body {
    LB add [file join $d bar.c]
    list [lindex [LB project-compile-products] 0] [LB project-static-packages]
} -cleanup {
    LB destroy
    file delete -force $d
    unset d
} -result {foo_bar {foo {initfunc Foo_Init version 1.0 autoload 0}}}

