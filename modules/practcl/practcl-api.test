# -------------------------------------------------------------------------
# ::practcl::tcl_to_c, _tagblock

test practcl-api-18.1 {tcl_to_c quotes each line as a C string} -body {
    ::practcl::tcl_to_c "puts \"hi\"\nset a \\\\"
} -result "\n        \"puts \\\"hi\\\"\\n\" \\\n        \"set a \\\\\\\\\\n\" "

test practcl-api-18.2 {tcl_to_c result is a valid C string literal body} -body {
    # The generated text, wrapped by a C compiler, would be the original
    # script with a line feed after each line.
    set c [::practcl::tcl_to_c "a {b}\nc"]
    set out {}
    foreach {- s} [regexp -all -inline {"((?:[^"\\]|\\.)*)"} $c] {
	append out [subst -nocommands -novariables $s]
    }
    set out
} -cleanup {
    unset c out s
} -result "a {b}\nc\n"

test practcl-api-18.3 {_tagblock, tcl style} -body {
    ::practcl::_tagblock "set a 1" tcl note
} -result "\n# BEGIN note\nset a 1\n# END note"

test practcl-api-18.4 {_tagblock, c style} -body {
    ::practcl::_tagblock "int a;" c note
} -result "\n/* BEGIN note */\nint a;\n/* END note */"

test practcl-api-18.5 {_tagblock, default and unknown styles} -body {
    list [::practcl::_tagblock x] [::practcl::_tagblock x other n]
} -result [list "\n# BEGIN \nx\n# END " "\n# BEGIN n\nx\n# END n"]

test practcl-api-18.6 {_tagblock of blank text is empty} -body {
    list [::practcl::_tagblock {}] [::practcl::_tagblock " \n\t" c n]
} -result {{} {}}

