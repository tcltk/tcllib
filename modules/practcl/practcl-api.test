test practcl-api-20.1 {grep over several files} -setup {
    set a [pwrite [file join $::PracWork a.txt] "foo\nbar\nfoobar\n"]
    set b [pwrite [file join $::PracWork b.txt] "nothing\nfoo2\n"]
} -body {
    ::practcl::grep foo [list $a $b]
} -cleanup {
    file delete $a $b
    unset a b
} -result [list [file join $::PracWork a.txt]:1:foo [file join $::PracWork a.txt]:3:foobar [file join $::PracWork b.txt]:2:foo2]

test practcl-api-20.2 {grep, regular expression, no match} -setup {
    set a [pwrite [file join $::PracWork a.txt] "foo\nbar\nfoobar\n"]
} -body {
    list [::practcl::grep ^bar $a] [::practcl::grep zzz $a]
} -cleanup {
    file delete $a
