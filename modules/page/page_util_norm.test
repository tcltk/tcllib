# -*- tcl -*-
# page_util_norm.test:  Tests for the packages page::util::norm::peg and
# page::util::norm::lemon.
#
# The normalizers are meant to run inside plugins managed by
# page::pluginmgr. Here the plugin environment (the pseudo-package
# page::plugin and the page_* reporting commands) is emulated in the
# main interpreter, and the input trees are generated by the parsers
# page::parse::peg and page::parse::lemon, as done by the reader plugins.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors.  No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

# Plugin environment emulation.
package provide page::plugin 1.0
proc page_info    {args} {lappend ::reports info    $args}
proc page_warning {args} {lappend ::reports warning $args}
proc page_error   {args} {lappend ::reports error   $args}
proc page_log_info    {args} {}
proc page_log_warning {args} {}
proc page_log_error   {args} {}

support {
    use snit/snit.tcl          snit
    use cmdline/cmdline.tcl    cmdline
    use struct/list.tcl        struct::list
    use struct/sets.tcl        struct::set
    use struct/tree.tcl        struct::tree
    use treeql/treeql.tcl      treeql
    use grammar_me/me_tcl.tcl  grammar::me::tcl
    use grammar_me/me_util.tcl grammar::me::util
    useLocal util_quote.tcl    page::util::quote
    useLocal util_peg.tcl      page::util::peg
    useLocal parse_peg.tcl     page::parse::peg
    useLocal parse_lemon.tcl   page::parse::lemon
}
testing {
    useLocal util_norm_peg.tcl   page::util::norm::peg
    useLocal util_norm_lemon.tcl page::util::norm::lemon
}

# -------------------------------------------------------------------------
## Helpers

proc nextchar {} {
    global input pos cline ccol
    if {$pos >= [string length $input]} {return {}}
    set ch [string index $input $pos]
    incr pos
    set tok [list $ch {} $cline $ccol]
    if {$ch eq "\n"} {incr cline ; set ccol 0} else {incr ccol}
    return $tok
}

# Parse the text with the given parser and convert the AST into the
# struct::tree ::t. Returns the parser result.
proc parse {parser text} {
    global input pos cline ccol
    set input $text ; set pos 0 ; set cline 1 ; set ccol 0
    set ok [::page::parse::${parser}::parse ::nextchar err ast]
    if {!$ok} {return [list fail $err]}
    catch {::t destroy}
    struct::tree ::t
    ::grammar::me::util::ast2etree $ast ::grammar::me::tcl ::t
    return ok
}

proc cleanup {} {
    catch {::t destroy}
    unset -nocomplain ::input ::pos ::cline ::ccol ::reports
}

# Expression subtree as nested list.
proc expr2list {n} {
    set op [::t get $n op]
    set r [list $op]
    foreach c [::t children $n] {lappend r [expr2list $c]}
    switch -exact -- $op {
	n  {lappend r [::t get $n sym]}
	t  {lappend r [::t get $n char]}
	.. {lappend r [::t get $n begin] [::t get $n end]}
    }
    return $r
}

# Definitions: symbol -> {mode expression}
proc defs {} {
    set r {}
    foreach {sym def} [dictsort [::t get root definitions]] {
	set ch [::t children $def]
	lappend r $sym [list [::t get $def mode] [llength $ch] [expr2list [lindex $ch 0]]]
    }
    return $r
}

set calc {PEG calc (Expr)
  Expr  <- Term ('+' Term)* ;
  leaf: Term <- [0-9]+ / Unk ;
  Unused <- 'x' "y" . ;
END;
}

# -------------------------------------------------------------------------
## page::util::norm::peg

test page-util-norm-peg-1.0 {norm::peg, wrong # args} -body {
    page::util::norm::peg
} -returnCodes error -result [wrongNumArgs page::util::norm::peg {t} 0]

test page-util-norm-peg-1.1 {norm::peg, wrong # args, too many} -body {
    page::util::norm::peg a b
} -returnCodes error -result [tooManyArgs page::util::norm::peg {t}]

test page-util-norm-peg-1.2 {norm::peg, result and report} -setup {
    set reports {}
    parse peg $calc
} -body {
    list [page::util::norm::peg ::t] $reports
} -cleanup {
    cleanup
} -result {{} {info {{[PEG Normalization]}}}}

test page-util-norm-peg-1.3 {norm::peg, root attributes} -setup {
    parse peg $calc
} -body {
    page::util::norm::peg ::t
    list [lsort [::t keys root]] [::t get root name] [::t get root symbol] \
	[lsort [dict keys [::t get root definitions]]] \
	[dict keys [::t get root undefined]]
} -cleanup {
    cleanup
} -result {{definitions name start symbol undefined} calc <StartExpression> {Expr Term Unused} Unk}

test page-util-norm-peg-1.4 {norm::peg, start expression} -setup {
    parse peg $calc
} -body {
    page::util::norm::peg ::t
    set s [::t get root start]
    list [::t parent $s] [expr2list $s] \
	[expr {[::t get $s def] eq [dict get [::t get root definitions] Expr]}]
} -cleanup {
    cleanup
    unset -nocomplain s
} -result {root {n Expr} 1}

test page-util-norm-peg-1.5 {norm::peg, definitions, modes, expressions} -setup {
    parse peg $calc
} -body {
    page::util::norm::peg ::t
    defs
} -cleanup {
    cleanup
} -result {Expr {value 1 {x {n Term} {* {x {t +} {n Term}}}}} Term {leaf 1 {/ {+ {.. 0 9}} {n Unk}}} Unused {value 1 {x {t x} {t y} dot}}}

test page-util-norm-peg-1.6 {norm::peg, definition nodes} -setup {
    parse peg $calc
} -body {
    page::util::norm::peg ::t
    set r {}
    foreach {sym def} [dictsort [::t get root definitions]] {
	lappend r [::t parent $def] [::t get $def symbol] [::t get $def label] \
	    [llength [::t get $def users]] [::t get $def range_lc]
    }
    set r
} -cleanup {
    cleanup
    unset -nocomplain r sym def
} -result {root Expr Expr 1 {{2 2} {2 27}} root Term Term 2 {{3 8} {3 27}} root Unused Unused 0 {{4 2} {4 21}}}

test page-util-norm-peg-1.7 {norm::peg, nonterminal references} -setup {
    parse peg $calc
} -body {
    page::util::norm::peg ::t
    set defs [::t get root definitions]
    set r {}
    foreach u [::t get [dict get $defs Term] users] {
	lappend r [::t get $u op] [::t get $u sym] [expr {[::t get $u def] eq [dict get $defs Term]}]
    }
    set unk [lindex [dict get [::t get root undefined] Unk] 0]
    lappend r [::t get $unk sym] [::t get $unk def]
} -cleanup {
    cleanup
    unset -nocomplain r defs u unk
} -result {n Term 1 n Term 1 Unk {}}

# Note: the characters are stored unquoted, the newline is literal in
# the expected result.
test page-util-norm-peg-1.8 {norm::peg, all operators and attributes} -setup {
    parse peg {PEG g (A)
void:  A <- "abc" [a-c_] <alpha> <alnum> &B !C D? E* F+ ;
leaf:  B <- 'x' ;
match: C <- "\\" '\n' ;
       D <- (A / B) (C) ;
       E <- B ;
       F <- . ;
END;}
} -body {
    page::util::norm::peg ::t
    list [defs] [dict keys [::t get root undefined]]
} -cleanup {
    cleanup
} -result {{A {discard 1 {x {t a} {t b} {t c} {/ {.. a c} {t _}} alpha alnum {& {n B}} {! {n C}} {? {n D}} {* {n E}} {+ {n F}}}} B {leaf 1 {t x}} C {match 1 {x {t \\} {t {
}}}} D {value 1 {x {/ {n A} {n B}} {n C}}} E {value 1 {n B}} F {value 1 dot}} {}}

test page-util-norm-peg-1.9 {norm::peg, start expression not a single symbol} -setup {
    parse peg {PEG g (A B) A <- 'a'; END;}
} -body {
    page::util::norm::peg ::t
    list [expr2list [::t get root start]] [dict keys [::t get root undefined]]
} -cleanup {
    cleanup
} -result {{x {n A} {n B}} B}

test page-util-norm-peg-1.10 {norm::peg, location data of expressions} -setup {
    parse peg $calc
} -body {
    page::util::norm::peg ::t
    set def [dict get [::t get root definitions] Unused]
    set r {}
    foreach n [::t children -all $def] {lappend r [::t get $n range_lc]}
    set r
} -cleanup {
    cleanup
    unset -nocomplain def r n
} -result {{{4 12} {4 21}} {{4 13} {4 13}} {{4 17} {4 17}} {{4 20} {4 21}}}

# -------------------------------------------------------------------------
## page::util::norm::lemon

test page-util-norm-lemon-1.0 {norm::lemon, wrong # args} -body {
    page::util::norm::lemon
} -returnCodes error -result [wrongNumArgs page::util::norm::lemon {t} 0]

test page-util-norm-lemon-1.1 {norm::lemon, wrong # args, too many} -body {
    page::util::norm::lemon a b
} -returnCodes error -result [tooManyArgs page::util::norm::lemon {t}]

test page-util-norm-lemon-1.2 {norm::lemon, normalize a parsed lemon grammar} -constraints knownBug -setup {
    # page::parse::lemon calls grammar::me::tcl::ict_match_token
    # with one argument instead of two, every parse throws an error.
} -body {
    set r [parse lemon "%name calc\nexpr ::= expr PLUS term.\nexpr ::= term.\nterm ::= NUM.\n"]
    page::util::norm::lemon ::t
    list $r [::t get root name]
} -cleanup {
    cleanup
    unset -nocomplain r
} -result {ok calc}

# -------------------------------------------------------------------------

cleanup
unset calc
rename nextchar {}
rename parse {}
rename cleanup {}
rename expr2list {}
rename defs {}
foreach c {page_info page_warning page_error page_log_info page_log_warning page_log_error} {
    rename $c {}
}
unset c
package forget page::plugin
testsuiteCleanup
return
