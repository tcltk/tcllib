# -*- tcl -*-
# ripemd160-api.test: tests for the ripemd160 package, complementing
# ripemd160.test (which covers the test vectors).
#
# Covers binary results, -file and -channel input, the token based
# programming interface, and argument errors.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal ripemd160.tcl ripemd160 ::ripemd::ripemd160
}

# -------------------------------------------------------------------------

# file tempfile needs Tcl 8.6.
tcltest::testConstraint fileTempfile [package vsatisfies [package provide Tcl] 8.6-]

proc hex {s} {
    binary scan $s H* h
    return $h
}

# Creates a temporary file with the given binary contents, returns its name.
proc mkTemp {data} {
    set f [file tempfile path]
    fconfigure $f -translation binary
    puts -nonewline $f $data
    close $f
    return $path
}

set abc     8eb208f7e05d987a9b044a8e98c6b087f15a0bfc
set jefe    dda6c0213a485a9e24f4742064a7f033b43c4069
set long    [string repeat "\x00\x01\x80\xff0123456789abcdef" 700]

# -------------------------------------------------------------------------
# ripemd160

test ripemd160-api-1.1 {ripemd160, no arguments} -body {
    ::ripemd::ripemd160
} -returnCodes error -result {wrong # args: should be "ripemd160 ?-hex? -filename file | string"}

test ripemd160-api-1.2 {ripemd160, too many strings} -body {
    ::ripemd::ripemd160 -hex a b
} -returnCodes error -result {wrong # args: should be "ripemd160 ?-hex? -filename file | string"}

test ripemd160-api-1.3 {ripemd160, unknown option} -body {
    ::ripemd::ripemd160 -bogus x abc
} -returnCodes error -result {bad option -bogus: must be one of -channel, -chunksize, -filename, -hex}

test ripemd160-api-1.4 {ripemd160, binary result by default} -body {
    set r [::ripemd::ripemd160 abc]
    list [string length $r] [hex $r]
} -cleanup {
    unset -nocomplain r
} -result [list 20 $abc]

test ripemd160-api-1.5 {ripemd160, -hex} -body {
    ::ripemd::ripemd160 -hex abc
} -result $abc

test ripemd160-api-1.6 {ripemd160, -hex after other options} -body {
    ::ripemd::ripemd160 -chunksize 10 -hex -- abc
} -result $abc

test ripemd160-api-1.8 {ripemd160, -file} -constraints fileTempfile -setup {
    set path [mkTemp abc]
} -body {
    ::ripemd::ripemd160 -hex -file $path
} -cleanup {
    file delete $path
    unset -nocomplain path
} -result $abc

test ripemd160-api-1.9 {ripemd160, -filename, binary file larger than chunk size} -constraints fileTempfile -setup {
    set path [mkTemp $long]
} -body {
    list [string equal [::ripemd::ripemd160 -hex -filename $path] \
	      [::ripemd::ripemd160 -hex $long]] \
	[string equal [::ripemd::ripemd160 -filename $path] \
	     [::ripemd::ripemd160 $long]] \
	[string equal [::ripemd::ripemd160 -hex -chunksize 7 -filename $path] \
	     [::ripemd::ripemd160 -hex $long]]
} -cleanup {
    file delete $path
    unset -nocomplain path
} -result {1 1 1}

test ripemd160-api-1.10 {ripemd160, -file, empty file} -constraints fileTempfile -setup {
    set path [mkTemp ""]
} -body {
    string equal [::ripemd::ripemd160 -hex -file $path] [::ripemd::ripemd160 -hex ""]
} -cleanup {
    file delete $path
    unset -nocomplain path
} -result 1

test ripemd160-api-1.11 {ripemd160, -file, no such file} -body {
    ::ripemd::ripemd160 -file [file join [tcltest::temporaryDirectory] no-such-ripemd-file]
} -returnCodes error -match glob -result {couldn't open "*no-such-ripemd-file": no such file or directory}

test ripemd160-api-1.12 {ripemd160, -channel, channel is not closed} -constraints fileTempfile -setup {
    set path [mkTemp $long]
    set chan [open $path rb]
} -body {
    set r [::ripemd::ripemd160 -hex -channel $chan]
    list [string equal $r [::ripemd::ripemd160 -hex $long]] \
	[expr {$chan in [file channels]}] [eof $chan]
} -cleanup {
    close $chan
    file delete $path
    unset -nocomplain path chan r
} -result {1 1 1}

test ripemd160-api-1.13 {ripemd160, -channel, reads from current position} -constraints fileTempfile -setup {
    set path [mkTemp xyzabc]
    set chan [open $path rb]
    read $chan 3
} -body {
    ::ripemd::ripemd160 -hex -channel $chan
} -cleanup {
    close $chan
    file delete $path
    unset -nocomplain path chan
} -result $abc

# -------------------------------------------------------------------------
# hmac160

test ripemd160-api-2.1 {hmac160, no -key} -body {
    ::ripemd::hmac160 abc
} -returnCodes error -result {wrong # args: should be "hmac160 ?-hex? -key key -filename file | string"}

test ripemd160-api-2.2 {hmac160, no data} -body {
    ::ripemd::hmac160 -key k
} -returnCodes error -result {wrong # args: should be "hmac160 ?-hex? -key key -filename file | string"}

test ripemd160-api-2.3 {hmac160, too many strings} -body {
    ::ripemd::hmac160 -key k a b
} -returnCodes error -result {wrong # args: should be "hmac160 ?-hex? -key key -filename file | string"}

test ripemd160-api-2.4 {hmac160, unknown option} -body {
    ::ripemd::hmac160 -key k -bogus x abc
} -returnCodes error -result {bad option -bogus: must be one of -channel, -chunksize, -filename, -hex, -key}

test ripemd160-api-2.5 {hmac160, binary result by default} -body {
    set r [::ripemd::hmac160 -key Jefe "what do ya want for nothing?"]
    list [string length $r] [hex $r]
} -cleanup {
    unset -nocomplain r
} -result [list 20 $jefe]

test ripemd160-api-2.6 {hmac160, option order} -body {
    ::ripemd::hmac160 -hex -key Jefe -- "what do ya want for nothing?"
} -result $jefe

test ripemd160-api-2.7 {hmac160, -file} -constraints fileTempfile -setup {
    set path [mkTemp "what do ya want for nothing?"]
} -body {
    ::ripemd::hmac160 -hex -key Jefe -file $path
} -cleanup {
    file delete $path
    unset -nocomplain path
} -result $jefe

test ripemd160-api-2.8 {hmac160, -channel, channel is not closed} -constraints fileTempfile -setup {
    set path [mkTemp $long]
    set chan [open $path rb]
} -body {
    set r [::ripemd::hmac160 -hex -key Jefe -channel $chan]
    list [string equal $r [::ripemd::hmac160 -hex -key Jefe $long]] \
	[expr {$chan in [file channels]}]
} -cleanup {
    close $chan
    file delete $path
    unset -nocomplain path chan r
} -result {1 1}

test ripemd160-api-2.9 {hmac160, short keys are padded with zero bytes} -body {
    list [string equal [::ripemd::hmac160 -key "" abc] \
	      [::ripemd::hmac160 -key [string repeat \0 64] abc]] \
	[string equal [::ripemd::hmac160 -key k abc] \
	     [::ripemd::hmac160 -key k\0\0 abc]] \
	[string equal [::ripemd::hmac160 -key k abc] \
	     [::ripemd::hmac160 -key K abc]]
} -result {1 1 0}

# -------------------------------------------------------------------------
# Programming interface

test ripemd160-api-3.1 {RIPEMD160Init, wrong # args} -body {
    ::ripemd::RIPEMD160Init x
} -returnCodes error -result {wrong # args: should be "::ripemd::RIPEMD160Init"}

test ripemd160-api-3.2 {RIPEMD160Update, wrong # args} -body {
    ::ripemd::RIPEMD160Update x
} -returnCodes error -result {wrong # args: should be "::ripemd::RIPEMD160Update token data"}

test ripemd160-api-3.3 {RIPEMD160Final, wrong # args} -body {
    ::ripemd::RIPEMD160Final
} -returnCodes error -result {wrong # args: should be "::ripemd::RIPEMD160Final token"}

test ripemd160-api-3.4 {Init/Update/Final} -body {
    set tok [::ripemd::RIPEMD160Init]
    ::ripemd::RIPEMD160Update $tok abc
    set r [::ripemd::RIPEMD160Final $tok]
    list [string length $r] [hex $r]
} -cleanup {
    unset -nocomplain tok r
} -result [list 20 $abc]

test ripemd160-api-3.5 {Update in pieces is equivalent to a single update} -body {
    set tok [::ripemd::RIPEMD160Init]
    foreach piece {a b {} c} {
	::ripemd::RIPEMD160Update $tok $piece
    }
    hex [::ripemd::RIPEMD160Final $tok]
} -cleanup {
    unset -nocomplain tok piece
} -result $abc

test ripemd160-api-3.6 {Update in pieces of various sizes, across blocks} -body {
    set r {}
    foreach size {1 55 56 63 64 65 1000} {
	set tok [::ripemd::RIPEMD160Init]
	for {set i 0} {$i < [string length $long]} {incr i $size} {
	    ::ripemd::RIPEMD160Update $tok [string range $long $i [expr {$i+$size-1}]]
	}
	lappend r [string equal [::ripemd::RIPEMD160Final $tok] [::ripemd::ripemd160 $long]]
    }
    set r
} -cleanup {
    unset -nocomplain r size tok i
} -result {1 1 1 1 1 1 1}

test ripemd160-api-3.7 {Final with no data} -body {
    set tok [::ripemd::RIPEMD160Init]
    string equal [::ripemd::RIPEMD160Final $tok] [::ripemd::ripemd160 ""]
} -cleanup {
    unset -nocomplain tok
} -result 1

test ripemd160-api-3.8 {Final releases the token} -body {
    set tok [::ripemd::RIPEMD160Init]
    set before [info exists $tok]
    ::ripemd::RIPEMD160Final $tok
    list $before [info exists $tok]
} -cleanup {
    unset -nocomplain tok before
} -result {1 0}

test ripemd160-api-3.9 {Independent tokens} -body {
    set t1 [::ripemd::RIPEMD160Init]
    set t2 [::ripemd::RIPEMD160Init]
    ::ripemd::RIPEMD160Update $t1 ab
    ::ripemd::RIPEMD160Update $t2 xyz
    ::ripemd::RIPEMD160Update $t1 c
    list [expr {$t1 ne $t2}] [hex [::ripemd::RIPEMD160Final $t1]] \
	[string equal [::ripemd::RIPEMD160Final $t2] [::ripemd::ripemd160 xyz]]
} -cleanup {
    unset -nocomplain t1 t2
} -result [list 1 $abc 1]

test ripemd160-api-3.10 {RIPEHMAC160Init, wrong # args} -body {
    ::ripemd::RIPEHMAC160Init
} -returnCodes error -result {wrong # args: should be "::ripemd::RIPEHMAC160Init K"}

test ripemd160-api-3.11 {RIPEHMAC160Update, wrong # args} -body {
    ::ripemd::RIPEHMAC160Update x
} -returnCodes error -result {wrong # args: should be "::ripemd::RIPEHMAC160Update token data"}

test ripemd160-api-3.12 {RIPEHMAC160Final, wrong # args} -body {
    ::ripemd::RIPEHMAC160Final
} -returnCodes error -result {wrong # args: should be "::ripemd::RIPEHMAC160Final token"}

test ripemd160-api-3.13 {HMAC Init/Update/Final in pieces} -body {
    set tok [::ripemd::RIPEHMAC160Init Jefe]
    foreach piece {"what do " "ya want" "" " for nothing?"} {
	::ripemd::RIPEHMAC160Update $tok $piece
    }
    set r [::ripemd::RIPEHMAC160Final $tok]
    list [string length $r] [hex $r] [info exists $tok]
} -cleanup {
    unset -nocomplain tok piece r
} -result [list 20 $jefe 0]

test ripemd160-api-3.14 {HMAC with key longer than a block} -body {
    set key [string repeat k 100]
    set tok [::ripemd::RIPEHMAC160Init $key]
    ::ripemd::RIPEHMAC160Update $tok $long
    string equal [::ripemd::RIPEHMAC160Final $tok] [::ripemd::hmac160 -key $key $long]
} -cleanup {
    unset -nocomplain key tok
} -result 1

test ripemd160-api-3.15 {Commands are exported from ::ripemd} -body {
    lsort [namespace eval ::ripemd {namespace export}]
} -match glob -result {*RIPEHMAC160Final RIPEHMAC160Init RIPEHMAC160Update RIPEMD160Final RIPEMD160Init RIPEMD160Update*hmac160*ripemd160*}

# -------------------------------------------------------------------------

rename hex {}
rename mkTemp {}
unset abc jefe long
testsuiteCleanup
return
