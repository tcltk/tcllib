# -------------------------------------------------------------------------
# -binary

test nntp-6.0 {-binary, article retrieved as binary data} -constraints {
    knownBug
} -setup {
    set n [connect]
    $n group comp.lang.tcl
    $n configure -binary 1
} -body {
    # The server closes the connection after the article, so that the
    # test does not hang if the end of the article is not recognized.
    srv {set closeafter 1}
    $n body 2
} -cleanup {
    disconnect $n
    unset n
} -result {{Body of article 2} {.hidden line} {} {..two dots} end}

test nntp-6.1 {-binary, no translation of bytes} -constraints {
    knownBug
} -setup {
    set n [connect]
    $n group comp.lang.tcl
    $n configure -binary 1
    srv {rename artbody artbody0; proc artbody {n} {list "\xe9\xff\x80" "x\ry"}}
} -body {
    srv {set closeafter 1}
    $n body 1
} -cleanup {
    srv {rename artbody {}; rename artbody0 artbody}
    disconnect $n
    unset n
} -result [list "\xe9\xff\x80" "x\ry"]

