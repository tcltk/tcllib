# last / next

test nntp-9.0 {next} -setup {
    set n [connect]
    srv {proc cmd_NEXT {sock arg} {
	global state
	set state($sock,cur) 2
	send $sock "223 2 <2@test>"
    }}
    $n group comp.lang.tcl
} -body {
    list [$n next] [lindex [srv {set log}] end]
} -cleanup {
    srv {proc cmd_NEXT {sock arg} {move $sock 1}}
    disconnect $n
    unset n
} -result {2 NEXT}

test nntp-9.1 {next, returns the article number (RFC 977 reply text)} -constraints {
    knownBug
} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    $n next
} -cleanup {
    disconnect $n
    unset n
} -result 2

