# -*- tcl -*-
# nntp-api.test:  tests for the documented API of the nntp client.
#
# The client uses blocking sockets, so the fake NNTP server runs in a
# child process.  The child is controlled through its standard input:
# the tests send it Tcl scripts and read back the results.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors.  No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

testing {
    useLocal nntp.tcl nntp
}

# -------------------------------------------------------------------------
# Child process running scripts sent by the tests.

set childScript {
    fconfigure stdin  -translation lf -encoding utf-8
    fconfigure stdout -translation lf -encoding utf-8
    proc ctl {} {
	if {[gets stdin n] < 0} {exit}
	set script [read stdin $n]
	set code [catch {uplevel #0 $script} res]
	set reply [list $code $res]
	puts stdout [string length $reply]
	puts -nonewline stdout $reply
	flush stdout
    }
    fileevent stdin readable ctl
    vwait forever
}

proc srvstart {} {
    set f [makeFile $::childScript nntpchild.tcl]
    set ::srvpipe [open |[list [info nameofexecutable] $f] r+]
    fconfigure $::srvpipe -translation lf -encoding utf-8 -buffering full
}

proc srv {script} {
    puts $::srvpipe [string length $script]
    puts -nonewline $::srvpipe $script
    flush $::srvpipe
    set n [gets $::srvpipe]
    if {![string is integer -strict $n]} {
	error "server child died"
    }
    set reply [read $::srvpipe $n]
    lassign $reply code res
    return -code $code $res
}

proc srvstop {} {
    catch {close $::srvpipe}
    unset ::srvpipe
    removeFile nntpchild.tcl
}

# -------------------------------------------------------------------------
# Fake NNTP server (RFC 977 and common extensions), evaluated in the child.

set serverScript {
    proc reset {} {
	global log bare posted reply greeting canpost users groups closeafter
	set log {}
	set bare {}
	set posted {}
	array unset reply
	array set reply {}
	set greeting "200 fake news server ready - posting allowed"
	set canpost 1
	set users {joe secret}
	set groups {
	    comp.lang.tcl  {1 2 3}
	    alt.test       {}
	    alt.test-group {1 2 3}
	}
	set closeafter 0
    }

    proc arthead {n} {
	list "From: user$n@example.com" "Subject: Test $n" \
	    "Message-ID: <$n@test>" "Newsgroups: comp.lang.tcl"
    }
    proc artbody {n} {
	if {$n == 2} {
	    return [list "Body of article 2" ".hidden line" "" "..two dots" end]
	}
	list "Body of article $n"
    }

    proc accept {sock host port} {
	global state greeting
	fconfigure $sock -translation {binary crlf} -encoding iso8859-1 \
	    -buffering full -blocking 0
	set state($sock,group) {}
	set state($sock,cur) {}
	set state($sock,user) {}
	set state($sock,mode) cmd
	set state($sock,post) {}
	send $sock $greeting
	fileevent $sock readable [list readline $sock]
    }

    proc send {sock args} {
	foreach line $args {
	    puts $sock $line
	}
	flush $sock
    }

    # Sends a multi-line block with dot-stuffing.
    proc block {sock status lines} {
	puts $sock $status
	foreach line $lines {
	    if {[string index $line 0] eq "."} {set line .$line}
	    puts $sock $line
	}
	puts $sock .
	flush $sock
	global closeafter
	if {$closeafter} {closeconn $sock}
    }

    proc closeconn {sock} {
	global state
	array unset state $sock,*
	close $sock
    }

    proc readline {sock} {
	global state log reply posted
	if {[catch {gets $sock line} n] || $n < 0} {
	    if {[catch {eof $sock}] || [eof $sock]} {closeconn $sock}
	    return
	}
	# Lines must end with CR LF; remember those that do not.
	if {[string index $line end] eq "\r"} {
	    set line [string range $line 0 end-1]
	} else {
	    lappend ::bare $line
	}
	if {$state($sock,mode) eq "post"} {
	    if {$line eq "."} {
		set state($sock,mode) cmd
		lappend posted $state($sock,post)
		set state($sock,post) {}
		send $sock "240 article posted ok"
	    } else {
		if {[string index $line 0] eq "."} {
		    set line [string range $line 1 end]
		}
		lappend state($sock,post) $line
	    }
	    return
	}
	set line [string trimright $line]
	lappend log $line
	if {[info exists reply($line)]} {
	    set r $reply($line)
	    if {$r eq "CLOSE"} {
		closeconn $sock
	    } else {
		eval [list send $sock] $r
	    }
	    return
	}
	set cmd [string toupper [lindex [split $line] 0]]
	set arg [string trim [string range $line [string length $cmd] end]]
	if {[info commands cmd_$cmd] eq ""} {
	    send $sock "500 command not recognized"
	    return
	}
	cmd_$cmd $sock $arg
    }

    proc grouparts {sock} {
	global state groups
	dict get $groups $state($sock,group)
    }

    # Selects an article; returns its number or "" after sending an error.
    proc selectart {sock arg} {
	global state
	if {[string match <*> $arg]} {
	    if {[regexp {^<(\d+)@test>$} $arg -> n] && $n >= 1 && $n <= 3} {
		return $n
	    }
	    send $sock "430 no such article found"
	    return
	}
	if {$state($sock,group) eq ""} {
	    send $sock "412 no newsgroup has been selected"
	    return
	}
	if {$arg eq ""} {
	    if {$state($sock,cur) eq ""} {
		send $sock "420 no current article has been selected"
		return
	    }
	    return $state($sock,cur)
	}
	if {[lsearch -exact [grouparts $sock] $arg] < 0} {
	    send $sock "423 no such article number in this group"
	    return
	}
	set state($sock,cur) $arg
	return $arg
    }

    proc cmd_ARTICLE {sock arg} {
	set n [selectart $sock $arg]
	if {$n eq ""} return
	block $sock "220 $n <$n@test> article retrieved - head and body follow" \
	    [concat [arthead $n] [list {}] [artbody $n]]
    }
    proc cmd_HEAD {sock arg} {
	set n [selectart $sock $arg]
	if {$n eq ""} return
	block $sock "221 $n <$n@test> article retrieved - head follows" [arthead $n]
    }
    proc cmd_BODY {sock arg} {
	set n [selectart $sock $arg]
	if {$n eq ""} return
	block $sock "222 $n <$n@test> article retrieved - body follows" [artbody $n]
    }
    proc cmd_STAT {sock arg} {
	set n [selectart $sock $arg]
	if {$n eq ""} return
	send $sock "223 $n <$n@test> article retrieved - request text separately"
    }
    proc cmd_GROUP {sock arg} {
	global state groups
	if {![dict exists $groups $arg]} {
	    send $sock "411 no such news group"
	    return
	}
	set state($sock,group) $arg
	set arts [dict get $groups $arg]
	if {[llength $arts]} {
	    set state($sock,cur) [lindex $arts 0]
	    send $sock "211 [llength $arts] [lindex $arts 0] [lindex $arts end] $arg group selected"
	} else {
	    set state($sock,cur) {}
	    send $sock "211 0 1 0 $arg group selected"
	}
    }
    proc cmd_HELP {sock arg} {
	block $sock "100 help text follows" {
	    {  article [MessageID|Number]} {  body [MessageID|Number]}
	    {  group newsgroup} {  quit}
	}
    }
    proc move {sock dir} {
	global state
	if {$state($sock,group) eq ""} {
	    send $sock "412 no newsgroup selected"
	    return
	}
	if {$state($sock,cur) eq ""} {
	    send $sock "420 no current article has been selected"
	    return
	}
	set arts [grouparts $sock]
	set i [expr {[lsearch -exact $arts $state($sock,cur)] + $dir}]
	if {$i < 0} {
	    send $sock "422 no previous article in this group"
	    return
	}
	if {$i >= [llength $arts]} {
	    send $sock "421 no next article in this group"
	    return
	}
	set n [lindex $arts $i]
	set state($sock,cur) $n
	send $sock "223 $n <$n@test> article retrieved - request text separately"
    }
    proc cmd_LAST {sock arg} {move $sock -1}
    proc cmd_NEXT {sock arg} {move $sock 1}
    proc cmd_LIST {sock arg} {
	if {$arg ne "" && $arg ne "ACTIVE"} {
	    send $sock "501 syntax error"
	    return
	}
	block $sock "215 list of newsgroups follows" {
	    {comp.lang.tcl 0000000003 0000000001 y}
	    {alt.test 0000000000 0000000001 n}
	    {alt.test-group 0000000003 0000000001 m}
	}
    }
    proc cmd_LISTGROUP {sock arg} {
	global state groups
	if {$arg ne ""} {
	    if {![dict exists $groups $arg]} {
		send $sock "411 no such news group"
		return
	    }
	    set state($sock,group) $arg
	}
	if {$state($sock,group) eq ""} {
	    send $sock "412 no newsgroup selected"
	    return
	}
	block $sock "211 article numbers follow" [grouparts $sock]
    }
    proc cmd_MODE {sock arg} {
	if {[string toupper $arg] eq "READER"} {
	    send $sock "200 reader mode, posting permitted"
	} else {
	    send $sock "501 unknown mode"
	}
    }
    proc cmd_NEWGROUPS {sock arg} {
	block $sock "231 list of new newsgroups follows" {
	    {alt.test-group 0000000003 0000000001 m}
	}
    }
    proc cmd_NEWNEWS {sock arg} {
	block $sock "230 list of new articles by message-id follows" {<1@test> <3@test>}
    }
    proc cmd_POST {sock arg} {
	global state canpost
	if {!$canpost} {
	    send $sock "440 posting not allowed"
	    return
	}
	set state($sock,mode) post
	send $sock "340 send article to be posted. End with <CR-LF>.<CR-LF>"
    }
    proc cmd_SLAVE {sock arg} {
	send $sock "202 slave status noted"
    }
    proc cmd_QUIT {sock arg} {
	send $sock "205 closing connection - goodbye!"
	closeconn $sock
    }
    proc cmd_AUTHINFO {sock arg} {
	global state users
	lassign $arg what value
	switch -- [string toupper $what] {
	    USER {
		set state($sock,user) $value
		send $sock "381 more authentication information required"
	    }
	    PASS {
		set u $state($sock,user)
		if {$u ne "" && [dict exists $users $u] &&
		    [dict get $users $u] eq $value} {
		    send $sock "281 authentication accepted"
		} else {
		    send $sock "481 authentication rejected"
		}
	    }
	    default {
		send $sock "501 syntax error"
	    }
	}
    }
    proc cmd_DATE {sock arg} {
	send $sock "111 20261121103000"
    }
    proc cmd_XGTITLE {sock arg} {
	set lines {}
	foreach {g d} {comp.lang.tcl {The Tcl language} alt.test {Testing}} {
	    if {$arg eq "" || [string match $arg $g]} {
		lappend lines "$g\t$d"
	    }
	}
	block $sock "282 list of groups and descriptions follows" $lines
    }
    # Parses an article range; returns a list of article numbers.
    proc range {sock arg} {
	global state
	if {$arg eq ""} {
	    if {$state($sock,cur) eq ""} {return {}}
	    return [list $state($sock,cur)]
	}
	if {[regexp {^(\d+)-(\d*)$} $arg -> a b]} {
	    if {$b eq ""} {set b 999999}
	} elseif {[regexp {^\d+$} $arg]} {
	    set a $arg
	    set b $arg
	} else {
	    return {}
	}
	set res {}
	foreach n [grouparts $sock] {
	    if {$n >= $a && $n <= $b} {lappend res $n}
	}
	return $res
    }
    proc header {n field} {
	foreach h [arthead $n] {
	    if {[string equal -nocase -length [string length $field:] $field: $h]} {
		return [string trim [string range $h [string length $field:] end]]
	    }
	}
	return {}
    }
    proc cmd_XHDR {sock arg} {
	global state
	if {$state($sock,group) eq ""} {
	    send $sock "412 no newsgroup selected"
	    return
	}
	set field [lindex [split $arg] 0]
	set r [string trim [string range $arg [string length $field] end]]
	set lines {}
	foreach n [range $sock $r] {
	    lappend lines "$n [header $n $field]"
	}
	block $sock "221 $field fields follow" $lines
    }
    proc cmd_XOVER {sock arg} {
	global state
	if {$state($sock,group) eq ""} {
	    send $sock "412 no newsgroup selected"
	    return
	}
	set lines {}
	foreach n [range $sock $arg] {
	    lappend lines [join [list $n "Test $n" "user$n@example.com" \
		"21 Nov 2026 10:0$n:00 GMT" <$n@test> {} [expr {100 + $n}] \
		[expr {10 + $n}] "Xref: test comp.lang.tcl:$n"] \t]
	}
	block $sock "224 overview information follows" $lines
    }
    proc cmd_XPAT {sock arg} {
	global state
	if {$state($sock,group) eq ""} {
	    send $sock "412 no newsgroup selected"
	    return
	}
	set words [regexp -all -inline {\S+} $arg]
	set pats [lrange $words 2 end]
	set lines {}
	foreach n [range $sock [lindex $words 1]] {
	    set v [header $n [lindex $words 0]]
	    foreach p $pats {
		if {[string match $p $v]} {
		    lappend lines "$n $v"
		    break
		}
	    }
	}
	block $sock "221 header follows" $lines
    }

    reset
    set listener [socket -server accept -myaddr 127.0.0.1 0]
    lindex [fconfigure $listener -sockname] 2
}

srvstart
set port [srv $serverScript]

# A free port with nothing listening on it.
proc freeport {} {
    set s [socket -server {} -myaddr 127.0.0.1 0]
    set p [lindex [fconfigure $s -sockname] 2]
    close $s
    return $p
}

# Connection setup and cleanup used by most tests.
proc connect {} {
    srv reset
    ::nntp::nntp 127.0.0.1 $::port
}
proc disconnect {name} {
    if {[llength [info commands ::$name]]} {
	catch {$name quit}
	if {[llength [info commands ::$name]]} {
	    catch {close [set ::nntp::${name}data(sock)]}
	    rename ::$name {}
	}
    }
    unset -nocomplain ::nntp::${name}data ::nntp::socks($name)
}

set allmethods {article, authinfo, body, date, group, head, help, last, list, listgroup, mode_reader, newgroups, newnews, next, post, stat, quit, xgtitle, xhdr, xover, or xpat}

# -------------------------------------------------------------------------
# ::nntp::nntp

test nntp-1.0 {nntp, too many args} -body {
    ::nntp::nntp a b c d
} -returnCodes error -result {wrong # args: should be "::nntp::nntp ?server? ?port? ?name?"}

test nntp-1.1 {nntp, generated name} -setup {
    srv reset
} -body {
    set n [::nntp::nntp 127.0.0.1 $port]
    list $n [info commands ::$n] [srv {set log}]
} -cleanup {
    disconnect $n
    unset n
} -result {nntp0 ::nntp0 {}}

test nntp-1.2 {nntp, generated names are unique} -setup {
    srv reset
    set n1 [::nntp::nntp 127.0.0.1 $port]
} -body {
    set n2 [::nntp::nntp 127.0.0.1 $port]
    list $n1 $n2
} -cleanup {
    disconnect $n1
    disconnect $n2
    unset n1 n2
} -result {nntp0 nntp1}

test nntp-1.3 {nntp, explicit name} -setup {
    srv reset
} -body {
    set n [::nntp::nntp 127.0.0.1 $port mynews]
    list $n [info commands ::mynews]
} -cleanup {
    disconnect $n
    unset n
} -result {mynews ::mynews}

test nntp-1.4 {nntp, name of an existing command} -setup {
    proc ::mynews {} {}
} -body {
    ::nntp::nntp 127.0.0.1 $port mynews
} -cleanup {
    rename ::mynews {}
    unset -nocomplain ::nntp::mynewsdata ::nntp::socks(mynews)
} -returnCodes error -result {command "mynews" already exists, unable to create nntp connection}

test nntp-1.5 {nntp, connection refused} -setup {
    set p [freeport]
} -body {
    ::nntp::nntp 127.0.0.1 $p mynews
} -cleanup {
    unset -nocomplain p ::nntp::mynewsdata ::nntp::socks(mynews)
} -returnCodes error -match glob -result {couldn't open socket: *}

test nntp-1.6 {nntp, server error in the greeting} -setup {
    srv reset
    srv {set greeting "400 service discontinued"}
} -body {
    ::nntp::nntp 127.0.0.1 $port mynews
} -cleanup {
    disconnect mynews
} -returnCodes error -result {NNTPERROR: 400 service discontinued}

test nntp-1.7 {nntp, no command is left after an error in the greeting} -constraints {
    knownBug
} -setup {
    srv reset
    srv {set greeting "400 service discontinued"}
} -body {
    catch {::nntp::nntp 127.0.0.1 $port mynews}
    info commands ::mynews
} -cleanup {
    disconnect mynews
} -result {}

test nntp-1.8 {nntp, greeting without posting} -setup {
    srv reset
    srv {set greeting "201 fake news server ready - no posting allowed"}
} -body {
    ::nntp::nntp 127.0.0.1 $port mynews
} -cleanup {
    disconnect mynews
} -result mynews

test nntp-1.9 {nntp, connection closed instead of a greeting} -setup {
    srv reset
    srv {set greeting ""}
} -body {
    ::nntp::nntp 127.0.0.1 $port mynews
} -cleanup {
    disconnect mynews
} -returnCodes error -match glob -result "nntp: unexpected EOF on *"

test nntp-1.10 {nntp, default port from NNTPPORT} -setup {
    srv reset
    set env(NNTPPORT) $port
} -body {
    set n [::nntp::nntp 127.0.0.1]
    $n date
} -cleanup {
    disconnect $n
    unset n env(NNTPPORT)
} -result 20261121103000

test nntp-1.11 {nntp, default port from NNTPPORT, empty port} -setup {
    srv reset
    set env(NNTPPORT) $port
} -body {
    set n [::nntp::nntp 127.0.0.1 ""]
    $n date
} -cleanup {
    disconnect $n
    unset n env(NNTPPORT)
} -result 20261121103000

test nntp-1.12 {nntp, default host from NNTPHOST (documented)} -constraints {
    knownBug
} -setup {
    srv reset
    unset -nocomplain env(NNTPSERVER)
    set env(NNTPHOST) 127.0.0.1
    # Never look up the default host "news".
    rename ::socket ::nntptest_socket
    proc ::socket {args} {
	if {[lindex $args end-1] ne "127.0.0.1"} {
	    error "test: connection to [lindex $args end-1] refused"
	}
	uplevel 1 [linsert $args 0 ::nntptest_socket]
    }
} -body {
    set n [::nntp::nntp "" $port]
    $n date
} -cleanup {
    rename ::socket {}
    rename ::nntptest_socket ::socket
    catch {disconnect $n}
    unset -nocomplain n env(NNTPHOST)
} -result 20261121103000

test nntp-1.13 {nntp, default host from NNTPSERVER (implemented)} -setup {
    srv reset
    unset -nocomplain env(NNTPHOST)
    set env(NNTPSERVER) 127.0.0.1
} -body {
    set n [::nntp::nntp "" $port]
    $n date
} -cleanup {
    disconnect $n
    unset n env(NNTPSERVER)
} -result 20261121103000

test nntp-1.14 {nntp, all defaults from the environment} -setup {
    srv reset
    set env(NNTPSERVER) 127.0.0.1
    set env(NNTPPORT) $port
} -body {
    set n [::nntp::nntp]
    $n date
} -cleanup {
    disconnect $n
    unset n env(NNTPSERVER) env(NNTPPORT)
} -result 20261121103000

test nntp-1.15 {nntp, namespace export} -body {
    namespace eval ::nntp {namespace export}
} -result nntp

# -------------------------------------------------------------------------
# Access command dispatch

test nntp-2.0 {access command, no method} -setup {
    set n [connect]
} -body {
    $n
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {wrong # args: should be "nntp0 option ?arg arg ...?"}

test nntp-2.1 {access command, unknown method} -setup {
    set n [connect]
} -body {
    $n foo
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result "bad option \"foo\": must be $allmethods"

test nntp-2.2 {access command, empty method} -setup {
    set n [connect]
} -body {
    $n ""
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result "bad option \"\": must be $allmethods"

test nntp-2.3 {access command, glob characters in method} -constraints {
    knownBug
} -setup {
    set n [connect]
} -body {
    $n *
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result "bad option \"*\": must be $allmethods"

test nntp-2.4 {access command, wrong # args for a method} -setup {
    set n [connect]
} -body {
    $n date extra
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {wrong # args: should be "::nntp::_date name"}

# -------------------------------------------------------------------------
# configure / cget

test nntp-3.0 {configure, no args} -setup {
    set n [connect]
} -body {
    $n configure
} -cleanup {
    disconnect $n
    unset n
} -result {-binary 0}

test nntp-3.1 {configure, query option} -setup {
    set n [connect]
} -body {
    $n configure -binary
} -cleanup {
    disconnect $n
    unset n
} -result 0

test nntp-3.2 {configure, set option} -setup {
    set n [connect]
} -body {
    list [$n configure -binary 1] [$n configure -binary] [$n cget -binary] \
	[$n configure -binary off] [$n cget -binary] [$n configure]
} -cleanup {
    disconnect $n
    unset n
} -result {{} 1 1 {} off {-binary off}}

test nntp-3.3 {configure, set option twice} -setup {
    set n [connect]
} -body {
    $n configure -binary 1 -binary 0
    $n cget -binary
} -cleanup {
    disconnect $n
    unset n
} -result 0

test nntp-3.4 {configure, bad option} -setup {
    set n [connect]
} -body {
    $n configure -foo
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {Illegal option "-foo", expected "-binary"}

test nntp-3.5 {configure, set bad option} -setup {
    set n [connect]
} -body {
    $n configure -foo 1
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {Illegal option "-foo", expected "-binary"}

test nntp-3.6 {configure, missing value} -setup {
    set n [connect]
} -body {
    $n configure -binary 1 -binary
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {wrong#args: expected even number of elements}

test nntp-3.7 {configure, bad boolean} -setup {
    set n [connect]
} -body {
    list [catch {$n configure -binary maybe} msg] $msg [$n cget -binary]
} -cleanup {
    disconnect $n
    unset n msg
} -result {1 {Expected boolean, got "maybe"} 0}

test nntp-3.8 {cget, bad option} -setup {
