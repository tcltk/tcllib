    $n group alt.test
} -body {
    $n newnews "2026-01-02 03:04:05"
    lindex [srv {set log}] end
} -cleanup {
    disconnect $n
    unset n
} -result {NEWNEWS alt.test 260102 030405}

test nntp-11.2 {newnews, time only, no current group} -setup {
    set n [connect]
} -body {
    $n newnews "2026-01-02 03:04:05"
    srv {set log}
} -cleanup {
    disconnect $n
    unset n
} -result {{NEWNEWS * 260102 030405}}

test nntp-11.3 {newnews, no args: current group, last day} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    $n newnews
    set cmd [lindex [srv {set log}] end]
    set since [clock scan [lrange $cmd 2 3] -format {%y%m%d %H%M%S}]
    list [lrange $cmd 0 1] [expr {[clock seconds] - $since <= 2*86400}] \
	[expr {$since < [clock seconds]}]
} -cleanup {
    disconnect $n
    unset -nocomplain n cmd since
} -result {{NEWNEWS comp.lang.tcl} 1 1}

test nntp-11.4 {newnews, group only, last day} -setup {
    set n [connect]
} -body {
    $n newnews alt.test
    lrange [lindex [srv {set log}] end] 0 1
} -cleanup {
    disconnect $n
    unset n
} -result {NEWNEWS alt.test}

test nntp-11.5 {newnews, default time in a time zone with unusual abbreviation, ticket 937e32f95e} -constraints {
    knownBug
} -setup {
    set n [connect]
    set oldtz [array get env TZ]
    set env(TZ) :Australia/Sydney
} -body {
    $n newnews alt.test
    lrange [lindex [srv {set log}] end] 0 1
} -cleanup {
    unset env(TZ)
    array set env $oldtz
    disconnect $n
    unset n oldtz
} -result {NEWNEWS alt.test}

test nntp-11.6 {newnews, group of a previous connection is not used} -constraints {
    knownBug
