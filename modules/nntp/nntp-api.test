    unset n
} -result {3 <3@test>}

test nntp-9.4 {last} -setup {
    set n [connect]
    srv {proc cmd_LAST {sock arg} {
	global state
	set state($sock,cur) 1
	send $sock "223 1 <1@test>"
    }}
    $n group comp.lang.tcl
    $n stat 2
} -body {
    list [$n last] [lindex [srv {set log}] end]
} -cleanup {
    srv {proc cmd_LAST {sock arg} {move $sock -1}}
    disconnect $n
    unset n
} -result {1 LAST}

test nntp-9.5 {last, returns the article number (RFC 977 reply text)} -constraints {
    knownBug
} -setup {
