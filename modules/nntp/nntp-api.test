# -------------------------------------------------------------------------
# post

test nntp-12.0 {post} -setup {
    set n [connect]
} -body {
    set article "From: joe@example.com\nNewsgroups: alt.test\nSubject: test\n\nbody line\n.dot line\nlast"
    list [$n post $article] [srv {set log}] [srv {set posted}]
} -cleanup {
    disconnect $n
    unset n article
} -result {1 POST {{{From: joe@example.com} {Newsgroups: alt.test} {Subject: test} {} {body line} {.dot line} last}}}

test nntp-12.1 {post, line with a single dot} -setup {
    set n [connect]
} -body {
    $n post "Subject: x\n\n.\nafter"
    list [srv {set posted}] [$n date]
} -cleanup {
    disconnect $n
    unset n
} -result {{{{Subject: x} {} . after}} 20261121103000}

test nntp-12.2 {post, not allowed} -setup {
    set n [connect]
    srv {set canpost 0}
} -body {
    list [catch {$n post "Subject: x\n\nbody"} msg] $msg [srv {set posted}] [$n date]
} -cleanup {
    disconnect $n
    unset n msg
} -result {1 {NNTPERROR: 440 posting not allowed} {} 20261121103000}

test nntp-12.3 {post, failed} -setup {
    set n [connect]
    srv {proc cmd_POST {sock arg} {
	send $sock "340 send article"
	fileevent $sock readable [list readbody $sock]
    }
    proc readbody {sock} {
	if {[gets $sock line] < 0} return
	if {$line eq ".\r"} {
	    send $sock "441 posting failed"
	    fileevent $sock readable [list readline $sock]
	}
    }}
} -body {
    $n post "Subject: x\n\nbody"
} -cleanup {
    srv {proc cmd_POST {sock arg} {
	global state canpost
	if {!$canpost} {
	    send $sock "440 posting not allowed"
	    return
	}
	set state($sock,mode) post
	send $sock "340 send article to be posted. End with <CR-LF>.<CR-LF>"
    }}
    disconnect $n
    unset n
} -returnCodes error -result {NNTPERROR: 441 posting failed}

test nntp-12.4 {post, wrong # args} -setup {
    set n [connect]
} -body {
    $n post
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {wrong # args: should be "::nntp::_post name article"}

# -------------------------------------------------------------------------
# xhdr / xover / xpat

test nntp-13.0 {xhdr, current article} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xhdr subject] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{1 Test 1}} {XHDR subject}}

test nntp-13.1 {xhdr, empty range} -setup {
    set n [connect]
    $n group comp.lang.tcl
    $n stat 2
} -body {
    list [$n xhdr from ""] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{2 user2@example.com}} {XHDR from}}

test nntp-13.2 {xhdr, range m1-m2} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xhdr subject 2-3] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{2 Test 2} {3 Test 3}} {XHDR subject 2-3}}

test nntp-13.3 {xhdr, range m1 m2} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xhdr subject 1 2] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{1 Test 1} {2 Test 2}} {XHDR subject 1-2}}

test nntp-13.4 {xhdr, default field} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xhdr] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{1 <1@test>}} {XHDR message-id}}

test nntp-13.5 {xhdr, error} -setup {
    set n [connect]
} -body {
    $n xhdr subject
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {NNTPERROR: 412 no newsgroup selected}

test nntp-13.6 {xover, current article} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xover] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result [list [list "1\tTest 1\tuser1@example.com\t21 Nov 2026 10:01:00 GMT\t<1@test>\t\t101\t11\tXref: test comp.lang.tcl:1"] XOVER]

test nntp-13.7 {xover, range m1-m2} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    set res [$n xover 1-2]
    set ids {}
    foreach line $res {
	lappend ids [lindex [split $line \t] 0] [lindex [split $line \t] 4]
    }
    list $ids [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n res ids line
} -result {{1 <1@test> 2 <2@test>} {XOVER 1-2}}

test nntp-13.8 {xover, range m1 m2} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [llength [$n xover 2 3]] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {2 {XOVER 2-3}}

test nntp-13.9 {xover, empty range} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [llength [$n xover ""]] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {1 XOVER}

test nntp-13.10 {xover, error} -setup {
    set n [connect]
} -body {
    $n xover 1-2
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {NNTPERROR: 412 no newsgroup selected}

test nntp-13.11 {xpat, range m1-m2 and pattern} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xpat subject 1-3 {*[13]}] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{1 Test 1} {3 Test 3}} {XPAT subject 1-3 *[13]}}

test nntp-13.12 {xpat, range m1-m2, no pattern} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xpat from 2-3] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{2 user2@example.com} {3 user3@example.com}} {XPAT from 2-3 *}}

test nntp-13.13 {xpat, range m1 m2 and patterns} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    set res [$n xpat subject 1 3 *1 *2]
    list $res [regsub -all { +} [lindex [srv {set log}] end] { }]
} -cleanup {
    disconnect $n
    unset n res
} -result {{{1 Test 1} {2 Test 2}} {XPAT subject 1-3 *1 *2}}

test nntp-13.14 {xpat, pattern list} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xpat subject 1-3 {*1 *3}] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{1 Test 1} {3 Test 3}} {XPAT subject 1-3 *1 *3}}

test nntp-13.15 {xpat, single article, no pattern} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xpat subject 2] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{{2 Test 2}} {XPAT subject 2 *}}

test nntp-13.16 {xpat, single article and pattern} -constraints {
    knownBug
} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    list [$n xpat subject 2 *3] [lindex [srv {set log}] end]
} -cleanup {
    disconnect $n
    unset n
} -result {{} {XPAT subject 2 *3}}

test nntp-13.17 {xpat, error} -setup {
    set n [connect]
} -body {
    $n xpat subject 1-3 *
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {NNTPERROR: 412 no newsgroup selected}

# -------------------------------------------------------------------------
# quit

test nntp-14.0 {quit} -setup {
    set n [connect]
} -body {
    list [$n quit] [info commands ::$n] [srv {set log}]
} -cleanup {
    disconnect $n
    unset n
} -result {1 {} QUIT}

test nntp-14.1 {quit, name can be reused} -setup {
    set n [connect]
    $n quit
} -body {
    set n2 [::nntp::nntp 127.0.0.1 $port]
    list $n2 [$n2 date]
} -cleanup {
    disconnect $n2
    unset n n2
} -result {nntp0 20261121103000}

test nntp-14.2 {quit, wrong # args} -setup {
    set n [connect]
} -body {
    $n quit now
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {wrong # args: should be "::nntp::_quit name"}

# -------------------------------------------------------------------------
# Server responses

test nntp-15.0 {connection closed by the server} -setup {
    set n [connect]
    srv {set reply(HELP) CLOSE}
} -body {
    $n help
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -match glob -result "nntp: unexpected EOF on *"

test nntp-15.1 {garbled response} -setup {
    set n [connect]
    srv {set reply(DATE) {{what?}}}
} -body {
    $n date
} -cleanup {
    disconnect $n
    unset n
} -result {} -errorOutput "nntp garbled response: what?\n\n"

test nntp-15.2 {response line with CR LF} -setup {
    set n [connect]
    srv {set reply(DATE) [list "111 20250101000000\r"]}
} -body {
    $n date
} -cleanup {
    disconnect $n
    unset n
} -result 20250101000000

test nntp-15.3 {error reply to a multi-line request} -setup {
    set n [connect]
} -body {
    $n xhdr
} -cleanup {
    disconnect $n
    unset n
} -returnCodes error -result {NNTPERROR: 412 no newsgroup selected}

test nntp-15.4 {commands are sent with CR LF} -setup {
    set n [connect]
    $n group comp.lang.tcl
} -body {
    $n article 1
    $n xover 1-2
    $n post "Subject: x\n\nbody\nmore"
    $n quit
    srv {set bare}
} -cleanup {
    disconnect $n
    unset n
} -result {}

# -------------------------------------------------------------------------

srvstop
rename srvstart {}
rename srv {}
rename srvstop {}
rename connect {}
rename disconnect {}
rename freeport {}
unset childScript serverScript port allmethods
testsuiteCleanup
return
