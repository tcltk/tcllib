source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use md5/md5x.tcl md5
    use log/logger.tcl logger
    use mime/mime.tcl mime
}
testing {
    useLocal smtpd.tcl smtpd
}

::smtpd::configure -loglevel critical

# -------------------------------------------------------------------------
# Talks to the server, line by line, from the event loop.  Returns the
# replies of the server, one per line sent.

proc dialog {port lines} {
    set sock [socket 127.0.0.1 $port]
    fconfigure $sock -translation crlf -buffering line -blocking 0
    set ::dialog(replies) {}
    set ::dialog(lines) $lines
    fileevent $sock readable [list dialogread $sock]
    set ::dialog(done) 0
    set id [after 5000 {set ::dialog(done) timeout}]
    vwait ::dialog(done)
    after cancel $id
    close $sock
    return $::dialog(replies)
}

proc dialogread {sock} {
    if {[gets $sock reply] < 0} {
        if {[eof $sock]} {set ::dialog(done) eof}
        return
    }
    if {[string index $reply 3] eq "-"} return
    lappend ::dialog(replies) [string range $reply 0 2]
    if {![llength $::dialog(lines)]} {
        set ::dialog(done) 1
        return
    }
    # Send the lines up to and including the next command.
    while {[llength $::dialog(lines)]} {
        set line [lindex $::dialog(lines) 0]
        set ::dialog(lines) [lrange $::dialog(lines) 1 end]
        if {$line eq "-"} break
        puts $sock $line
    }
}

proc deliverto {var from to data} {
    lappend ::$var $from $to
}

# -------------------------------------------------------------------------
# Tests
# -------------------------------------------------------------------------

test smtpd-1.1 {-deliver with a command prefix, ticket 1dd19ccd14} -setup {
    set delivered {}
    ::smtpd::configure -deliver [list deliverto delivered]
    set port [lindex [fconfigure [::smtpd::start 127.0.0.1 0] -sockname] 2]
} -body {
    list [dialog $port {
        {HELO client} -
        {MAIL FROM:<a@example.com>} -
        {RCPT TO:<b@example.com>} -
        DATA -
        {Subject: test} {} hello . -
        QUIT
    }] $delivered
} -cleanup {
    ::smtpd::stop
    ::smtpd::configure -deliver {}
    unset delivered port
} -result {{220 250 250 250 354 250 221} {<a@example.com> <b@example.com>}}

# -------------------------------------------------------------------------

testsuiteCleanup
return
