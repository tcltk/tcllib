# -*- tcl -*-
# filetypes-api.test: Additional tests for fileutil::magic::filetype
# (see also filetypes.test).
#
# Sourcing this file into Tcl runs the tests and generates output for errors.
# No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.6
testsNeedTcltest 2.0

support {
    useLocal rtcore.tcl fileutil::magic::rt
}
testing {
    useLocal filetypes.tcl fileutil::magic::filetype
}

set gifdata "GIF89a\x2b\x00\x40\x00\xf7\xff\x00"

# -------------------------------------------------------------------------
## Arguments and file names

test fumagic.filetype-api-1.0 {filetype, wrong # args} -body {
    fileutil::magic::filetype
} -returnCodes error -result {wrong # args: should be "fileutil::magic::filetype file"}

test fumagic.filetype-api-1.1 {filetype, wrong # args} -body {
    fileutil::magic::filetype a b
} -returnCodes error -result {wrong # args: should be "fileutil::magic::filetype file"}

test fumagic.filetype-api-1.2 {filetype, empty file name} -body {
    fileutil::magic::filetype {}
} -returnCodes error -result {file not found: ""}

test fumagic.filetype-api-1.3 {filetype, relative file name} -setup {
    makeBinaryFile $gifdata rel.gif
    set cwd [pwd]
    cd [temporaryDirectory]
} -body {
    fileutil::magic::filetype rel.gif
} -cleanup {
    cd $cwd
    removeFile rel.gif
    unset -nocomplain cwd
} -result {{{GIF image data} {version 89a} {43 x} 64} {image gif} {}}

test fumagic.filetype-api-1.4 {filetype, file name with spaces} -setup {
    set d [makeDirectory "dir with spaces"]
    set f [file join $d "a b.gif"]
    set ch [open $f wb]
    puts -nonewline $ch $gifdata
    close $ch
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeDirectory "dir with spaces"
    unset -nocomplain d f ch
} -result {{{GIF image data} {version 89a} {43 x} 64} {image gif} {}}

test fumagic.filetype-api-1.5 {filetype, symbolic link to a file} -constraints {
    unix
} -setup {
    set f [makeBinaryFile $gifdata target.gif]
    set l [tempPath link.gif]
    file link -symbolic $l $f
} -body {
    fileutil::magic::filetype $l
} -cleanup {
    file delete $l
    removeFile target.gif
    unset -nocomplain f l
} -result {{{GIF image data} {version 89a} {43 x} 64} {image gif} {}}

test fumagic.filetype-api-1.6 {filetype, symbolic link to a directory} -constraints {
    unix
} -setup {
    set d [makeDirectory linkeddir]
    set l [tempPath dirlink]
    file link -symbolic $l $d
} -body {
    fileutil::magic::filetype $l
} -cleanup {
    file delete $l
    removeDirectory linkeddir
    unset -nocomplain d l
} -result {directory application/x-directory {}}

test fumagic.filetype-api-1.7 {filetype does not leave channels open} -setup {
    set f [makeBinaryFile $gifdata chan.gif]
    set before [lsort [chan names]]
} -body {
    fileutil::magic::filetype $f
    expr {[lsort [chan names]] eq $before}
} -cleanup {
    removeFile chan.gif
    unset -nocomplain f before
} -result 1

test fumagic.filetype-api-1.8 {filetype, the result has three elements} -setup {
    set f [makeBinaryFile $gifdata three.gif]
} -body {
    llength [fileutil::magic::filetype $f]
} -cleanup {
    removeFile three.gif
    unset -nocomplain f
} -result 3

# -------------------------------------------------------------------------
## More file types

test fumagic.filetype-api-2.1 {filetype, zip archive} -setup {
    set f [makeBinaryFile "PK\x03\x04\x14\x00\x00\x00\x08\x00" a.zip]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile a.zip
    unset -nocomplain f
} -result {{{Zip archive data} {at least} v2.0 {to extract}} {application zip} {}}

test fumagic.filetype-api-2.2 {filetype, 7-zip archive with extensions} -setup {
    set f [makeBinaryFile "7z\xbc\xaf\x27\x1c\x00\x04" a.7z]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile a.7z
    unset -nocomplain f
} -result {{{7-zip archive data} {version 0.4}} {application x-7z-compressed} {7z cb7}}

test fumagic.filetype-api-2.3 {filetype, POSIX shell script} -setup {
    set f [makeBinaryFile "#!/bin/sh\necho hi\n" a.sh]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile a.sh
    unset -nocomplain f
} -result {{{POSIX shell script text executable}} {text x-shellscript} {}}

test fumagic.filetype-api-2.4 {filetype, Windows bitmap} -setup {
    set f [makeBinaryFile [binary format a2ix4iiiiss \
	BM 54 54 40 2 3 1 24] a.bmp]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile a.bmp
    unset -nocomplain f
} -result {{{PC bitmap} {Windows 3.x format} {2 x} {3 x} 24} {image x-ms-bmp} {}}

test fumagic.filetype-api-2.5 {filetype, RTF document} -setup {
    set f [makeBinaryFile "\{\\rtf1\\ansi hello\}" a.rtf]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile a.rtf
    unset -nocomplain f
} -result {{{Rich Text Format data} {version 1} ANSI} {text rtf} {}}

test fumagic.filetype-api-2.6 {filetype, UTF-8 text is text} -setup {
    # Ukrainian "pryvit" in UTF-8.
    set f [makeBinaryFile "\xd0\xbf\xd1\x80\xd0\xb8\xd0\xb2\xd1\x96\xd1\x82\n" utf8.txt]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile utf8.txt
    unset -nocomplain f
} -result {text {} {}}

test fumagic.filetype-api-2.7 {filetype, text with a control character is binary} -setup {
    set f [makeBinaryFile "hello\x01world\n" ctrl.txt]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile ctrl.txt
    unset -nocomplain f
} -result {binary {} {}}

test fumagic.filetype-api-2.8 {filetype, Ogg data} -setup {
    set f [makeBinaryFile "OggS\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00" a.ogg]
} -body {
    fileutil::magic::filetype $f
} -cleanup {
    removeFile a.ogg
    unset -nocomplain f
} -result {{{Ogg data}} {} {}}

# -------------------------------------------------------------------------
unset gifdata
testsuiteCleanup
return
