# -*- tcl -*-
# doctools-api.test:  additional tests for the API of the doctools package.
#
# Complements doctools.test: object methods map, parameters, setparam,
# warnings and destroy, the -ibase option, format mapping and the
# engine API (dt_* commands) as seen by a formatting engine.
# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use textutil/expander.tcl textutil::expander
}
testing {
    useLocal doctools.tcl doctools
}

# The formatting engines load helper packages (textutil, ...) from
# auto_path, make sure they are found when run outside of sak.
set saved_auto_path $auto_path
set auto_path [linsert $auto_path 0 \
    [file dirname [file dirname [file normalize [info script]]]]]

# -------------------------------------------------------------------------

array_unset env LANG*
array_unset env LC_*
set env(LANG) C

set minimal {[manpage_begin foo n 1.0][description]Hello[manpage_end]}

# A minimal formatting engine which reports what the doctools object
# makes available to it through the engine API.

set probeEngine {
    global var
    set var(alpha) {}
    proc fmt_initialize  {}  {return}
    proc fmt_shutdown    {}  {return}
    proc fmt_numpasses   {}  {return 1}
    proc fmt_setup       {n} {return}
    proc fmt_listvariables {} {return alpha}
    proc fmt_varset {v t} {
	global var
	if {$v ne "alpha"} {
	    return -code error "Unknown engine variable \"$v\""
	}
	set var($v) $t
	return
    }
    proc fmt_plain_text  {text} {return $text}
    proc fmt_postprocess {text} {
	global var
	list file [dt_file] mainfile [dt_mainfile] fileid [dt_fileid] \
	    ibase [dt_ibase] module [dt_module] copyright [dt_copyright] \
	    fmap [dt_fmap sym] nomap [dt_fmap other] alpha $var(alpha) \
	    text [string trim $text]
    }
    foreach p {
	manpage_begin moddesc titledesc manpage_end require description
	section para list_begin list_end lst_item call usage bullet enum
	arg_def cmd_def opt_def tkoption_def see_also keywords example
	example_begin example_end nl arg cmd opt emph comment image mdash
	sectref syscmd method option widget fun type package class var
	file uri term const copyright namespace subsection category ndash
    } {
	proc fmt_$p {args} {return ""}
    }
}

set engdir  [tcltest::makeDirectory doctools-api-engines]
set probe   [tcltest::makeFile $probeEngine fmt.probe $engdir]
set partial [tcltest::makeFile {
    proc fmt_numpasses {} {return 1}
} fmt.partial $engdir]
set badpass [tcltest::makeFile [string map {
    {proc fmt_numpasses   {}  {return 1}} {proc fmt_numpasses {} {return 0}}
} $probeEngine] fmt.badpass $engdir]

proc probeResult {res} {
    # The engine output is a dictionary, without the 'text' key
    # it is easier to compare.
    dict remove $res text
}

# -------------------------------------------------------------------------
# Package level commands

test doctools-api-1.0 {help, wrong # args} -body {
    ::doctools::help x
} -returnCodes error -result {wrong # args: should be "::doctools::help"}

test doctools-api-1.1 {help lists the formatting commands} -body {
    set help [::doctools::help]
    list [string match *manpage_begin* $help] [string match *list_begin* $help]
} -cleanup {
    unset help
} -result {1 1}

test doctools-api-1.2 {search, wrong # args} -body {
    ::doctools::search
} -returnCodes error -result {wrong # args: should be "::doctools::search path"}

test doctools-api-1.3 {search, too many args} -body {
    ::doctools::search a b
} -returnCodes error -result {wrong # args: should be "::doctools::search path"}

test doctools-api-1.4 {search, package paths are used for format mapping} -setup {
    set saved $::doctools::paths
    ::doctools::new mydt
} -body {
    ::doctools::search $engdir
    mydt configure -format probe
    mydt cget -format
} -cleanup {
    mydt destroy
    set ::doctools::paths $saved
    unset saved
} -result probe

test doctools-api-1.5 {search, the last path entered is searched first} -setup {
    set saved $::doctools::paths
    set d2 [tcltest::makeDirectory doctools-api-engines2]
    tcltest::makeFile {proc fmt_numpasses {} {return 1}} fmt.probe $d2
    ::doctools::new mydt
} -body {
    ::doctools::search $engdir
    ::doctools::search $d2
    # The incomplete engine in d2 is found first.
    list [catch {mydt configure -format probe} msg] \
	[string match {*error: API incomplete, cannot use this engine} $msg]
} -cleanup {
    mydt destroy
    set ::doctools::paths $saved
    tcltest::removeDirectory doctools-api-engines2
    unset saved d2 msg
} -result {1 1}

# -------------------------------------------------------------------------
# Object creation

test doctools-api-2.0 {new returns the object name} -body {
    ::doctools::new mydt
} -cleanup {
    mydt destroy
} -result mydt

test doctools-api-2.1 {new with options} -body {
    ::doctools::new mydt -ibase /x/y.man -module mod -copyright c
    list [mydt cget -ibase] [mydt cget -module] [mydt cget -copyright]
} -cleanup {
    mydt destroy
} -result {/x/y.man mod c}

test doctools-api-2.2 {new with an unknown option} -body {
    ::doctools::new mydt -foo bar
} -returnCodes error -cleanup {
    catch {mydt destroy}
} -result {doctools::_configure: Unknown option "-foo", expected -copyright, -file, -ibase, -module, -format, or -deprecated}

test doctools-api-2.3 {new with a bad option value} -body {
    ::doctools::new mydt -deprecated foo
} -returnCodes error -cleanup {
    catch {mydt destroy}
} -result {doctools::_configure: -deprecated expected a boolean, got "foo"}

# -------------------------------------------------------------------------
# -ibase

test doctools-api-3.0 {cget -ibase, default} -setup {
    ::doctools::new mydt
} -body {
    mydt cget -ibase
} -cleanup {
    mydt destroy
} -result {}

test doctools-api-3.1 {configure -ibase, set and query} -setup {
    ::doctools::new mydt
} -body {
    mydt configure -ibase /some/where.man
    list [mydt cget -ibase] [mydt configure -ibase]
} -cleanup {
    mydt destroy
} -result {/some/where.man /some/where.man}

test doctools-api-3.2 {configure several options at once} -setup {
    ::doctools::new mydt
} -body {
    mydt configure -file f -ibase i -module m -copyright c -deprecated yes
    mydt configure
} -cleanup {
    mydt destroy
} -result {-file f -ibase i -module m -format {} -copyright c -deprecated yes}

test doctools-api-3.3 {include is resolved relative to -ibase} -setup {
    set dir [tcltest::makeDirectory doctools-api-inc]
    tcltest::makeFile {[manpage_begin incl n 2.0][description][manpage_end]} sub.inc $dir
    ::doctools::new mydt -format list -ibase [file join $dir main.man] -file /nowhere/main.man
} -body {
    dict get [lindex [mydt format {[include sub.inc]}] 1] title
} -cleanup {
    mydt destroy
    tcltest::removeDirectory doctools-api-inc
    unset dir
} -result incl

test doctools-api-3.4 {include falls back to -file if -ibase is empty} -setup {
    set dir [tcltest::makeDirectory doctools-api-inc]
    tcltest::makeFile {[manpage_begin incl n 2.0][description][manpage_end]} sub.inc $dir
    ::doctools::new mydt -format list -file [file join $dir main.man]
} -body {
    dict get [lindex [mydt format {[include sub.inc]}] 1] title
} -cleanup {
    mydt destroy
    tcltest::removeDirectory doctools-api-inc
    unset dir
} -result incl

test doctools-api-3.5 {include of a missing file} -setup {
    set dir [tcltest::makeDirectory doctools-api-inc]
    ::doctools::new mydt -format list -ibase [file join $dir main.man]
} -body {
    mydt format {[include no-such-file.inc]}
} -returnCodes error -cleanup {
    mydt destroy
    tcltest::removeDirectory doctools-api-inc
    unset dir
} -match glob -result {*Unable to find include file "no-such-file.inc"*}

# -------------------------------------------------------------------------
# -format, format mapping

test doctools-api-4.0 {-format accepts the path of an engine file} -setup {
    ::doctools::new mydt
} -body {
    mydt configure -format $probe
    expr {[mydt cget -format] eq $probe}
} -cleanup {
    mydt destroy
} -result 1

test doctools-api-4.1 {-format uses the object search paths} -setup {
    ::doctools::new mydt
} -body {
    mydt search $engdir
    mydt configure -format probe
    mydt cget -format
} -cleanup {
    mydt destroy
} -result probe

test doctools-api-4.2 {object search paths are not shared between objects} -setup {
    ::doctools::new mydt
    ::doctools::new mydt2
} -body {
    mydt search $engdir
    mydt2 configure -format probe
} -returnCodes error -cleanup {
    mydt destroy
    mydt2 destroy
} -result {doctools::_configure: -format: Unknown format "probe"}

test doctools-api-4.3 {failed -format leaves the previous format untouched} -setup {
    ::doctools::new mydt -format list
} -body {
    catch {mydt configure -format bogus}
    list [mydt cget -format] [lindex [mydt format $minimal] 0]
} -cleanup {
    mydt destroy
} -result {list manpage}

test doctools-api-4.4 {engine with incomplete API is rejected} -setup {
    ::doctools::new mydt
} -body {
    list [catch {mydt configure -format $partial} msg] \
	[expr {$msg eq "doctools::_configure: -format: $partial error: API incomplete, cannot use this engine"}] \
	[mydt cget -format]
} -cleanup {
    mydt destroy
    unset msg
} -result {1 1 {}}

test doctools-api-4.5 {engine with illegal number of passes is rejected} -setup {
    ::doctools::new mydt
} -body {
    list [catch {mydt configure -format $badpass} msg] \
	[expr {$msg eq "doctools::_configure: -format: $badpass error: illegal number of passes \"0\""}]
} -cleanup {
    mydt destroy
    unset msg
} -result {1 1}

# -------------------------------------------------------------------------
# Engine API: information passed to the engine

test doctools-api-5.0 {engine sees -file, -module, -copyright} -setup {
    ::doctools::new mydt -format $probe -file /a/b/c.man -module mod -copyright cpr
} -body {
    probeResult [mydt format $minimal]
} -cleanup {
    mydt destroy
} -result {file /a/b/c.man mainfile /a/b/c.man fileid c ibase /a/b/c.man module mod copyright cpr fmap sym nomap other alpha {}}

test doctools-api-5.1 {engine sees -ibase} -setup {
    ::doctools::new mydt -format $probe -file /a/b/c.man -ibase /d/e.man
} -body {
    dict get [mydt format $minimal] ibase
} -cleanup {
    mydt destroy
} -result /d/e.man

test doctools-api-5.2 {engine gets the formatted text} -setup {
    ::doctools::new mydt -format $probe
} -body {
    dict get [mydt format $minimal] text
} -cleanup {
    mydt destroy
} -result Hello

# -------------------------------------------------------------------------
# map

test doctools-api-6.0 {map, wrong # args} -setup {
    ::doctools::new mydt
} -body {
    mydt map a
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_map name sfname afname"}

test doctools-api-6.1 {map, too many args} -setup {
    ::doctools::new mydt
} -body {
    mydt map a b c
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_map name sfname afname"}

test doctools-api-6.2 {map returns empty, mapping is seen through dt_fmap} -setup {
    ::doctools::new mydt -format $probe
} -body {
    set r [mydt map sym actual.html]
    lappend r [dict get [mydt format $minimal] fmap] \
	[dict get [mydt format $minimal] nomap]
} -cleanup {
    mydt destroy
    unset r
} -result {actual.html other}

test doctools-api-6.3 {map, later mapping replaces earlier one} -setup {
    ::doctools::new mydt -format $probe
} -body {
    mydt map sym first.html
    mydt map sym second.html
    dict get [mydt format $minimal] fmap
} -cleanup {
    mydt destroy
} -result second.html

test doctools-api-6.4 {map is used by html xref links} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt map sym actual.html
    mydt setparam xref {{sa,foo sym frag}}
    regexp {<a href="actual.html#frag">} [mydt format \
	{[manpage_begin foo n 1.0][description][para][cmd foo][manpage_end]}]
} -cleanup {
    mydt destroy
} -result 1

# -------------------------------------------------------------------------
# parameters

test doctools-api-7.0 {parameters, too many args} -setup {
    ::doctools::new mydt
} -body {
    mydt parameters x
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_parameters name"}

test doctools-api-7.1 {parameters, no format configured} -setup {
    ::doctools::new mydt
} -body {
    mydt parameters
} -cleanup {
    mydt destroy
} -result {}

test doctools-api-7.2 {parameters, html engine} -setup {
    ::doctools::new mydt -format html
} -body {
    lsort [mydt parameters]
} -cleanup {
    mydt destroy
} -result {footer header meta raw xref}

test doctools-api-7.3 {parameters, markdown engine} -setup {
    ::doctools::new mydt -format markdown
} -body {
    lsort [mydt parameters]
} -cleanup {
    mydt destroy
} -result {header xref}

test doctools-api-7.4 {parameters, engines without parameters} -setup {
    ::doctools::new mydt
} -body {
    set res {}
    foreach f {latex nroff text wiki tmml} {
	mydt configure -format $f
	lappend res $f [mydt parameters]
    }
    set res
} -cleanup {
    mydt destroy
    unset res f
} -result {latex {} nroff {} text {} wiki {} tmml {}}

# The stubs in api.tcl return the error script as a string instead of
# throwing it, so engines not defining fmt_listvariables themselves
# (list, desc, null) report a bogus parameter list.
test doctools-api-7.5 {parameters, engines without fmt_listvariables} -constraints knownBug -setup {
    ::doctools::new mydt
} -body {
    set res {}
    foreach f {list desc null} {
	mydt configure -format $f
	lappend res $f [mydt parameters]
    }
    set res
} -cleanup {
    mydt destroy
    unset res f
} -result {list {} desc {} null {}}

test doctools-api-7.6 {parameters change with the format} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt configure -format $probe
    mydt parameters
} -cleanup {
    mydt destroy
} -result alpha

# -------------------------------------------------------------------------
# setparam

test doctools-api-8.0 {setparam, wrong # args} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt setparam x
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_setparam name param value"}

test doctools-api-8.1 {setparam, too many args} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt setparam x y z
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_setparam name param value"}

test doctools-api-8.2 {setparam, no format configured} -setup {
    ::doctools::new mydt
} -body {
    mydt setparam header x
} -returnCodes error -cleanup {
    mydt destroy
} -result {Unable to set parameters without a valid format}

test doctools-api-8.3 {setparam, unknown parameter} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt setparam nosuch x
} -returnCodes error -cleanup {
    mydt destroy
} -result {Unknown engine variable "nosuch"}

# Engines without parameters silently accept any parameter name.
test doctools-api-8.4 {setparam, unknown parameter, engine without parameters} -constraints knownBug -setup {
    ::doctools::new mydt -format latex
} -body {
    mydt setparam nosuch x
} -returnCodes error -cleanup {
    mydt destroy
} -match glob -result *nosuch*

test doctools-api-8.5 {setparam returns empty, value reaches the engine} -setup {
    ::doctools::new mydt -format $probe
} -body {
    list [mydt setparam alpha 42] [dict get [mydt format $minimal] alpha]
} -cleanup {
    mydt destroy
} -result {{} 42}

test doctools-api-8.6 {setparam html header and footer} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt setparam header <p>HEADERMARK</p>
    mydt setparam footer <p>FOOTERMARK</p>
    set out [mydt format $minimal]
    list [regexp {<body>.*HEADERMARK.*FOOTERMARK.*</body>} $out]
} -cleanup {
    mydt destroy
    unset out
} -result 1

test doctools-api-8.7 {setparam html meta} -setup {
    ::doctools::new mydt -format html
} -body {
    mydt setparam meta {<meta name="x" content="METAMARK">}
    regexp {<head>.*METAMARK.*</head>} [mydt format $minimal]
} -cleanup {
    mydt destroy
} -result 1

test doctools-api-8.8 {setparam, new format resets parameters} -setup {
    ::doctools::new mydt -format $probe
} -body {
    mydt setparam alpha 42
    mydt configure -format $probe
    dict get [mydt format $minimal] alpha
} -cleanup {
    mydt destroy
} -result {}

# -------------------------------------------------------------------------
# warnings

test doctools-api-9.0 {warnings, too many args} -setup {
    ::doctools::new mydt
} -body {
    mydt warnings x
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_warnings name"}

test doctools-api-9.1 {warnings, before any format} -setup {
    ::doctools::new mydt
} -body {
    mydt warnings
} -cleanup {
    mydt destroy
} -result {}

test doctools-api-9.2 {warnings refer to the last format only} -setup {
    ::doctools::new mydt -format list -deprecated 1
} -body {
    mydt format {[manpage_begin foo n 1.0][description][strong foo][manpage_end]}
    set n [llength [mydt warnings]]
    mydt format $minimal
    list $n [mydt warnings]
} -cleanup {
    mydt destroy
    unset n
} -result {1 {}}

# -------------------------------------------------------------------------
# destroy

test doctools-api-10.0 {destroy, too many args} -setup {
    ::doctools::new mydt
} -body {
    mydt destroy x
} -returnCodes error -cleanup {
    mydt destroy
} -result {wrong # args: should be "::doctools::_destroy name"}

test doctools-api-10.1 {destroy removes command and state} -setup {
    ::doctools::new mydt -format html
} -body {
    list [mydt destroy] [info commands mydt] \
	[namespace exists ::doctools::doctoolsmydt]
} -result {{} {} 0}

test doctools-api-10.2 {name can be reused after destroy} -setup {
    ::doctools::new mydt -module a
    mydt destroy
} -body {
    ::doctools::new mydt
    mydt cget -module
} -cleanup {
    mydt destroy
} -result {}

# -------------------------------------------------------------------------

tcltest::removeDirectory doctools-api-engines
unset -nocomplain minimal probeEngine engdir probe partial badpass
rename probeResult {}
set auto_path $saved_auto_path
unset saved_auto_path
testsuiteCleanup
return
