test ftpd-3.0 {docRoot, set and get} -setup {
    set old [::ftpd::fsFile::docRoot]
} -body {
    list [::ftpd::fsFile::docRoot $root] [::ftpd::fsFile::docRoot]
} -cleanup {
    ::ftpd::fsFile::docRoot $old
    unset old
} -result [list {} $root]

test ftpd-3.1 {fs exists} -setup {
    ::ftpd::fsFile::docRoot [mktree $root]
} -body {
    list [::ftpd::fsFile::fs exists a.txt] [::ftpd::fsFile::fs exists sub] \
	[::ftpd::fsFile::fs exists missing] [::ftpd::fsFile::fs exists sub/b.txt]
} -cleanup {
    ::ftpd::fsFile::docRoot /
    file delete -force $root
} -result {1 0 0 1}

test ftpd-3.2 {fs permissions} -constraints unix -setup {
    ::ftpd::fsFile::docRoot [mktree $root]
} -body {
    list [format %o [expr {[::ftpd::fsFile::fs permissions a.txt] & 0o777}]] \
