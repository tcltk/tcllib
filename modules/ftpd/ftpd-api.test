# -*- tcl -*-
# ftpd-api.test:  tests for the documented API of the ftpd package.
#
# The configuration commands and the default file system callback are
# tested in this process.  The server itself runs in a child process,
# controlled through its standard input (the tests send it Tcl scripts
# and read back the results), so that the tests can use simple blocking
# client sockets for the control and data connections.
#
# Sourcing this file into Tcl runs the tests and generates output for
# errors.  No output means no errors were found.

# -------------------------------------------------------------------------

source [file join \
	[file dirname [file dirname [file join [pwd] [info script]]]] \
	devtools testutilities.tcl]

testsNeedTcl     8.5
testsNeedTcltest 2.0

support {
    use cmdline/cmdline.tcl cmdline
}
testing {
    # On Tcl 9 the package does not load, ticket 34a589f660 (see the
    # test ftpd-0.1).  Make tcl_platform visible in the namespace, so
    # that the rest of the API can be tested.
    namespace eval ::ftpd {upvar #0 ::tcl_platform tcl_platform}
    useLocalKeep ftpd.tcl ftpd
}

# Never print the log to stderr.
::ftpd::config -logCmd {apply {args {}}}

testConstraint unix [string equal $tcl_platform(platform) unix]

# -------------------------------------------------------------------------
# A small tree of files used as the document root.

proc mktree {root} {
    file delete -force $root
    file mkdir $root [file join $root sub] [file join $root empty]
    foreach {name data perm} {
	a.txt      "hello\n"        0644
	secret.txt "secret\n"       0600
	sub/b.txt  "line1\nline2\n" 0644
	.hidden    "h\n"            0644
    } {
	set f [open [file join $root $name] wb]
	puts -nonewline $f $data
	close $f
	catch {file attributes [file join $root $name] -permissions $perm}
    }
    return $root
}

proc readfile {path} {
    set f [open $path rb]
    set data [read $f]
    close $f
    return $data
}

set root [file join [temporaryDirectory] ftpdroot]

# Calls the default file system callback with a channel for the
# messages; returns the result and the messages.
proc fs {args} {
    set f [open [file join [temporaryDirectory] ftpdmsg] w+]
    set code [catch {uplevel 1 [linsert $args 0 ::ftpd::fsFile::fs] $f} res]
    seek $f 0
    set msg [read $f]
    close $f
    file delete [file join [temporaryDirectory] ftpdmsg]
    return -code $code [list $res $msg]
}

# -------------------------------------------------------------------------
# Loading, variables

test ftpd-0.1 {package loads on Tcl 9, ticket 34a589f660} -constraints {
    knownBug
} -setup {
    set ip [interp create]
} -body {
    $ip eval [list source [localPath ftpd.tcl]]
    $ip eval {package present ftpd}
} -cleanup {
    interp delete $ip
    unset ip
} -match glob -result {1.*}

test ftpd-0.2 {variables, defaults} -setup {
    set ip [interp create]
    $ip eval {namespace eval ::ftpd {upvar #0 ::tcl_platform tcl_platform}}
    $ip eval [list source [localPath ftpd.tcl]]
} -body {
    $ip eval {list $::ftpd::port $::ftpd::cwd $::ftpd::contact $::ftpd::welcome}
} -cleanup {
    interp delete $ip
    unset ip
} -result [list 21 {} "$tcl_platform(user)@[info hostname]" "[info hostname] FTP server ready."]

test ftpd-0.3 {variables are not overwritten when the package is loaded} -setup {
    set ip [interp create]
} -body {
    $ip eval {
	namespace eval ::ftpd {
	    upvar #0 ::tcl_platform tcl_platform
	    variable contact me@example.com
	    variable welcome Hello
	    variable cwd sub
	}
    }
    $ip eval [list source [localPath ftpd.tcl]]
    $ip eval {list $::ftpd::contact $::ftpd::welcome $::ftpd::cwd}
} -cleanup {
    interp delete $ip
    unset ip
} -result {me@example.com Hello sub}

test ftpd-0.4 {namespace exports} -body {
    lsort [namespace eval ::ftpd {namespace export}]
} -result {accept anonAuth config fileAuth hasCallback logStderr read server unixAuth}

# -------------------------------------------------------------------------
# ::ftpd::config / ::ftpd::hasCallback

test ftpd-1.0 {config, no options} -body {
    ::ftpd::config
} -result {}

test ftpd-1.1 {config, defaults} -setup {
    set ip [interp create]
    $ip eval {namespace eval ::ftpd {upvar #0 ::tcl_platform tcl_platform}}
    $ip eval [list source [localPath ftpd.tcl]]
} -body {
    $ip eval {
	set res {}
	foreach o {closeCmd authIpCmd authUsrCmd authFileCmd logCmd fsCmd xferDoneCmd} {
	    lappend res $o [::ftpd::hasCallback $o]
	}
	set res
    }
} -cleanup {
    interp delete $ip
    unset ip
} -result {closeCmd 0 authIpCmd 0 authUsrCmd 1 authFileCmd 1 logCmd 1 fsCmd 1 xferDoneCmd 0}

test ftpd-1.2 {config, set all callbacks} -setup {
    set ip [interp create]
    $ip eval {namespace eval ::ftpd {upvar #0 ::tcl_platform tcl_platform}}
    $ip eval [list source [tcllibPath cmdline/cmdline.tcl]]
    $ip eval [list source [localPath ftpd.tcl]]
} -body {
    $ip eval {
	::ftpd::config -closeCmd c1 -authIpCmd c2 -authUsrCmd c3 \
	    -authFileCmd c4 -logCmd c5 -fsCmd c6 -xferDoneCmd c7
	set res {}
	foreach o {closeCmd authIpCmd authUsrCmd authFileCmd logCmd fsCmd xferDoneCmd} {
	    lappend res [set ::ftpd::cfg($o)] [::ftpd::hasCallback $o]
	}
	set res
    }
} -cleanup {
    interp delete $ip
    unset ip
} -result {c1 1 c2 1 c3 1 c4 1 c5 1 c6 1 c7 1}

test ftpd-1.3 {config, keeps the other callbacks} -setup {
    set ip [interp create]
    $ip eval {namespace eval ::ftpd {upvar #0 ::tcl_platform tcl_platform}}
    $ip eval [list source [tcllibPath cmdline/cmdline.tcl]]
    $ip eval [list source [localPath ftpd.tcl]]
} -body {
    $ip eval {
	::ftpd::config -closeCmd c1
	::ftpd::config -logCmd c5
	::ftpd::config -authIpCmd {}
	list $::ftpd::cfg(closeCmd) $::ftpd::cfg(logCmd) $::ftpd::cfg(authUsrCmd) \
	    [::ftpd::hasCallback authIpCmd]
    }
} -cleanup {
    interp delete $ip
    unset ip
} -result {c1 c5 ::ftpd::anonAuth 0}

test ftpd-1.4 {config, unknown option} -body {
    ::ftpd::config -foo bar
} -returnCodes error -match glob -result "* options:\n -closeCmd value *"

test ftpd-1.5 {config, missing value} -body {
    ::ftpd::config -closeCmd
} -returnCodes error -match glob -result "* options:\n -closeCmd value *"

test ftpd-1.6 {hasCallback, unknown callback} -body {
    ::ftpd::hasCallback fooCmd
} -result 0

# -------------------------------------------------------------------------
# Authentication callbacks shipped with the package

test ftpd-2.0 {anonAuth} -body {
    list [::ftpd::anonAuth anonymous joe@example.com] [::ftpd::anonAuth ftp a@b.c] \
	[::ftpd::anonAuth joe joe@example.com] [::ftpd::anonAuth anonymous joe] \
	[::ftpd::anonAuth anonymous joe@localhost] [::ftpd::anonAuth anonymous a@b@c.d] \
	[::ftpd::anonAuth Anonymous joe@example.com]
} -result {1 1 0 0 0 0 0}

test ftpd-2.1 {fileAuth, read} -constraints unix -setup {
    ::ftpd::fsFile::docRoot [mktree $root]
} -body {
    list [::ftpd::fileAuth joe a.txt read] [::ftpd::fileAuth joe secret.txt read] \
	[::ftpd::fileAuth joe missing.txt read]
} -cleanup {
    ::ftpd::fsFile::docRoot /
    file delete -force $root
} -result {1 0 0}

test ftpd-2.2 {fileAuth, write} -constraints unix -setup {
    ::ftpd::fsFile::docRoot [mktree $root]
    file attributes [file join $root sub b.txt] -permissions 0666
    file attributes [file join $root empty] -permissions 0777
} -body {
    list [::ftpd::fileAuth joe a.txt write] [::ftpd::fileAuth joe sub/b.txt write] \
	[::ftpd::fileAuth joe sub/new.txt write]
} -cleanup {
    ::ftpd::fsFile::docRoot /
    file delete -force $root
} -result {0 1 0}

test ftpd-2.3 {fileAuth, new file in a directory writable by others} -constraints {
    unix knownBug
} -setup {
    ::ftpd::fsFile::docRoot [mktree $root]
    file attributes [file join $root empty] -permissions 0777
} -body {
    ::ftpd::fileAuth joe empty/new.txt write
} -cleanup {
    ::ftpd::fsFile::docRoot /
    file delete -force $root
} -result 1

