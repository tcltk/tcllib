# -*- tcl -*-
# -------------------------------------------------------------------------
# Tests
# -------------------------------------------------------------------------

set i 0
foreach name [lsort -dict [array names JSON]] {
    test json-${impl}-1.[incr i] "test JSON $name" -body {
	transform [json::json2dict $JSON($name)] $name
    } -result [resultfor $name]
}

set i 0
foreach name [lsort -dict [array names JSON]] {
    test json-${impl}-7.[incr i] "validate JSON $name" -body {
        json::validate $JSON($name)
    } -result 1
}

set i 0
foreach name [lsort -dict [array names FAIL]] {
    test json-${impl}-8.[incr i] "test FAIL $name" -body {
	json::json2dict $FAIL($name)
    } -returnCodes error -result $ERR(${name}-${impl})
}

set i 0
foreach name [lsort -dict [array names FAIL]] {
    test json-${impl}-9.[incr i] "validate FAIL $name" -body {
        json::validate $FAIL($name)
    } -result 0
}

# -------------------------------------------------------------------------
# More Tests - list2json, string2json
# TODO: dict2json
# -------------------------------------------------------------------------

test json-${impl}-2.0 {list2json} -body {
    json::list2json {{"a"} {"b"} {"c"}}
} -result {["a","b","c"]}

test json-${impl}-2.1 {string2json} -body {
    json::string2json a
} -result {"a"}

# -------------------------------------------------------------------------
# many-json2dict
# -------------------------------------------------------------------------

test json-${impl}-3.0 {many-json2dict, wrong args, not enough} -body {
    json::many-json2dict
} -returnCodes error -match glob -result {wrong # args: should be "*json::many[-_]json2dict* jsonText ?max?"}

test json-${impl}-3.1 {many-json2dict, wrong args, too many} -body {
    json::many-json2dict J M X
} -returnCodes error -match glob -result {wrong # args: should be "*json::many[-_]json2dict* jsonText ?max?"}

test json-${impl}-3.2 {many-json2dict, bad limit, zero} -body {
    json::many-json2dict {[]} 0
} -returnCodes error -result {Bad limit 0 of json entities to extract.}

set i 0
foreach first [lsort -dict [array names JSON]] {
    foreach second [lsort -dict [array names JSON]] {
        set    input $JSON($first)
        append input " " $JSON($second)

        set     output {}
        lappend output [resultfor $first]
        lappend output [resultfor $second]

        test json-${impl}-4.[incr i] "many-json2dict: $first/$second, all" -body {
            transform* [json::many-json2dict $input] $first $second
        } -result $output
    }
}

set i 0
foreach first [lsort -dict [array names JSON]] {
    foreach second [lsort -dict [array names JSON]] {
        set    input $JSON($first)
        append input " " $JSON($second)

        set     output {}
        lappend output [resultfor $first]

        test json-${impl}-5.[incr i] "many-json2dict: $first/$second, first only" -body {
            transform* [json::many-json2dict $input 1] $first
        } -result $output
    }
}

set i 0
foreach first [lsort -dict [array names JSON]] {
    set input $JSON($first)
    test json-${impl}-6.[incr i] "many-json2dict, bad limit, 3 over 1" -body {
        json::many-json2dict $input 3
    } -returnCodes error -result {Bad limit 3 of json entities to extract, found only 1.}
}

# -------------------------------------------------------------------------
# json2dict -strict
# -------------------------------------------------------------------------

set i 0
foreach name [lsort -dict [array names JSON]] {
    test json-${impl}-10.[incr i] "json2dict -strict, JSON $name" -body {
	transform [json::json2dict -strict $JSON($name)] $name
    } -result [resultfor $name]
}

test json-${impl}-11.0 {json2dict, wrong args, not enough} -body {
    json::json2dict
} -returnCodes error -result {wrong # args: should be "json::json2dict ?-strict? jsonText"}

test json-${impl}-11.1 {json2dict, wrong args, too many} -body {
    json::json2dict -strict {[]} X
} -returnCodes error -result {wrong # args: should be "json::json2dict ?-strict? jsonText"}

test json-${impl}-11.2 {json2dict, wrong args, bad option} -body {
    json::json2dict -bogus {[]}
} -returnCodes error -result {wrong # args: should be "json::json2dict ?-strict? jsonText"}

test json-${impl}-11.3 {json2dict, trailing text ignored by default} -body {
    json::json2dict {{"a":1} garbage}
} -result {a 1}

test json-${impl}-11.4 {json2dict, second entity ignored by default} -body {
    json::json2dict {{"a":1} {"b":2}}
} -result {a 1}

test json-${impl}-11.5 {json2dict, invalid characters ignored by default} -constraints tcl -body {
    json::json2dict {{"a": @@ 1}}
} -result {a 1}

test json-${impl}-11.6 {json2dict -strict, trailing white space} -body {
    json::json2dict -strict "{\"a\":1} \n\t\r"
} -result {a 1}

test json-${impl}-11.7 {json2dict -strict, second entity} -body {
    json::json2dict -strict {{"a":1} {"b":2}}
} -returnCodes error -result {unexpected trailing text after the JSON entity}

test json-${impl}-11.8 {json2dict -strict, second entity without white space} -body {
    json::json2dict -strict {truefalse}
} -returnCodes error -result {unexpected trailing text after the JSON entity}

test json-${impl}-11.9 {json2dict -strict, error code for trailing text} -body {
    catch {json::json2dict -strict {[1] [2]}}
    set ::errorCode
} -result {JSON TRAILING}

test json-${impl}-11.10 {json2dict -strict, trailing garbage} -body {
    json::json2dict -strict {{"a":1} garbage}
} -returnCodes error -match glob -result *

test json-${impl}-11.11 {json2dict -strict, invalid characters} -body {
    json::json2dict -strict {{"a": @@ 1}}
} -returnCodes error -match glob -result *

test json-${impl}-11.12 {json2dict -strict, invalid characters} -constraints tcl -body {
    json::json2dict -strict {{"a": @@ 1}}
} -returnCodes error -result {unexpected character "@" at offset 6}

test json-${impl}-11.13 {json2dict -strict, error code for invalid characters} -constraints tcl -body {
    catch {json::json2dict -strict {[1] x}}
    set ::errorCode
} -result {JSON BAD-CHARACTER 4}

# The C parser accepts \f and \v before numbers (strtod skips them).
test json-${impl}-11.14 {json2dict -strict, non-JSON white space} -constraints tcl -body {
    json::json2dict -strict "\[1,\f2\]"
} -returnCodes error -match glob -result *

test json-${impl}-11.15 {json2dict -strict, garbage after a word} -body {
    json::json2dict -strict {nullx}
} -returnCodes error -match glob -result *

# -------------------------------------------------------------------------
