.SH NAME
struct::matrix \- Create and manipulate matrix objects
.SH SYNOPSIS
package require \fBTcl 8\&.5 9\fR
.sp
package require \fBstruct::matrix ?2\&.2?\fR
.sp
\fB::struct::matrix\fR ?\fIaMatrix\fR? ?\fB=\fR|\fB:=\fR|\fBas\fR|\fBdeserialize\fR \fIsource\fR?
.sp
\fBaMatrix\fR \fIoption\fR ?\fIarg arg \&.\&.\&.\fR?
